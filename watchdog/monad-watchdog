#!/usr/bin/env bash
#
# monad-watchdog.sh — detect & recover a stuck Monad FULL-NODE.
#
# ┌─ READ THIS ───────────────────────────────────────────────────────────────┐
# │ FULL-NODES ONLY by default. This script `systemctl restart`s the monad     │
# │ services. On a full-node that is safe. On an ACTIVE VALIDATOR a restart in  │
# │ your proposal slot = MISSED BLOCKS (and possible penalties). The script     │
# │ auto-detects a non-burn beneficiary in node.toml and REFUSES to restart     │
# │ unless ALLOW_VALIDATOR_RESTART=1 is set explicitly.                         │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# Targets the "local timeout deadlock": a full-node that drops below the
# upstream-validator target stops receiving proposals, loops on `local timeout`,
# freezes its block-tree root, and can NEVER self-recover (its auto-statesync
# trigger is gated behind a restart that won't self-fire). A process restart is
# the required recovery.
#
# DECISION MODEL (important — designed to avoid false restarts):
#   * The ONLY restart trigger is RPC-derived: block FROZEN (not advancing).
#     A large GAP while the node is still ADVANCING is alert-only — a restart
#     can't help a node that is already processing blocks, it would only discard
#     progress. The local node RPC is read directly on the host and guarded — if
#     the RPC is unreachable we ALERT and do nothing (never restart on a blind 0).
#   * Session count is read LOCALLY from otelcol (:8889/metrics), NOT from
#     Prometheus (which may be remote or absent on a clean validator). It is
#     used only as alert CONTEXT — it NEVER triggers a restart by itself. If it
#     is unreadable we simply omit it; the RPC signals still drive the decision.
#   * Sessions use monad_wireauth_udp_state_TRANSPORT_sessions (established
#     sessions), NOT *_total_sessions — total includes in-progress
#     initiating/responding handshakes and an isolated node hammering handshakes
#     can show total>=3 while transport=0. (Matches the Grafana "Active peers" fix.)
#
# Cron (every 5 min):
#   */5 * * * * /usr/local/bin/monad-watchdog >> /var/log/monad-watchdog.log 2>&1
#
set -uo pipefail

# ---- config (override via env) ----
RPC="${RPC:-http://localhost:8080}"                   # local node RPC
# Network head reference. Do NOT hardcode testnet: on a mainnet node a testnet reference either
# spams "N blocks behind" forever (testnet ahead) or makes the lag detector silently dead
# (testnet behind → GAP negative → threshold never trips). Resolve from the local chain_id
# unless the operator pinned NET_RPC explicitly.
chain_id_local() {
  curl -s -m5 -X POST "$RPC" -H 'Content-Type: application/json' \
    --data '{"jsonrpc":"2.0","method":"eth_chainId","params":[],"id":1}' 2>/dev/null \
    | grep -oiE '"result":"0x[0-9a-f]+"' | grep -oiE '0x[0-9a-f]+'
}
if [ -z "${NET_RPC:-}" ]; then
  case "$(chain_id_local)" in
    0x279f|0x279F) NET_RPC="https://testnet-rpc.monad.xyz" ;;   # 10143 testnet
    0x8f|0x8F)     NET_RPC="https://rpc.monad.xyz" ;;           # 143 mainnet
    *)             NET_RPC="" ;;                                # unknown → gap check disabled below
  esac
fi
OTEL="${OTEL:-http://127.0.0.1:8889/metrics}"         # LOCAL otelcol exporter (no Prometheus dep)
SERVICES="${SERVICES:-monad-bft monad-execution monad-rpc}"

# Restart triggers (RPC-derived only):
#   Testnet runs ~750 blocks / 5 min (~2.5 bps). A healthy synced node advances
#   far more than MIN_ADVANCE each run; below it the node is effectively dead
#   even if not at a hard 0. Tune MIN_ADVANCE to your cron interval + network bps.
MIN_ADVANCE="${MIN_ADVANCE:-50}"   # min blocks local head must gain per run to count as alive
GAP_ALERT="${GAP_ALERT:-2000}"     # blocks behind network head that is clearly unhealthy

# Corroborating-only (NEVER triggers a restart):
SESS_TARGET="${SESS_TARGET:-3}"    # NUM_UPSTREAM_VALIDATORS target, for alert context

# Stuck-statesync detector: a node too far behind can sit at statesync_syncing=1
# forever while no peer serves the snapshot — block height never advances and a
# restart will NOT help (needs a Hard Reset / snapshot restore). We don't restart
# in this state; we ALERT after the synced height has been frozen this long.
STATESYNC_STALL_MIN="${STATESYNC_STALL_MIN:-30}"   # minutes of frozen height while syncing → alert

RESTART_COOLDOWN="${RESTART_COOLDOWN:-1800}"            # min seconds between restarts
ALLOW_VALIDATOR_RESTART="${ALLOW_VALIDATOR_RESTART:-0}" # safety gate, see header
NODE_TOML="${NODE_TOML:-/home/monad/monad-bft/config/node.toml}"
ALERT_WEBHOOK="${ALERT_WEBHOOK:-}"                      # optional Slack/Discord/Telegram webhook

STATE_DIR="${STATE_DIR:-/var/lib/monad-watchdog}"
STATE_FILE="$STATE_DIR/last_block"
COOLDOWN_FILE="$STATE_DIR/last_restart"
mkdir -p "$STATE_DIR"

ts()  { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
log() { echo "$(ts) $*"; }
alert() {
  log "ALERT: $*"
  [ -n "$ALERT_WEBHOOK" ] && curl -fsS -m5 -X POST "$ALERT_WEBHOOK" \
    -H 'Content-Type: application/json' \
    --data "{\"text\":\"[monad-watchdog $(hostname)] $*\"}" >/dev/null 2>&1 || true
}

rpc_block() {
  # Empty endpoint (unknown chain) → no reference height, callers treat as "no data".
  [ -n "$1" ] || return 0
  # Extract the `result` field specifically and accept UPPERCASE hex: a proxy/CDN returning
  # `0x2EF127F` used to match only `0x2` here, yielding LOCAL=2 and a bogus "frozen" verdict
  # that restarted a perfectly healthy node.
  curl -s -m5 -X POST "$1" -H 'Content-Type: application/json' \
    --data '{"jsonrpc":"2.0","method":"eth_blockNumber","params":[],"id":1}' \
    | sed -n 's/.*"result"[[:space:]]*:[[:space:]]*"\(0[xX][0-9a-fA-F]*\)".*/\1/p' | head -1
}
# read a single gauge value from the local otelcol exposition. The metric line
# is `name{labels} value timestamp`, so anchor on name + `{` or space, then the
# value is field 2 after awk splits on whitespace.
#
# Prometheus renders large gauge values in scientific notation
# (e.g. block height 34688141 → "3.4688141e+07"). Bash arithmetic and the
# `${var%%.*}` truncation callers use would mangle that ("3.46…" → "3"), so we
# normalize to a plain integer here via printf "%.0f". All gauges read by this
# watchdog (session counts, statesync_syncing 0/1, ledger block_num) are
# integer-valued, so rounding is exact.
otel_gauge() {
  curl -s -m5 "$OTEL" 2>/dev/null \
    | grep -E "^$1[ {]" | head -1 \
    | awk '{ if ($2 == "") exit; printf "%.0f\n", $2 }'
}
# established sessions only — read locally, no Prometheus dependency
otel_transport_sessions() { otel_gauge 'monad_wireauth_udp_state_transport_sessions'; }

# ---- validator safety gate (point 4) ----
# FAIL-CLOSED: an unreadable / missing node.toml must NOT disable the gate. Previously the
# whole block sat inside `&& [ -r "$NODE_TOML" ]`, so `chmod 700 /home/monad`, running from a
# non-root cron, or MF moving the config path in a future release silently removed the
# protection and the watchdog would restart an ACTIVE VALIDATOR — the exact thing this gate
# exists to prevent. When we cannot tell, we assume validator and refuse to restart.
GATE_BLOCK_RESTART=0
if [ "$ALLOW_VALIDATOR_RESTART" != "1" ]; then
  if [ -r "$NODE_TOML" ]; then
    BEN=$(grep -E '^\s*beneficiary' "$NODE_TOML" 2>/dev/null | grep -oiE '0x[0-9a-f]+' | head -1)
    if [ -n "$BEN" ] && [ "$BEN" != "0x0000000000000000000000000000000000000000" ]; then
      log "node.toml beneficiary=$BEN (non-burn) → looks like a VALIDATOR. Will NOT auto-restart."
      log "  override with ALLOW_VALIDATOR_RESTART=1 (WARNING: restart in a proposal slot drops blocks)."
      GATE_BLOCK_RESTART=1
    fi
  else
    log "ALERT: node.toml not readable at $NODE_TOML — cannot tell validator from full-node."
    log "  Assuming VALIDATOR (fail-closed). Will NOT auto-restart."
    log "  Fix the path/permissions, or set ALLOW_VALIDATOR_RESTART=1 if this is a full-node."
    GATE_BLOCK_RESTART=1
  fi
fi

# ---- gather RPC signals (authoritative restart triggers) ----
LOCAL_HEX=$(rpc_block "$RPC");    LOCAL=$(printf '%d' "$LOCAL_HEX" 2>/dev/null || echo 0)
HEAD_HEX=$(rpc_block "$NET_RPC"); HEAD=$(printf '%d' "$HEAD_HEX" 2>/dev/null || echo 0)
PREV=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
[ "$LOCAL" -gt 0 ] && echo "$LOCAL" > "$STATE_FILE"

# guard (point 2): local RPC unreachable / statesync in progress → never restart on a blind 0.
# During statesync the RPC is intentionally down until sync completes, so we
# must not alert-spam every run. If statesync_syncing=1 we check that the synced
# height is actually advancing: advancing → quiet log; frozen past
# STATESYNC_STALL_MIN → ALERT (peer statesync that can't complete needs a Hard
# Reset, which we never auto-perform). A genuine RPC-down-without-statesync also
# escalates to an alert.
if [ "$LOCAL" -eq 0 ]; then
  SYNCING=$(otel_gauge 'monad_statesync_syncing'); SYNCING="${SYNCING%%.*}"
  if [ "${SYNCING:-0}" = "1" ]; then
    # Legitimately recovering — BUT verify statesync is actually advancing.
    # If the synced height stays frozen while syncing=1, peer statesync is
    # stuck (no peer serving state at our target) and only a Hard Reset fixes
    # it. Track height+timestamp across runs; alert once frozen too long.
    SS_H=$(otel_gauge 'monad_execution_ledger_block_num'); SS_H="${SS_H%%.*}"
    SS_FILE="$STATE_DIR/statesync_progress"
    NOW=$(date +%s)
    read -r PREV_H PREV_T < "$SS_FILE" 2>/dev/null || { PREV_H=""; PREV_T=""; }
    if [ -z "$PREV_H" ] || [ "${SS_H:-0}" != "$PREV_H" ]; then
      echo "${SS_H:-0} $NOW" > "$SS_FILE"   # advancing (or first sample) → reset stall timer
      log "statesync_syncing=1, height=${SS_H:-?} advancing → recovering. No action."
      exit 0
    fi
    FROZEN_S=$(( NOW - ${PREV_T:-$NOW} ))
    if [ "$FROZEN_S" -ge "$(( STATESYNC_STALL_MIN * 60 ))" ]; then
      alert "statesync STALLED — syncing=1 but height frozen at ${SS_H:-?} for ${FROZEN_S}s (>= ${STATESYNC_STALL_MIN}m). Peer statesync not completing — needs Hard Reset / snapshot restore. NOT auto-performing destructive recovery."
      exit 2
    fi
    log "statesync_syncing=1, height ${SS_H:-?} frozen ${FROZEN_S}s (alert at ${STATESYNC_STALL_MIN}m). No action yet."
    exit 0
  fi
  rm -f "$STATE_DIR/statesync_progress" 2>/dev/null   # not syncing → clear stall tracker
  alert "local RPC unreachable or returning 0 (services down?). Not auto-restarting on a blind 0 — check manually."
  exit 2
fi

GAP=0; [ "$HEAD" -gt 0 ] && GAP=$(( HEAD - LOCAL ))
ADVANCED=$(( LOCAL - PREV ))
# FROZEN catches slow-crawl, not just a hard stop (point 3). Needs a prior sample.
FROZEN=0; [ "$PREV" -gt 0 ] && [ "$ADVANCED" -lt "$MIN_ADVANCE" ] && FROZEN=1

# ---- corroborating-only session count (point 1 + 2: local, transport, never a trigger) ----
SESS_RAW=$(otel_transport_sessions); SESS="${SESS_RAW%%.*}"
if [ -n "${SESS:-}" ]; then
  SESS_CTX="transport_sessions=$SESS"; [ "$SESS" -lt "$SESS_TARGET" ] && SESS_CTX="$SESS_CTX(<$SESS_TARGET target!)"
else
  SESS_CTX="transport_sessions=unreadable"
fi

log "block=$LOCAL head=$HEAD gap=$GAP advanced=${ADVANCED}/run frozen=$FROZEN $SESS_CTX"

# ---- healthy / catching-up? ----
# A restart only recovers a FROZEN (deadlocked) node. If the node is ADVANCING
# (FROZEN=0) it is processing blocks — a restart would just discard progress,
# even when it is still far behind (e.g. replaying right after statesync). So a
# large GAP while advancing is ALERT-only, never a restart trigger.
if [ "$FROZEN" -eq 0 ]; then
  if [ "$GAP" -ge "$GAP_ALERT" ]; then
    alert "node is $GAP blocks behind but ADVANCING (${ADVANCED}/run) — catching up, NOT restarting. Investigate if the gap is not shrinking."
    exit 1
  fi
  log "OK — advancing ${ADVANCED}/run, gap=$GAP"
  exit 0
fi

log "UNHEALTHY (RPC): frozen=$FROZEN advanced=$ADVANCED gap=$GAP | context: $SESS_CTX"

# validator gate
if [ "$GATE_BLOCK_RESTART" = "1" ]; then
  alert "stalled (frozen=$FROZEN gap=$GAP $SESS_CTX) but node looks like a VALIDATOR — NOT auto-restarting (would miss slots). Manual action needed."
  exit 2
fi

# ---- cooldown: restarted recently and STILL stuck → escalate, don't loop ----
NOW=$(date +%s)
LAST=$(cat "$COOLDOWN_FILE" 2>/dev/null || echo 0)
# A truncated/empty cooldown file (write interrupted, disk full) used to make `$(( NOW - LAST ))`
# an arithmetic error → empty substitution → the `-lt` test became a one-argument test that
# succeeded → cooldown BYPASSED and the node restarted every 5 minutes.
[[ "$LAST" =~ ^[0-9]+$ ]] || LAST=0
if [ $(( NOW - LAST )) -lt "$RESTART_COOLDOWN" ]; then
  alert "still stuck $(( NOW - LAST ))s after a restart (gap=$GAP $SESS_CTX). Restart didn't recover — likely needs Hard Reset / snapshot restore. NOT auto-performing destructive recovery."
  exit 2
fi

# ---- recovery: restart services ----
log "ACTION: restarting services: $SERVICES"
echo "$NOW" > "$COOLDOWN_FILE"
# Restart unit-by-unit and skip units that do not exist on this host. A single missing unit
# (e.g. a full-node without monad-rpc.service, or a build naming it differently) used to make
# `systemctl restart $SERVICES` return non-zero even though the units that DO exist restarted
# fine — reporting "manual intervention needed" for a successful recovery.
RESTART_FAILED=""
RESTART_DONE=""
for s in $SERVICES; do
  if ! systemctl cat "$s" >/dev/null 2>&1; then
    log "  unit $s not present on this host — skipping"
    continue
  fi
  if systemctl restart "$s"; then
    RESTART_DONE="$RESTART_DONE $s"
  else
    RESTART_FAILED="$RESTART_FAILED $s"
  fi
done
if [ -z "$RESTART_FAILED" ] && [ -n "$RESTART_DONE" ]; then
  alert "restarted [${RESTART_DONE# }] — was frozen=$FROZEN gap=$GAP $SESS_CTX. Re-checking next run."
  exit 1
elif [ -n "$RESTART_DONE" ]; then
  alert "PARTIAL restart: ok [${RESTART_DONE# }], FAILED [${RESTART_FAILED# }] — check those units."
  exit 2
else
  alert "systemctl restart FAILED for [${RESTART_FAILED# }] — manual intervention needed."
  exit 2
fi
