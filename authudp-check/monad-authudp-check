#!/usr/bin/env bash
# monad-authudp-check — verify your Monad node has Authenticated UDP active
# Project: BeeHive monad-tools
# Repo: https://github.com/BeeHiveTeam/monad-tools
#
# Why: Monad release 0.14.3 will drop support for non-authenticated UDP at the
# network level. Nodes that have not migrated to Authenticated UDP will be
# disconnected. Reference:
#   https://docs.monad.xyz/node-ops/upgrade-instructions/authenticated-udp-checking
#
# This script checks (in order, fast-to-slow):
#   1. monad package version (≥0.14.0 has Auth UDP enforced)
#   2. Active wireauth log entries in monad-bft journal (proof it's running)
#   3. wireauth UDP socket open
#   4. Recent peer keepalive activity (from logs)
#
# Usage:
#   ./monad-authudp-check                # text report
#   ./monad-authudp-check --json         # machine-readable
#   ./monad-authudp-check --quiet        # only print on FAIL
#   ./monad-authudp-check --post URL     # POST result JSON to URL (compliance tracker)

set -u

JSON_OUTPUT=0
QUIET=0
POST_URL=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)   JSON_OUTPUT=1 ;;
    --quiet)  QUIET=1 ;;
    --post)   POST_URL="${2:-}"; shift ;;
    --post=*) POST_URL="${1#*=}" ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) echo "Unknown option: $1" >&2; exit 64 ;;
  esac
  shift
done

if [[ -t 1 && $JSON_OUTPUT -eq 0 && $QUIET -eq 0 ]]; then
  C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[0;33m'
  C_BLUE=$'\033[0;34m'; C_BOLD=$'\033[1m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_BOLD=""; C_RESET=""
fi

# Result accumulator
declare -A R
HAS_FAIL=0; HAS_WARN=0

emit() {
  local key="$1" status="$2" detail="$3"
  R["${key}.status"]="$status"
  R["${key}.detail"]="$detail"
  case "$status" in
    fail) HAS_FAIL=1 ;;
    warn) HAS_WARN=1 ;;
  esac
  if [[ $JSON_OUTPUT -eq 0 && $QUIET -eq 0 ]]; then
    local sym color
    case "$status" in
      pass) sym="✓"; color="$C_GREEN" ;;
      warn) sym="!"; color="$C_YELLOW" ;;
      fail) sym="✗"; color="$C_RED" ;;
      info) sym="i"; color="$C_BLUE" ;;
    esac
    printf "  ${color}%s${C_RESET} %-25s %s\n" "$sym" "$key" "$detail"
  fi
}

# ===== Check 1: monad version (two-tier) =====
# Per docs (https://docs.monad.xyz/node-ops/upgrade-instructions/auth-udp):
#   Auth UDP support requires monad ≥ 0.12.6 (capability available).
# Per Foundation announcement (Discord, mainnet-fullnode-announcements):
#   "Running 0.14.x or later? You're all set — Authenticated UDP is already
#    enforced and active on your node. Running before 0.14.0? Suggestion to
#    upgrade as soon as possible."
# So 0.14.0 is the operational cutoff for the upcoming 0.14.3 enforcement.
MONAD_AUTHUDP_VERSION_MIN="${MONAD_AUTHUDP_VERSION_MIN:-0.12.6}"
MONAD_AUTHUDP_VERSION_REC="${MONAD_AUTHUDP_VERSION_REC:-0.14.0}"
MONAD_NODE_TOML="${MONAD_NODE_TOML:-/home/monad/monad-bft/config/node.toml}"

check_version() {
  if ! command -v dpkg-query >/dev/null; then
    emit "version" "info" "dpkg not available — cannot check package version"
    return
  fi
  local v
  v=$(dpkg-query -W -f='${Version}' monad 2>/dev/null || true)
  if [[ -z "$v" ]]; then
    emit "version" "info" "monad package not installed"
    return
  fi

  if printf '%s\n%s\n' "$MONAD_AUTHUDP_VERSION_REC" "$v" | sort -V -C 2>/dev/null; then
    emit "version" "pass" "monad $v — fully compliant (≥${MONAD_AUTHUDP_VERSION_REC}, Auth UDP enforced)"
  elif printf '%s\n%s\n' "$MONAD_AUTHUDP_VERSION_MIN" "$v" | sort -V -C 2>/dev/null; then
    emit "version" "warn" "monad $v — Auth UDP capable but pre-${MONAD_AUTHUDP_VERSION_REC} (upgrade recommended before 0.14.3 enforcement)"
  else
    emit "version" "fail" "monad $v — UPGRADE REQUIRED (need ≥${MONAD_AUTHUDP_VERSION_MIN}, recommend ≥${MONAD_AUTHUDP_VERSION_REC})"
  fi

  # Check for available upgrade
  if command -v apt-get >/dev/null; then
    local avail
    avail=$(apt list --upgradable 2>/dev/null | awk '/^monad\// {print $2}' | head -1)
    if [[ -n "$avail" && "$avail" != "$v" ]]; then
      emit "version.upgrade" "warn" "newer version available: $avail (current $v)"
    fi
  fi
}

# ===== Check 2: monad-bft service =====
check_service() {
  if ! command -v systemctl >/dev/null; then
    emit "service" "info" "systemctl not available — cannot verify service"
    return
  fi
  if systemctl is-active --quiet monad-bft 2>/dev/null; then
    emit "service" "pass" "monad-bft.service active"
  else
    emit "service" "fail" "monad-bft.service NOT active"
  fi
}

# ===== Check 3: wireauth log entries =====
check_wireauth_logs() {
  if ! command -v journalctl >/dev/null; then
    emit "wireauth.logs" "info" "journalctl not available"
    return
  fi
  if [[ $EUID -ne 0 ]] && ! groups | grep -q '\(systemd-journal\|adm\)'; then
    emit "wireauth.logs" "info" "run as root or member of systemd-journal/adm group for log access"
    return
  fi

  local count
  count=$(journalctl -u monad-bft -n 1000 --no-pager 2>/dev/null | grep -c monad_wireauth || true)
  if (( count >= 5 )); then
    emit "wireauth.logs" "pass" "$count wireauth log entries in last 1000 lines"
  elif (( count > 0 )); then
    emit "wireauth.logs" "warn" "only $count wireauth entries found — verify Auth UDP is active"
  else
    emit "wireauth.logs" "fail" "0 wireauth entries — Auth UDP may not be active"
  fi
}

# ===== Check 4: peer connectivity =====
check_peer_keepalive() {
  if ! command -v journalctl >/dev/null; then return; fi
  if [[ $EUID -ne 0 ]] && ! groups | grep -q '\(systemd-journal\|adm\)'; then return; fi

  # remote_addr can be IPv4 (1.2.3.4:port) or IPv6 ([::1]:port). Match both.
  local recent_peers
  recent_peers=$(journalctl -u monad-bft -n 2000 --no-pager 2>/dev/null \
    | grep 'sending keepalive packet' \
    | grep -oE 'remote_addr":"[^"]+' \
    | sort -u | wc -l)
  if (( recent_peers >= 5 )); then
    emit "wireauth.peers" "pass" "$recent_peers unique peers seen in keepalives"
  elif (( recent_peers > 0 )); then
    emit "wireauth.peers" "warn" "only $recent_peers unique peer(s) — small set"
  else
    emit "wireauth.peers" "info" "no recent keepalive activity in logs"
  fi
}

# ===== Check 5: UDP ports listening =====
# Per docs: 8000/UDP = consensus P2P, 8001/UDP = Authenticated UDP (separate port).
check_udp_ports() {
  if ! command -v ss >/dev/null; then return; fi
  local out
  out=$(ss -uln 2>/dev/null)
  if echo "$out" | grep -qE ':8000\b'; then
    emit "udp.8000" "pass" "UDP port 8000 listening (consensus P2P)"
  else
    emit "udp.8000" "fail" "UDP port 8000 NOT listening"
  fi
  if echo "$out" | grep -qE ':8001\b'; then
    emit "udp.8001" "pass" "UDP port 8001 listening (Authenticated UDP)"
  else
    emit "udp.8001" "fail" "UDP port 8001 NOT listening — Auth UDP not bound"
  fi
}

# ===== Check 6: node.toml config (section-aware) =====
# Per docs:
#   [peer_discovery] → self_auth_port, self_record_seq_num, self_name_record_sig
#   [network]        → authenticated_bind_address_port
check_node_toml() {
  if [[ ! -r "$MONAD_NODE_TOML" ]]; then
    emit "config.toml" "info" "node.toml not readable at $MONAD_NODE_TOML"
    return
  fi

  toml_has_key_in_section() {
    local section="$1" key="$2"
    awk -v sec="[$section]" -v key="$key" '
      /^[[:space:]]*\[/ { current=$0; sub(/^[[:space:]]+/,"",current); sub(/[[:space:]]+$/,"",current) }
      $0 ~ "^[[:space:]]*"key"[[:space:]]*=" { if (current==sec) {found=1; exit} }
      END { exit !found }
    ' "$MONAD_NODE_TOML"
  }

  local missing=""
  for key in self_auth_port self_record_seq_num self_name_record_sig; do
    toml_has_key_in_section peer_discovery "$key" || missing+="[peer_discovery].$key "
  done
  toml_has_key_in_section network authenticated_bind_address_port \
    || missing+="[network].authenticated_bind_address_port "

  if [[ -z "$missing" ]]; then
    emit "config.toml" "pass" "all Auth UDP keys present in correct sections"
  else
    emit "config.toml" "fail" "node.toml missing: $missing"
  fi

  # Auth port should be 8001 per docs (also verify it's inside [peer_discovery])
  local self_auth
  self_auth=$(awk '
    /^[[:space:]]*\[/ { current=$0; sub(/^[[:space:]]+/,"",current); sub(/[[:space:]]+$/,"",current) }
    /^[[:space:]]*self_auth_port[[:space:]]*=/ {
      if (current=="[peer_discovery]") { gsub(/.*=[[:space:]]*/,""); gsub(/[ "]/,""); print; exit }
    }
  ' "$MONAD_NODE_TOML" 2>/dev/null)
  if [[ -n "$self_auth" && "$self_auth" != "8001" ]]; then
    emit "config.port" "warn" "self_auth_port=$self_auth (docs default: 8001)"
  fi
}

# ===== Output =====
print_header() {
  [[ $JSON_OUTPUT -eq 1 || $QUIET -eq 1 ]] && return
  cat <<EOF
${C_BOLD}monad-authudp-check${C_RESET}  —  $(hostname) at $(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
}

print_verdict() {
  if [[ $JSON_OUTPUT -eq 1 ]]; then
    print_json
    return
  fi
  [[ $QUIET -eq 1 && $HAS_FAIL -eq 0 ]] && return

  echo
  if (( HAS_FAIL )); then
    echo "${C_RED}${C_BOLD}✗ FAIL — your node may be disconnected at next Monad release${C_RESET}"
    echo "  Action: upgrade monad and verify wireauth is running."
    echo "  Docs: https://docs.monad.xyz/node-ops/upgrade-instructions/auth-udp"
  elif (( HAS_WARN )); then
    echo "${C_YELLOW}${C_BOLD}! OK — Auth UDP active but with warnings${C_RESET}"
  else
    echo "${C_GREEN}${C_BOLD}✓ READY — Auth UDP active, node compliant${C_RESET}"
  fi
}

print_json() {
  local verdict
  if (( HAS_FAIL )); then verdict="FAIL"
  elif (( HAS_WARN )); then verdict="WARN"
  else verdict="PASS"; fi
  printf '{\n'
  printf '  "host": "%s",\n' "$(hostname)"
  printf '  "timestamp": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '  "verdict": "%s",\n' "$verdict"
  printf '  "checks": {\n'
  local keys=()
  for k in "${!R[@]}"; do
    [[ "$k" == *.status ]] && keys+=("${k%.status}")
  done
  local n=${#keys[@]} i=0
  for key in "${keys[@]}"; do
    local sep=","
    (( ++i == n )) && sep=""
    printf '    "%s": {"status": "%s", "detail": "%s"}%s\n' \
      "$key" "${R[${key}.status]}" \
      "$(printf '%s' "${R[${key}.detail]}" | sed 's/"/\\"/g')" \
      "$sep"
  done
  printf '  }\n'
  printf '}\n'
}

# ===== Optional: POST result to compliance tracker =====
post_result() {
  [[ -z "$POST_URL" ]] && return
  if ! command -v curl >/dev/null; then
    [[ $QUIET -eq 0 ]] && echo "(curl not installed — skipping --post)" >&2
    return
  fi
  local payload
  payload=$(JSON_OUTPUT=1; print_json 2>/dev/null)
  if curl -fsS -m 5 -X POST "$POST_URL" \
    -H 'Content-Type: application/json' \
    -d "$payload" >/dev/null 2>&1; then
    [[ $QUIET -eq 0 ]] && echo "Result posted to $POST_URL"
  else
    [[ $QUIET -eq 0 ]] && echo "Failed to POST to $POST_URL" >&2
  fi
}

main() {
  print_header
  check_version

  # Early exit when monad is not installed: the rest of the checks would all
  # FAIL with misleading messages ("service not active", "0 wireauth entries",
  # "UDP NOT listening") even though the real issue is just "no node here".
  if [[ "${R[version.status]:-}" == "info" && "${R[version.detail]:-}" == *"not installed"* ]]; then
    if [[ $JSON_OUTPUT -eq 0 && $QUIET -eq 0 ]]; then
      echo
      echo "${C_BLUE}ℹ Monad not installed on this host — Auth UDP check is for running nodes only.${C_RESET}"
      echo "  Install Monad first (see https://docs.monad.xyz/node-ops/full-node-installation)"
    elif [[ $JSON_OUTPUT -eq 1 ]]; then
      print_json
    fi
    exit 0
  fi

  check_service
  check_wireauth_logs
  check_peer_keepalive
  check_udp_ports
  check_node_toml
  print_verdict
  post_result

  if (( HAS_FAIL )); then exit 2
  elif (( HAS_WARN )); then exit 1
  else exit 0
  fi
}

main
