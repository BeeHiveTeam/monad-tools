#!/usr/bin/env bash
# monad-doctor — pre-flight readiness check for Monad validator nodes
# Project: BeeHive monad-tools
# Repo: https://github.com/BeeHiveTeam/monad-tools
#
# Usage:
#   sudo ./monad-doctor                        # full check (default)
#   sudo ./monad-doctor --json                 # machine-readable
#   sudo ./monad-doctor --quick                # skip slow checks (fio IOPS)
#   sudo ./monad-doctor --section hardware     # only one section
#   sudo ./monad-doctor --no-color             # no ANSI colors
#   sudo ./monad-doctor --mode fullnode        # validator | fullnode | auto (default)
#
# --mode affects the VDP checks only. The Validator Delegation Program applies to
# validators, so a full node must not be FAILed for not pushing metrics to the
# Foundation — and validator-setup installs a full node by default, which made that
# false FAIL the default outcome. node.toml cannot tell the two apart
# ([fullnode_raptorcast] and enable_publisher are present in validator templates too),
# so this is declared, not guessed: undeclared yields WARN, never a silent pass.
#
# One-liner from internet:
#   curl -fsSL https://raw.githubusercontent.com/BeeHiveTeam/monad-tools/main/doctor/monad-doctor | sudo bash
#
# Exit codes:
#   0  all checks passed (or only INFO/PASS)
#   1  warnings only — node will run but suboptimal
#   2  one or more FAIL — node should NOT be deployed yet

set -u
# Note: no pipefail — `grep -q` exits early on match, causing SIGPIPE on producers
# like journalctl/apt/dpkg, which would propagate as false failures.

# Fixed locale for every child command. Without it a comma-decimal locale (LC_NUMERIC=ru_RU,
# de_DE — sshd forwards LC_* by default, so `curl … | sudo bash` inherits it) makes awk print
# "4,75" and then parse that string back as 4, so a 4.75 GHz CPU failed the 4.5 GHz check.
# The same class of breakage applies to parsing lsblk/df/ethtool/chronyc output.
export LC_ALL=C

# ===== Defaults / thresholds (tuneable via env or flags) =====
# Sources:
#   - https://docs.monad.xyz/node-ops/hardware-requirements
#   - https://docs.monad.xyz/node-ops/full-node-installation
#   - https://docs.monad.xyz/node-ops/upgrade-instructions/auth-udp
CPU_CORES_MIN=${CPU_CORES_MIN:-16}      # docs: "16 core CPU"
CPU_CORES_REC=${CPU_CORES_REC:-16}
CPU_GHZ_MIN=${CPU_GHZ_MIN:-4.5}         # docs: "4.5 GHz+ base clock speed"
RAM_GB_MIN=${RAM_GB_MIN:-32}            # docs: "32 GB+ RAM"
RAM_GB_REC=${RAM_GB_REC:-64}
DISK_GB_OS_MIN=${DISK_GB_OS_MIN:-500}   # docs: "500GB Disk" for MonadBFT/OS — this is disk SIZE
# Free-space thresholds are a separate question from disk size; not in docs, BeeHive figures.
DISK_GB_OS_FREE_MIN=${DISK_GB_OS_FREE_MIN:-100}
DISK_GB_OS_FREE_WARN=${DISK_GB_OS_FREE_WARN:-40}
DISK_GB_TRIEDB_MIN=${DISK_GB_TRIEDB_MIN:-1700}  # docs: "2TB dedicated disk" (real 2TB-class drives advertise ~1.92TB ≈ 1788 GiB)
NVME_IOPS_MIN=${NVME_IOPS_MIN:-200000}  # not in docs — heuristic from operators
NVME_IOPS_REC=${NVME_IOPS_REC:-500000}
ULIMIT_MIN=${ULIMIT_MIN:-1000000}                  # per-process LimitNOFILE (validator needs ~10k fd; 1M is generous headroom matching what the monad apt pkg sets in units)
SYSTEM_FILE_MAX_MIN=${SYSTEM_FILE_MAX_MIN:-65536}  # system-wide fs.file-max cap; sum of all-processes fd; 65k is the canonical Linux floor (was kernel default for years)
# Per docs.monad.xyz/node-ops/full-node-installation:
#   "Linux Kernel >= 6.8.0.60"
#   "There is a known bug affecting Linux kernel versions v6.8.0.56-generic
#    – v6.8.0.59-generic (inclusive) that causes Monad clients to hang."
KERNEL_MIN=${KERNEL_MIN:-6.8.0}
KERNEL_MIN_PATCH=${KERNEL_MIN_PATCH:-60}      # apt name: 6.8.0-60-generic
# 56-59: Monad client hangs. 136: monad-bft fails to start with
# "failed to create buffer ring: Os { code: 22 }" — docs recommend 6.8.0.134 and an apt pin.
# 136 was missing here, so a host that auto-upgraded into it got a green kernel check and
# a node that would not come back after the next reboot.
KERNEL_BUGGY_PATCHES=${KERNEL_BUGGY_PATCHES:-"56 57 58 59 136"}
# Ubuntu 24.04+ required (apt repo only ships 'noble' suite per docs).
UBUNTU_VERSION_MIN=${UBUNTU_VERSION_MIN:-24.04}
# 8000 = TCP+UDP P2P, 8001 = UDP-only Auth UDP per docs.
# Format: "port/proto" pairs.
NET_PORTS_REQUIRED=${NET_PORTS_REQUIRED:-"8000/tcp 8000/udp 8001/udp"}
NET_SPEED_VALIDATOR_MBPS=${NET_SPEED_VALIDATOR_MBPS:-300}   # docs: "300 Mbit/s (Validators)"
NET_SPEED_FULLNODE_MBPS=${NET_SPEED_FULLNODE_MBPS:-100}     # docs: "100 Mbit/s (Full Nodes)"
MONAD_AUTHUDP_VERSION_MIN=${MONAD_AUTHUDP_VERSION_MIN:-0.12.6}
MONAD_NODE_TOML=${MONAD_NODE_TOML:-/home/monad/monad-bft/config/node.toml}

JSON_OUTPUT=0
QUICK_MODE=0
SECTION=""
USE_COLOR=1
# validator | fullnode | auto. Drives the VDP section only: the Validator Delegation Program
# applies to validators, so demanding VDP compliance from a full node is a false FAIL — and
# validator-setup installs a full node BY DEFAULT, so that was the default outcome.
# There is no reliable signal for this in node.toml: [fullnode_raptorcast] and enable_publisher
# appear in validator templates too (that is what broke the old detector, MT-2). So it is
# operator-declared, with an explicit third state rather than a guess.
NODE_MODE=${NODE_MODE:-auto}

# Valid sections — keep in sync with run_section calls in main()
VALID_SECTIONS=("hardware" "os" "network" "security" "monad")

# ===== Argument parsing =====
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)      JSON_OUTPUT=1 ;;
    --quick)     QUICK_MODE=1 ;;
    --mode)      NODE_MODE="${2:-}"; shift ;;
    --mode=*)    NODE_MODE="${1#*=}" ;;
    --section)   SECTION="${2:-}"; shift ;;
    --section=*) SECTION="${1#*=}" ;;
    --no-color)  USE_COLOR=0 ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) echo "Unknown option: $1 (--help for usage)" >&2; exit 64 ;;
  esac
  shift
done

case "$NODE_MODE" in
  validator|fullnode|auto) ;;
  *) echo "Unknown --mode '$NODE_MODE'. Valid: validator, fullnode, auto" >&2; exit 64 ;;
esac

# Validate --section if provided (catches typos like 'hardwear')
if [[ -n "$SECTION" ]]; then
  found=0
  for v in "${VALID_SECTIONS[@]}"; do [[ "$v" == "$SECTION" ]] && found=1; done
  if (( found == 0 )); then
    echo "Unknown section '$SECTION'. Valid: ${VALID_SECTIONS[*]}" >&2
    exit 64
  fi
fi

# ===== Colors =====
if [[ $USE_COLOR -eq 1 && -t 1 && $JSON_OUTPUT -eq 0 ]]; then
  C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[0;33m'
  C_BLUE=$'\033[0;34m'; C_PURPLE=$'\033[0;35m'; C_CYAN=$'\033[0;36m'
  C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_PURPLE=""; C_CYAN=""
  C_BOLD=""; C_DIM=""; C_RESET=""
fi

# ===== Result accumulation =====
declare -a RESULTS_NAME RESULTS_STATUS RESULTS_MSG RESULTS_FIX RESULTS_SECTION
declare -i COUNT_PASS=0 COUNT_WARN=0 COUNT_FAIL=0 COUNT_INFO=0 COUNT_SKIP=0

emit() {
  # emit <section> <name> <status> <msg> [fix]
  # The fix string may contain literal newlines (\n); each line is rendered as a
  # separate hint line. Convention for extended hints:
  #   $'Quick fix:  cmd\nVerify:     cmd\nWhy:        explanation'
  local section="$1" name="$2" status="$3" msg="$4" fix="${5:-}"
  RESULTS_SECTION+=("$section")
  RESULTS_NAME+=("$name")
  RESULTS_STATUS+=("$status")
  RESULTS_MSG+=("$msg")
  RESULTS_FIX+=("$fix")
  case "$status" in
    PASS) COUNT_PASS+=1 ;;
    WARN) COUNT_WARN+=1 ;;
    FAIL) COUNT_FAIL+=1 ;;
    INFO) COUNT_INFO+=1 ;;
    # SKIP = "this check did NOT run" (missing tool, unreadable source, ambiguous layout).
    # Previously such cases silently emitted PASS or nothing at all, so an unperformed check
    # was indistinguishable from a passed one and still produced `verdict: READY` / exit 0.
    # Counted separately and always printed; deliberately does NOT change exit codes, so the
    # documented contract (0 ok / 1 warnings / 2 failures) is unaffected.
    SKIP) COUNT_SKIP+=1 ;;
  esac

  [[ $JSON_OUTPUT -eq 1 ]] && return

  local sym color
  case "$status" in
    PASS) sym="✓"; color="$C_GREEN"  ;;
    WARN) sym="!"; color="$C_YELLOW" ;;
    FAIL) sym="✗"; color="$C_RED"    ;;
    INFO) sym="i"; color="$C_BLUE"   ;;
    SKIP) sym="?"; color="$C_YELLOW" ;;
  esac

  printf "  ${color}%s${C_RESET} %-30s %s\n" "$sym" "$name" "$msg"
  if [[ -n "$fix" ]]; then
    local line
    while IFS= read -r line; do
      printf "    ${C_DIM}→ %s${C_RESET}\n" "$line"
    done <<<"$fix"
  fi
}

section_header() {
  [[ $JSON_OUTPUT -eq 1 ]] && return
  printf "\n${C_BOLD}${C_PURPLE}━━ %s ━━${C_RESET}\n" "$1"
}

# ===== Helpers =====
require_cmd() { command -v "$1" >/dev/null 2>&1; }

ver_ge() {
  # ver_ge "5.15.0" "5.15"  → 0 (true)
  printf '%s\n%s\n' "$2" "$1" | sort -V -C
}

# ===== Disk topology analyzer =====
# Classifies each NVMe disk by role:
#   os-raid     — at least one partition is a member of a md array mounted at /
#   os-single   — at least one partition is mounted at / directly
#   triedb      — contains the partition that /dev/triedb points to
#   swap-only   — only swap partitions (and nothing else mounted)
#   unused      — no partitions or no mounted partitions (a spare)
#   other       — partitions exist but role unclear (LVM, encrypted, etc)
#
# Outputs lines:  <devname>\t<size_human>\t<role>\t<detail>
disk_topology() {
  # Resolve which device(s) back the / mount.
  local root_src root_dev parts_under_root=()
  root_src=$(findmnt -no SOURCE / 2>/dev/null)
  root_dev="${root_src##*/}"  # md3, sda1, dm-0...

  # If / is on md raid, find the underlying member partitions.
  if [[ -n "$root_dev" && -e "/sys/block/$root_dev/md" ]]; then
    while IFS= read -r m; do
      parts_under_root+=("$m")
    done < <(ls "/sys/block/$root_dev/md/" 2>/dev/null | sed -n 's/^dev-//p')
  fi

  # Resolve triedb partition.
  local triedb_part=""
  if [[ -L /dev/triedb ]]; then
    triedb_part=$(readlink -f /dev/triedb 2>/dev/null)
    triedb_part="${triedb_part##*/}"
  fi

  # Iterate all top-level NVMe disks.
  local disk
  for disk in $(lsblk -dn -o NAME,TYPE 2>/dev/null | awk '$2=="disk" && $1 ~ /^nvme/ {print $1}'); do
    local size_h size_b
    size_h=$(lsblk -dn -o SIZE "/dev/$disk" 2>/dev/null)
    size_b=$(lsblk -bdn -o SIZE "/dev/$disk" 2>/dev/null)

    # Collect partition info.
    local parts mounts has_root has_triedb has_swap has_other
    # Отбрасываем строку САМОГО диска по имени, а не по позиции. `tail -n +2` исходило из
    # того, что диск идёт первым, но вывод lsblk -l отсортирован по ИМЕНИ (здесь первыми
    # идут md2/md3), поэтому выбрасывался легитимный дочерний узел. На LVM/btrfs-subvol
    # это давало ложный WARN «OS on single disk (SPOF)».
    parts=$(lsblk -ln -o NAME,MOUNTPOINT "/dev/$disk" 2>/dev/null \
            | awk -v d="$disk" '$1 != d')
    has_root=0; has_triedb=0; has_swap=0; has_other=0

    while IFS= read -r line; do
      local pname pmount
      pname=$(awk '{print $1}' <<<"$line")
      pmount=$(awk '{print $2}' <<<"$line")
      [[ "$pname" == "$disk" ]] && continue
      # Member of root md?
      for m in "${parts_under_root[@]}"; do
        [[ "$pname" == "$m" ]] && has_root=1
      done
      # Mounted at / directly (no RAID)?
      [[ "$pmount" == "/" ]] && has_root=2
      # Triedb
      [[ "$pname" == "$triedb_part" ]] && has_triedb=1
      # Swap
      [[ "$pmount" == "[SWAP]" ]] && has_swap=1
      # Anything else mounted
      if [[ -n "$pmount" && "$pmount" != "[SWAP]" && "$pmount" != "/" ]]; then
        has_other=1
      fi
    done <<<"$parts"

    local role detail=""
    if (( has_triedb )); then
      role="triedb"
      detail="/dev/triedb → $triedb_part"
    elif (( has_root == 2 )); then
      role="os-single"
      detail="/ on this disk (single, no RAID)"
    elif (( has_root == 1 )); then
      role="os-raid"
      detail="member of $root_dev (raid for /)"
    elif (( has_other )); then
      role="other"
      detail="has mounted partitions"
    elif (( has_swap )); then
      role="swap-only"
      detail="only swap"
    elif [[ -z "$parts" ]]; then
      role="unused"
      detail="no partitions"
    else
      role="unused"
      detail="partitions present but no mounts"
    fi

    printf '%s\t%s\t%s\t%s\n' "$disk" "$size_h" "$role" "$detail"
  done
}

# ===== Section: HARDWARE =====
check_baremetal() {
  # Per docs.monad.xyz/node-ops/hardware-requirements:
  #   "Monad nodes must operate on bare metal servers rather than virtualized
  #    or cloud-based environments"
  # Quirk: systemd-detect-virt exits 1 when virt is "none" (bare metal).
  # So we explicitly check the output, not the exit code.
  if ! command -v systemd-detect-virt >/dev/null; then
    emit hardware "host.bare-metal" INFO "systemd-detect-virt not available — cannot verify"
    return
  fi
  local virt
  virt=$(systemd-detect-virt 2>/dev/null)
  case "$virt" in
    none|"") emit hardware "host.bare-metal" PASS "running on bare metal" ;;
    *)       emit hardware "host.bare-metal" FAIL "running in '$virt' (virtualized) — docs require bare metal" \
                  $'Action:      Move to a bare-metal server (Hetzner AX/EX, OVH HG/Advance, Latitude.sh).\nVerify:      systemd-detect-virt → "none"\nWhy:         Foundation/VDP rejects KVM/cloud nodes per hardware-requirements.\n             Performance: virtualized IO collapses under triedb random-write load.' ;;
  esac
}

check_cpu() {
  local model phys_cores logical
  model=$(awk -F: '/model name/ {print $2; exit}' /proc/cpuinfo | sed 's/^ *//')
  # Physical cores per docs: nproc returns logical (with SMT), but docs
  # require SMT off, so we should count physical cores.
  phys_cores=$(lscpu 2>/dev/null \
    | awk -F: '/^Core\(s\) per socket/ {gsub(/ /,"",$2); c=$2} /^Socket\(s\)/ {gsub(/ /,"",$2); s=$2} END {if (c && s) print c*s; else print 0}')
  logical=$(nproc)
  [[ -z "$phys_cores" || "$phys_cores" == "0" ]] && phys_cores="$logical"

  if (( phys_cores >= CPU_CORES_REC )); then
    emit hardware "cpu.cores"   PASS "$phys_cores physical cores ($model)"
  elif (( phys_cores >= CPU_CORES_MIN )); then
    emit hardware "cpu.cores"   WARN "$phys_cores physical cores — meets min ($CPU_CORES_MIN), recommend $CPU_CORES_REC+ ($model)"
  else
    emit hardware "cpu.cores"   FAIL "$phys_cores physical cores — below minimum $CPU_CORES_MIN ($model)" \
         $'Action:      Use a server with ≥'"$CPU_CORES_MIN"$' physical cores (AMD Ryzen 7950X/EPYC 4585PX, Intel Xeon W).\nWhy:         BLS sig verification + raptorcast + triedb compaction are CPU-bound;\n             undersized hosts miss vote deadlines and lose epochs.\nNote:        physical, not logical — count cores with SMT *off*.'
  fi

  # SMT/HyperThreading per docs: "Disabled HyperThreading (HT) or
  # Simultaneous MultiThreading (SMT) via BIOS settings — these features
  # degrade the node performance."
  local smt_active
  smt_active=$(cat /sys/devices/system/cpu/smt/active 2>/dev/null || echo unknown)
  case "$smt_active" in
    0)     emit hardware "cpu.smt"  PASS "SMT/HyperThreading disabled (per docs)" ;;
    1)     emit hardware "cpu.smt"  FAIL "SMT/HyperThreading active — must be disabled in BIOS per docs" \
                $'Preferred:   Reboot → BIOS/UEFI → disable SMT (AMD) / HyperThreading (Intel) → save.\nWorkaround:  (when BIOS is unreachable, e.g. Hetzner dedicated)\n             sed -i \'s/GRUB_CMDLINE_LINUX="\\([^"]*\\)"/GRUB_CMDLINE_LINUX="\\1 nosmt"/\' /etc/default/grub\n             update-grub && reboot\nVerify:      cat /sys/devices/system/cpu/smt/active   # 0\n             cat /proc/cmdline | grep -o nosmt        # nosmt (workaround only)\nWhy:         SMT siblings share execution units → cache contention and tail-latency spikes\n             during raptorcast/consensus; docs explicitly call it out as degrading the node.' ;;
    *)     emit hardware "cpu.smt"  INFO "SMT state unknown — verify in BIOS (must be off)" ;;
  esac

  # CPU clock. Docs require 4.5 GHz+ *base* clock, but `CPU max MHz` from lscpu is the BOOST
  # ceiling — always >= base, so comparing it against the requirement can never fail on any CPU
  # (this host: boost 5.75 GHz vs base 4.3 GHz on an EPYC 4585PX → PASS regardless). And the old
  # fallback read `cpu MHz` from /proc/cpuinfo, which is the CURRENT frequency: on a host without
  # cpufreq exposed, an idling 4.7 GHz CPU reported ~1.2 GHz and produced a false WARN.
  # We therefore report boost as INFO (cannot judge) and only PASS/WARN when a real base clock
  # is available: model-name suffix (e.g. "@ 4.30GHz") or dmidecode's Current/Max Speed.
  local mhz_boost mhz_base=""
  mhz_boost=$(lscpu 2>/dev/null | awk -F: '/CPU max MHz/ {gsub(/[ \t]/,"",$2); print $2; exit}')
  mhz_base=$(lscpu 2>/dev/null | awk -F: '/Model name/ {print $2; exit}' \
             | grep -oE '@[[:space:]]*[0-9]+\.[0-9]+GHz' | grep -oE '[0-9]+\.[0-9]+' \
             | awk '{printf "%.0f", $1*1000}')
  if [[ -z "$mhz_base" ]] && require_cmd dmidecode; then
    mhz_base=$(dmidecode -t processor 2>/dev/null \
               | awk -F: '/Current Speed/ {gsub(/[^0-9]/,"",$2); if ($2>0) {print $2; exit}}')
  fi
  if [[ -n "$mhz_base" ]]; then
    local ghz_base
    ghz_base=$(awk -v m="$mhz_base" 'BEGIN {printf "%.2f", m/1000}')
    if awk -v a="$ghz_base" -v b="$CPU_GHZ_MIN" 'BEGIN {exit !(a+0 >= b+0)}'; then
      emit hardware "cpu.clock"   PASS "${ghz_base} GHz base (≥${CPU_GHZ_MIN} GHz required)"
    else
      emit hardware "cpu.clock"   WARN "${ghz_base} GHz base — docs require ${CPU_GHZ_MIN} GHz+ base clock" \
           $'Why:         base clock, not boost, is what docs specify. Boost cannot be sustained\n             across all cores under consensus + execution load.'
    fi
  elif [[ -n "$mhz_boost" ]]; then
    local ghz_boost
    ghz_boost=$(awk -v m="$mhz_boost" 'BEGIN {printf "%.2f", m/1000}')
    emit hardware "cpu.clock"   SKIP "base clock unknown; boost ceiling is ${ghz_boost} GHz (docs require ${CPU_GHZ_MIN} GHz+ BASE)" \
         $'Action:      check the CPU model spec, or install dmidecode for Current Speed.\nWhy:         `CPU max MHz` is the boost ceiling and is always >= base, so comparing it\n             against the base-clock requirement would pass on every CPU.'
  else
    emit hardware "cpu.clock"   SKIP "could not read any CPU clock"
  fi

  # AVX2 / AVX-512 hints (BLS sig verification benefits)
  if grep -q avx512f /proc/cpuinfo; then
    emit hardware "cpu.avx"     PASS "AVX-512 supported (faster BLS)"
  elif grep -q avx2 /proc/cpuinfo; then
    emit hardware "cpu.avx"     PASS "AVX2 supported"
  else
    emit hardware "cpu.avx"     WARN "no AVX2 — BLS verification will be slower"
  fi
}

check_ram() {
  local total_gb avail_gb total_kb
  total_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
  total_gb=$(awk '/MemTotal/ {printf "%d", $2/1024/1024}' /proc/meminfo)
  avail_gb=$(awk '/MemAvailable/ {printf "%d", $2/1024/1024}' /proc/meminfo)

  # Compare in KiB with a 5% tolerance, NOT truncated GiB. /proc/meminfo
  # MemTotal already excludes firmware/kernel-reserved RAM, so a "32 GB" stick
  # reports ~31.2 GiB → truncating to 31 and testing `31 >= 32` false-FAILed
  # every 32 GB box. 95% of the threshold absorbs that reserve.
  local min_kb=$(( RAM_GB_MIN * 1024 * 1024 * 95 / 100 ))
  local rec_kb=$(( RAM_GB_REC * 1024 * 1024 * 95 / 100 ))

  if (( total_kb >= rec_kb )); then
    emit hardware "ram.total"   PASS "${total_gb} GB total (${avail_gb} GB available)"
  elif (( total_kb >= min_kb )); then
    emit hardware "ram.total"   WARN "${total_gb} GB — meets min ($RAM_GB_MIN), recommend ${RAM_GB_REC}+"
  else
    emit hardware "ram.total"   FAIL "${total_gb} GB — below minimum $RAM_GB_MIN GB" \
         $'Action:      Add RAM or use a server with ≥'"$RAM_GB_REC"$' GB.\nWhy:         triedb mmap working set + raptorcast UDP buffers + BFT in-flight state\n             easily exceed '"$RAM_GB_MIN"$' GB under mainnet load; OOM kills are catastrophic.\nNote:        ECC RAM strongly recommended for validator longevity.'
  fi

  # Swap usage warning (validator should not be swapping)
  local swap_used_mb
  swap_used_mb=$(awk '/SwapFree/ {sf=$2} /SwapTotal/ {st=$2} END {printf "%d", (st-sf)/1024}' /proc/meminfo)
  if (( swap_used_mb > 100 )); then
    emit hardware "ram.swap"    WARN "swap in use: ${swap_used_mb} MB — node may stall under load" \
         $'Quick fix:   sudo swapoff -a && sudo swapon -a   # resets swap, frees pressure now\nInvestigate: ps -eo pid,rss,cmd --sort=-rss | head   # who is using memory?\nLong-term:   echo "vm.swappiness = 1" | sudo tee /etc/sysctl.d/99-monad-tuning.conf\n             sudo sysctl --system\n             if RAM <64GB, upgrade — chronic swap = stalled votes.\nWhy:         swapped-out validator state introduces 10-100ms read latency,\n             missing vote deadlines and triggering re-elections.\nNote:        BeeHive recommendation — not in docs.monad.xyz.'
  else
    emit hardware "ram.swap"    PASS "swap not in use"
  fi
}

check_disks() {
  local topo nvme_count total_size_gb
  topo=$(disk_topology)
  # grep -c always prints the count (even 0) then exits 1 on no match; the old
  # `|| echo 0` appended a SECOND "0", producing "0\n0" which crashed the
  # `(( nvme_count == 0 ))` below (arithmetic syntax error) and fell through to
  # a false PASS on a machine with no NVMe. `|| true` masks the exit code
  # without adding a line.
  nvme_count=$(echo "$topo" | grep -c . || true)
  nvme_count=${nvme_count:-0}
  total_size_gb=$(lsblk -bdn -o NAME,SIZE 2>/dev/null \
    | awk '/^nvme/ {s+=$2} END {printf "%d", s/1024/1024/1024}')

  if (( nvme_count == 0 )); then
    emit hardware "disk.nvme"   FAIL "no NVMe drives detected" \
         $'Action:      Provision NVMe SSDs (datacenter-class: Samsung PM9A3, WD SN850X, Micron 7450).\nWhy:         triedb does sustained random 4K writes at 100k+ IOPS; SATA SSDs top out\n             around 80k and HDDs are 3 orders of magnitude too slow.\nVerify:      lsblk -d -o NAME,ROTA,TRAN | grep nvme'
    return
  fi

  emit hardware "disk.nvme"     PASS "$nvme_count NVMe drive(s), ${total_size_gb} GB total"

  # Print topology table — one line per disk with role + detail.
  # This is INFO-level: the WARN/FAIL signals come from derived checks below.
  while IFS=$'\t' read -r dev size role detail; do
    [[ -z "$dev" ]] && continue
    case "$role" in
      triedb)    emit hardware "disk.role.$dev" PASS "$dev ($size): triedb — $detail" ;;
      os-raid)   emit hardware "disk.role.$dev" PASS "$dev ($size): OS RAID — $detail" ;;
      os-single) emit hardware "disk.role.$dev" WARN "$dev ($size): OS on single disk (SPOF) — $detail" \
                      $'Cause:       installimage was run with SWRAID 0, or only one NVMe was installed.\nFix (reinstall, destructive — back up keys first):\n             Hetzner: Reset → Rescue → installimage → SWRAID 1 + SWRAIDLEVEL 1\n             Other providers: re-run installer with software RAID1 enabled.\nAlternative: accept SPOF for a non-validator full-node, OR plan recovery via\n             key escrow + standby host (mainnet validators MUST plan for disk failure).\nWhy:         single-NVMe OS = one failed drive → node down, possible double-sign\n             risk if hot-recovered without care.' ;;
      unused)    emit hardware "disk.role.$dev" INFO "$dev ($size): unused — $detail" ;;
      swap-only) emit hardware "disk.role.$dev" INFO "$dev ($size): swap-only" ;;
      other)     emit hardware "disk.role.$dev" INFO "$dev ($size): $detail" ;;
    esac
  done <<<"$topo"

  # NVMe LBA format per docs:
  # "Data Size should be set to 512 bytes and marked as (in use). If that
  #  is not the case, then you will need to set the TRIEDB_DRIVE to use
  #  512 byte LBA." → only enforce on the actual triedb device.
  # PKNAME is EMPTY when /dev/triedb points at a whole device rather than a partition (a valid
  # monad-mpt layout). That used to leave triedb_disk_for_lba empty, so neither the triedb nor
  # the "unused" branch below matched any disk and the LBA + scheduler checks emitted NOTHING —
  # two documented mandatory requirements silently unverified, verdict READY, exit 0.
  local triedb_disk_for_lba="" triedb_real=""
  if [[ -L /dev/triedb || -b /dev/triedb ]]; then
    triedb_real=$(readlink -f /dev/triedb 2>/dev/null)
    triedb_disk_for_lba=$(lsblk -no PKNAME "$triedb_real" 2>/dev/null | head -1)
    # whole-device: fall back to the device itself
    [[ -z "$triedb_disk_for_lba" ]] && triedb_disk_for_lba=$(basename "${triedb_real:-}")
  fi
  if [[ -z "$triedb_disk_for_lba" ]]; then
    # No /dev/triedb at all is the NORMAL pre-install state — this is a pre-flight tool, and
    # the device is created during installation. Reporting it as "a check did not run" turned
    # every greenfield run into 2 spurious SKIPs. SKIP is reserved for the genuinely ambiguous
    # case: the device exists but we cannot resolve which disk backs it.
    if [[ ! -e /dev/triedb ]]; then
      emit hardware "disk.lba"   INFO "/dev/triedb not present — LBA check applies after installation"
      emit hardware "disk.sched" INFO "/dev/triedb not present — IO scheduler check applies after installation"
    else
      emit hardware "disk.lba"   SKIP "/dev/triedb exists but its backing disk could not be resolved — LBA size NOT verified" \
           $'Action:      ls -l /dev/triedb ; lsblk -o NAME,PKNAME,TYPE'
      emit hardware "disk.sched" SKIP "/dev/triedb exists but its backing disk could not be resolved — IO scheduler NOT verified" \
           $'Action:      cat /sys/block/<triedb-disk>/queue/scheduler   # expect mq-deadline'
    fi
  fi
  while IFS=$'\t' read -r dev _ role _; do
    [[ -z "$dev" ]] && continue
    local lba
    lba=$(lsblk -dn -o LOG-SEC "/dev/$dev" 2>/dev/null | tr -d ' ')
    [[ -z "$lba" ]] && continue
    if [[ "$dev" == "$triedb_disk_for_lba" ]]; then
      if [[ "$lba" == "512" ]]; then
        emit hardware "disk.lba.$dev" PASS "triedb device $dev: 512-byte LBA (per docs)"
      else
        emit hardware "disk.lba.$dev" FAIL "triedb device $dev: ${lba}-byte LBA — docs require 512" \
             $'DANGER:      reformatting DESTROYS ALL DATA on /dev/'"$dev"$'. Back up keys first!\nQuick fix:   sudo umount /dev/'"$dev"$'* 2>/dev/null; \\\n             sudo nvme format /dev/'"$dev"$' --lbaf=0 --force\nList LBAFs:  sudo nvme id-ns /dev/'"$dev"$' -H | grep -i "LBA Format"\nVerify:      lsblk -dn -o NAME,LOG-SEC /dev/'"$dev"$'   # → 512\nWhy:         docs explicitly mandate 512-byte LBA on the triedb drive;\n             4096-byte sectors cause read-modify-write amplification and lower IOPS.'
      fi
    elif [[ "$role" == "unused" ]]; then
      # Unused disk — could become triedb. Inform if it would need reformat.
      if [[ "$lba" != "512" ]]; then
        emit hardware "disk.lba.$dev" INFO "$dev (unused): ${lba}-byte LBA — must be reformatted to 512 if used as triedb"
      fi
    fi
  done <<<"$topo"

  # Sanity: triedb on RAID is wasteful (extra writes, slower)
  if [[ -L /dev/triedb ]]; then
    local triedb_part triedb_disk
    triedb_part=$(readlink -f /dev/triedb)
    triedb_part="${triedb_part##*/}"
    triedb_disk=$(lsblk -no PKNAME "/dev/${triedb_part}" 2>/dev/null | head -1)
    # mdstat lists members as `<dev>[role]`, e.g. `nvme1n1p1[0]` (partition) or
    # `nvme1n1[0]` (whole-disk). Match both: optional `pN` then `[`. The old
    # `${disk}p` pattern missed whole-disk md membership entirely.
    if [[ -n "$triedb_disk" ]] && grep -qE "${triedb_disk}(p[0-9]+)?\[" /proc/mdstat 2>/dev/null; then
      emit hardware "disk.triedb-raid" WARN "triedb device $triedb_disk is part of RAID — wasted writes" \
           $'Action:      Provision a dedicated NVMe for triedb (no RAID, no other partitions).\n             Then re-point /dev/triedb udev rule at the new device PARTUUID.\nWhy:         triedb is already write-heavy; RAID1 doubles writes and shortens NVMe TBW;\n             RAID5/6 adds parity write amplification on top.'
    fi
  fi

  # IO scheduler — only the triedb device strictly needs mq-deadline
  # Reuse the already-resolved disk instead of repeating the lookup: the LBA check gained a
  # whole-device fallback and -b support, this one did not, so with /dev/triedb pointing at a
  # whole device the scheduler check matched no disk and printed NOTHING — not even a SKIP,
  # because the LBA variable was non-empty. Exactly the defect the change claimed to fix.
  local triedb_disk_for_sched="$triedb_disk_for_lba"
  while IFS=$'\t' read -r dev size role _; do
    [[ -z "$dev" ]] && continue
    local sched
    sched=$(awk '{for(i=1;i<=NF;i++) if($i ~ /^\[/) {gsub(/[][]/,"",$i); print $i; exit}}' "/sys/block/$dev/queue/scheduler" 2>/dev/null)
    if [[ "$dev" == "$triedb_disk_for_sched" ]]; then
      if [[ "$sched" == "mq-deadline" ]]; then
        emit hardware "disk.sched.$dev" PASS "triedb device on mq-deadline ✓"
      else
        emit hardware "disk.sched.$dev" FAIL "triedb device $dev on '$sched' — must be mq-deadline" \
             $'Quick fix:   echo mq-deadline | sudo tee /sys/block/'"$dev"$'/queue/scheduler\nPersist:     validator-setup writes /etc/udev/rules.d/60-monad-triedb-scheduler.rules\n             (otherwise scheduler resets to "none" on reboot).\nVerify:      cat /sys/block/'"$dev"$'/queue/scheduler   # → [mq-deadline]\nWhy:         mq-deadline batches writes and prioritizes reads — critical for triedb\n             mixed-workload tail latency.'
      fi
    fi
  done <<<"$topo"

  # If no triedb yet, recommend an unused candidate. If none — WARN: there
  # is no free NVMe for triedb, so validator-setup will require --triedb-dev
  # or fail entirely (all disks are RAID members / mounted / swap).
  if [[ ! -L /dev/triedb ]]; then
    # Size must be compared in BYTES. The previous awk passed -v min=… and then never used it
    # (`if ($2+0 >= 0)` is true for everything), and $2 was lsblk's human size, so
    # gsub(/[^0-9.]/) turned "1.7T" into 1.7 and "894.3G" into 894.3 — had the threshold
    # actually been applied, a correct 1.9 TB disk (1.7 < 1700) would have been rejected while
    # an undersized 894 GB one passed.
    local cand="" cand_small=""
    while IFS=$'\t' read -r _dev _size _role _detail; do
      [[ "$_role" == "unused" && -n "$_dev" ]] || continue
      local _bytes _gb
      _bytes=$(lsblk -bdn -o SIZE "/dev/$_dev" 2>/dev/null | head -1)
      [[ "$_bytes" =~ ^[0-9]+$ ]] || continue
      # GiB, not decimal GB: DISK_GB_TRIEDB_MIN is documented in GiB and the post-install
      # size check uses GiB too. Mixing bases made the doctor recommend a 1.8 TB disk and
      # then FAIL the very same disk after installation.
      _gb=$(( _bytes / 1073741824 ))
      if (( _gb >= DISK_GB_TRIEDB_MIN )); then
        cand+="$_dev (${_gb} GB) "
      else
        cand_small+="$_dev (${_gb} GB, below ${DISK_GB_TRIEDB_MIN} GB) "
      fi
    done <<<"$topo"
    if [[ -n "$cand" ]]; then
      emit hardware "disk.triedb-candidate" INFO "candidate(s) for /dev/triedb: ${cand% }"
    elif [[ -n "$cand_small" ]]; then
      emit hardware "disk.triedb-candidate" WARN "unused NVMe present but too small for triedb: ${cand_small% }" \
           $'Why:         docs specify a dedicated ~2TB disk for triedb; an undersized disk will fill\n             up and stop the node. Provision a larger drive.'
    else
      emit hardware "disk.triedb-candidate" WARN "no unused NVMe for /dev/triedb — every disk is RAID/mounted/swap; validator-setup will need --triedb-dev or fail" \
           $'Option A:    Provision a dedicated NVMe for triedb (cleanest).\nOption B:    Reinstall with installimage placing the OS on ONE drive, leaving the\n             second NVMe untouched as the triedb candidate.\nWhy:         triedb sharing a disk with OS contends for IO; sharing with OS RAID\n             multiplies writes and breaks the "dedicated 2TB disk" docs spec.'
    fi
  fi

  # Free space on root (OS partition — docs say 500 GB)
  local free_root_gb
  # -P (POSIX) forces single-line output: without it, a long device name (LVM
  # /dev/mapper/…) wraps onto its own line, so NR==2 captures only the name and
  # $4 (Avail) is empty → arithmetic error → false FAIL.
  local size_root_gb
  # DECIMAL GB, to match how the docs and every disk vendor state capacity. `df -BG` reports
  # GiB: a disk sold as 500 GB shows 465 there, so comparing it against the documented 500
  # failed a host that meets the requirement exactly. Compute from bytes and divide by 1000^3.
  free_root_gb=$(df -P -B1 / | awk 'NR==2 {printf "%d", $4/1000/1000/1000}')
  size_root_gb=$(df -P -B1 / | awk 'NR==2 {printf "%d", $2/1000/1000/1000}')
  # The docs requirement is "500GB Disk for MonadBFT / OS" — a disk SIZE, not free space.
  # Comparing FREE space against it failed any correctly-provisioned 500 GB host the moment it
  # had ~1 GB of anything on it, which is every host after installation. Size and headroom are
  # now separate questions.
  if (( size_root_gb >= DISK_GB_OS_MIN )); then
    emit hardware "disk.os"     PASS "${size_root_gb} GB disk on / (need ≥${DISK_GB_OS_MIN} GB), ${free_root_gb} GB free"
  else
    emit hardware "disk.os"     FAIL "${size_root_gb} GB disk on / — below ${DISK_GB_OS_MIN} GB minimum" \
         $'Action:      Provision a larger OS disk, or move /home/monad to a bigger volume.\nWhy:         MonadBFT WAL + logs + apt cache grow on /; docs require a 500 GB disk.'
  fi
  # Headroom is its own check: a big disk that is nearly full is just as fatal as a small one,
  # and the old check could not express that at all.
  if (( free_root_gb >= DISK_GB_OS_FREE_MIN )); then
    emit hardware "disk.os-free" PASS "${free_root_gb} GB free on / (≥${DISK_GB_OS_FREE_MIN} GB headroom)"
  elif (( free_root_gb >= DISK_GB_OS_FREE_WARN )); then
    emit hardware "disk.os-free" WARN "${free_root_gb} GB free on / — below ${DISK_GB_OS_FREE_MIN} GB, WAL growth will bite"
  else
    emit hardware "disk.os-free" FAIL "${free_root_gb} GB free on / — critically low"
  fi

  # TriedB device size — docs require 2 TB dedicated disk
  if [[ -L /dev/triedb ]]; then
    local triedb_part triedb_disk triedb_size_gb
    triedb_part=$(readlink -f /dev/triedb)
    triedb_part="${triedb_part##*/}"
    triedb_disk=$(lsblk -no PKNAME "/dev/${triedb_part}" 2>/dev/null | head -1)
    # Measure the PARTITION that /dev/triedb actually points at, not its parent disk. Reading
    # the disk size reported a 1.9 TB PASS for a 300 GB triedb partition on a split drive —
    # the node would then fill the partition and stop, with the doctor having said it was fine.
    local triedb_part_gb triedb_disk_gb=""
    triedb_part_gb=$(lsblk -bdn -o SIZE "/dev/${triedb_part}" 2>/dev/null \
                     | awk '{printf "%d", $1/1024/1024/1024}')
    [[ -n "$triedb_disk" ]] && triedb_disk_gb=$(lsblk -bdn -o SIZE "/dev/${triedb_disk}" 2>/dev/null \
                     | awk '{printf "%d", $1/1024/1024/1024}')
    triedb_size_gb="$triedb_part_gb"
    local whole_note=""
    if [[ -n "$triedb_disk_gb" && -n "$triedb_part_gb" ]] && (( triedb_disk_gb > triedb_part_gb + 1 )); then
      whole_note=" — partition is ${triedb_part_gb} GiB of a ${triedb_disk_gb} GiB disk"
    fi
    if [[ -z "$triedb_size_gb" || "$triedb_size_gb" == "0" ]]; then
      emit hardware "disk.triedb-size" SKIP "could not read the size of /dev/triedb (${triedb_part}) — size NOT verified" \
           $'Action:      lsblk -b -o NAME,SIZE,TYPE $(readlink -f /dev/triedb)'
    elif (( triedb_size_gb >= DISK_GB_TRIEDB_MIN )); then
      emit hardware "disk.triedb-size" PASS "/dev/triedb → /dev/${triedb_part} (${triedb_size_gb} GiB)${whole_note}"
    else
      emit hardware "disk.triedb-size" FAIL "triedb partition only ${triedb_size_gb} GiB — need ≥${DISK_GB_TRIEDB_MIN} GiB (docs: 2 TB disk ≈ 1788 GiB)${whole_note}" \
           $'Why:         the node writes triedb into this partition; the parent disk being larger\n             does not help. Re-partition to give triedb the full drive.'
    fi
  else
    emit hardware "disk.triedb-size" INFO "/dev/triedb not present — skipping size check (created on first install)"
  fi
}

check_iops() {
  if (( QUICK_MODE == 1 )); then
    emit hardware "disk.iops"   INFO "skipped (--quick)"
    return
  fi
  if ! require_cmd fio; then
    emit hardware "disk.iops"   INFO "skipped (fio not installed) — install: apt install -y fio"
    return
  fi

  # Safety: do not run fio on a disk where monad-execution is hammering triedb —
  # would compete with real IO and could spike vote_delay.
  if systemctl is-active --quiet monad-bft 2>/dev/null \
     || systemctl is-active --quiet monad-execution 2>/dev/null; then
    emit hardware "disk.iops"   INFO "skipped — monad services active, fio would compete with triedb IO" \
         "Run on a non-triedb disk separately, or stop monad-execution briefly: 'systemctl stop monad-execution && fio ... && systemctl start monad-execution'"
    return
  fi

  # Pick a non-triedb NVMe to avoid stomping on production data.
  local target_dev triedb_disk=""
  if [[ -L /dev/triedb ]]; then
    triedb_disk=$(lsblk -no PKNAME "$(readlink -f /dev/triedb)" 2>/dev/null | head -1)
  fi
  target_dev=$(lsblk -d -o NAME,TYPE 2>/dev/null \
    | awk -v skip="$triedb_disk" '/disk/ && /^nvme/ && $1 != skip {print "/dev/"$1; exit}')
  if [[ -z "$target_dev" ]]; then
    emit hardware "disk.iops"   INFO "skipped (no non-triedb NVMe found)"
    return
  fi

  # This is a PROXY measurement. fio deliberately avoids the triedb disk so it cannot compete
  # with production IO — but the number was then reported as though it described triedb, with
  # advice about "the validator critical path". On a host whose OS disk is a consumer drive and
  # whose triedb is datacenter-class (or the reverse), that verdict is about the wrong hardware.
  # Say which device was measured, and do not FAIL on a disk the node never touches.
  emit hardware "disk.iops"     INFO "running fio on $target_dev — a PROXY for triedb (${triedb_disk:-triedb disk} is in use and must not be disturbed)…"
  local iops
  iops=$(fio --name=mdr --filename="$target_dev" --rw=randread --bs=4k \
    --runtime=10 --time_based=1 --ioengine=libaio --iodepth=32 --direct=1 \
    --numjobs=4 --group_reporting --output-format=terse 2>/dev/null \
    | awk -F\; '{print $8}' | head -1)

  if [[ -z "$iops" || "$iops" == "0" ]]; then
    emit hardware "disk.iops"   WARN "fio returned no result"
    return
  fi

  # Same device as triedb? Then the figure genuinely describes triedb and FAIL is warranted.
  # A different device can only ever be an indication, so it must not drive the verdict.
  local _measured="${target_dev##*/}" _is_triedb_disk=0
  [[ -n "$triedb_disk" && "$_measured" == "$triedb_disk" ]] && _is_triedb_disk=1
  local _scope=" on /dev/${_measured}"
  (( _is_triedb_disk )) || _scope=" on /dev/${_measured} — NOT the triedb disk, indicative only"

  if (( iops >= NVME_IOPS_REC )); then
    emit hardware "disk.iops"   PASS "${iops} 4k random read IOPS${_scope}"
  elif (( iops >= NVME_IOPS_MIN )); then
    emit hardware "disk.iops"   WARN "${iops} IOPS${_scope} — meets min ($NVME_IOPS_MIN), recommend $NVME_IOPS_REC+"
  elif (( _is_triedb_disk == 0 )); then
    emit hardware "disk.iops"   WARN "${iops} IOPS${_scope} — below minimum $NVME_IOPS_MIN, but this is not the disk triedb uses" \
         $'Action:      Measure the real thing while the node is stopped:\n               systemctl stop monad-execution\n               sudo fio --filename=/dev/triedb --rw=randread --bs=4k --iodepth=64 \\\n                   --runtime=30 --name=iops --direct=1\n               systemctl start monad-execution\nWhy:         a slow OS disk says little about triedb latency, and vice versa.'
  else
    emit hardware "disk.iops"   FAIL "${iops} IOPS${_scope} — below minimum $NVME_IOPS_MIN" \
         $'Action:      Replace with datacenter-class NVMe (Samsung PM9A3, WD SN850X, Micron 7450,\n             Intel D7-P5520). Consumer NVMe slows to 50-80k IOPS under sustained load.\nVerify:      sudo fio --filename=/dev/triedb --rw=randread --bs=4k --iodepth=64 \\\n                  --runtime=30 --name=iops --direct=1\nWhy:         triedb random reads define the validator critical path; <'"$NVME_IOPS_MIN"$' IOPS\n             produces slow blocks, missed votes and eventual jail.'
  fi
}

# ===== Section: OS =====
check_os() {
  if [[ ! -r /etc/os-release ]]; then
    emit os "os.release" FAIL "/etc/os-release not readable"
    return
  fi
  . /etc/os-release
  case "$ID" in
    ubuntu)
      local ver_id="${VERSION_ID:-0}"
      if ver_ge "$ver_id" "$UBUNTU_VERSION_MIN"; then
        emit os "os.distro"     PASS "$PRETTY_NAME"
      else
        # apt repo pkg.category.xyz only ships 'noble' (24.04). On 22.04 jammy
        # the install will fail with "Unable to find package" anyway.
        emit os "os.distro"     FAIL "$PRETTY_NAME — Ubuntu ${UBUNTU_VERSION_MIN}+ required (apt repo ships noble only)" \
             $'Action:      Reinstall with Ubuntu 24.04 LTS (Hetzner: installimage → Ubuntu-2404-noble image).\nWhy:         Monad apt repo (pkg.category.xyz) only ships the "noble" suite;\n             apt install monad on older releases fails with "Unable to locate package".'
      fi ;;
    debian)
      emit os "os.distro"       FAIL "$PRETTY_NAME — Debian not supported by docs (only Ubuntu ${UBUNTU_VERSION_MIN}+)" \
           $'Action:      Reinstall with Ubuntu 24.04 LTS — Debian is not in the supported matrix.\nWhy:         libc/systemd versions and apt repo suite differ; package install will break.'
      ;;
    *)
      emit os "os.distro"       FAIL "$PRETTY_NAME — only Ubuntu ${UBUNTU_VERSION_MIN}+ supported per docs" \
           $'Action:      Reinstall with Ubuntu 24.04 LTS.\nWhy:         docs and Monad apt repo target Ubuntu noble exclusively.'
      ;;
  esac

  # Architecture
  local arch
  arch=$(uname -m)
  if [[ "$arch" == "x86_64" ]]; then
    emit os "os.arch"           PASS "x86_64"
  else
    emit os "os.arch"           FAIL "$arch — only x86_64 supported" \
         $'Action:      Provision a server with x86_64 (AMD64) CPU.\nWhy:         Monad ships binaries for amd64 only; arm64/aarch64 hosts have no\n             working monad-bft package.'
  fi
}

kernel_upgrade_tip() {
  # On Ubuntu <24.04 the `linux-generic-hwe-24.04` package does not exist
  # (HWE meta-packages target their own LTS). Reinstall is the only way to
  # reach kernel ≥${KERNEL_MIN}-${KERNEL_MIN_PATCH}. On 24.04 the HWE rolls
  # forward as new generic kernels ship.
  local ver_id=""
  if [[ -r /etc/os-release ]]; then
    ver_id=$(. /etc/os-release && echo "${VERSION_ID:-}")
  fi
  if [[ -n "$ver_id" ]] && ver_ge "$ver_id" "$UBUNTU_VERSION_MIN"; then
    printf '%s\n' \
      "Quick fix:   apt update && apt install --install-recommends linux-generic-hwe-${UBUNTU_VERSION_MIN} && reboot" \
      "Verify:      uname -r   # → ≥${KERNEL_MIN}-${KERNEL_MIN_PATCH}-generic" \
      "Why:         buggy 6.8.0-{56..59} kernels cause Monad client hangs (docs); HWE pulls a newer generic kernel."
  else
    printf '%s\n' \
      "Action:      Reinstall with Ubuntu ${UBUNTU_VERSION_MIN}+ — HWE on older releases does not reach ${KERNEL_MIN}-${KERNEL_MIN_PATCH}." \
      "Why:         apt repo is noble-only and docs target the noble HWE stack."
  fi
}

# Is 6.8.0-136 actually blocked? The presence of a file in preferences.d proves nothing: apt
# IGNORES names containing a dot unless the extension is .pref, so the filename the MF docs
# suggest (block-kernel-6.8.0-136) is silently inert. Verified by experiment — with a dotted name
# the candidate stays installable, with .pref it becomes (none). One of our own nodes ran for
# weeks with an ineffective pin and unattended-upgrades enabled: one reboot from a dead node.
check_kernel_pin() {
  if ! require_cmd apt-cache; then
    emit os "kernel.pin" SKIP "apt-cache unavailable — 6.8.0-136 pin NOT verified"
    return
  fi
  local cand
  cand=$(apt-cache policy linux-image-6.8.0-136-generic 2>/dev/null | awk '/Candidate:/ {print $2}')
  local fix
  fix=$'Quick fix:   sudo tee /etc/apt/preferences.d/block-kernel-136.pref <<\'EOF\'\n             Package: linux-image-6.8.0-136-generic linux-headers-6.8.0-136-generic linux-modules-6.8.0-136-generic linux-modules-extra-6.8.0-136-generic\n             Pin: release *\n             Pin-Priority: -1\n             EOF\nVerify:      apt-cache policy linux-image-6.8.0-136-generic   # expect Candidate: (none)\nNote:        the filename MUST end in .pref — apt ignores dotted names such as\n             block-kernel-6.8.0-136, which is the name the MF docs suggest.\nWhy:         monad-bft does not start on 6.8.0-136 ("failed to create buffer ring:\n             Os { code: 22 }"), so the node will not come back after the next reboot.'
  if [[ -z "$cand" ]]; then
    # apt knows nothing about the package at all — wrong release (the 6.8 kernels are noble)
    # or no index yet. Nothing to pin, so this is informational, not an unperformed check.
    emit os "kernel.pin" INFO "linux-image-6.8.0-136-generic is not in the apt index — nothing to pin on this release"
  elif [[ "$cand" == "(none)" ]]; then
    emit os "kernel.pin" PASS "kernel 6.8.0-136 pinned out (apt offers no candidate)"
  elif ! _monad_pkg_installed; then
    # PRE-INSTALL: the installer writes this pin itself, in step_cve_mitigation. But that step
    # runs AFTER step_preflight, so returning FAIL here made the doctor exit 2, which
    # step_preflight turns into a fatal under --non-interactive — the installer refused to run
    # because of a condition only the installer could fix. A deadlock on stock Ubuntu 24.04,
    # where the package is installable and unattended-upgrades is on by default.
    # Same convention as check_unattended_upgrades: inform before install, judge after.
    emit os "kernel.pin" INFO "kernel 6.8.0-136 is installable ($cand) — monad-validator-setup → step_cve_mitigation writes the pin on install"
  elif systemctl is-active --quiet unattended-upgrades 2>/dev/null; then
    emit os "kernel.pin" FAIL "kernel 6.8.0-136 is installable ($cand) AND unattended-upgrades is active" "$fix"
  else
    emit os "kernel.pin" WARN "kernel 6.8.0-136 is installable ($cand) — pin it before enabling unattended upgrades" "$fix"
  fi
}

check_kernel() {
  local full base patch tip
  full=$(uname -r)              # e.g. "6.8.0-60-generic"
  base=$(echo "$full" | cut -d- -f1)
  patch=$(echo "$full" | sed -nE 's/^[0-9]+\.[0-9]+\.[0-9]+-([0-9]+).*/\1/p')
  tip=$(kernel_upgrade_tip)

  # Reject buggy 6.8.0-{56..59} range explicitly (docs cite this hang bug)
  if [[ "$base" == "6.8.0" && -n "$patch" ]]; then
    # 136 needs its OWN advice: the generic kernel_upgrade_tip suggests linux-generic-hwe-24.04,
    # which on noble pulls the newest generic — i.e. 6.8.0-136 itself — so the "fix" leaves the
    # host on the broken kernel, and its Verify step (uname -r >= 6.8.0-60) passes there too.
    # The symptom differs as well: 136 does not hang, monad-bft refuses to start.
    if [[ "$patch" == "136" ]]; then
      emit os "kernel.version"  FAIL "kernel $full — monad-bft will not start on 6.8.0-136 (failed to create buffer ring: Os { code: 22 })" \
           $'Quick fix:   sudo apt install -y linux-image-6.8.0-134-generic linux-headers-6.8.0-134-generic\n             sudo tee /etc/apt/preferences.d/block-kernel-136.pref <<EOF\n             Package: linux-image-6.8.0-136-generic linux-headers-6.8.0-136-generic linux-modules-6.8.0-136-generic linux-modules-extra-6.8.0-136-generic\n             Pin: release *\n             Pin-Priority: -1\n             EOF\n             sudo reboot   # into 6.8.0-134\nVerify:      uname -r   # expect 6.8.0-134-generic, NOT 136\nWhy:         docs.monad.xyz recommends 6.8.0.134 and pinning 136 out. Do NOT install\n             linux-generic-hwe-24.04 here — on noble it pulls 136 straight back.'
      return
    fi
    for bad in $KERNEL_BUGGY_PATCHES; do
      if [[ "$patch" == "$bad" ]]; then
        emit os "kernel.version"  FAIL "kernel $full — known buggy range 6.8.0-${KERNEL_BUGGY_PATCHES// /,} (causes Monad client hangs)" \
             "$tip"
        return
      fi
    done
  fi

  # Compare base version + patch number against minimum (6.8.0 + patch 60)
  if ver_ge "$base" "$KERNEL_MIN"; then
    if [[ "$base" == "$KERNEL_MIN" && -n "$patch" && "$patch" -lt "$KERNEL_MIN_PATCH" ]]; then
      emit os "kernel.version"  FAIL "kernel $full — need ≥${KERNEL_MIN}-${KERNEL_MIN_PATCH}" \
           "$tip"
    else
      emit os "kernel.version"  PASS "$full"
    fi
  else
    emit os "kernel.version"    FAIL "kernel $base — need ≥${KERNEL_MIN}-${KERNEL_MIN_PATCH}" \
         "$tip"
  fi
}

check_ulimits() {
  # If monad-bft.service exists, its LimitNOFILE is the authoritative value
  # for the validator process. Shell ulimit is only relevant if running monad manually.
  if systemctl cat monad-bft 2>/dev/null >/dev/null; then
    local svc_limit
    svc_limit=$(systemctl show monad-bft -p LimitNOFILE 2>/dev/null | cut -d= -f2)
    svc_limit=${svc_limit:-0}
    # systemd reports an unbounded limit as the literal "infinity" — stronger
    # than the numeric target, so it's a PASS. Gate the numeric comparison
    # behind ^[0-9]+$ so a non-numeric value can never reach (( )) and abort
    # the whole script under `set -u` (mirrors the limits.conf branch below).
    if [[ "$svc_limit" == "infinity" ]]; then
      emit os "ulimit.service"  PASS "monad-bft LimitNOFILE=infinity (unlimited)"
    elif [[ "$svc_limit" =~ ^[0-9]+$ ]] && (( svc_limit >= ULIMIT_MIN )); then
      emit os "ulimit.service"  PASS "monad-bft LimitNOFILE=$svc_limit"
    else
      emit os "ulimit.service"  WARN "monad-bft LimitNOFILE=$svc_limit — recommend ≥$ULIMIT_MIN" \
           $'Quick fix:   sudo mkdir -p /etc/systemd/system/monad-bft.service.d\n             printf \'[Service]\\nLimitNOFILE=1048576\\n\' | \\\n               sudo tee /etc/systemd/system/monad-bft.service.d/override.conf\n             sudo systemctl daemon-reload && sudo systemctl restart monad-bft\nVerify:      systemctl show monad-bft -p LimitNOFILE   # → 1048576\nWhy:         monad-bft opens many UDP sockets + log files; default 1024 ulimit causes\n             "too many open files" mid-epoch and crashes.'
    fi
  else
    # No service yet — fall back to /etc/security/limits.conf
    local conf_limit
    conf_limit=$(awk '$1=="*" && $2=="hard" && $3=="nofile" {print $4}' /etc/security/limits.conf 2>/dev/null | tail -1)
    if [[ "$conf_limit" == "unlimited" ]]; then
      emit os "ulimit.limits-conf" PASS "limits.conf hard nofile=unlimited"
    elif [[ -n "$conf_limit" && "$conf_limit" =~ ^[0-9]+$ ]] && (( conf_limit >= ULIMIT_MIN )); then
      emit os "ulimit.limits-conf" PASS "limits.conf hard nofile=$conf_limit"
    elif ! _monad_pkg_installed; then
      emit os "ulimit.limits-conf" INFO "no high nofile limit in limits.conf — monad-validator-setup → step_ulimits will write 99-monad-validator.conf on install"
    else
      emit os "ulimit.limits-conf" WARN "no high nofile limit set in /etc/security/limits.conf" \
           $'Auto:        monad-validator-setup → step_ulimits writes /etc/security/limits.d/99-monad-validator.conf\nManual:      sudo tee /etc/security/limits.d/99-monad-validator.conf <<EOF\n             * soft nofile 1048576\n             * hard nofile 1048576\n             EOF\nVerify:      ulimit -n   # in a fresh shell session\nWhy:         pre-empts the same FD exhaustion as ulimit.service, for non-service runs.'
    fi
  fi

  # System-wide file-max — the cap on TOTAL open fd across all processes on
  # the host, separate from per-process LimitNOFILE. Validator workload uses
  # ~3k fd total in practice (monad-bft + execution + rpc combined; measured
  # 2688 used on a 9-day-uptime BeeHive prod node). docs.monad.xyz specifies
  # neither this nor LimitNOFILE; the monad apt pkg sets LimitNOFILE=1048576
  # per-service in its unit files but says nothing about system-wide cap.
  # Threshold: canonical Linux floor (65536), not per-process (1M).
  local sysmax filenr used pct
  sysmax=$(cat /proc/sys/fs/file-max 2>/dev/null || echo 0)
  filenr=$(awk '{print $1}' /proc/sys/fs/file-nr 2>/dev/null || echo 0)
  used=${filenr:-0}
  pct=$(( sysmax > 0 ? (used * 100 / sysmax) : 100 ))
  if (( sysmax >= SYSTEM_FILE_MAX_MIN )); then
    emit os "ulimit.system"     PASS "fs.file-max = $sysmax (current usage ${used}, ${pct}%)"
  elif (( used * 4 < sysmax )); then
    # file-max below 65k floor BUT current usage uses <25% — node is fine
    # right now, headroom adequate. INFO not WARN to avoid false-alarming
    # operators on a perfectly functional install.
    emit os "ulimit.system"     INFO "fs.file-max = $sysmax (below ${SYSTEM_FILE_MAX_MIN} floor but only ${pct}% used, ${used} of ${sysmax}); per-process LimitNOFILE from monad systemd units is the authoritative limit for monad-* processes"
  else
    emit os "ulimit.system"     WARN "fs.file-max = $sysmax — low AND usage at ${pct}% (${used} of ${sysmax})" \
         $'Quick fix:   echo "fs.file-max = 2097152" | sudo tee /etc/sysctl.d/99-monad-tuning.conf\n             sudo sysctl --system\nVerify:      sysctl fs.file-max   # ≥ 2097152\nWhy:         system-wide cap above per-process; the kernel rejects open() with ENFILE\n             once total fd allocated approaches fs.file-max regardless of LimitNOFILE.\nNote:        BeeHive recommendation — not in docs.monad.xyz. The monad apt pkg\n             sets LimitNOFILE=1048576 per service unit, but those are bounded by\n             this system-wide cap.'
  fi
}

check_sysctl() {
  # Network buffer sizes critical for raptorcast UDP throughput
  local rmem_max wmem_max
  rmem_max=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)

  wmem_max=$(sysctl -n net.core.wmem_max 2>/dev/null || echo 0)
  # monad-bft (since ~0.14.x) sets SO_RCVBUF=62500000 on the dataplane UDP
  # socket and panics at startup if rmem_max is below that. The exact panic
  # message: "unable to set udp receive buffer size to 62500000. Got X instead.
  # Set net.core.rmem_max to at least 62500000". So 62500000 IS the threshold,
  # not a padded value above it. The monad apt package's
  # /etc/sysctl.d/90-monad-network-buffer.conf ships exactly 62500000.
  local need=62500000  # 62.5 MB — exact monad-bft requirement
  if (( rmem_max >= need && wmem_max >= need )); then
    emit os "sysctl.netbuf"     PASS "rmem_max=$rmem_max wmem_max=$wmem_max"
  elif ! _monad_pkg_installed; then
    # Pre-install: the monad apt package writes /etc/sysctl.d/90-monad-network-buffer.conf
    # in its postinst, which raises rmem_max/wmem_max to 62500000. Until that
    # happens the operator can't (and shouldn't need to) fix this manually.
    emit os "sysctl.netbuf"     INFO "rmem/wmem_max below ${need} — monad pkg will raise this on install (postinst writes /etc/sysctl.d/90-monad-network-buffer.conf)"
  else
    emit os "sysctl.netbuf"     FAIL "rmem/wmem_max below ${need} — monad-bft will panic at startup" \
         $'Symptom:     "unable to set udp receive buffer size to 62500000" in journalctl -u monad-bft\nExpected:    the monad apt package ships /etc/sysctl.d/90-monad-network-buffer.conf\n             with net.core.rmem_max = 62500000 (applied on package install via\n             postinst). If this file is missing/overridden, monad-bft will panic.\nCheck:       cat /etc/sysctl.d/90-monad-network-buffer.conf   # should exist after monad install\n             ls /etc/sysctl.d/ | grep -E "monad|99-"   # look for higher-priority overrides\nFix:         sudo dpkg-reconfigure monad   # re-apply pkg drop-in\n             OR remove any 99-*.conf that lowers rmem_max below 62500000\n             sudo sysctl --system\nVerify:      sysctl net.core.rmem_max net.core.wmem_max   # both ≥ 62500000\nWhy:         monad-bft (since ~0.14.x) calls setsockopt(SO_RCVBUF, 62500000) on\n             the dataplane UDP socket; kernel clamps to rmem_max and the node\n             panics if the resulting buffer is below the requested size.'
  fi

  local swappiness
  swappiness=$(sysctl -n vm.swappiness 2>/dev/null || echo 60)
  if (( swappiness <= 10 )); then
    emit os "sysctl.swappiness" PASS "vm.swappiness=$swappiness"
  else
    emit os "sysctl.swappiness" WARN "vm.swappiness=$swappiness — high" \
         $'Quick fix:   echo "vm.swappiness = 1" | sudo tee /etc/sysctl.d/99-monad-tuning.conf\n             sudo sysctl --system\nVerify:      sysctl vm.swappiness   # 1\nWhy:         default 60 swaps anonymous pages aggressively; for a validator with hot\n             working set this introduces 10-100ms read latency and missed votes.\nNote:        BeeHive recommendation — not in docs.monad.xyz.'
  fi
}

check_ntp() {
  if require_cmd chronyc && systemctl is-active --quiet chrony 2>/dev/null; then
    local track off leap refid
    track=$(chronyc tracking 2>/dev/null)
    off=$(awk -F': ' '/Last offset/ {print $2}' <<<"$track" | awk '{print $1}')
    leap=$(awk -F': ' '/Leap status/ {gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2}' <<<"$track")
    refid=$(awk -F': ' '/Reference ID/ {print $2}' <<<"$track" | awk '{print $1}')
    # `Last offset` alone is not evidence of synchronisation: it keeps the value from the last
    # successful correction. With every source unreachable (NTP blocked upstream, DNS down) chrony
    # stays active, reports a microscopic stale offset — and the old check said PASS while the
    # clock drifted freely, which is exactly what inflates vote_delay and risks a jail.
    if [[ -z "$off" ]]; then
      emit os "ntp"             SKIP "chrony active but 'chronyc tracking' returned nothing — clock NOT verified" \
           $'Action:      chronyc tracking ; chronyc sources -v ; systemctl status chrony'
      return
    fi
    if [[ "$refid" == "00000000" || "$leap" == "Not synchronised" ]]; then
      emit os "ntp"             FAIL "chrony is NOT synchronised (Reference ID=${refid:-?}, Leap status=${leap:-?}) — offset value is stale" \
           $'Investigate: chronyc sources -v   # are any sources reachable/selectable?\nQuick fix:   check egress UDP/123 and DNS, then: sudo systemctl restart chrony; sleep 30; chronyc tracking\nWhy:         an unsynchronised clock drifts freely; `Last offset` keeps the value from the\n             last successful correction and looks healthy while time is wrong.'
      return
    fi
    local off_us
    off_us=$(awk -v o="$off" 'BEGIN {printf "%d", (o<0?-o:o)*1000000}')
    if (( off_us < 1000 )); then
      emit os "ntp"             PASS "chrony, |offset|=${off_us}µs"
    elif (( off_us < 10000 )); then
      emit os "ntp"             WARN "chrony, |offset|=${off_us}µs — slight drift"
    else
      emit os "ntp"             FAIL "chrony, |offset|=${off_us}µs — significant drift" \
           $'Investigate: chronyc sources -v   # check selectability/reachability\n             chronyc tracking      # current offset/skew\nQuick fix:   sudo systemctl restart chrony; sleep 30; chronyc tracking\nIf persists: pool/server lines in /etc/chrony/chrony.conf reachable?\n             Add closer sources: pool 2.ubuntu.pool.ntp.org iburst maxsources 4\nWhy:         high clock offset distorts vote_delay metric and can cause MF jail decisions.'
    fi
  elif systemctl is-active --quiet systemd-timesyncd 2>/dev/null; then
    if ! _monad_pkg_installed; then
      emit os "ntp"             INFO "systemd-timesyncd active — monad-validator-setup → step_chrony will replace with chrony on install"
    else
      emit os "ntp"             WARN "systemd-timesyncd active — drifts ~10-100ms, inflates vote_delay" \
           $'Quick fix:   sudo apt install -y chrony   # auto-replaces timesyncd on Ubuntu\n             sudo systemctl disable --now systemd-timesyncd\nAuto:        monad-validator-setup → step_chrony does exactly this.\nVerify:      chronyc tracking   # tiny offset, leap status normal\nWhy:         timesyncd uses SNTP, no kernel discipline → drift accumulates between syncs,\n             distorts vote_delay; chrony slews continuously.'
    fi
  else
    emit os "ntp"               FAIL "no NTP daemon active" \
         $'Quick fix:   sudo apt install -y chrony && sudo systemctl enable --now chrony\nVerify:      chronyc tracking   # source synced, offset <1ms\nWhy:         without time sync, vote_delay drifts, MF metrics become incorrect,\n             and operators chase phantom performance regressions.'
  fi
}

# ===== Section: NETWORK =====
check_bandwidth() {
  # Per docs: 300 Mbit/s for validators, 100 Mbit/s for full nodes.
  # ethtool reports link speed; iface running on a virtio adapter often
  # reports 0 or "Unknown!" — INFO in that case.
  if ! command -v ethtool >/dev/null; then
    emit network "net.speed" INFO "ethtool not installed — cannot check link speed"
    return
  fi
  local checked=0
  while IFS= read -r iface; do
    [[ "$iface" == "lo" ]] && continue
    [[ "$iface" =~ ^(docker|veth|br-|virbr) ]] && continue
    local speed
    speed=$(ethtool "$iface" 2>/dev/null | awk '/Speed:/ {sub(/Mb\/s.*/,"",$2); print $2; exit}')
    [[ -z "$speed" || ! "$speed" =~ ^[0-9]+$ ]] && continue
    checked=1
    if (( speed >= NET_SPEED_VALIDATOR_MBPS )); then
      emit network "net.speed.$iface" PASS "${speed} Mb/s on $iface (≥${NET_SPEED_VALIDATOR_MBPS} required for validator)"
    elif (( speed >= NET_SPEED_FULLNODE_MBPS )); then
      emit network "net.speed.$iface" WARN "${speed} Mb/s on $iface — below validator min (${NET_SPEED_VALIDATOR_MBPS}), OK for full-node (${NET_SPEED_FULLNODE_MBPS})"
    else
      emit network "net.speed.$iface" FAIL "${speed} Mb/s on $iface — below full-node min (${NET_SPEED_FULLNODE_MBPS})"
    fi
  done < <(ip -o link show 2>/dev/null | awk -F': ' '/state UP/ {print $2}' | awk '{print $1}')
  if (( checked == 0 )); then
    emit network "net.speed" INFO "no UP physical interface reported a numeric link speed"
  fi
}

check_public_ip() {
  local ip
  ip=$(curl -fsS -m 4 https://api.ipify.org 2>/dev/null || true)
  if [[ -z "$ip" ]]; then
    emit network "net.public-ip" WARN "couldn't determine public IP (api.ipify.org timeout)"
    return
  fi
  emit network "net.public-ip"   PASS "$ip"

  # Check that public IP is on this host (not behind NAT)
  if hostname -I 2>/dev/null | grep -qw "$ip"; then
    emit network "net.nat-detect" PASS "public IP bound to interface (no NAT)"
  else
    emit network "net.nat-detect" WARN "public IP not on local interface — possible NAT" \
         "Validator behind NAT requires port-forwarding for ports $NET_PORTS_REQUIRED"
  fi
}

check_ports_free() {
  # NET_PORTS_REQUIRED contains "port/proto" tokens (e.g. 8000/tcp 8000/udp 8001/udp)
  for spec in $NET_PORTS_REQUIRED; do
    local port="${spec%/*}" proto="${spec#*/}" ss_flag
    case "$proto" in
      tcp) ss_flag="-tln" ;;
      udp) ss_flag="-uln" ;;
      *)   emit network "net.port.$spec" INFO "unknown proto '$proto'"; continue ;;
    esac

    local listening_line who
    listening_line=$(ss $ss_flag 2>/dev/null | awk -v p=":${port}" '$4 ~ (p"$") {print; exit}')
    if [[ -z "$listening_line" ]]; then
      # "Free" is only good news BEFORE install. Once the monad package is installed and
      # monad-bft is enabled, a free consensus port means the node is NOT running — and the old
      # code handed out three green PASSes for exactly that, so a dead node still produced
      # `verdict: READY` / exit 0.
      if _monad_pkg_installed && systemctl is-enabled --quiet monad-bft 2>/dev/null \
         && ! systemctl is-active --quiet monad-bft 2>/dev/null; then
        emit network "net.port.$spec" FAIL "port ${port}/${proto} free but monad-bft is installed+enabled and NOT running — the node is down" \
             $'Investigate: systemctl status monad-bft --no-pager -l\n             journalctl -u monad-bft -n 200 --no-pager\nWhy:         an unused consensus port on a configured node means no consensus at all.'
      else
        emit network "net.port.$spec" PASS "port ${port}/${proto} free"
      fi
      continue
    fi

    # Try to identify the listening process (-p needs root)
    who=$(ss "${ss_flag}p" 2>/dev/null | awk -v p=":${port}" '$4 ~ (p"$") {print; exit}' \
          | grep -oE 'users:\(\("[^"]+"' | grep -oE '"[^"]+"' | tr -d '"' | head -1)
    if [[ "$who" =~ ^monad ]]; then
      emit network "net.port.$spec" PASS "port ${port}/${proto} owned by $who (node already running)"
    else
      emit network "net.port.$spec" WARN "port ${port}/${proto} occupied by ${who:-?} — must be free or owned by monad-*" \
           $'Investigate: sudo ss -'"$(case $proto in tcp) echo -n tlnp;; udp) echo -n ulnp;; esac)"$' | grep :'"$port"$'\nQuick fix:   stop conflicting service: sudo systemctl stop <service>; sudo systemctl disable <service>\n             or rebind it to another port in its config.\nWhy:         monad-bft will fail to bind '"$port/$proto"$' and exit on startup.'
    fi
  done
}

check_firewall() {
  if require_cmd ufw && ufw status 2>/dev/null | grep -q "Status: active"; then
    local ufw_status missing="" restricted=""
    ufw_status=$(ufw status 2>/dev/null)
    for spec in $NET_PORTS_REQUIRED; do
      local port="${spec%/*}" proto="${spec#*/}"
      # ufw rules appear as "8000/tcp ALLOW IN Anywhere", "8000 ALLOW IN Anywhere" (any proto),
      # or restricted to a source: "8000/udp ALLOW IN 203.0.113.5".
      # The old pattern only looked at the "To" column and the word ALLOW, so a rule scoped to a
      # single peer counted as an open port — the node was unreachable for the rest of the
      # network (desync, no votes) while the doctor reported "all required pairs allowed".
      # Consensus ports must be open to Anywhere; anything narrower is reported explicitly.
      local rule_line
      rule_line=$(awk -v p="$port" -v pr="$proto" '
        $0 ~ "^"p"/"pr"[[:space:]]" || $0 ~ "^"p"[[:space:]]" {print; exit}' <<<"$ufw_status")
      if [[ -n "$rule_line" ]] && grep -qE 'ALLOW' <<<"$rule_line"; then
        if grep -qiE 'ALLOW[[:space:]]+(IN[[:space:]]+)?Anywhere' <<<"$rule_line"; then
          continue
        fi
        restricted+="$spec "
        continue
      fi
      missing+="$spec "
    done
    if [[ -z "$missing" && -n "$restricted" ]]; then
      emit network "net.firewall" WARN "ufw allows $restricted only from specific sources — the rest of the network cannot reach this node" \
           $'Quick fix:   for s in '"$restricted"$'; do sudo ufw allow $s; done\nVerify:      sudo ufw status numbered\nWhy:         consensus/raptorcast ports must accept traffic from any peer. A source-scoped\n             rule silently isolates the node: it stays up, but desyncs and stops voting.'
    elif [[ -z "$missing" ]]; then
      emit network "net.firewall" PASS "ufw active, all required port/proto pairs allowed from Anywhere"
    else
      emit network "net.firewall" WARN "ufw active but missing rules for: $missing${restricted:+ (source-restricted: $restricted)}" \
           $'Quick fix:   '"$(for s in $missing; do printf 'sudo ufw allow %s; ' "$s"; done)"$'\nAuto:        monad-validator-setup → step_firewall adds all required rules.\nVerify:      sudo ufw status verbose\nWhy:         peers cannot reach this node on the missing port → desyncs, no votes.'
    fi

    # Lockout guard: ufw is active — make sure SSH is whitelisted on whatever
    # port sshd actually listens on. Hardcoded 22 isn't enough because operators
    # commonly move SSH; if rules don't match the active port, ANY ufw reload
    # locks the operator out of their own validator.
    local _ssh_ports_detected=""
    [[ -n "${SSH_CONNECTION:-}" ]] && _ssh_ports_detected=$(awk '{print $NF}' <<<"$SSH_CONNECTION")
    if [[ -r /etc/ssh/sshd_config ]]; then
      local _from_cfg
      _from_cfg=$(sshd -T 2>/dev/null | awk '/^port / {print $2}')
      [[ -n "$_from_cfg" ]] && _ssh_ports_detected="$_ssh_ports_detected $_from_cfg"
    fi
    _ssh_ports_detected=$(tr ' ' '\n' <<<"$_ssh_ports_detected" \
                          | awk 'NF && /^[0-9]+$/' | sort -u | tr '\n' ' ')
    _ssh_ports_detected="${_ssh_ports_detected% }"
    if [[ -n "$_ssh_ports_detected" ]]; then
      local _ssh_missing=""
      for _p in $_ssh_ports_detected; do
        # Accept every shape ufw actually prints for a permitted SSH port:
        #   22/tcp        ALLOW    Anywhere         plain allow
        #   22/tcp        LIMIT    Anywhere         `ufw limit ssh` — the RECOMMENDED hardening,
        #                                           and it is not the word ALLOW
        #   22/tcp (v6)   ALLOW    Anywhere (v6)    v6 row
        #   OpenSSH       ALLOW    Anywhere         app profile — no port number in the row at all
        # Matching only ALLOW-with-a-port meant a host hardened with `ufw limit` or the OpenSSH
        # profile was reported as "ufw active but does NOT allow SSH" — a FAIL, with a DANGER
        # notice, on a host that is more carefully protected than the one that passes.
        if ! echo "$ufw_status" | grep -qE "^${_p}(/tcp)?( \(v6\))?[[:space:]]+(ALLOW|LIMIT)"; then
          # Fall back to app profiles, which name a service instead of a port.
          local _prof_ok=0
          if [[ "$_p" == "22" ]] && echo "$ufw_status" | grep -qE '^(OpenSSH|SSH)( \(v6\))?[[:space:]]+(ALLOW|LIMIT)'; then
            _prof_ok=1
          fi
          (( _prof_ok )) || _ssh_missing+="$_p "
        fi
      done
      if [[ -z "$_ssh_missing" ]]; then
        emit network "ssh.firewall" PASS "SSH port(s) ${_ssh_ports_detected} whitelisted in ufw"
      else
        emit network "ssh.firewall" FAIL "ufw active but does NOT allow SSH port(s): ${_ssh_missing}" \
             $'DANGER:      next `ufw reload` or rule change can drop your SSH session.\nQuick fix:   for p in '"${_ssh_missing}"$'; do sudo ufw allow ${p}/tcp comment "ssh ${p}"; done\nVerify:      sudo ufw status | grep -E "'"$(echo "$_ssh_missing" | tr ' ' '|')"$'"/tcp"\nWhy:         operators frequently move SSH off :22; if ufw whitelist is stale\n             (still allows only :22 while sshd moved to :2222), the next reload\n             locks the operator out — recovery requires console/KVM.'
      fi
    fi
  elif require_cmd ufw; then
    # Suggest the *actual* SSH port (from this connection if available, else
    # sshd_config). Hardcoding 22/tcp here would lock out operators on custom ports.
    local _ssh_port=""
    [[ -n "${SSH_CONNECTION:-}" ]] && _ssh_port=$(awk '{print $NF}' <<<"$SSH_CONNECTION")
    [[ -z "$_ssh_port" && -r /etc/ssh/sshd_config ]] && _ssh_port=$(sshd -T 2>/dev/null | awk '/^port / {print $2; exit}')
    [[ -z "$_ssh_port" ]] && _ssh_port="22"
    if ! _monad_pkg_installed; then
      emit network "net.firewall" INFO "ufw installed but inactive — monad-validator-setup → step_firewall will enable it on install (auto-detects SSH port)"
    else
      emit network "net.firewall" WARN "ufw installed but inactive — no firewall protection" \
           $'Quick fix:   sudo ufw allow '"$_ssh_port"$'/tcp     # SSH (detected — verify before enabling!)\n             sudo ufw allow 8000             # tcp+udp (consensus P2P)\n             sudo ufw allow 8001/udp         # authenticated UDP\n             sudo ufw --force enable\nAuto:        monad-validator-setup → step_firewall auto-detects SSH port and whitelists it.\nVerify:      sudo ufw status verbose\nDANGER:      double-check SSH port BEFORE `ufw enable`. Wrong port → lockout.\nWhy:         a publicly reachable validator without a firewall exposes management/\n             OS services to the open internet. ufw default-deny is a one-line win.'
    fi
  elif require_cmd nft || require_cmd iptables; then
    emit network "net.firewall" INFO "nftables/iptables in use (manual config) — ensure $NET_PORTS_REQUIRED open"
  else
    emit network "net.firewall" WARN "no firewall detected" \
         $'Quick fix:   sudo apt install -y ufw\n             then apply the rules above (or run monad-validator-setup → step_firewall).\nWhy:         see "ufw installed but inactive" above — default-deny is the cheapest hardening.'
  fi
}

# ===== Section: SECURITY =====
check_validator_registration() {
  # "Registered" and "in the active set" are different states, and the difference is the
  # one that decides whether this node signs anything. self_stake_bps is the only metric
  # that separates them: it stays 0 for a registered validator waiting on delegation.
  #
  # created_vote is a false friend here — it increments on nodes with no consensus
  # participation at all, so a node outside the set shows millions of them and looks busy.
  local port=9143 metrics
  if ! require_cmd curl; then
    emit node "validator.registration" SKIP "curl unavailable — registration state NOT checked"
    return
  fi
  metrics=$(curl -s -m 5 "http://127.0.0.1:${port}/metrics" 2>/dev/null) || true
  if [[ -z "$metrics" ]]; then
    emit node "validator.registration" SKIP "node metrics on :${port} unreachable — registration state NOT checked"
    return
  fi

  local bps
  bps=$(printf '%s' "$metrics" | grep -m1 -E '^monad_state_node_state_self_stake_bps' \
        | sed 's/{[^}]*}//' | awk '{print $2}')

  if [[ -z "$bps" ]]; then
    # Absent is not zero: a full-node never publishes this series, and so does a client
    # too old to expose it. Either way we did not measure, so we do not claim.
    emit node "validator.registration" SKIP \
      "self_stake_bps not published — full-node, or a client that predates the metric" \
      $'Note:        this is not "unregistered"; the series is simply absent here.\nCheck:       curl -s localhost:9143/metrics | grep self_stake_bps'
    return
  fi

  if [[ "$bps" == "0" || "$bps" == "0.0" ]]; then
    emit node "validator.registration" INFO \
      "registered but NOT in the active set (self_stake_bps = 0) — this node signs nothing yet" \
      $'Why:         registration alone does not admit a validator; the set is ranked by stake\n             and entry needs total delegation above the active-set threshold.\nCheck:       cast call 0x...1000 (staking precompile) or the explorer for your id.\nNote:        a restart is free while this reads 0 — no blocks are missed.'
    return
  fi

  emit node "validator.registration" PASS "in the active set (self_stake_bps = ${bps})"
}

check_metrics_exposure() {
  # The Foundation asks operators to keep the client's metrics port off the public internet
  # ("block 9143/tcp from outside", applies to every node type on both networks). The endpoint
  # is unauthenticated and names the node: `secp_key`, `service_name`, peer counts and stake all
  # come out of it, so an open port hands an observer a live map of who you are and how you are
  # doing. Local readers are unaffected — ufw accepts loopback before any rule is consulted.
  local port=9143
  if ! ss -tlnH 2>/dev/null | awk '{print $4}' | grep -qE ":${port}\$"; then
    emit security "metrics.exposure" PASS "metrics port ${port} is not listening"
    return
  fi
  local bound_public=0
  ss -tlnH 2>/dev/null | awk '{print $4}' \
    | grep -qE "(^|[^0-9])(0\.0\.0\.0|\[::\]|\*):${port}\$" && bound_public=1

  if ! require_cmd ufw || ! ufw status >/dev/null 2>&1; then
    # Cannot read the firewall: that is "not verified", not "fine". Saying PASS here is how an
    # exposed port gets a green tick.
    emit security "metrics.exposure" SKIP "ufw unavailable — metrics exposure NOT verified" \
         $'Action:      ss -tlnp | grep :9143 ; check your firewall manually'
    return
  fi
  local ufw_status
  ufw_status=$(ufw status 2>/dev/null)
  if ! grep -qiE '^Status:[[:space:]]*active' <<<"$ufw_status"; then
    if (( bound_public )); then
      emit security "metrics.exposure" FAIL "ufw INACTIVE and metrics port ${port} bound to 0.0.0.0 — reachable from the internet" \
           $'Quick fix:   sudo ufw deny 9143/tcp\n             sudo ufw enable   # after allowing your SSH port!\nVerify:      from another host: nc -z -w3 <YOUR-IP> 9143   # must fail\nWhy:         Foundation guidance; the endpoint is unauthenticated and publishes secp_key.'
    else
      emit security "metrics.exposure" WARN "ufw is INACTIVE — metrics port ${port} judged from its listen address only" \
           $'Quick fix:   sudo ufw enable   # after allowing your SSH port!\nWhy:         without a firewall nothing stops a later rebind from exposing it.'
    fi
    return
  fi
  # An explicit DENY is what the Foundation asks for. A rule limited to specific source IPs is
  # also acceptable — that is a scraper you run, not the public internet.
  if awk -v p="$port" '$0 ~ "^"p".*DENY"' <<<"$ufw_status" | grep -q .; then
    emit security "metrics.exposure" PASS "metrics port ${port} explicitly denied in ufw"
  elif awk -v p="$port" '$0 ~ "^"p".*ALLOW.*Anywhere"' <<<"$ufw_status" | grep -q .; then
    emit security "metrics.exposure" FAIL "metrics port ${port} publicly ALLOWed in ufw — Foundation asks for it to be blocked" \
         $'Quick fix:   sudo ufw delete allow 9143/tcp ; sudo ufw deny 9143/tcp\n             # keep a scraper? allow only its address instead:\n             sudo ufw allow from <SCRAPER-IP> to any port 9143\nVerify:      sudo ufw status numbered | grep 9143\nWhy:         the endpoint is unauthenticated and publishes secp_key, peers and stake.'
  elif awk -v p="$port" '$0 ~ "^"p".*ALLOW"' <<<"$ufw_status" | grep -q .; then
    # Reached only when no ALLOW was to Anywhere, so every allow rule names a source. That is a
    # scraper the operator runs, not the public internet — the same latitude check_rpc_exposure
    # gives 8080. Saying "no rule" here would have described the state wrongly.
    emit security "metrics.exposure" PASS "metrics port ${port} allowed only from specific sources, not Anywhere"
  elif (( bound_public )); then
    # Default-deny already covers it, but the Foundation asked for an explicit rule and an
    # explicit rule survives someone widening the default policy later.
    emit security "metrics.exposure" WARN "metrics port ${port} listens on 0.0.0.0 and has no ufw rule — covered by default-deny only" \
         $'Quick fix:   sudo ufw deny 9143/tcp\nVerify:      from another host: nc -z -w3 <YOUR-IP> 9143   # must fail\nWhy:         Foundation asks for an explicit block; a default policy is one command from changing.'
  else
    emit security "metrics.exposure" PASS "metrics port ${port} bound to loopback only"
  fi
}

check_rpc_exposure() {
  # Per docs.monad.xyz/node-ops/validator-delegation-program:
  #   "Not use a validator node to service external RPCs (Axelar, Wormhole, etc.)"
  # If RPC ports (8080/8081) are publicly open in UFW → operator violates VDP.
  if ! require_cmd ufw || ! ufw status >/dev/null 2>&1; then
    emit security "rpc.exposure" SKIP "ufw unavailable — RPC exposure NOT verified" \
         $'Action:      ss -tlnp | grep -E ":(8080|8081)" ; check your firewall manually'
    return
  fi
  local ufw_status flagged=()
  ufw_status=$(ufw status 2>/dev/null)
  # `ufw status` exits 0 even when the firewall is INACTIVE. The rule scan below then finds no
  # "ALLOW … Anywhere" lines and used to conclude PASS "no RPC ports publicly exposed" — while
  # RPC on 0.0.0.0:8080 was in fact open to the whole internet. With no firewall the only
  # meaningful evidence is the listen address, so check that instead of ufw rules.
  if ! grep -qiE '^Status:[[:space:]]*active' <<<"$ufw_status"; then
    local listening=()
    for rpc_port in 8080 8081; do
      if ss -tlnH 2>/dev/null | awk '{print $4}' \
           | grep -qE "(^|[^0-9])(0\.0\.0\.0|\[::\]|\*):${rpc_port}\$"; then
        listening+=("$rpc_port")
      fi
    done
    if (( ${#listening[@]} > 0 )); then
      emit security "rpc.exposure" FAIL "ufw INACTIVE and RPC port(s) ${listening[*]} bound to 0.0.0.0 — reachable from the internet" \
           $'Quick fix:   sudo ufw enable   # after allowing your SSH port!\n             sudo ufw allow from <TRUSTED-IP> to any port 8080\nVerify:      sudo ufw status verbose ; ss -tlnp | grep -E ":(8080|8081)"\nWhy:         VDP forbids serving external RPC from a validator node, and an open RPC is\n             an abuse vector regardless of VDP.'
    else
      emit security "rpc.exposure" WARN "ufw is INACTIVE — exposure judged from listen addresses only (RPC not bound to 0.0.0.0)" \
           $'Quick fix:   sudo ufw enable   # after allowing your SSH port!\nWhy:         without a firewall nothing prevents a future service from binding publicly.'
    fi
    return
  fi
  for rpc_port in 8080 8081; do
    # Anywhere = publicly exposed; we accept rules limited to specific source IPs
    if echo "$ufw_status" \
        | awk -v port="$rpc_port" '$0 ~ "^"port".*ALLOW.*Anywhere"' \
        | grep -q .; then
      flagged+=("$rpc_port")
    fi
  done
  if (( ${#flagged[@]} > 0 )); then
    emit security "rpc.exposure" FAIL "RPC port(s) ${flagged[*]} publicly exposed — VDP forbids 'external RPC servicing on validator nodes'" \
         $'Quick fix:   for p in '"${flagged[*]}"$'; do sudo ufw delete allow $p; done\n             # then allow only trusted internal sources:\n             sudo ufw allow from <YOUR-RPC-PROXY-IP> to any port '"${flagged[0]}"$'\nVerify:      sudo ufw status numbered | grep -E "808[01]"\nWhy:         VDP eligibility (docs/validator-delegation-program) bans serving external\n             RPC traffic from a validator node — Foundation can exclude you for this.'
  else
    emit security "rpc.exposure" PASS "no RPC ports (8080/8081) publicly exposed"
  fi
}

check_iptables_udp_filter() {
  # Per docs.monad.xyz/node-ops/full-node-installation:
  #   "Additional iptables rule for robustness:
  #    sudo iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP"
  if ! command -v iptables >/dev/null; then
    emit security "iptables.udp-filter" INFO "iptables not installed — skipping check"
    return
  fi
  # Rule may live in either INPUT (classic netfilter-persistent setup) or
  # ufw-before-input (when UFW manages persistence via /etc/ufw/before.rules).
  if iptables -C INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP 2>/dev/null \
     || iptables -C ufw-before-input -p udp --dport 8000 -m length --length 0:1400 -j DROP 2>/dev/null; then
    emit security "iptables.udp-filter" PASS "UDP length filter on :8000 active (per docs)"
  elif ! _monad_pkg_installed; then
    # Pre-install: monad-validator-setup → step_iptables_ddos applies this rule.
    # Until then, nothing is listening on :8000, so the filter would be no-op anyway.
    emit security "iptables.udp-filter" INFO "no UDP length filter on :8000 yet — monad-validator-setup will add it (step_iptables_ddos)"
    return
  else
    emit security "iptables.udp-filter" WARN "no UDP length 0:1400 DROP rule on :8000 — robustness against UDP DDoS missing" \
         $'Quick fix:   sudo iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP\n             # then persist: sudo netfilter-persistent save\n             # OR (if UFW replaced iptables-persistent): add to /etc/ufw/before.rules\nAuto:        monad-validator-setup → step_iptables_ddos applies + persists this rule.\n             Auto-detects whether netfilter-persistent or UFW before.rules is the\n             right persistence path (ufw + iptables-persistent Conflict on Ubuntu 24.04).\nVerify:      sudo iptables -L INPUT -nv -L ufw-before-input -nv 2>/dev/null | grep "dpt:8000"\nWhy:         valid raptorcast UDP datagrams exceed 1400 bytes; small UDP packets on\n             :8000 are spoofed amplification / probing traffic. Docs recommend this rule.'
  fi
}

check_cve_2026_31431() {
  # Per Foundation Discord 2026-04-30 (ACTION RECOMMENDED): the algif_aead
  # kernel module has an LPE. Mitigation = blacklist OR don't have it loaded.
  # If the module isn't loaded right now, the server is not vulnerable —
  # we don't WARN, we just inform. WARN only when it's actively loaded.
  # "Not loaded" is NOT "not vulnerable": algif_aead is auto-loaded on demand — an
  # unprivileged socket(AF_ALG) + bind with an aead type triggers request_module(). That is
  # precisely why the only real mitigation is a blacklist. The old logic emitted PASS whenever
  # lsmod came up empty, i.e. handed a clean bill of health to an unmitigated host.
  local blacklisted=0
  if grep -rqsE '^[[:space:]]*(blacklist|install)[[:space:]]+algif_aead' /etc/modprobe.d/ 2>/dev/null; then
    blacklisted=1
  fi
  if lsmod 2>/dev/null | grep -q '^algif_aead'; then
    if (( blacklisted )); then
      emit security "cve.2026-31431" WARN "algif_aead is blacklisted but STILL LOADED — unload it or reboot" \
           $'Quick fix:   sudo rmmod algif_aead   # or reboot\nVerify:      lsmod | grep algif_aead   # empty\nWhy:         the blacklist only prevents future autoloads; the running module is exploitable now.'
    else
      emit security "cve.2026-31431" FAIL "algif_aead loaded and NOT blacklisted — CVE-2026-31431 (LPE) exploitable right now" \
           $'Quick fix:   echo \'blacklist algif_aead\' | sudo tee /etc/modprobe.d/blacklist-algif_aead.conf\n             sudo rmmod algif_aead\nVerify:      lsmod | grep algif_aead ; grep -r algif_aead /etc/modprobe.d/\nWhy:         module is loaded AND autoload is unrestricted.'
    fi
  elif (( blacklisted )); then
    emit security "cve.2026-31431" PASS "algif_aead blacklisted in /etc/modprobe.d (autoload blocked)"
  else
    emit security "cve.2026-31431" WARN "algif_aead not loaded, but NOT blacklisted — it autoloads on demand, so the host is still exposed" \
         $'Quick fix:   echo \'blacklist algif_aead\' | sudo tee /etc/modprobe.d/blacklist-algif_aead.conf\nVerify:      grep -r algif_aead /etc/modprobe.d/\nWhy:         any local process can trigger the autoload with socket(AF_ALG); "not currently\n             loaded" is not a mitigation.'
  fi
}

check_nvme_cli() {
  # Required for /dev/triedb LBA reformat (`nvme format` command).
  if command -v nvme >/dev/null; then
    emit security "deps.nvme-cli" PASS "nvme-cli installed"
  else
    emit security "deps.nvme-cli" WARN "nvme-cli not installed — needed for LBA reformat command" \
         $'Quick fix:   sudo apt install -y nvme-cli\nAuto:        monad-validator-setup installs nvme-cli in step_dependencies.\nWhy:         needed for `nvme format ... --lbaf=0` to satisfy the 512-byte LBA requirement.'
  fi
}

check_ssh_hardening() {
  # Use `sshd -T` to query the effective config — this is the only authoritative
  # source on modern Ubuntu (22.04+) where /etc/ssh/sshd_config includes
  # /etc/ssh/sshd_config.d/*.conf via "Include" at the top. Grepping the main
  # file alone misses every drop-in override and reports stale defaults from
  # the commented-out lines like "#PasswordAuthentication yes". Output keys
  # from sshd -T are lowercase.
  local effective
  effective=$(sshd -T 2>/dev/null) || effective=""

  if [[ -z "$effective" ]]; then
    # Fallback: parse main file directly. Only happens if sshd isn't installed
    # or current user lacks privilege to read host keys (rare on a node host).
    local sshd=/etc/ssh/sshd_config
    [[ -r "$sshd" ]] || { emit security "ssh.config" INFO "sshd not queryable and sshd_config not readable (skipped)"; return; }
    effective=$(grep -E '^[[:space:]]*(PasswordAuthentication|PermitRootLogin)[[:space:]]' "$sshd" 2>/dev/null \
                | awk '{print tolower($1), $2}')
  fi

  # PasswordAuthentication
  local pwauth
  pwauth=$(awk '/^passwordauthentication / {print $2; exit}' <<<"$effective")
  pwauth=${pwauth:-yes}  # sshd default when unset
  case "$pwauth" in
    no|No|NO)  emit security "ssh.passwordauth" PASS "PasswordAuthentication=no (effective via sshd -T)" ;;
    *)         emit security "ssh.passwordauth" WARN "PasswordAuthentication=$pwauth — bruteforce risk" \
                  $'Quick fix:   echo \'PasswordAuthentication no\' | sudo tee /etc/ssh/sshd_config.d/99-no-password.conf\n             sudo systemctl reload ssh\nDANGER:      ensure your SSH key is already in ~/.ssh/authorized_keys BEFORE reload,\n             or you will lock yourself out (no console fallback on some hosts).\nVerify:      sshd -T | grep -i passwordauthentication   # no\nWhy:         password auth is the primary bruteforce surface on a 22/tcp validator.' ;;
  esac

  # PermitRootLogin — but if PasswordAuth is already off, key-only root login
  # has the same effective security as 'prohibit-password'.
  local rootlogin
  rootlogin=$(awk '/^permitrootlogin / {print $2; exit}' <<<"$effective")
  rootlogin=${rootlogin:-prohibit-password}
  case "$rootlogin" in
    no|No|NO|prohibit-password|without-password)
      # "without-password" is the legacy synonym for "prohibit-password" still
      # emitted by sshd -T on some Ubuntu versions; both forbid password auth
      # for root.
      emit security "ssh.rootlogin" PASS "PermitRootLogin=$rootlogin (effective via sshd -T)" ;;
    yes|Yes|YES)
      if [[ "$pwauth" == "no" || "$pwauth" == "No" || "$pwauth" == "NO" ]]; then
        emit security "ssh.rootlogin" INFO "PermitRootLogin=yes — but PasswordAuth=no, so effectively key-only" \
             "Optional tightening: set 'PermitRootLogin prohibit-password' in /etc/ssh/sshd_config.d/*.conf"
      else
        emit security "ssh.rootlogin" WARN "PermitRootLogin=yes with password auth — risky" \
             $'Quick fix:   echo \'PermitRootLogin prohibit-password\' | sudo tee /etc/ssh/sshd_config.d/98-root-keys-only.conf\n             sudo systemctl reload ssh\nDANGER:      ensure root\'s authorized_keys is set BEFORE reload.\nWhy:         allows password bruteforce directly against root — historically the\n             #1 vector for compromised validators.'
      fi ;;
    *)
      emit security "ssh.rootlogin" INFO "PermitRootLogin=$rootlogin (effective via sshd -T)" ;;
  esac
}

check_unattended_upgrades() {
  # Goal: keep security patches flowing, but prevent automatic reboots
  # mid-epoch. Disabling unattended-upgrades entirely is dangerous (CVE
  # exposure). Instead check for Automatic-Reboot=false setting.
  if ! dpkg -l unattended-upgrades 2>/dev/null | grep -qE '^.i  unattended-upgrades'; then
    emit security "auto-upgrades" INFO "unattended-upgrades not installed — security patches not auto-applied" \
         "Recommended: apt install -y unattended-upgrades and configure Automatic-Reboot=false"
    return
  fi
  if [[ -f /etc/apt/apt.conf.d/20auto-upgrades ]] \
     && grep -q '^APT::Periodic::Unattended-Upgrade "1"' /etc/apt/apt.conf.d/20auto-upgrades 2>/dev/null; then
    # Check whether automatic reboot is disabled
    if grep -rqE '^[[:space:]]*Unattended-Upgrade::Automatic-Reboot[[:space:]]+"?false"?' /etc/apt/apt.conf.d/ 2>/dev/null; then
      emit security "auto-upgrades" PASS "unattended-upgrades active, Automatic-Reboot=false (safe for validator)"
    else
      if ! _monad_pkg_installed; then
        emit security "auto-upgrades" INFO "unattended-upgrades active with auto-reboot — monad-validator-setup → step_cve_mitigation will disable auto-reboot on install"
      else
        emit security "auto-upgrades" WARN "unattended-upgrades active but may auto-reboot mid-epoch" \
             $'Quick fix:   echo \'Unattended-Upgrade::Automatic-Reboot "false";\' | \\\n               sudo tee /etc/apt/apt.conf.d/52monad-no-reboot\nVerify:      apt-config dump | grep -i Automatic-Reboot   # "false"\nWhy:         unattended-upgrades CAN trigger reboot during a kernel update — if it lands\n             mid-epoch your validator is jailed. Keep patches flowing, disable reboot.'
      fi
    fi
  else
    emit security "auto-upgrades" INFO "unattended-upgrades installed but disabled — security patches not auto-applied"
  fi
}

check_fail2ban() {
  if systemctl is-active --quiet fail2ban 2>/dev/null; then
    emit security "fail2ban"     PASS "fail2ban active"
  else
    emit security "fail2ban"     INFO "fail2ban not active — recommended for SSH bruteforce protection" \
         "apt install -y fail2ban && systemctl enable --now fail2ban"
  fi
}

# ===== Section: MONAD-SPECIFIC (if already installed) =====
check_monad_user() {
  if id monad >/dev/null 2>&1; then
    emit monad "monad.user"      PASS "monad system user exists ($(id -u monad):$(id -g monad))"
  else
    emit monad "monad.user"      INFO "monad user not present (created automatically by package install)"
  fi
}

check_triedb_device() {
  # Docs require /dev/triedb to be a symlink to a dedicated NVMe partition (e.g. nvme1n1p1).
  # Created by /etc/monad-mpt/monad_mpt.toml and the monad-mpt one-shot service.
  if [[ -e /dev/triedb ]]; then
    if [[ -L /dev/triedb ]]; then
      local tgt
      tgt=$(readlink -f /dev/triedb)
      emit monad "monad.triedb"  PASS "/dev/triedb → ${tgt}"
    else
      emit monad "monad.triedb"  WARN "/dev/triedb exists but is not a symlink"
    fi
  else
    emit monad "monad.triedb"    INFO "/dev/triedb not present (created on first monad-mpt run)"
  fi
}

check_triedb_udev() {
  # Docs require a udev rule mapping the triedb partition's PARTUUID to the
  # /dev/triedb symlink so it survives reboot regardless of disk enumeration.
  # https://docs.monad.xyz/node-ops/full-node-installation (TrieDB section)
  # Accept a rule under any filename in /etc/udev/rules.d — pinning the name to 99-triedb.rules
  # produced a false WARN for an equivalent rule written as e.g. 70-triedb.rules.
  local rule=/etc/udev/rules.d/99-triedb.rules
  if [[ ! -f "$rule" ]]; then
    local alt
    alt=$(grep -rlE 'SYMLINK\+="?triedb"?' /etc/udev/rules.d/ 2>/dev/null | head -1)
    [[ -n "$alt" ]] && rule="$alt"
  fi
  if [[ -f "$rule" ]]; then
    if grep -qE 'SYMLINK\+="?triedb"?' "$rule" 2>/dev/null; then
      # Presence of the rule is not enough: it must point at the partition that IS triedb.
      # After replacing the NVMe or re-creating the partition (which this very tool recommends
      # via `nvme format`), the PARTUUID changes and the stale rule silently stops producing
      # /dev/triedb on the next boot — while the old check happily reported PASS.
      local rule_uuid live_uuid
      rule_uuid=$(grep -oE 'ID_PART_ENTRY_UUID\}?=="?[0-9a-fA-F-]+' "$rule" 2>/dev/null \
                  | head -1 | grep -oE '[0-9a-fA-F-]{8,}')
      live_uuid=""
      if [[ -L /dev/triedb || -b /dev/triedb ]]; then
        live_uuid=$(blkid -s PARTUUID -o value "$(readlink -f /dev/triedb)" 2>/dev/null)
      fi
      if [[ -z "$rule_uuid" ]]; then
        emit monad "monad.triedb-udev" SKIP "$rule has SYMLINK+=\"triedb\" but no ID_PART_ENTRY_UUID — cannot verify it targets the right partition" \
             $'Action:      blkid -s PARTUUID -o value $(readlink -f /dev/triedb)\n             ensure the rule matches that PARTUUID.'
      elif [[ -z "$live_uuid" ]]; then
        emit monad "monad.triedb-udev" SKIP "$rule targets PARTUUID ${rule_uuid} but /dev/triedb is absent — cannot cross-check" \
             $'Why:         with no live device the rule cannot be validated; it may or may not fire on boot.'
      elif [[ "${rule_uuid,,}" == "${live_uuid,,}" ]]; then
        emit monad "monad.triedb-udev" PASS "$rule pins PARTUUID ${live_uuid} → matches the live /dev/triedb"
      else
        emit monad "monad.triedb-udev" FAIL "$rule pins PARTUUID ${rule_uuid}, but /dev/triedb is ${live_uuid} — /dev/triedb will NOT reappear after reboot" \
             $'Quick fix:   sudo sed -i "s/${rule_uuid}/${live_uuid}/" '"$rule"$'\n             sudo udevadm control --reload && sudo udevadm trigger\nVerify:      ls -l /dev/triedb ; and re-check after the next reboot\nWhy:         the rule points at a partition that no longer exists (disk replaced or\n             re-partitioned); the node will fail to start with no triedb device.'
      fi
    else
      emit monad "monad.triedb-udev" WARN "$rule exists but no SYMLINK+=\"triedb\" entry — /dev/triedb may not appear on reboot" \
           $'Action:      Find the triedb partition PARTUUID: blkid -s PARTUUID -o value /dev/<part>\n             Write the rule:\n               ENV{ID_PART_ENTRY_UUID}=="<PARTUUID>", MODE="0666", SYMLINK+="triedb"\n             to /etc/udev/rules.d/99-triedb.rules\n             udevadm control --reload && udevadm trigger\nVerify:      ls -l /dev/triedb   # after reboot too\nWhy:         disk enumeration is not stable across reboots; udev SYMLINK pins\n             /dev/triedb to a specific partition by PARTUUID.'
    fi
  else
    if [[ -L /dev/triedb ]]; then
      emit monad "monad.triedb-udev" WARN "no $rule — /dev/triedb may disappear after reboot if created manually" \
           $'Auto:        monad-validator-setup → step_triedb_symlink writes this rule.\nManual:      see "monad.triedb-udev exists but missing SYMLINK" above.\nWhy:         a manually-created /dev/triedb symlink does not persist across reboots;\n             udev rule by PARTUUID is the only way to make it stable.'
    else
      emit monad "monad.triedb-udev" INFO "$rule not present (created during validator-setup)"
    fi
  fi
}

check_mip8_timeline() {
  # MIP-8 page-storage migration. The node publishes monad_triedb_migration_phase:
  # 0 = legacy/slot, 1 = dual-timeline (Phase A done), 2 = page-encoded (Phase C done).
  #
  # Severity is NOT fixed — it depends on whether a hardfork is scheduled for this network.
  # Legacy/slot was a settled state until MF scheduled MONAD_TEN; from that moment the same
  # phase 0 means the node will refuse to start on the target release and will fall off the
  # chain at the fork. The deadline is read from networks.json, per network, so this stays
  # correct on mainnet (no fork scheduled) and on testnet (scheduled) without a code change.
  if ! require_cmd curl; then
    emit monad "monad.mip8-timeline" INFO "curl not installed — cannot read migration phase"
    return
  fi
  # 0.16.0 exposes metrics on 9143 by default; earlier builds used the OTel scrape port 8889.
  local payload="" port=""
  for port in 9143 8889; do
    payload=$(curl -sf --max-time 5 "http://localhost:${port}/metrics" 2>/dev/null) && [[ -n "$payload" ]] && break
    payload=""
  done
  if [[ -z "$payload" ]]; then
    emit monad "monad.mip8-timeline" INFO "metrics endpoint (:9143, :8889) unreachable — MIP-8 phase NOT determined"
    return
  fi
  local phase
  # NOT $NF: the OTel Prometheus exposition appends a millisecond timestamp, so the last field
  # is the clock, not the value —
  #   monad_triedb_migration_phase{...} 0 1785475911990
  # Strip the label block, then take the first remaining token.
  phase=$(printf '%s\n' "$payload" \
          | awk '/^monad_triedb_migration_phase/ {sub(/^[^ ]*[}] */,""); sub(/^monad_triedb_migration_phase */,""); print $1; exit}')
  if [[ -z "$phase" ]]; then
    # Absence is its own answer, and not the same as "phase 0": older node builds do not
    # publish this series at all.
    emit monad "monad.mip8-timeline" SKIP "monad_triedb_migration_phase not published by this node build — phase NOT verified"
    return
  fi
  phase="${phase%%.*}"

  # Is a fork scheduled for THIS network? null / absent means no.
  local network fork_ts="" now left="" deadline=""
  network=$(detect_network)
  if [[ -n "$network" ]]; then
    fork_ts=$(curl -fsS -m 5 -H 'User-Agent: BeeHive/monad-tools' \
      https://docs.monad.xyz/networks.json 2>/dev/null | tr -d ' \n' \
      | grep -oE "\"${network}\":\{[^}]*\"mip8\":\{\"hardfork_timestamp\":[0-9]+" \
      | grep -oE '[0-9]+$')
  fi
  if [[ -n "$fork_ts" ]]; then
    now=$(date -u +%s)
    left=$(( (fork_ts - now) / 86400 ))
    deadline=$(date -u -d "@${fork_ts}" '+%Y-%m-%d %H:%M UTC' 2>/dev/null || printf 'timestamp %s' "$fork_ts")
  fi

  case "$phase" in
    0)
      if [[ -n "$fork_ts" ]]; then
        emit monad "monad.mip8-timeline" FAIL \
             "legacy/slot storage, but MONAD_TEN is scheduled for ${network} at ${deadline} (~${left}d) — Phase A NOT done" \
             $'Why:         the release that activates the fork refuses to start without a page\n             timeline, and a node still on slot encoding stops following the chain\n             at the fork. This is not a warning about the future: an upgrade attempted\n             before Phase A aborts at startup.\nQuick fix:   run Phase A (dual-db activation) BEFORE upgrading:\n             https://docs.monad.xyz/node-ops/upgrade-instructions/page-storage-mip-8-migration\nVerify:      monad-mpt --storage /dev/triedb   # expect Primary ethereum AND Secondary monad\nValidators:  migrate only when your cohort is announced.'
      else
        emit monad "monad.mip8-timeline" PASS "legacy/slot storage; no MONAD_TEN fork scheduled for ${network:-this network} yet"
      fi
      ;;
    1)
      emit monad "monad.mip8-timeline" PASS \
           "dual-timeline — Phase A done${fork_ts:+, fork ${deadline} (~${left}d)}" \
           $'Note:        this is the STEADY STATE between Phase A and the fork, not a migration\n             in flight. Both encodings are written, so triedb is larger and writes are\n             heavier than they will be after Phase C. Watch headroom, not elapsed time.\nVerify:      curl -s localhost:9143/metrics | grep monad_triedb_migration_phase'
      ;;
    2) emit monad "monad.mip8-timeline" PASS "page-encoded storage (MIP-8 migration complete)" ;;
    *) emit monad "monad.mip8-timeline" SKIP "unrecognised migration phase value '$phase' — phase NOT verified" ;;
  esac
}

check_statesync_threshold() {
  # statesync_threshold is how far behind the node must fall before it gives up on blocksync
  # and statesyncs instead. The default is 600.
  #
  # Raising it is a known operator workaround for a period when statesync serving was broken
  # network-wide — and it is a trap once that period ends. On 2026-08-07 this node came back
  # from a 4-minute maintenance window ~4000 blocks behind, with the threshold left at 65000:
  # below the threshold the node refuses to statesync, and blocksync got no headers from its
  # group, so it sat still and fell further behind until consensus could no longer reconcile
  # ("high qc too far ahead of block tree root"). Recovery then required a full hard reset.
  # A stale high threshold turns a two-minute catch-up into an hour of downtime.
  if [[ ! -r "$MONAD_NODE_TOML" ]]; then
    emit monad "monad.statesync-threshold" INFO "node.toml not readable at $MONAD_NODE_TOML (skipped)"
    return
  fi
  local val
  val=$(awk -F= '/^[[:space:]]*statesync_threshold[[:space:]]*=/ {gsub(/[^0-9]/,"",$2); print $2; exit}' "$MONAD_NODE_TOML")
  if [[ -z "$val" ]]; then
    emit monad "monad.statesync-threshold" PASS "statesync_threshold not set — node uses the built-in default"
    return
  fi
  if (( val > 2000 )); then
    emit monad "monad.statesync-threshold" WARN \
         "statesync_threshold = ${val} — far above the 600 default; automatic recovery is disabled below that gap" \
         $'Why:         the node only statesyncs once it is MORE than this many blocks behind.\n             Under the threshold it must blocksync, and if peers do not serve the\n             range it stays stuck and keeps falling behind instead of recovering.\nQuick fix:   set statesync_threshold = 600 in node.toml, then restart monad-bft\nWhy it is here: a value raised during a network-wide statesync outage is easy to\n             leave behind. Re-check it whenever the reason for raising it has passed.'
  else
    emit monad "monad.statesync-threshold" PASS "statesync_threshold = ${val} (at or near the 600 default)"
  fi
}

check_needrestart() {
  # unattended-upgrades and needrestart are DIFFERENT mechanisms, and checking only the first
  # gives a host a clean bill of health while the second restarts the node underneath it.
  # Observed 2026-08-01 on our own machine: an openssl security update (libssl3t64) had
  # needrestart restart monad-bft, monad-rpc, sshd and fail2ban at 06:14 UTC. No reboot, no
  # human, no warning — Automatic-Reboot=false was true the whole time and says nothing about
  # this. On a validator that is missed proposal slots.
  if ! dpkg -l needrestart 2>/dev/null | grep -qE '^.i  needrestart'; then
    emit security "needrestart" INFO "needrestart not installed — library upgrades will not auto-restart services"
    return
  fi
  local mode
  mode=$(grep -hoE "^[[:space:]]*\\\$nrconf\{restart\}[[:space:]]*=[[:space:]]*'[lia]'" \
         /etc/needrestart/needrestart.conf /etc/needrestart/conf.d/*.conf 2>/dev/null \
         | grep -oE "'[lia]'" | tr -d "'" | tail -1)
  # Unset means automatic under a non-interactive frontend, which is exactly how
  # unattended-upgrades invokes it.
  [[ -z "$mode" ]] && mode="a (default — unset)"
  # Смотреть на ДИРЕКТИВЫ, а не на текст файла. Первая версия грепала файл целиком, поэтому
  # комментарий «когда-нибудь заблокируем monad-bft» засчитывался как настроенное исключение.
  # Учитываем обе формы: `$nrconf{blacklist_rc} = [ ... ]` и `push @{$nrconf{blacklist_rc}}, ...`.
  local blacklisted=0
  if sed -e 's/#.*$//' /etc/needrestart/needrestart.conf /etc/needrestart/conf.d/*.conf 2>/dev/null \
     | grep -qE 'blacklist_rc.*monad'; then
    blacklisted=1
  fi
  if [[ "$mode" == l* ]]; then
    emit security "needrestart" PASS "needrestart in list-only mode — will not restart services by itself"
  elif (( blacklisted )); then
    emit security "needrestart" PASS "needrestart may restart services, but monad units are blacklisted"
  else
    emit security "needrestart" WARN "needrestart mode '${mode}' and monad units NOT blacklisted — a library upgrade will restart the node" \
         $'Quick fix:   printf \'%s\\n\' "\\$nrconf{blacklist_rc} = [ qr(^monad-) ];" \\\n               | sudo tee /etc/needrestart/conf.d/99-monad.conf\nAlternative: echo "\\$nrconf{restart} = \'l\';" | sudo tee /etc/needrestart/conf.d/99-list-only.conf\n             (list only — you then restart on your own schedule)\nVerify:      sudo needrestart -b   # NEEDRESTART-SVC lines are what would be restarted\nWhy:         Automatic-Reboot=false does NOT cover this. needrestart restarts daemons\n             linked against an upgraded library — openssl, libc — with no reboot and no\n             prompt. On a validator that is dropped proposal slots, mid-epoch, unattended.'
  fi
}

check_cruft_timer() {
  # monad-cruft.timer is a stock hourly cleanup unit shipped by the monad
  # package (drops old artifacts so disk doesn't fill). Docs list it among
  # required services. systemctl returns non-zero if unit is missing/disabled.
  if systemctl cat monad-cruft.timer >/dev/null 2>&1; then
    if systemctl is-enabled --quiet monad-cruft.timer 2>/dev/null; then
      emit monad "monad.cruft-timer" PASS "monad-cruft.timer enabled (hourly artifact cleanup)"
    else
      emit monad "monad.cruft-timer" WARN "monad-cruft.timer present but not enabled — old artifacts will accumulate" \
           $'Quick fix:   sudo systemctl enable --now monad-cruft.timer\nAuto:        monad-validator-setup → step_cruft_timer does exactly this.\nVerify:      systemctl list-timers monad-cruft.timer\nWhy:         old WAL/triedb artifacts otherwise grow unbounded and eventually fill /.'
    fi
  else
    emit monad "monad.cruft-timer" INFO "monad-cruft.timer not installed (ships with monad package)"
  fi
}

check_authudp_config() {
  # Verify Auth UDP keys in correct TOML sections per docs.
  # https://docs.monad.xyz/node-ops/upgrade-instructions/auth-udp
  #   [peer_discovery] → self_auth_port, self_record_seq_num, self_name_record_sig
  #   [network]        → authenticated_bind_address_port
  if [[ ! -r "$MONAD_NODE_TOML" ]]; then
    emit monad "monad.authudp-cfg" INFO "node.toml not readable at $MONAD_NODE_TOML (skipped)"
    return
  fi

  # Helper: check if KEY appears under [SECTION] in $MONAD_NODE_TOML.
  # Uses awk to track current section header [..] and matches key only inside.
  toml_has_key_in_section() {
    local section="$1" key="$2"
    awk -v sec="[$section]" -v key="$key" '
      /^[[:space:]]*\[/ { current=$0; sub(/^[[:space:]]+/,"",current); sub(/[[:space:]]+$/,"",current) }
      $0 ~ "^[[:space:]]*"key"[[:space:]]*=" { if (current==sec) {found=1; exit} }
      END { exit !found }
    ' "$MONAD_NODE_TOML"
  }

  # Read the VALUE of KEY under [SECTION], empty string if absent.
  toml_value_in_section() {
    local section="$1" key="$2"
    awk -v sec="[$section]" -v key="$key" '
      /^[[:space:]]*\[/ { current=$0; sub(/^[[:space:]]+/,"",current); sub(/[[:space:]]+$/,"",current) }
      $0 ~ "^[[:space:]]*"key"[[:space:]]*=" {
        if (current==sec) {
          v=$0; sub(/^[^=]*=[[:space:]]*/,"",v); gsub(/^"|"$/,"",v);
          sub(/[[:space:]]*#.*$/,"",v); gsub(/[[:space:]]+$/,"",v);
          print v; exit
        }
      }
    ' "$MONAD_NODE_TOML"
  }

  local missing="" empty=""
  for key in self_auth_port self_record_seq_num self_name_record_sig; do
    if ! toml_has_key_in_section peer_discovery "$key"; then
      missing+="[peer_discovery].$key "
    else
      # Presence was the ONLY test, so a node.toml carrying the shipped placeholder — or an
      # empty signature — reported "all Auth UDP keys in correct sections". That is precisely
      # the node that will be rejected by the authenticated mesh, told it is configured.
      local v; v=$(toml_value_in_section peer_discovery "$key")
      if [[ -z "$v" || "$v" == "0" || "$v" =~ [\<\>] || "$v" == "PLACEHOLDER" || "$v" == "REPLACE_ME" ]]; then
        empty+="[peer_discovery].$key=${v:-<empty>} "
      fi
    fi
  done
  if ! toml_has_key_in_section network authenticated_bind_address_port; then
    missing+="[network].authenticated_bind_address_port "
  else
    local vp; vp=$(toml_value_in_section network authenticated_bind_address_port)
    [[ -z "$vp" || "$vp" == "0" ]] && empty+="[network].authenticated_bind_address_port=${vp:-<empty>} "
  fi

  if [[ -n "$empty" ]]; then
    emit monad "monad.authudp-cfg" FAIL "Auth UDP keys present but unset/placeholder: $empty" \
         $'Action:      Fill the real values — a key that exists with an empty or <placeholder>\n             value is not configuration, and peers will reject the node all the same.\nGenerate sig: sudo -u monad monad-sign-name-record ...   # see docs for the exact CLI\nDocs:        https://docs.monad.xyz/node-ops/upgrade-instructions/auth-udp'
  elif [[ -z "$missing" ]]; then
    emit monad "monad.authudp-cfg" PASS "node.toml has all Auth UDP keys, with non-placeholder values"
  else
    emit monad "monad.authudp-cfg" FAIL "node.toml missing Auth UDP keys: $missing" \
         $'Action:      Edit '"$MONAD_NODE_TOML"$' and add the missing keys:\n               [peer_discovery]\n               self_auth_port = 8001\n               self_record_seq_num = 1\n               self_name_record_sig = "<run monad-sign-name-record>"\n               [network]\n               authenticated_bind_address_port = 8001\nGenerate sig: sudo -u monad monad-sign-name-record --help   # see docs for exact CLI\nDocs:        https://docs.monad.xyz/node-ops/upgrade-instructions/auth-udp\nWhy:         Auth UDP is mandatory ≥ v0.12.6; without these keys the node will not\n             join the authenticated mesh and peers will reject it.'
  fi
}

# Which network is this node on? Needed because since 0.15.x testnet and mainnet
# deliberately run DIFFERENT monad versions, so a network-agnostic "latest" check
# gives mainnet operators a false "you are behind" and pushes them onto a version
# MF has not sanctioned for mainnet. Prefer node.toml's network_name; fall back to
# chain_id (testnet 10143 / mainnet 143).
detect_network() {
  local n="" cid=""
  [[ -r "$MONAD_NODE_TOML" ]] || return 0
  n=$(grep -oE '^[[:space:]]*network_name[[:space:]]*=[[:space:]]*"[a-z]+"' "$MONAD_NODE_TOML" 2>/dev/null \
      | grep -oE '"[a-z]+"' | tr -d '"' | head -1)
  if [[ -z "$n" ]]; then
    cid=$(grep -oE '^[[:space:]]*chain_id[[:space:]]*=[[:space:]]*[0-9]+' "$MONAD_NODE_TOML" 2>/dev/null \
          | grep -oE '[0-9]+' | head -1)
    case "$cid" in
      10143) n=testnet ;;
      143)   n=mainnet ;;
    esac
  fi
  printf '%s' "$n"
}

check_github_release() {
  # Cross-check the installed version against MF's target for THIS network.
  # Priority: docs.monad.xyz/networks.json (per-network, machine-readable) →
  # GitHub releases/latest (network-agnostic fallback).
  if ! command -v curl >/dev/null; then return; fi
  local latest="" installed="" network="" net_target="" source=""
  installed=$(dpkg-query -W -f='${Version}' monad 2>/dev/null || true)
  network=$(detect_network)
  if [[ -n "$network" ]]; then
    net_target=$(curl -fsS -m 5 -H 'User-Agent: BeeHive/monad-tools' \
      https://docs.monad.xyz/networks.json 2>/dev/null | tr -d ' \n' \
      | grep -oE "\"${network}\":\{\"monad_version\":\"[0-9]+\.[0-9]+\.[0-9]+[^\"]*\"" \
      | grep -oE '[0-9]+\.[0-9]+\.[0-9]+[^"]*' | head -1)
  fi
  if [[ -n "$net_target" ]]; then
    latest="$net_target"
    source="networks.json target for ${network}"
  else
    latest=$(curl -fsS -m 5 -H 'Accept: application/vnd.github+json' \
      https://api.github.com/repos/category-labs/monad-bft/releases/latest 2>/dev/null \
      | grep -oE '"tag_name":[^,]+' | head -1 \
      | grep -oE 'v[0-9.]+(-[a-z0-9.]+)?' | sed 's/^v//')
    source="GitHub latest stable (network unknown — verify against your network's target)"
  fi
  if [[ -z "$latest" ]]; then
    emit monad "monad.upstream" INFO "networks.json and GitHub API unreachable (offline or rate-limited)"
    return
  fi
  if [[ -z "$installed" ]]; then
    emit monad "monad.upstream" INFO "$source: v$latest (monad not installed yet)"
  elif [[ "$latest" == "$installed" ]]; then
    emit monad "monad.upstream" PASS "matches $source (v$latest)"
  else
    # Distinguish "we're ahead" (e.g. on RC) vs "we're behind"
    if printf '%s\n%s\n' "$latest" "$installed" | sort -V -C 2>/dev/null; then
      emit monad "monad.upstream" INFO "installed v$installed > $source v$latest (RC, pre-release, or network not yet upgraded)"
    else
      emit monad "monad.upstream" WARN "$source is v$latest > installed v$installed" \
           $'Quick fix:   sudo apt-mark unhold monad\n             sudo apt update && sudo apt install --only-upgrade monad\n             sudo apt-mark hold monad   # re-hold to prevent surprise upgrades\nVerify:      dpkg-query -W -f=\'${Version}\\n\' monad\nWhy:         lagging behind stable carries CVE and consensus-bug exposure;\n             release notes often include mandatory upgrades for network compatibility.\nNote:        upgrade during a low-stakes window — monad-bft restarts mid-epoch.'
    fi
  fi
}

check_monad_install() {
  # dpkg -l states: ii=installed, hi=hold+installed, rc=removed-config, etc.
  # Match anything where 2nd char is 'i' (installed).
  if ! dpkg -l monad 2>/dev/null | grep -qE '^.i  monad'; then
    emit monad "monad.installed" INFO "monad package not installed (this is a pre-flight check, OK)"
    return
  fi

  local installed available state
  installed=$(dpkg-query -W -f='${Version}' monad 2>/dev/null || echo "?")
  state=$(dpkg -l monad 2>/dev/null | awk '/^.i  monad/ {print $1; exit}')
  # apt list output: "monad/noble 0.14.3 amd64 [upgradable from: 0.14.2]"
  # Field 2 (after split by space) is the version.
  available=$(apt list --upgradable 2>/dev/null | awk '/^monad\// {print $2}' | head -1)

  if [[ "$state" == "hi" ]]; then
    emit monad "monad.installed" INFO "monad on hold — apt won't auto-upgrade (intentional?)"
  fi

  if [[ -n "$available" && "$available" != "$installed" ]]; then
    # Distinguish stable vs pre-release "available" candidates. Apt's
    # "Candidate" greedily picks the highest version including ~rc/~alpha/
    # ~beta/~dev suffixes. Recommending the operator upgrade FROM a stable
    # release TO an RC is wrong — RCs aren't blessed for production.
    if [[ "$available" =~ ~(rc|alpha|beta|dev|pre) ]]; then
      emit monad "monad.version" INFO "installed=$installed (stable). Apt sees $available — pre-release, ignore unless deliberately tracking RCs." \
           $'Why:         apt-cache greedy candidate picks any higher version including ~rc.X.\n             Stay on stable; rotate forward only when the RC promotes to a tagged release.'
    else
      emit monad "monad.version"   WARN "installed=$installed, available=$available" \
           $'Quick fix:   sudo apt-mark unhold monad   # if on hold\n             sudo apt update && sudo apt install --only-upgrade monad\n             sudo apt-mark hold monad     # re-hold\nVerify:      dpkg-query -W -f=\'${Version}\\n\' monad\nWhy:         apt has a newer STABLE version pinned in your suite (noble); the gap may\n             include consensus-affecting fixes. Don\'t lag.'
    fi
  else
    emit monad "monad.version"   PASS "installed=$installed (latest)"
  fi

  # Auth UDP check — wireauth log entries (DEBUG level, may need broader scan)
  if systemctl is-active --quiet monad-bft 2>/dev/null; then
    # Scan last 500 lines instead of time-based — DEBUG messages may be rotated
    if journalctl -u monad-bft --since "-10min" -n 200000 --no-pager 2>/dev/null | grep -q monad_wireauth; then
      emit monad "monad.authudp" PASS "Auth UDP active (wireauth sessions in logs)"
    else
      emit monad "monad.authudp" WARN "no wireauth log entries — Auth UDP may not be active or DEBUG logs disabled" \
           $'Investigate: journalctl -u monad-bft -n 2000 | grep -E "wireauth|monad_wireauth"\n             # if no matches: confirm node.toml has [peer_discovery] keys (monad.authudp-cfg)\nLog level:   monad-bft default log level may exclude DEBUG; check RUST_LOG / log filter.\nWhy:         no wireauth activity means peer authentication is not negotiating —\n             node may be running but isolated from the authenticated mesh.'
    fi
  fi
}

# ===== Run all checks =====
header() {
  [[ $JSON_OUTPUT -eq 1 ]] && return
  cat <<EOF
${C_BOLD}${C_PURPLE}
  ╔══════════════════════════════════════════════╗
  ║       monad-doctor — pre-flight check        ║
  ║       BeeHive monad-tools                    ║
  ╚══════════════════════════════════════════════╝${C_RESET}
  Hostname: $(hostname)
  Date:     $(date -u +%Y-%m-%dT%H:%M:%SZ)
  $([ $QUICK_MODE -eq 1 ] && echo "Mode:     ${C_YELLOW}quick (--quick)${C_RESET}")
EOF
}

check_authudp_peers() {
  # Runtime visibility into Auth UDP health: count unique peer endpoints that
  # have sent keepalives recently. Complements monad.authudp (which only
  # confirms the receiver is logging) and monad.authudp-cfg (which only
  # confirms node.toml has the right keys).
  #
  # Thresholds chosen from operational experience:
  #   ≥5 peers → healthy mesh
  #   1-4 peers → restart artefact or NAT trouble — investigate
  #   0 peers → Auth UDP not actually negotiating; service may be running
  #             but isolated (firewall, missing self_name_record_sig, etc.)
  if ! command -v journalctl >/dev/null; then
    emit monad "monad.authudp-peers" INFO "journalctl unavailable — cannot count keepalive peers"
    return
  fi
  if ! systemctl is-active --quiet monad-bft 2>/dev/null; then
    emit monad "monad.authudp-peers" INFO "monad-bft not active — skipping peer count"
    return
  fi
  # remote_addr may be IPv4 ("1.2.3.4:port") or IPv6 ("[::1]:port"). Match both.
  local peers
  peers=$(journalctl -u monad-bft --since "-10min" -n 200000 --no-pager 2>/dev/null \
    | grep 'sending keepalive packet' \
    | grep -oE 'remote_addr":"[^"]+' \
    | sort -u | wc -l)
  if (( peers >= 5 )); then
    emit monad "monad.authudp-peers" PASS "$peers unique peers in recent keepalives (healthy mesh)"
  elif (( peers > 0 )); then
    emit monad "monad.authudp-peers" WARN "only $peers peer(s) in keepalives — small set, check NAT/firewall" \
         $'Investigate: journalctl -u monad-bft -n 2000 | grep "sending keepalive packet" | \\\n               grep -oE \'remote_addr":"[^"]+\' | sort -u\n             # expected: ≥5 unique remote endpoints\nCheck:       firewall 8001/udp inbound? NAT (net.nat-detect)? port already in use?\nWhy:         <5 keepalive peers usually means partial mesh: firewall blocks inbound\n             Auth UDP, or NAT drops return path; raptorcast efficiency suffers.'
  else
    emit monad "monad.authudp-peers" INFO "no recent keepalive activity — Auth UDP may not be negotiating or DEBUG logs disabled"
  fi
}

# Helper: is monad pkg installed? Node-specific checks are meaningless
# until the package is in place.
_monad_pkg_installed() {
  dpkg -l monad 2>/dev/null | grep -qE '^.i  monad'
}

# Helper: single INFO emitted when monad pkg isn't installed, to make the
# pre-flight intent explicit in the report.
_monad_not_installed_notice() {
  emit monad "monad.preflight" INFO \
    "monad package not installed — node-specific checks (triedb, keys, OTel, VDP, Auth UDP) skipped. Hardware/OS/network/security still verified above."
}

check_vdp_otel_collector() {
  # MF VDP (May 2026 email) requires every validator to push OTel metrics to
  # otel-external.monadinfra.com:443. That needs an active OTel collector.
  # Plain `otelcol` ships with Monad apt package; `otelcol-contrib` is sometimes
  # installed separately for journald receivers (logs → Loki). Either is fine —
  # VDP only cares the push works. Caller (main) gates this on _monad_pkg_installed.
  local active=""
  for svc in otelcol otelcol-contrib; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      active="$svc"
      break
    fi
  done
  if [[ -z "$active" ]]; then
    emit monad "vdp.otel-collector" "$(_vdp_severity)" "no active OTel collector — VDP requires metrics push to MF$(_vdp_note)" \
         $'Quick fix:   sudo systemctl enable --now otelcol   # if already installed by `monad` pkg\nIf missing:  sudo apt install -y monad   # otelcol is bundled with the monad package\nVDP setup:   sudo ./monad-validator-setup --with-vdp-otel   # downloads & runs MF script\nVerify:      systemctl is-active otelcol && curl -s localhost:8888/metrics | head\nWhy:         VDP eligibility requires push of monad_* metrics to\n             otel-external.monadinfra.com:443. No collector → no metrics → excluded.'
    return
  fi
  emit monad "vdp.otel-collector" PASS "$active.service active"
}

check_vdp_otel_version() {
  # MF VDP setup script (May 2026) targets otelcol >= 0.139.0 — earlier versions
  # lack the resource processor attributes used by MF config.
  local required="0.139.0"
  local bin=""
  for svc in otelcol otelcol-contrib; do
    if systemctl is-active --quiet "$svc" 2>/dev/null && command -v "$svc" >/dev/null 2>&1; then
      bin="$svc"
      break
    fi
  done
  if [[ -z "$bin" ]]; then
    emit monad "vdp.otel-version" INFO "no active OTel collector to version-check"
    return
  fi
  local ver
  ver=$("$bin" --version 2>/dev/null | awk '{print $NF; exit}')
  if [[ -z "$ver" ]]; then
    emit monad "vdp.otel-version" WARN "could not determine $bin version"
    return
  fi
  if dpkg --compare-versions "$ver" ge "$required" 2>/dev/null; then
    emit monad "vdp.otel-version" PASS "$bin v$ver (>= $required required by MF setup script)"
  else
    emit monad "vdp.otel-version" WARN "$bin v$ver < $required — MF setup script targets $required" \
         $'Quick fix:   sudo ./monad-validator-setup --with-vdp-otel   # MF script installs required version\nManual:      sudo apt install -y '"$bin"$'='"$required"$'-1   # if MF script unavailable\nVerify:      '"$bin"$' --version   # ≥ '"$required"$'\nWhy:         MF VDP config (resource processor + attributes) uses features only in\n             '"$bin"$' ≥ '"$required"$'; older versions silently fail to apply config.'
  fi
}

# VDP checks apply to VALIDATORS. Full nodes are not in the Delegation Program, so a missing
# OTel push is not a defect for them — but it IS one for a validator, and silently downgrading
# it there would cost real VDP eligibility. Hence three outcomes, not two:
#   validator -> FAIL (as before)
#   fullnode  -> INFO (not applicable, does not touch the verdict)
#   auto      -> WARN + tell the operator to declare the mode
_vdp_severity() {
  case "$NODE_MODE" in
    validator) echo FAIL ;;
    fullnode)  echo INFO ;;
    *)         echo WARN ;;
  esac
}
_vdp_note() {
  case "$NODE_MODE" in
    fullnode)  echo " (full node — VDP applies to validators only)" ;;
    validator) echo "" ;;
    *)         echo " (node mode undeclared — re-run with --mode validator|fullnode)" ;;
  esac
}

check_vdp_secp_key_label() {
  # MF VDP compliance check: every monad_* metric served by local Prometheus
  # exporter on :8889 must carry a secp_key="<pubkey>" label so MF can identify
  # the validator. This is exactly what the MF script's idempotency-check looks for.
  if ! command -v curl >/dev/null 2>&1; then
    emit monad "vdp.secp-key-label" INFO "curl not installed — skipping VDP label check"
    return
  fi
  local metrics_url="http://localhost:8889/metrics"
  local payload
  payload=$(curl -sf --max-time 5 "$metrics_url" 2>/dev/null) || {
    emit monad "vdp.secp-key-label" WARN "could not reach $metrics_url — OTel collector may not be exposing :8889" \
         $'Investigate: ss -tln | grep 8889                          # is anything bound?\n             systemctl status otelcol otelcol-contrib        # which collector?\n             journalctl -u otelcol -n 100 --no-pager         # config errors?\nQuick fix:   sudo ./monad-validator-setup --with-vdp-otel    # apply MF config\nWhy:         MF VDP setup binds Prometheus receiver on :8889 — required for resource\n             attribute injection. Missing binding = no metrics flow.'
    return
  }
  local secp
  secp=$(printf '%s\n' "$payload" | grep -oE 'secp_key="[0-9a-f]{2,}"' | head -1 | sed 's/secp_key="\([0-9a-f]*\)"/\1/')
  if [[ -z "$secp" ]]; then
    emit monad "vdp.secp-key-label" "$(_vdp_severity)" "metrics on :8889 lack 'secp_key' label — NOT VDP-compliant$(_vdp_note)" \
         "Run MF setup (testnet first): curl -fsSL -o /tmp/x.sh bucket.monadinfra.com/tmp/otel-validator-setup.sh && verify sha256 then sudo bash /tmp/x.sh"
    return
  fi
  local len=${#secp}
  if [[ $len -ge 64 ]]; then
    emit monad "vdp.secp-key-label" PASS "metrics tagged with secp_key=${secp:0:8}…${secp: -4} (VDP-compliant)"
  else
    emit monad "vdp.secp-key-label" WARN "secp_key label present but unusually short ($len chars)"
  fi
}

check_vdp_mf_push() {
  # MF push uses OTLP gRPC over TLS to otel-external.monadinfra.com:443 (Cloudflare-fronted).
  # We confirm a live push by counting ESTABLISHED TLS connections from the
  # otelcol process to :443 destinations.
  if ! command -v ss >/dev/null 2>&1; then
    emit monad "vdp.mf-push" INFO "ss not available — skipping connection check"
    return
  fi
  local otel_pids=""
  for svc in otelcol otelcol-contrib; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      local pid
      pid=$(systemctl show "$svc" --property=MainPID --value 2>/dev/null)
      [[ -n "$pid" && "$pid" != "0" ]] && otel_pids="$otel_pids $pid"
    fi
  done
  if [[ -z "$otel_pids" ]]; then
    emit monad "vdp.mf-push" INFO "no active otelcol process — already covered by vdp.otel-collector"
    return
  fi
  local conns=0
  for pid in $otel_pids; do
    local c
    c=$(ss -tnp 2>/dev/null | awk -v pid="pid=$pid," '$0 ~ pid && $5 ~ /:443$/' | wc -l)
    conns=$((conns + c))
  done
  if (( conns >= 1 )); then
    emit monad "vdp.mf-push" PASS "OTel collector has $conns active TLS connection(s) to :443 — push to MF appears active"
  else
    emit monad "vdp.mf-push" WARN "no ESTABLISHED :443 connections from otelcol — push to MF may not be configured" \
         $'Investigate: journalctl -u otelcol -u otelcol-contrib -n 200 --no-pager | grep -iE "monadinfra|export|tls"\n             grep -r monadinfra /etc/otelcol* 2>/dev/null   # is the MF exporter defined?\nQuick fix:   sudo ./monad-validator-setup --with-vdp-otel   # MF script writes exporter config\nVerify:      ss -tnp | grep "pid=$(systemctl show otelcol --property=MainPID --value)" | grep :443\nWhy:         no outbound :443 from otelcol = metrics not reaching otel-external.monadinfra.com.\n             Without this push, MF cannot count your validator for VDP.'
  fi
}

run_section() {
  local name="$1"; shift
  [[ -n "$SECTION" && "$SECTION" != "$name" ]] && return
  section_header "$(echo "$name" | tr a-z A-Z)"
  for fn in "$@"; do "$fn"; done
}

main() {
  header
  run_section hardware  check_baremetal check_cpu check_ram check_disks check_iops
  run_section os        check_os check_kernel check_kernel_pin check_ulimits check_sysctl check_ntp
  run_section network   check_public_ip check_bandwidth check_ports_free check_firewall
  run_section security  check_ssh_hardening check_unattended_upgrades check_needrestart check_fail2ban \
                        check_rpc_exposure check_metrics_exposure check_iptables_udp_filter check_cve_2026_31431 \
                        check_nvme_cli
  # MONAD section: if the monad package is not installed, only run
  # `check_monad_install` (which emits an INFO that this is a pre-flight
  # check) and skip every other node-specific check. There's nothing for
  # them to measure until the package is in place. Operators running
  # doctor before installation get a clean report focused on hardware/OS/
  # network/security — i.e. what they CAN fix before kicking off install.
  if _monad_pkg_installed; then
    run_section monad     check_monad_user check_triedb_device check_triedb_udev \
                          check_cruft_timer check_monad_install \
                          check_github_release check_authudp_config check_authudp_peers \
                          check_mip8_timeline \
                          check_statesync_threshold \
                          check_validator_registration \
                          check_vdp_otel_collector check_vdp_otel_version \
                          check_vdp_secp_key_label check_vdp_mf_push
  else
    run_section monad     check_monad_install _monad_not_installed_notice
  fi

  if [[ $JSON_OUTPUT -eq 1 ]]; then
    print_json
  else
    print_summary
  fi

  # Exit code
  if (( COUNT_FAIL > 0 )); then exit 2
  elif (( COUNT_WARN > 0 )); then exit 1
  else exit 0
  fi
}

print_summary() {
  echo
  printf "${C_BOLD}━━ Summary ━━${C_RESET}\n"
  printf "  ${C_GREEN}PASS${C_RESET}: %d   " "$COUNT_PASS"
  printf "${C_YELLOW}WARN${C_RESET}: %d   " "$COUNT_WARN"
  printf "${C_RED}FAIL${C_RESET}: %d   " "$COUNT_FAIL"
  printf "${C_BLUE}INFO${C_RESET}: %d   " "$COUNT_INFO"
  printf "${C_YELLOW}SKIP${C_RESET}: %d\n" "$COUNT_SKIP"
  if (( COUNT_SKIP > 0 )); then
    printf "  ${C_YELLOW}%d check(s) did NOT run${C_RESET} — a SKIP is not a pass. Review them above.\n" "$COUNT_SKIP"
  fi
  echo

  if (( COUNT_FAIL > 0 )); then
    printf "${C_RED}${C_BOLD}✗ Verdict: NOT READY${C_RESET}\n"
    printf "  Fix the FAIL items before deploying a validator.\n"
  elif (( COUNT_WARN > 0 )); then
    printf "${C_YELLOW}${C_BOLD}! Verdict: READY WITH WARNINGS${C_RESET}\n"
    printf "  Node will run but address WARN items for best operation.\n"
  else
    printf "${C_GREEN}${C_BOLD}✓ Verdict: READY${C_RESET}\n"
    printf "  All checks passed. Server is ready for Monad validator deployment.\n"
  fi
  echo
}

json_escape() {
  # Properly escape a string for JSON: backslash, quote, control chars, newlines.
  # Uses python3 if available (most reliable), else minimal fallback.
  if command -v python3 >/dev/null; then
    python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.argv[1])[1:-1])' "$1"
  else
    # Fallback: handle backslash, quote, tab, newline, CR.
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
                          -e ':a;N;$!ba;s/\n/\\n/g' -e 's/\r/\\r/g' -e 's/\t/\\t/g'
  fi
}

print_json() {
  printf '{\n'
  printf '  "host": "%s",\n' "$(hostname)"
  printf '  "date": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '  "summary": {"pass": %d, "warn": %d, "fail": %d, "info": %d, "skip": %d},\n' \
    "$COUNT_PASS" "$COUNT_WARN" "$COUNT_FAIL" "$COUNT_INFO" "$COUNT_SKIP"
  if (( COUNT_FAIL > 0 )); then printf '  "verdict": "NOT_READY",\n'
  elif (( COUNT_WARN > 0 )); then printf '  "verdict": "READY_WITH_WARNINGS",\n'
  else printf '  "verdict": "READY",\n'; fi
  printf '  "checks": [\n'
  local n=${#RESULTS_NAME[@]}
  for ((i=0; i<n; i++)); do
    local sep=","
    (( i == n-1 )) && sep=""
    printf '    {"section": "%s", "name": "%s", "status": "%s", "message": "%s", "fix": "%s"}%s\n' \
      "$(json_escape "${RESULTS_SECTION[i]}")" \
      "$(json_escape "${RESULTS_NAME[i]}")" \
      "$(json_escape "${RESULTS_STATUS[i]}")" \
      "$(json_escape "${RESULTS_MSG[i]}")" \
      "$(json_escape "${RESULTS_FIX[i]}")" \
      "$sep"
  done
  printf '  ]\n'
  printf '}\n'
}

main
