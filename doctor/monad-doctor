#!/usr/bin/env bash
# monad-doctor — pre-flight readiness check for Monad validator nodes
# Project: BeeHive monad-tools
# Repo: https://github.com/BeeHiveTeam/monad-tools
#
# Usage:
#   sudo ./monad-doctor                        # full check (default)
#   sudo ./monad-doctor --json                 # machine-readable
#   sudo ./monad-doctor --quick                # skip slow checks (fio IOPS)
#   sudo ./monad-doctor --section hardware     # only one section
#   sudo ./monad-doctor --no-color             # no ANSI colors
#
# One-liner from internet:
#   curl -fsSL https://raw.githubusercontent.com/BeeHiveTeam/monad-tools/main/doctor/monad-doctor | sudo bash
#
# Exit codes:
#   0  all checks passed (or only INFO/PASS)
#   1  warnings only — node will run but suboptimal
#   2  one or more FAIL — node should NOT be deployed yet

set -u
# Note: no pipefail — `grep -q` exits early on match, causing SIGPIPE on producers
# like journalctl/apt/dpkg, which would propagate as false failures.

# ===== Defaults / thresholds (tuneable via env or flags) =====
# Sources:
#   - https://docs.monad.xyz/node-ops/hardware-requirements
#   - https://docs.monad.xyz/node-ops/full-node-installation
#   - https://docs.monad.xyz/node-ops/upgrade-instructions/auth-udp
CPU_CORES_MIN=${CPU_CORES_MIN:-16}      # docs: "16 core CPU"
CPU_CORES_REC=${CPU_CORES_REC:-16}
CPU_GHZ_MIN=${CPU_GHZ_MIN:-4.5}         # docs: "4.5 GHz+ base clock speed"
RAM_GB_MIN=${RAM_GB_MIN:-32}            # docs: "32 GB+ RAM"
RAM_GB_REC=${RAM_GB_REC:-64}
DISK_GB_OS_MIN=${DISK_GB_OS_MIN:-500}   # docs: "500GB Disk" for MonadBFT/OS
DISK_GB_TRIEDB_MIN=${DISK_GB_TRIEDB_MIN:-1700}  # docs: "2TB dedicated disk" (real 2TB-class drives advertise ~1.92TB ≈ 1788 GiB)
NVME_IOPS_MIN=${NVME_IOPS_MIN:-200000}  # not in docs — heuristic from operators
NVME_IOPS_REC=${NVME_IOPS_REC:-500000}
ULIMIT_MIN=${ULIMIT_MIN:-1000000}
# Per docs.monad.xyz/node-ops/full-node-installation:
#   "Linux Kernel >= 6.8.0.60"
#   "There is a known bug affecting Linux kernel versions v6.8.0.56-generic
#    – v6.8.0.59-generic (inclusive) that causes Monad clients to hang."
KERNEL_MIN=${KERNEL_MIN:-6.8.0}
KERNEL_MIN_PATCH=${KERNEL_MIN_PATCH:-60}      # apt name: 6.8.0-60-generic
KERNEL_BUGGY_PATCHES=${KERNEL_BUGGY_PATCHES:-"56 57 58 59"}
# Ubuntu 24.04+ required (apt repo only ships 'noble' suite per docs).
UBUNTU_VERSION_MIN=${UBUNTU_VERSION_MIN:-24.04}
# 8000 = TCP+UDP P2P, 8001 = UDP-only Auth UDP per docs.
# Format: "port/proto" pairs.
NET_PORTS_REQUIRED=${NET_PORTS_REQUIRED:-"8000/tcp 8000/udp 8001/udp"}
NET_SPEED_VALIDATOR_MBPS=${NET_SPEED_VALIDATOR_MBPS:-300}   # docs: "300 Mbit/s (Validators)"
NET_SPEED_FULLNODE_MBPS=${NET_SPEED_FULLNODE_MBPS:-100}     # docs: "100 Mbit/s (Full Nodes)"
MONAD_AUTHUDP_VERSION_MIN=${MONAD_AUTHUDP_VERSION_MIN:-0.12.6}
MONAD_NODE_TOML=${MONAD_NODE_TOML:-/home/monad/monad-bft/config/node.toml}

JSON_OUTPUT=0
QUICK_MODE=0
SECTION=""
USE_COLOR=1

# Valid sections — keep in sync with run_section calls in main()
VALID_SECTIONS=("hardware" "os" "network" "security" "monad")

# ===== Argument parsing =====
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)      JSON_OUTPUT=1 ;;
    --quick)     QUICK_MODE=1 ;;
    --section)   SECTION="${2:-}"; shift ;;
    --section=*) SECTION="${1#*=}" ;;
    --no-color)  USE_COLOR=0 ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) echo "Unknown option: $1 (--help for usage)" >&2; exit 64 ;;
  esac
  shift
done

# Validate --section if provided (catches typos like 'hardwear')
if [[ -n "$SECTION" ]]; then
  found=0
  for v in "${VALID_SECTIONS[@]}"; do [[ "$v" == "$SECTION" ]] && found=1; done
  if (( found == 0 )); then
    echo "Unknown section '$SECTION'. Valid: ${VALID_SECTIONS[*]}" >&2
    exit 64
  fi
fi

# ===== Colors =====
if [[ $USE_COLOR -eq 1 && -t 1 && $JSON_OUTPUT -eq 0 ]]; then
  C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[0;33m'
  C_BLUE=$'\033[0;34m'; C_PURPLE=$'\033[0;35m'; C_CYAN=$'\033[0;36m'
  C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_PURPLE=""; C_CYAN=""
  C_BOLD=""; C_DIM=""; C_RESET=""
fi

# ===== Result accumulation =====
declare -a RESULTS_NAME RESULTS_STATUS RESULTS_MSG RESULTS_FIX RESULTS_SECTION
declare -i COUNT_PASS=0 COUNT_WARN=0 COUNT_FAIL=0 COUNT_INFO=0

emit() {
  # emit <section> <name> <status> <msg> [fix]
  local section="$1" name="$2" status="$3" msg="$4" fix="${5:-}"
  RESULTS_SECTION+=("$section")
  RESULTS_NAME+=("$name")
  RESULTS_STATUS+=("$status")
  RESULTS_MSG+=("$msg")
  RESULTS_FIX+=("$fix")
  case "$status" in
    PASS) COUNT_PASS+=1 ;;
    WARN) COUNT_WARN+=1 ;;
    FAIL) COUNT_FAIL+=1 ;;
    INFO) COUNT_INFO+=1 ;;
  esac

  [[ $JSON_OUTPUT -eq 1 ]] && return

  local sym color
  case "$status" in
    PASS) sym="✓"; color="$C_GREEN"  ;;
    WARN) sym="!"; color="$C_YELLOW" ;;
    FAIL) sym="✗"; color="$C_RED"    ;;
    INFO) sym="i"; color="$C_BLUE"   ;;
  esac

  printf "  ${color}%s${C_RESET} %-30s %s\n" "$sym" "$name" "$msg"
  [[ -n "$fix" ]] && printf "    ${C_DIM}→ %s${C_RESET}\n" "$fix"
}

section_header() {
  [[ $JSON_OUTPUT -eq 1 ]] && return
  printf "\n${C_BOLD}${C_PURPLE}━━ %s ━━${C_RESET}\n" "$1"
}

# ===== Helpers =====
require_cmd() { command -v "$1" >/dev/null 2>&1; }

ver_ge() {
  # ver_ge "5.15.0" "5.15"  → 0 (true)
  printf '%s\n%s\n' "$2" "$1" | sort -V -C
}

# ===== Disk topology analyzer =====
# Classifies each NVMe disk by role:
#   os-raid     — at least one partition is a member of a md array mounted at /
#   os-single   — at least one partition is mounted at / directly
#   triedb      — contains the partition that /dev/triedb points to
#   swap-only   — only swap partitions (and nothing else mounted)
#   unused      — no partitions or no mounted partitions (a spare)
#   other       — partitions exist but role unclear (LVM, encrypted, etc)
#
# Outputs lines:  <devname>\t<size_human>\t<role>\t<detail>
disk_topology() {
  # Resolve which device(s) back the / mount.
  local root_src root_dev parts_under_root=()
  root_src=$(findmnt -no SOURCE / 2>/dev/null)
  root_dev="${root_src##*/}"  # md3, sda1, dm-0...

  # If / is on md raid, find the underlying member partitions.
  if [[ -n "$root_dev" && -e "/sys/block/$root_dev/md" ]]; then
    while IFS= read -r m; do
      parts_under_root+=("$m")
    done < <(ls "/sys/block/$root_dev/md/" 2>/dev/null | sed -n 's/^dev-//p')
  fi

  # Resolve triedb partition.
  local triedb_part=""
  if [[ -L /dev/triedb ]]; then
    triedb_part=$(readlink -f /dev/triedb 2>/dev/null)
    triedb_part="${triedb_part##*/}"
  fi

  # Iterate all top-level NVMe disks.
  local disk
  for disk in $(lsblk -dn -o NAME,TYPE 2>/dev/null | awk '$2=="disk" && $1 ~ /^nvme/ {print $1}'); do
    local size_h size_b
    size_h=$(lsblk -dn -o SIZE "/dev/$disk" 2>/dev/null)
    size_b=$(lsblk -bdn -o SIZE "/dev/$disk" 2>/dev/null)

    # Collect partition info.
    local parts mounts has_root has_triedb has_swap has_other
    parts=$(lsblk -ln -o NAME,MOUNTPOINT "/dev/$disk" 2>/dev/null | tail -n +2)
    has_root=0; has_triedb=0; has_swap=0; has_other=0

    while IFS= read -r line; do
      local pname pmount
      pname=$(awk '{print $1}' <<<"$line")
      pmount=$(awk '{print $2}' <<<"$line")
      [[ "$pname" == "$disk" ]] && continue
      # Member of root md?
      for m in "${parts_under_root[@]}"; do
        [[ "$pname" == "$m" ]] && has_root=1
      done
      # Mounted at / directly (no RAID)?
      [[ "$pmount" == "/" ]] && has_root=2
      # Triedb
      [[ "$pname" == "$triedb_part" ]] && has_triedb=1
      # Swap
      [[ "$pmount" == "[SWAP]" ]] && has_swap=1
      # Anything else mounted
      if [[ -n "$pmount" && "$pmount" != "[SWAP]" && "$pmount" != "/" ]]; then
        has_other=1
      fi
    done <<<"$parts"

    local role detail=""
    if (( has_triedb )); then
      role="triedb"
      detail="/dev/triedb → $triedb_part"
    elif (( has_root == 2 )); then
      role="os-single"
      detail="/ on this disk (single, no RAID)"
    elif (( has_root == 1 )); then
      role="os-raid"
      detail="member of $root_dev (raid for /)"
    elif (( has_other )); then
      role="other"
      detail="has mounted partitions"
    elif (( has_swap )); then
      role="swap-only"
      detail="only swap"
    elif [[ -z "$parts" ]]; then
      role="unused"
      detail="no partitions"
    else
      role="unused"
      detail="partitions present but no mounts"
    fi

    printf '%s\t%s\t%s\t%s\n' "$disk" "$size_h" "$role" "$detail"
  done
}

# ===== Section: HARDWARE =====
check_baremetal() {
  # Per docs.monad.xyz/node-ops/hardware-requirements:
  #   "Monad nodes must operate on bare metal servers rather than virtualized
  #    or cloud-based environments"
  # Quirk: systemd-detect-virt exits 1 when virt is "none" (bare metal).
  # So we explicitly check the output, not the exit code.
  if ! command -v systemd-detect-virt >/dev/null; then
    emit hardware "host.bare-metal" INFO "systemd-detect-virt not available — cannot verify"
    return
  fi
  local virt
  virt=$(systemd-detect-virt 2>/dev/null)
  case "$virt" in
    none|"") emit hardware "host.bare-metal" PASS "running on bare metal" ;;
    *)       emit hardware "host.bare-metal" FAIL "running in '$virt' (virtualized) — docs require bare metal" \
                  "Move to a bare-metal server. VDP/Foundation requires bare-metal per hardware-requirements." ;;
  esac
}

check_cpu() {
  local model phys_cores logical
  model=$(awk -F: '/model name/ {print $2; exit}' /proc/cpuinfo | sed 's/^ *//')
  # Physical cores per docs: nproc returns logical (with SMT), but docs
  # require SMT off, so we should count physical cores.
  phys_cores=$(lscpu 2>/dev/null \
    | awk -F: '/^Core\(s\) per socket/ {gsub(/ /,"",$2); c=$2} /^Socket\(s\)/ {gsub(/ /,"",$2); s=$2} END {if (c && s) print c*s; else print 0}')
  logical=$(nproc)
  [[ -z "$phys_cores" || "$phys_cores" == "0" ]] && phys_cores="$logical"

  if (( phys_cores >= CPU_CORES_REC )); then
    emit hardware "cpu.cores"   PASS "$phys_cores physical cores ($model)"
  elif (( phys_cores >= CPU_CORES_MIN )); then
    emit hardware "cpu.cores"   WARN "$phys_cores physical cores — meets min ($CPU_CORES_MIN), recommend $CPU_CORES_REC+ ($model)"
  else
    emit hardware "cpu.cores"   FAIL "$phys_cores physical cores — below minimum $CPU_CORES_MIN ($model)" \
         "Validator needs ≥$CPU_CORES_MIN physical cores; current hardware insufficient"
  fi

  # SMT/HyperThreading per docs: "Disabled HyperThreading (HT) or
  # Simultaneous MultiThreading (SMT) via BIOS settings — these features
  # degrade the node performance."
  local smt_active
  smt_active=$(cat /sys/devices/system/cpu/smt/active 2>/dev/null || echo unknown)
  case "$smt_active" in
    0)     emit hardware "cpu.smt"  PASS "SMT/HyperThreading disabled (per docs)" ;;
    1)     emit hardware "cpu.smt"  FAIL "SMT/HyperThreading active — must be disabled in BIOS per docs" \
                "Reboot into BIOS/UEFI and disable SMT (AMD) / HyperThreading (Intel)" ;;
    *)     emit hardware "cpu.smt"  INFO "SMT state unknown — verify in BIOS (must be off)" ;;
  esac

  # CPU base clock — docs require 4.5 GHz+. Read from cpuinfo "MHz" field if available,
  # otherwise from lscpu "CPU max MHz". Some servers report governed (current) clock not max.
  local mhz_max
  mhz_max=$(lscpu 2>/dev/null | awk -F: '/CPU max MHz/ {gsub(/ /,"",$2); print $2; exit}')
  [[ -z "$mhz_max" ]] && mhz_max=$(awk -F: '/cpu MHz/ {gsub(/ /,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null)
  if [[ -n "$mhz_max" ]]; then
    local ghz_max
    ghz_max=$(awk -v m="$mhz_max" 'BEGIN {printf "%.2f", m/1000}')
    if awk -v a="$ghz_max" -v b="$CPU_GHZ_MIN" 'BEGIN {exit !(a >= b)}'; then
      emit hardware "cpu.clock"   PASS "${ghz_max} GHz max (≥${CPU_GHZ_MIN} GHz required)"
    else
      emit hardware "cpu.clock"   WARN "${ghz_max} GHz max — docs require ${CPU_GHZ_MIN} GHz+ base clock"
    fi
  else
    emit hardware "cpu.clock"   INFO "could not read CPU max clock"
  fi

  # AVX2 / AVX-512 hints (BLS sig verification benefits)
  if grep -q avx512f /proc/cpuinfo; then
    emit hardware "cpu.avx"     PASS "AVX-512 supported (faster BLS)"
  elif grep -q avx2 /proc/cpuinfo; then
    emit hardware "cpu.avx"     PASS "AVX2 supported"
  else
    emit hardware "cpu.avx"     WARN "no AVX2 — BLS verification will be slower"
  fi
}

check_ram() {
  local total_gb avail_gb
  total_gb=$(awk '/MemTotal/ {printf "%d", $2/1024/1024}' /proc/meminfo)
  avail_gb=$(awk '/MemAvailable/ {printf "%d", $2/1024/1024}' /proc/meminfo)

  if (( total_gb >= RAM_GB_REC )); then
    emit hardware "ram.total"   PASS "${total_gb} GB total (${avail_gb} GB available)"
  elif (( total_gb >= RAM_GB_MIN )); then
    emit hardware "ram.total"   WARN "${total_gb} GB — meets min ($RAM_GB_MIN), recommend ${RAM_GB_REC}+"
  else
    emit hardware "ram.total"   FAIL "${total_gb} GB — below minimum $RAM_GB_MIN GB" \
         "Add RAM or use a server with ≥$RAM_GB_REC GB"
  fi

  # Swap usage warning (validator should not be swapping)
  local swap_used_mb
  swap_used_mb=$(awk '/SwapFree/ {sf=$2} /SwapTotal/ {st=$2} END {printf "%d", (st-sf)/1024}' /proc/meminfo)
  if (( swap_used_mb > 100 )); then
    emit hardware "ram.swap"    WARN "swap in use: ${swap_used_mb} MB — node may stall under load" \
         "Investigate memory pressure: 'sudo swapoff -a && sudo swapon -a' to reset"
  else
    emit hardware "ram.swap"    PASS "swap not in use"
  fi
}

check_disks() {
  local topo nvme_count total_size_gb
  topo=$(disk_topology)
  nvme_count=$(echo "$topo" | grep -c . || echo 0)
  total_size_gb=$(lsblk -bdn -o NAME,SIZE 2>/dev/null \
    | awk '/^nvme/ {s+=$2} END {printf "%d", s/1024/1024/1024}')

  if (( nvme_count == 0 )); then
    emit hardware "disk.nvme"   FAIL "no NVMe drives detected" \
         "Validator REQUIRES NVMe SSD — SATA/HDD will fail under triedb load"
    return
  fi

  emit hardware "disk.nvme"     PASS "$nvme_count NVMe drive(s), ${total_size_gb} GB total"

  # Print topology table — one line per disk with role + detail.
  # This is INFO-level: the WARN/FAIL signals come from derived checks below.
  while IFS=$'\t' read -r dev size role detail; do
    [[ -z "$dev" ]] && continue
    case "$role" in
      triedb)    emit hardware "disk.role.$dev" PASS "$dev ($size): triedb — $detail" ;;
      os-raid)   emit hardware "disk.role.$dev" PASS "$dev ($size): OS RAID — $detail" ;;
      os-single) emit hardware "disk.role.$dev" WARN "$dev ($size): OS on single disk (SPOF) — $detail" \
                      "Consider RAID1 for OS to avoid single-disk failure" ;;
      unused)    emit hardware "disk.role.$dev" INFO "$dev ($size): unused — $detail" ;;
      swap-only) emit hardware "disk.role.$dev" INFO "$dev ($size): swap-only" ;;
      other)     emit hardware "disk.role.$dev" INFO "$dev ($size): $detail" ;;
    esac
  done <<<"$topo"

  # NVMe LBA format per docs:
  # "Data Size should be set to 512 bytes and marked as (in use). If that
  #  is not the case, then you will need to set the TRIEDB_DRIVE to use
  #  512 byte LBA." → only enforce on the actual triedb device.
  local triedb_disk_for_lba=""
  if [[ -L /dev/triedb ]]; then
    triedb_disk_for_lba=$(lsblk -no PKNAME "$(readlink -f /dev/triedb)" 2>/dev/null | head -1)
  fi
  while IFS=$'\t' read -r dev _ role _; do
    [[ -z "$dev" ]] && continue
    local lba
    lba=$(lsblk -dn -o LOG-SEC "/dev/$dev" 2>/dev/null | tr -d ' ')
    [[ -z "$lba" ]] && continue
    if [[ "$dev" == "$triedb_disk_for_lba" ]]; then
      if [[ "$lba" == "512" ]]; then
        emit hardware "disk.lba.$dev" PASS "triedb device $dev: 512-byte LBA (per docs)"
      else
        emit hardware "disk.lba.$dev" FAIL "triedb device $dev: ${lba}-byte LBA — docs require 512" \
             "Reformat (DESTROYS DATA — backup keys first): nvme format /dev/$dev --lbaf=0 --force"
      fi
    elif [[ "$role" == "unused" ]]; then
      # Unused disk — could become triedb. Inform if it would need reformat.
      if [[ "$lba" != "512" ]]; then
        emit hardware "disk.lba.$dev" INFO "$dev (unused): ${lba}-byte LBA — must be reformatted to 512 if used as triedb"
      fi
    fi
  done <<<"$topo"

  # Sanity: triedb on RAID is wasteful (extra writes, slower)
  if [[ -L /dev/triedb ]]; then
    local triedb_part triedb_disk
    triedb_part=$(readlink -f /dev/triedb)
    triedb_part="${triedb_part##*/}"
    triedb_disk=$(lsblk -no PKNAME "/dev/${triedb_part}" 2>/dev/null | head -1)
    if [[ -n "$triedb_disk" ]] && grep -q "${triedb_disk}p" /proc/mdstat 2>/dev/null; then
      emit hardware "disk.triedb-raid" WARN "triedb device $triedb_disk is part of RAID — wasted writes" \
           "Move /dev/triedb to a dedicated NVMe (no RAID, no other use)"
    fi
  fi

  # IO scheduler — only the triedb device strictly needs mq-deadline
  local triedb_disk_for_sched=""
  if [[ -L /dev/triedb ]]; then
    triedb_disk_for_sched=$(lsblk -no PKNAME "$(readlink -f /dev/triedb)" 2>/dev/null | head -1)
  fi
  while IFS=$'\t' read -r dev size role _; do
    [[ -z "$dev" ]] && continue
    local sched
    sched=$(awk '{for(i=1;i<=NF;i++) if($i ~ /^\[/) {gsub(/[][]/,"",$i); print $i; exit}}' "/sys/block/$dev/queue/scheduler" 2>/dev/null)
    if [[ "$dev" == "$triedb_disk_for_sched" ]]; then
      if [[ "$sched" == "mq-deadline" ]]; then
        emit hardware "disk.sched.$dev" PASS "triedb device on mq-deadline ✓"
      else
        emit hardware "disk.sched.$dev" FAIL "triedb device $dev on '$sched' — must be mq-deadline" \
             "echo mq-deadline | sudo tee /sys/block/$dev/queue/scheduler"
      fi
    fi
  done <<<"$topo"

  # If no triedb yet, recommend an unused candidate. If none — WARN: there
  # is no free NVMe for triedb, so validator-setup will require --triedb-dev
  # or fail entirely (all disks are RAID members / mounted / swap).
  if [[ ! -L /dev/triedb ]]; then
    local cand
    cand=$(echo "$topo" | awk -F'\t' -v min="$DISK_GB_TRIEDB_MIN" \
      '$3=="unused" {gsub(/[^0-9.]/,"",$2); if ($2+0 >= 0) print $1, $2}')
    if [[ -n "$cand" ]]; then
      emit hardware "disk.triedb-candidate" INFO "candidate(s) for /dev/triedb: $(echo "$cand" | tr '\n' ',' )"
    else
      emit hardware "disk.triedb-candidate" WARN "no unused NVMe for /dev/triedb — every disk is RAID/mounted/swap; validator-setup will need --triedb-dev or fail" \
           "Add a dedicated NVMe for triedb, or repartition to free one (triedb must NOT share with OS RAID)"
    fi
  fi

  # Free space on root (OS partition — docs say 500 GB)
  local free_root_gb
  free_root_gb=$(df -BG / | awk 'NR==2 {gsub("G","",$4); print $4}')
  if (( free_root_gb >= DISK_GB_OS_MIN )); then
    emit hardware "disk.os"     PASS "${free_root_gb} GB free on / (need ≥${DISK_GB_OS_MIN} GB)"
  else
    emit hardware "disk.os"     FAIL "${free_root_gb} GB free on / — below ${DISK_GB_OS_MIN} GB minimum"
  fi

  # TriedB device size — docs require 2 TB dedicated disk
  if [[ -L /dev/triedb ]]; then
    local triedb_part triedb_disk triedb_size_gb
    triedb_part=$(readlink -f /dev/triedb)
    triedb_part="${triedb_part##*/}"
    triedb_disk=$(lsblk -no PKNAME "/dev/${triedb_part}" 2>/dev/null | head -1)
    triedb_size_gb=$(lsblk -bdn -o SIZE "/dev/${triedb_disk:-$triedb_part}" 2>/dev/null \
                     | awk '{printf "%d", $1/1024/1024/1024}')
    if [[ -n "$triedb_size_gb" ]] && (( triedb_size_gb >= DISK_GB_TRIEDB_MIN )); then
      emit hardware "disk.triedb-size" PASS "/dev/triedb on /dev/${triedb_disk:-$triedb_part} (${triedb_size_gb} GB)"
    elif [[ -n "$triedb_size_gb" ]]; then
      emit hardware "disk.triedb-size" FAIL "triedb device only ${triedb_size_gb} GB — docs require ≥${DISK_GB_TRIEDB_MIN} GB"
    fi
  else
    emit hardware "disk.triedb-size" INFO "/dev/triedb not present — skipping size check (created on first install)"
  fi
}

check_iops() {
  if (( QUICK_MODE == 1 )); then
    emit hardware "disk.iops"   INFO "skipped (--quick)"
    return
  fi
  if ! require_cmd fio; then
    emit hardware "disk.iops"   INFO "skipped (fio not installed) — install: apt install -y fio"
    return
  fi

  # Safety: do not run fio on a disk where monad-execution is hammering triedb —
  # would compete with real IO and could spike vote_delay.
  if systemctl is-active --quiet monad-bft 2>/dev/null \
     || systemctl is-active --quiet monad-execution 2>/dev/null; then
    emit hardware "disk.iops"   INFO "skipped — monad services active, fio would compete with triedb IO" \
         "Run on a non-triedb disk separately, or stop monad-execution briefly: 'systemctl stop monad-execution && fio ... && systemctl start monad-execution'"
    return
  fi

  # Pick a non-triedb NVMe to avoid stomping on production data.
  local target_dev triedb_disk=""
  if [[ -L /dev/triedb ]]; then
    triedb_disk=$(lsblk -no PKNAME "$(readlink -f /dev/triedb)" 2>/dev/null | head -1)
  fi
  target_dev=$(lsblk -d -o NAME,TYPE 2>/dev/null \
    | awk -v skip="$triedb_disk" '/disk/ && /^nvme/ && $1 != skip {print "/dev/"$1; exit}')
  if [[ -z "$target_dev" ]]; then
    emit hardware "disk.iops"   INFO "skipped (no non-triedb NVMe found)"
    return
  fi

  emit hardware "disk.iops"     INFO "running fio on $target_dev (10s random read, non-destructive)…"
  local iops
  iops=$(fio --name=mdr --filename="$target_dev" --rw=randread --bs=4k \
    --runtime=10 --time_based=1 --ioengine=libaio --iodepth=32 --direct=1 \
    --numjobs=4 --group_reporting --output-format=terse 2>/dev/null \
    | awk -F\; '{print $8}' | head -1)

  if [[ -z "$iops" || "$iops" == "0" ]]; then
    emit hardware "disk.iops"   WARN "fio returned no result"
    return
  fi

  if (( iops >= NVME_IOPS_REC )); then
    emit hardware "disk.iops"   PASS "${iops} 4k random read IOPS"
  elif (( iops >= NVME_IOPS_MIN )); then
    emit hardware "disk.iops"   WARN "${iops} IOPS — meets min ($NVME_IOPS_MIN), recommend $NVME_IOPS_REC+"
  else
    emit hardware "disk.iops"   FAIL "${iops} IOPS — below minimum $NVME_IOPS_MIN" \
         "Replace with datacenter-class NVMe (Samsung PM9A3, WD SN850X, Micron 7450)"
  fi
}

# ===== Section: OS =====
check_os() {
  if [[ ! -r /etc/os-release ]]; then
    emit os "os.release" FAIL "/etc/os-release not readable"
    return
  fi
  . /etc/os-release
  case "$ID" in
    ubuntu)
      local ver_id="${VERSION_ID:-0}"
      if ver_ge "$ver_id" "$UBUNTU_VERSION_MIN"; then
        emit os "os.distro"     PASS "$PRETTY_NAME"
      else
        # apt repo pkg.category.xyz only ships 'noble' (24.04). On 22.04 jammy
        # the install will fail with "Unable to find package" anyway.
        emit os "os.distro"     FAIL "$PRETTY_NAME — Ubuntu ${UBUNTU_VERSION_MIN}+ required (apt repo ships noble only)" \
             "Reinstall with Ubuntu 24.04 LTS or newer"
      fi ;;
    debian)
      emit os "os.distro"       FAIL "$PRETTY_NAME — Debian not supported by docs (only Ubuntu ${UBUNTU_VERSION_MIN}+)" \
           "Reinstall with Ubuntu 24.04 LTS"
      ;;
    *)
      emit os "os.distro"       FAIL "$PRETTY_NAME — only Ubuntu ${UBUNTU_VERSION_MIN}+ supported per docs" \
           "Reinstall with Ubuntu 24.04 LTS"
      ;;
  esac

  # Architecture
  local arch
  arch=$(uname -m)
  if [[ "$arch" == "x86_64" ]]; then
    emit os "os.arch"           PASS "x86_64"
  else
    emit os "os.arch"           FAIL "$arch — only x86_64 supported" \
         "Use a server with x86_64 (AMD64) CPU"
  fi
}

kernel_upgrade_tip() {
  # On Ubuntu <24.04 the `linux-generic-hwe-24.04` package does not exist
  # (HWE meta-packages target their own LTS). Reinstall is the only way to
  # reach kernel ≥${KERNEL_MIN}-${KERNEL_MIN_PATCH}. On 24.04 the HWE rolls
  # forward as new generic kernels ship.
  local ver_id=""
  if [[ -r /etc/os-release ]]; then
    ver_id=$(. /etc/os-release && echo "${VERSION_ID:-}")
  fi
  if [[ -n "$ver_id" ]] && ver_ge "$ver_id" "$UBUNTU_VERSION_MIN"; then
    echo "Upgrade: apt install --install-recommends linux-generic-hwe-24.04"
  else
    echo "Reinstall with Ubuntu ${UBUNTU_VERSION_MIN}+ first — HWE on older releases does not reach ${KERNEL_MIN}-${KERNEL_MIN_PATCH}"
  fi
}

check_kernel() {
  local full base patch tip
  full=$(uname -r)              # e.g. "6.8.0-60-generic"
  base=$(echo "$full" | cut -d- -f1)
  patch=$(echo "$full" | sed -nE 's/^[0-9]+\.[0-9]+\.[0-9]+-([0-9]+).*/\1/p')
  tip=$(kernel_upgrade_tip)

  # Reject buggy 6.8.0-{56..59} range explicitly (docs cite this hang bug)
  if [[ "$base" == "6.8.0" && -n "$patch" ]]; then
    for bad in $KERNEL_BUGGY_PATCHES; do
      if [[ "$patch" == "$bad" ]]; then
        emit os "kernel.version"  FAIL "kernel $full — known buggy range 6.8.0-${KERNEL_BUGGY_PATCHES// /,} (causes Monad client hangs)" \
             "$tip"
        return
      fi
    done
  fi

  # Compare base version + patch number against minimum (6.8.0 + patch 60)
  if ver_ge "$base" "$KERNEL_MIN"; then
    if [[ "$base" == "$KERNEL_MIN" && -n "$patch" && "$patch" -lt "$KERNEL_MIN_PATCH" ]]; then
      emit os "kernel.version"  FAIL "kernel $full — need ≥${KERNEL_MIN}-${KERNEL_MIN_PATCH}" \
           "$tip"
    else
      emit os "kernel.version"  PASS "$full"
    fi
  else
    emit os "kernel.version"    FAIL "kernel $base — need ≥${KERNEL_MIN}-${KERNEL_MIN_PATCH}" \
         "$tip"
  fi
}

check_ulimits() {
  # If monad-bft.service exists, its LimitNOFILE is the authoritative value
  # for the validator process. Shell ulimit is only relevant if running monad manually.
  if systemctl cat monad-bft 2>/dev/null >/dev/null; then
    local svc_limit
    svc_limit=$(systemctl show monad-bft -p LimitNOFILE 2>/dev/null | cut -d= -f2)
    svc_limit=${svc_limit:-0}
    if (( svc_limit >= ULIMIT_MIN )); then
      emit os "ulimit.service"  PASS "monad-bft LimitNOFILE=$svc_limit"
    else
      emit os "ulimit.service"  WARN "monad-bft LimitNOFILE=$svc_limit — recommend ≥$ULIMIT_MIN" \
           "Add to /etc/systemd/system/monad-bft.service.d/override.conf: [Service] LimitNOFILE=1048576"
    fi
  else
    # No service yet — fall back to /etc/security/limits.conf
    local conf_limit
    conf_limit=$(awk '$1=="*" && $2=="hard" && $3=="nofile" {print $4}' /etc/security/limits.conf 2>/dev/null | tail -1)
    if [[ "$conf_limit" == "unlimited" ]]; then
      emit os "ulimit.limits-conf" PASS "limits.conf hard nofile=unlimited"
    elif [[ -n "$conf_limit" && "$conf_limit" =~ ^[0-9]+$ ]] && (( conf_limit >= ULIMIT_MIN )); then
      emit os "ulimit.limits-conf" PASS "limits.conf hard nofile=$conf_limit"
    else
      emit os "ulimit.limits-conf" WARN "no high nofile limit set in /etc/security/limits.conf" \
           "Add: '* soft nofile 1048576' and '* hard nofile 1048576' to /etc/security/limits.conf"
    fi
  fi

  # System-wide file-max
  local sysmax
  sysmax=$(cat /proc/sys/fs/file-max 2>/dev/null || echo 0)
  if (( sysmax >= ULIMIT_MIN )); then
    emit os "ulimit.system"     PASS "fs.file-max = $sysmax"
  else
    emit os "ulimit.system"     WARN "fs.file-max = $sysmax — low" \
         "Add to /etc/sysctl.conf: 'fs.file-max = 2097152' && sysctl -p"
  fi
}

check_sysctl() {
  # Network buffer sizes critical for raptorcast UDP throughput
  local rmem_max wmem_max
  rmem_max=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
  wmem_max=$(sysctl -n net.core.wmem_max 2>/dev/null || echo 0)
  local need=16777216  # 16 MB
  if (( rmem_max >= need && wmem_max >= need )); then
    emit os "sysctl.netbuf"     PASS "rmem_max=$rmem_max wmem_max=$wmem_max"
  else
    emit os "sysctl.netbuf"     WARN "rmem/wmem_max below ${need} — UDP raptorcast may drop" \
         "Add to /etc/sysctl.conf: net.core.rmem_max=16777216, net.core.wmem_max=16777216 && sysctl -p"
  fi

  local swappiness
  swappiness=$(sysctl -n vm.swappiness 2>/dev/null || echo 60)
  if (( swappiness <= 10 )); then
    emit os "sysctl.swappiness" PASS "vm.swappiness=$swappiness"
  else
    emit os "sysctl.swappiness" WARN "vm.swappiness=$swappiness — high" \
         "Set vm.swappiness=1 in /etc/sysctl.conf to avoid validator stalls"
  fi
}

check_ntp() {
  if require_cmd chronyc && systemctl is-active --quiet chrony 2>/dev/null; then
    local off
    off=$(chronyc tracking 2>/dev/null | awk -F': ' '/Last offset/ {print $2}' | awk '{print $1}')
    local off_us
    off_us=$(awk -v o="$off" 'BEGIN {printf "%d", (o<0?-o:o)*1000000}')
    if (( off_us < 1000 )); then
      emit os "ntp"             PASS "chrony, |offset|=${off_us}µs"
    elif (( off_us < 10000 )); then
      emit os "ntp"             WARN "chrony, |offset|=${off_us}µs — slight drift"
    else
      emit os "ntp"             FAIL "chrony, |offset|=${off_us}µs — significant drift" \
           "Investigate: chronyc sources -v"
    fi
  elif systemctl is-active --quiet systemd-timesyncd 2>/dev/null; then
    emit os "ntp"               WARN "systemd-timesyncd active — drifts ~10-100ms, inflates vote_delay" \
         "Replace: apt install -y chrony && systemctl disable --now systemd-timesyncd"
  else
    emit os "ntp"               FAIL "no NTP daemon active" \
         "Install: apt install -y chrony"
  fi
}

# ===== Section: NETWORK =====
check_bandwidth() {
  # Per docs: 300 Mbit/s for validators, 100 Mbit/s for full nodes.
  # ethtool reports link speed; iface running on a virtio adapter often
  # reports 0 or "Unknown!" — INFO in that case.
  if ! command -v ethtool >/dev/null; then
    emit network "net.speed" INFO "ethtool not installed — cannot check link speed"
    return
  fi
  local checked=0
  while IFS= read -r iface; do
    [[ "$iface" == "lo" ]] && continue
    [[ "$iface" =~ ^(docker|veth|br-|virbr) ]] && continue
    local speed
    speed=$(ethtool "$iface" 2>/dev/null | awk '/Speed:/ {sub(/Mb\/s.*/,"",$2); print $2; exit}')
    [[ -z "$speed" || ! "$speed" =~ ^[0-9]+$ ]] && continue
    checked=1
    if (( speed >= NET_SPEED_VALIDATOR_MBPS )); then
      emit network "net.speed.$iface" PASS "${speed} Mb/s on $iface (≥${NET_SPEED_VALIDATOR_MBPS} required for validator)"
    elif (( speed >= NET_SPEED_FULLNODE_MBPS )); then
      emit network "net.speed.$iface" WARN "${speed} Mb/s on $iface — below validator min (${NET_SPEED_VALIDATOR_MBPS}), OK for full-node (${NET_SPEED_FULLNODE_MBPS})"
    else
      emit network "net.speed.$iface" FAIL "${speed} Mb/s on $iface — below full-node min (${NET_SPEED_FULLNODE_MBPS})"
    fi
  done < <(ip -o link show 2>/dev/null | awk -F': ' '/state UP/ {print $2}' | awk '{print $1}')
  if (( checked == 0 )); then
    emit network "net.speed" INFO "no UP physical interface reported a numeric link speed"
  fi
}

check_public_ip() {
  local ip
  ip=$(curl -fsS -m 4 https://api.ipify.org 2>/dev/null || true)
  if [[ -z "$ip" ]]; then
    emit network "net.public-ip" WARN "couldn't determine public IP (api.ipify.org timeout)"
    return
  fi
  emit network "net.public-ip"   PASS "$ip"

  # Check that public IP is on this host (not behind NAT)
  if hostname -I 2>/dev/null | grep -qw "$ip"; then
    emit network "net.nat-detect" PASS "public IP bound to interface (no NAT)"
  else
    emit network "net.nat-detect" WARN "public IP not on local interface — possible NAT" \
         "Validator behind NAT requires port-forwarding for ports $NET_PORTS_REQUIRED"
  fi
}

check_ports_free() {
  # NET_PORTS_REQUIRED contains "port/proto" tokens (e.g. 8000/tcp 8000/udp 8001/udp)
  for spec in $NET_PORTS_REQUIRED; do
    local port="${spec%/*}" proto="${spec#*/}" ss_flag
    case "$proto" in
      tcp) ss_flag="-tln" ;;
      udp) ss_flag="-uln" ;;
      *)   emit network "net.port.$spec" INFO "unknown proto '$proto'"; continue ;;
    esac

    local listening_line who
    listening_line=$(ss $ss_flag 2>/dev/null | awk -v p=":${port}" '$0 ~ p {print; exit}')
    if [[ -z "$listening_line" ]]; then
      emit network "net.port.$spec" PASS "port ${port}/${proto} free"
      continue
    fi

    # Try to identify the listening process (-p needs root)
    who=$(ss "${ss_flag}p" 2>/dev/null | awk -v p=":${port}" '$0 ~ p {print; exit}' \
          | grep -oE 'users:\(\("[^"]+"' | grep -oE '"[^"]+"' | tr -d '"' | head -1)
    if [[ "$who" =~ ^monad ]]; then
      emit network "net.port.$spec" PASS "port ${port}/${proto} owned by $who (node already running)"
    else
      emit network "net.port.$spec" WARN "port ${port}/${proto} occupied by ${who:-?} — must be free or owned by monad-*" \
           "Stop conflicting service or rebind it to another port"
    fi
  done
}

check_firewall() {
  if require_cmd ufw && ufw status 2>/dev/null | grep -q "Status: active"; then
    local ufw_status missing=""
    ufw_status=$(ufw status 2>/dev/null)
    for spec in $NET_PORTS_REQUIRED; do
      local port="${spec%/*}" proto="${spec#*/}"
      # ufw rules can appear as "8000/tcp ALLOW", "8000 ALLOW" (any proto), or "8000/udp ALLOW"
      if echo "$ufw_status" | grep -qE "^${port}/${proto}.*ALLOW|^${port}[[:space:]].*ALLOW"; then
        continue
      fi
      missing+="$spec "
    done
    if [[ -z "$missing" ]]; then
      emit network "net.firewall" PASS "ufw active, all required port/proto pairs allowed"
    else
      emit network "net.firewall" WARN "ufw active but missing rules for: $missing" \
           "Add: $(for s in $missing; do echo -n "ufw allow ${s%/*}/${s#*/}; "; done)"
    fi
  elif require_cmd ufw; then
    emit network "net.firewall" WARN "ufw installed but inactive — no firewall protection" \
         "Enable: ufw allow 22/tcp; ufw allow 8000; ufw allow 8001/udp; ufw enable"
  elif require_cmd nft || require_cmd iptables; then
    emit network "net.firewall" INFO "nftables/iptables in use (manual config) — ensure $NET_PORTS_REQUIRED open"
  else
    emit network "net.firewall" WARN "no firewall detected" \
         "Install ufw: apt install -y ufw"
  fi
}

# ===== Section: SECURITY =====
check_rpc_exposure() {
  # Per docs.monad.xyz/node-ops/validator-delegation-program:
  #   "Not use a validator node to service external RPCs (Axelar, Wormhole, etc.)"
  # If RPC ports (8080/8081) are publicly open in UFW → operator violates VDP.
  if ! require_cmd ufw || ! ufw status >/dev/null 2>&1; then
    return
  fi
  local ufw_status flagged=()
  ufw_status=$(ufw status 2>/dev/null)
  for rpc_port in 8080 8081; do
    # Anywhere = publicly exposed; we accept rules limited to specific source IPs
    if echo "$ufw_status" \
        | awk -v port="$rpc_port" '$0 ~ "^"port".*ALLOW.*Anywhere"' \
        | grep -q .; then
      flagged+=("$rpc_port")
    fi
  done
  if (( ${#flagged[@]} > 0 )); then
    emit security "rpc.exposure" FAIL "RPC port(s) ${flagged[*]} publicly exposed — VDP forbids 'external RPC servicing on validator nodes'" \
         "Restrict source: ufw delete allow ${flagged[0]}; ufw allow from <internal-ip> to any port ${flagged[0]}"
  else
    emit security "rpc.exposure" PASS "no RPC ports (8080/8081) publicly exposed"
  fi
}

check_iptables_udp_filter() {
  # Per docs.monad.xyz/node-ops/full-node-installation:
  #   "Additional iptables rule for robustness:
  #    sudo iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP"
  if ! command -v iptables >/dev/null; then
    emit security "iptables.udp-filter" INFO "iptables not installed — skipping check"
    return
  fi
  if iptables -C INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP 2>/dev/null; then
    emit security "iptables.udp-filter" PASS "UDP length filter on :8000 active (per docs)"
  else
    emit security "iptables.udp-filter" WARN "no UDP length 0:1400 DROP rule on :8000 — robustness against UDP DDoS missing" \
         "sudo iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP && netfilter-persistent save"
  fi
}

check_cve_2026_31431() {
  # Per Foundation Discord 2026-04-30 (ACTION RECOMMENDED):
  # algif_aead kernel module LPE — blacklist as mitigation.
  # PASS only if blacklisted (true mitigation). WARN if not loaded but not
  # blacklisted — module is one `modprobe` away from being exploitable.
  if [[ -f /etc/modprobe.d/disable-algif.conf ]] \
     && grep -q 'algif_aead' /etc/modprobe.d/disable-algif.conf 2>/dev/null; then
    emit security "cve.2026-31431" PASS "algif_aead blacklisted (CVE-2026-31431 mitigated)"
  elif ! lsmod 2>/dev/null | grep -q algif_aead; then
    emit security "cve.2026-31431" WARN "algif_aead not blacklisted — module not loaded now but can be loaded any time (CVE-2026-31431 LPE)" \
         "echo 'install algif_aead /bin/false' | sudo tee /etc/modprobe.d/disable-algif.conf"
  else
    emit security "cve.2026-31431" WARN "algif_aead loaded and not blacklisted — CVE-2026-31431 (LPE) unmitigated" \
         "echo 'install algif_aead /bin/false' | sudo tee /etc/modprobe.d/disable-algif.conf"
  fi
}

check_nvme_cli() {
  # Required for /dev/triedb LBA reformat (`nvme format` command).
  if command -v nvme >/dev/null; then
    emit security "deps.nvme-cli" PASS "nvme-cli installed"
  else
    emit security "deps.nvme-cli" WARN "nvme-cli not installed — needed for LBA reformat command" \
         "apt install -y nvme-cli"
  fi
}

check_ssh_hardening() {
  local sshd=/etc/ssh/sshd_config
  [[ -r "$sshd" ]] || { emit security "ssh.config" INFO "sshd_config not readable (skipped)"; return; }

  # PasswordAuthentication
  local pwauth
  pwauth=$(grep -E '^[[:space:]]*PasswordAuthentication' "$sshd" 2>/dev/null | awk '{print $2}' | tail -1)
  pwauth=${pwauth:-yes}  # default
  case "$pwauth" in
    no|No|NO)  emit security "ssh.passwordauth" PASS "PasswordAuthentication=no" ;;
    *)         emit security "ssh.passwordauth" WARN "PasswordAuthentication=$pwauth — bruteforce risk" \
                  "Set 'PasswordAuthentication no' in /etc/ssh/sshd_config && systemctl reload ssh" ;;
  esac

  # PermitRootLogin — but if PasswordAuth is already off, key-only root login
  # has the same effective security as 'prohibit-password'.
  local rootlogin
  rootlogin=$(grep -E '^[[:space:]]*PermitRootLogin' "$sshd" 2>/dev/null | awk '{print $2}' | tail -1)
  rootlogin=${rootlogin:-prohibit-password}
  case "$rootlogin" in
    no|No|NO|prohibit-password)
      emit security "ssh.rootlogin" PASS "PermitRootLogin=$rootlogin" ;;
    yes|Yes|YES)
      if [[ "$pwauth" == "no" || "$pwauth" == "No" || "$pwauth" == "NO" ]]; then
        emit security "ssh.rootlogin" INFO "PermitRootLogin=yes — but PasswordAuth=no, so effectively key-only" \
             "Optional tightening: set 'PermitRootLogin prohibit-password'"
      else
        emit security "ssh.rootlogin" WARN "PermitRootLogin=yes with password auth — risky" \
             "Set 'PermitRootLogin prohibit-password' or disable password auth first"
      fi ;;
    *)
      emit security "ssh.rootlogin" INFO "PermitRootLogin=$rootlogin" ;;
  esac
}

check_unattended_upgrades() {
  # Goal: keep security patches flowing, but prevent automatic reboots
  # mid-epoch. Disabling unattended-upgrades entirely is dangerous (CVE
  # exposure). Instead check for Automatic-Reboot=false setting.
  if ! dpkg -l unattended-upgrades 2>/dev/null | grep -qE '^.i  unattended-upgrades'; then
    emit security "auto-upgrades" INFO "unattended-upgrades not installed — security patches not auto-applied" \
         "Recommended: apt install -y unattended-upgrades and configure Automatic-Reboot=false"
    return
  fi
  if [[ -f /etc/apt/apt.conf.d/20auto-upgrades ]] \
     && grep -q '^APT::Periodic::Unattended-Upgrade "1"' /etc/apt/apt.conf.d/20auto-upgrades 2>/dev/null; then
    # Check whether automatic reboot is disabled
    if grep -rqE '^[[:space:]]*Unattended-Upgrade::Automatic-Reboot[[:space:]]+"?false"?' /etc/apt/apt.conf.d/ 2>/dev/null; then
      emit security "auto-upgrades" PASS "unattended-upgrades active, Automatic-Reboot=false (safe for validator)"
    else
      emit security "auto-upgrades" WARN "unattended-upgrades active but may auto-reboot mid-epoch" \
           "Configure no-reboot: echo 'Unattended-Upgrade::Automatic-Reboot \"false\";' | sudo tee /etc/apt/apt.conf.d/52monad-no-reboot"
    fi
  else
    emit security "auto-upgrades" INFO "unattended-upgrades installed but disabled — security patches not auto-applied"
  fi
}

check_fail2ban() {
  if systemctl is-active --quiet fail2ban 2>/dev/null; then
    emit security "fail2ban"     PASS "fail2ban active"
  else
    emit security "fail2ban"     INFO "fail2ban not active — recommended for SSH bruteforce protection" \
         "apt install -y fail2ban && systemctl enable --now fail2ban"
  fi
}

# ===== Section: MONAD-SPECIFIC (if already installed) =====
check_monad_user() {
  if id monad >/dev/null 2>&1; then
    emit monad "monad.user"      PASS "monad system user exists ($(id -u monad):$(id -g monad))"
  else
    emit monad "monad.user"      INFO "monad user not present (created automatically by package install)"
  fi
}

check_triedb_device() {
  # Docs require /dev/triedb to be a symlink to a dedicated NVMe partition (e.g. nvme1n1p1).
  # Created by /etc/monad-mpt/monad_mpt.toml and the monad-mpt one-shot service.
  if [[ -e /dev/triedb ]]; then
    if [[ -L /dev/triedb ]]; then
      local tgt
      tgt=$(readlink -f /dev/triedb)
      emit monad "monad.triedb"  PASS "/dev/triedb → ${tgt}"
    else
      emit monad "monad.triedb"  WARN "/dev/triedb exists but is not a symlink"
    fi
  else
    emit monad "monad.triedb"    INFO "/dev/triedb not present (created on first monad-mpt run)"
  fi
}

check_triedb_udev() {
  # Docs require a udev rule mapping the triedb partition's PARTUUID to the
  # /dev/triedb symlink so it survives reboot regardless of disk enumeration.
  # https://docs.monad.xyz/node-ops/full-node-installation (TrieDB section)
  local rule=/etc/udev/rules.d/99-triedb.rules
  if [[ -f "$rule" ]]; then
    if grep -qE 'SYMLINK\+="?triedb"?' "$rule" 2>/dev/null; then
      emit monad "monad.triedb-udev" PASS "$rule present with SYMLINK+=\"triedb\" rule"
    else
      emit monad "monad.triedb-udev" WARN "$rule exists but no SYMLINK+=\"triedb\" entry — /dev/triedb may not appear on reboot" \
           "Re-create the rule per docs: udev rule must contain SYMLINK+=\"triedb\""
    fi
  else
    if [[ -L /dev/triedb ]]; then
      emit monad "monad.triedb-udev" WARN "no $rule — /dev/triedb may disappear after reboot if created manually" \
           "Create per docs: ENV{ID_PART_ENTRY_UUID}==\"<PARTUUID>\", MODE=\"0666\", SYMLINK+=\"triedb\""
    else
      emit monad "monad.triedb-udev" INFO "$rule not present (created during validator-setup)"
    fi
  fi
}

check_cruft_timer() {
  # monad-cruft.timer is a stock hourly cleanup unit shipped by the monad
  # package (drops old artifacts so disk doesn't fill). Docs list it among
  # required services. systemctl returns non-zero if unit is missing/disabled.
  if systemctl cat monad-cruft.timer >/dev/null 2>&1; then
    if systemctl is-enabled --quiet monad-cruft.timer 2>/dev/null; then
      emit monad "monad.cruft-timer" PASS "monad-cruft.timer enabled (hourly artifact cleanup)"
    else
      emit monad "monad.cruft-timer" WARN "monad-cruft.timer present but not enabled — old artifacts will accumulate" \
           "systemctl enable --now monad-cruft.timer"
    fi
  else
    emit monad "monad.cruft-timer" INFO "monad-cruft.timer not installed (ships with monad package)"
  fi
}

check_authudp_config() {
  # Verify Auth UDP keys in correct TOML sections per docs.
  # https://docs.monad.xyz/node-ops/upgrade-instructions/auth-udp
  #   [peer_discovery] → self_auth_port, self_record_seq_num, self_name_record_sig
  #   [network]        → authenticated_bind_address_port
  if [[ ! -r "$MONAD_NODE_TOML" ]]; then
    emit monad "monad.authudp-cfg" INFO "node.toml not readable at $MONAD_NODE_TOML (skipped)"
    return
  fi

  # Helper: check if KEY appears under [SECTION] in $MONAD_NODE_TOML.
  # Uses awk to track current section header [..] and matches key only inside.
  toml_has_key_in_section() {
    local section="$1" key="$2"
    awk -v sec="[$section]" -v key="$key" '
      /^[[:space:]]*\[/ { current=$0; sub(/^[[:space:]]+/,"",current); sub(/[[:space:]]+$/,"",current) }
      $0 ~ "^[[:space:]]*"key"[[:space:]]*=" { if (current==sec) {found=1; exit} }
      END { exit !found }
    ' "$MONAD_NODE_TOML"
  }

  local missing=""
  for key in self_auth_port self_record_seq_num self_name_record_sig; do
    toml_has_key_in_section peer_discovery "$key" || missing+="[peer_discovery].$key "
  done
  toml_has_key_in_section network authenticated_bind_address_port \
    || missing+="[network].authenticated_bind_address_port "

  if [[ -z "$missing" ]]; then
    emit monad "monad.authudp-cfg" PASS "node.toml has all Auth UDP keys in correct sections"
  else
    emit monad "monad.authudp-cfg" FAIL "node.toml missing Auth UDP keys: $missing" \
         "Add to [peer_discovery] and [network] per docs: https://docs.monad.xyz/node-ops/upgrade-instructions/auth-udp"
  fi
}

check_github_release() {
  # Cross-check against the canonical GitHub release tag. Useful when apt is
  # not yet configured (greenfield host) or its cache is stale.
  # Independent source of truth — GitHub releases/latest excludes pre-releases.
  if ! command -v curl >/dev/null; then return; fi
  local latest installed
  installed=$(dpkg-query -W -f='${Version}' monad 2>/dev/null || true)
  latest=$(curl -fsS -m 5 -H 'Accept: application/vnd.github+json' \
    https://api.github.com/repos/category-labs/monad-bft/releases/latest 2>/dev/null \
    | grep -oE '"tag_name":[^,]+' | head -1 \
    | grep -oE 'v[0-9.]+(-[a-z0-9.]+)?' | sed 's/^v//')
  if [[ -z "$latest" ]]; then
    emit monad "monad.upstream" INFO "GitHub API unreachable (offline or rate-limited)"
    return
  fi
  if [[ -z "$installed" ]]; then
    emit monad "monad.upstream" INFO "GitHub latest stable: v$latest (monad not installed yet)"
  elif [[ "$latest" == "$installed" ]]; then
    emit monad "monad.upstream" PASS "matches GitHub latest stable (v$latest)"
  else
    # Distinguish "we're ahead" (e.g. on RC) vs "we're behind"
    if printf '%s\n%s\n' "$latest" "$installed" | sort -V -C 2>/dev/null; then
      emit monad "monad.upstream" INFO "installed v$installed > GitHub latest stable v$latest (RC or pre-release?)"
    else
      emit monad "monad.upstream" WARN "GitHub stable v$latest > installed v$installed" \
           "Upgrade: apt-mark unhold monad; apt update; apt install --only-upgrade monad; apt-mark hold monad"
    fi
  fi
}

check_monad_install() {
  # dpkg -l states: ii=installed, hi=hold+installed, rc=removed-config, etc.
  # Match anything where 2nd char is 'i' (installed).
  if ! dpkg -l monad 2>/dev/null | grep -qE '^.i  monad'; then
    emit monad "monad.installed" INFO "monad package not installed (this is a pre-flight check, OK)"
    return
  fi

  local installed available state
  installed=$(dpkg-query -W -f='${Version}' monad 2>/dev/null || echo "?")
  state=$(dpkg -l monad 2>/dev/null | awk '/^.i  monad/ {print $1; exit}')
  # apt list output: "monad/noble 0.14.3 amd64 [upgradable from: 0.14.2]"
  # Field 2 (after split by space) is the version.
  available=$(apt list --upgradable 2>/dev/null | awk '/^monad\// {print $2}' | head -1)

  if [[ "$state" == "hi" ]]; then
    emit monad "monad.installed" INFO "monad on hold — apt won't auto-upgrade (intentional?)"
  fi

  if [[ -n "$available" && "$available" != "$installed" ]]; then
    emit monad "monad.version"   WARN "installed=$installed, available=$available" \
         "Update: apt update && apt install --only-upgrade monad (or unhold first: apt-mark unhold monad)"
  else
    emit monad "monad.version"   PASS "installed=$installed (latest)"
  fi

  # Auth UDP check — wireauth log entries (DEBUG level, may need broader scan)
  if systemctl is-active --quiet monad-bft 2>/dev/null; then
    # Scan last 500 lines instead of time-based — DEBUG messages may be rotated
    if journalctl -u monad-bft -n 500 --no-pager 2>/dev/null | grep -q monad_wireauth; then
      emit monad "monad.authudp" PASS "Auth UDP active (wireauth sessions in logs)"
    else
      emit monad "monad.authudp" WARN "no wireauth log entries — Auth UDP may not be active or DEBUG logs disabled" \
           "Verify: journalctl -u monad-bft -n 1000 | grep wireauth"
    fi
  fi
}

# ===== Run all checks =====
header() {
  [[ $JSON_OUTPUT -eq 1 ]] && return
  cat <<EOF
${C_BOLD}${C_PURPLE}
  ╔══════════════════════════════════════════════╗
  ║       monad-doctor — pre-flight check        ║
  ║       BeeHive monad-tools                    ║
  ╚══════════════════════════════════════════════╝${C_RESET}
  Hostname: $(hostname)
  Date:     $(date -u +%Y-%m-%dT%H:%M:%SZ)
  $([ $QUICK_MODE -eq 1 ] && echo "Mode:     ${C_YELLOW}quick (--quick)${C_RESET}")
EOF
}

check_authudp_peers() {
  # Runtime visibility into Auth UDP health: count unique peer endpoints that
  # have sent keepalives recently. Complements monad.authudp (which only
  # confirms the receiver is logging) and monad.authudp-cfg (which only
  # confirms node.toml has the right keys).
  #
  # Thresholds chosen from operational experience:
  #   ≥5 peers → healthy mesh
  #   1-4 peers → restart artefact or NAT trouble — investigate
  #   0 peers → Auth UDP not actually negotiating; service may be running
  #             but isolated (firewall, missing self_name_record_sig, etc.)
  if ! command -v journalctl >/dev/null; then
    emit monad "monad.authudp-peers" INFO "journalctl unavailable — cannot count keepalive peers"
    return
  fi
  if ! systemctl is-active --quiet monad-bft 2>/dev/null; then
    emit monad "monad.authudp-peers" INFO "monad-bft not active — skipping peer count"
    return
  fi
  # remote_addr may be IPv4 ("1.2.3.4:port") or IPv6 ("[::1]:port"). Match both.
  local peers
  peers=$(journalctl -u monad-bft -n 2000 --no-pager 2>/dev/null \
    | grep 'sending keepalive packet' \
    | grep -oE 'remote_addr":"[^"]+' \
    | sort -u | wc -l)
  if (( peers >= 5 )); then
    emit monad "monad.authudp-peers" PASS "$peers unique peers in recent keepalives (healthy mesh)"
  elif (( peers > 0 )); then
    emit monad "monad.authudp-peers" WARN "only $peers peer(s) in keepalives — small set, check NAT/firewall" \
         "Verify: journalctl -u monad-bft -n 2000 | grep 'sending keepalive packet'"
  else
    emit monad "monad.authudp-peers" INFO "no recent keepalive activity — Auth UDP may not be negotiating or DEBUG logs disabled"
  fi
}

check_vdp_otel_collector() {
  # MF VDP (May 2026 email) requires every validator to push OTel metrics to
  # otel-external.monadinfra.com:443. That needs an active OTel collector.
  # Plain `otelcol` ships with Monad apt package; `otelcol-contrib` is sometimes
  # installed separately for journald receivers (logs → Loki). Either is fine —
  # VDP only cares the push works.
  local active=""
  for svc in otelcol otelcol-contrib; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      active="$svc"
      break
    fi
  done
  if [[ -z "$active" ]]; then
    emit monad "vdp.otel-collector" FAIL "no active OTel collector — VDP requires metrics push to MF" \
         "Monad apt package installs otelcol; ensure: sudo systemctl enable --now otelcol"
    return
  fi
  emit monad "vdp.otel-collector" PASS "$active.service active"
}

check_vdp_otel_version() {
  # MF VDP setup script (May 2026) targets otelcol >= 0.139.0 — earlier versions
  # lack the resource processor attributes used by MF config.
  local required="0.139.0"
  local bin=""
  for svc in otelcol otelcol-contrib; do
    if systemctl is-active --quiet "$svc" 2>/dev/null && command -v "$svc" >/dev/null 2>&1; then
      bin="$svc"
      break
    fi
  done
  if [[ -z "$bin" ]]; then
    emit monad "vdp.otel-version" INFO "no active OTel collector to version-check"
    return
  fi
  local ver
  ver=$("$bin" --version 2>/dev/null | awk '{print $NF; exit}')
  if [[ -z "$ver" ]]; then
    emit monad "vdp.otel-version" WARN "could not determine $bin version"
    return
  fi
  if dpkg --compare-versions "$ver" ge "$required" 2>/dev/null; then
    emit monad "vdp.otel-version" PASS "$bin v$ver (>= $required required by MF setup script)"
  else
    emit monad "vdp.otel-version" WARN "$bin v$ver < $required — MF setup script targets $required" \
         "MF setup script auto-installs the right version; or upgrade manually: apt install otelcol=$required-1"
  fi
}

check_vdp_secp_key_label() {
  # MF VDP compliance check: every monad_* metric served by local Prometheus
  # exporter on :8889 must carry a secp_key="<pubkey>" label so MF can identify
  # the validator. This is exactly what the MF script's idempotency-check looks for.
  if ! command -v curl >/dev/null 2>&1; then
    emit monad "vdp.secp-key-label" INFO "curl not installed — skipping VDP label check"
    return
  fi
  local metrics_url="http://localhost:8889/metrics"
  local payload
  payload=$(curl -sf --max-time 5 "$metrics_url" 2>/dev/null) || {
    emit monad "vdp.secp-key-label" WARN "could not reach $metrics_url — OTel collector may not be exposing :8889" \
         "Check binding: ss -tln | grep 8889 (Monad apt config or MF setup script should bind it)"
    return
  }
  local secp
  secp=$(printf '%s\n' "$payload" | grep -oE 'secp_key="[0-9a-f]{2,}"' | head -1 | sed 's/secp_key="\([0-9a-f]*\)"/\1/')
  if [[ -z "$secp" ]]; then
    emit monad "vdp.secp-key-label" FAIL "metrics on :8889 lack 'secp_key' label — NOT VDP-compliant" \
         "Run MF setup (testnet first): curl -fsSL -o /tmp/x.sh bucket.monadinfra.com/tmp/otel-validator-setup.sh && verify sha256 then sudo bash /tmp/x.sh"
    return
  fi
  local len=${#secp}
  if [[ $len -ge 64 ]]; then
    emit monad "vdp.secp-key-label" PASS "metrics tagged with secp_key=${secp:0:8}…${secp: -4} (VDP-compliant)"
  else
    emit monad "vdp.secp-key-label" WARN "secp_key label present but unusually short ($len chars)"
  fi
}

check_vdp_mf_push() {
  # MF push uses OTLP gRPC over TLS to otel-external.monadinfra.com:443 (Cloudflare-fronted).
  # We confirm a live push by counting ESTABLISHED TLS connections from the
  # otelcol process to :443 destinations.
  if ! command -v ss >/dev/null 2>&1; then
    emit monad "vdp.mf-push" INFO "ss not available — skipping connection check"
    return
  fi
  local otel_pids=""
  for svc in otelcol otelcol-contrib; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      local pid
      pid=$(systemctl show "$svc" --property=MainPID --value 2>/dev/null)
      [[ -n "$pid" && "$pid" != "0" ]] && otel_pids="$otel_pids $pid"
    fi
  done
  if [[ -z "$otel_pids" ]]; then
    emit monad "vdp.mf-push" INFO "no active otelcol process — already covered by vdp.otel-collector"
    return
  fi
  local conns=0
  for pid in $otel_pids; do
    local c
    c=$(ss -tnp 2>/dev/null | awk -v pid="pid=$pid," '$0 ~ pid && $5 ~ /:443$/' | wc -l)
    conns=$((conns + c))
  done
  if (( conns >= 1 )); then
    emit monad "vdp.mf-push" PASS "OTel collector has $conns active TLS connection(s) to :443 — push to MF appears active"
  else
    emit monad "vdp.mf-push" WARN "no ESTABLISHED :443 connections from otelcol — push to MF may not be configured" \
         "Verify exporter 'otlp/monadinfra' → https://otel-external.monadinfra.com:443; check: journalctl -u <svc> | grep -i monadinfra"
  fi
}

run_section() {
  local name="$1"; shift
  [[ -n "$SECTION" && "$SECTION" != "$name" ]] && return
  section_header "$(echo "$name" | tr a-z A-Z)"
  for fn in "$@"; do "$fn"; done
}

main() {
  header
  run_section hardware  check_baremetal check_cpu check_ram check_disks check_iops
  run_section os        check_os check_kernel check_ulimits check_sysctl check_ntp
  run_section network   check_public_ip check_bandwidth check_ports_free check_firewall
  run_section security  check_ssh_hardening check_unattended_upgrades check_fail2ban \
                        check_rpc_exposure check_iptables_udp_filter check_cve_2026_31431 \
                        check_nvme_cli
  run_section monad     check_monad_user check_triedb_device check_triedb_udev \
                        check_cruft_timer check_monad_install \
                        check_github_release check_authudp_config check_authudp_peers \
                        check_vdp_otel_collector check_vdp_otel_version \
                        check_vdp_secp_key_label check_vdp_mf_push

  if [[ $JSON_OUTPUT -eq 1 ]]; then
    print_json
  else
    print_summary
  fi

  # Exit code
  if (( COUNT_FAIL > 0 )); then exit 2
  elif (( COUNT_WARN > 0 )); then exit 1
  else exit 0
  fi
}

print_summary() {
  echo
  printf "${C_BOLD}━━ Summary ━━${C_RESET}\n"
  printf "  ${C_GREEN}PASS${C_RESET}: %d   " "$COUNT_PASS"
  printf "${C_YELLOW}WARN${C_RESET}: %d   " "$COUNT_WARN"
  printf "${C_RED}FAIL${C_RESET}: %d   " "$COUNT_FAIL"
  printf "${C_BLUE}INFO${C_RESET}: %d\n" "$COUNT_INFO"
  echo

  if (( COUNT_FAIL > 0 )); then
    printf "${C_RED}${C_BOLD}✗ Verdict: NOT READY${C_RESET}\n"
    printf "  Fix the FAIL items before deploying a validator.\n"
  elif (( COUNT_WARN > 0 )); then
    printf "${C_YELLOW}${C_BOLD}! Verdict: READY WITH WARNINGS${C_RESET}\n"
    printf "  Node will run but address WARN items for best operation.\n"
  else
    printf "${C_GREEN}${C_BOLD}✓ Verdict: READY${C_RESET}\n"
    printf "  All checks passed. Server is ready for Monad validator deployment.\n"
  fi
  echo
}

json_escape() {
  # Properly escape a string for JSON: backslash, quote, control chars, newlines.
  # Uses python3 if available (most reliable), else minimal fallback.
  if command -v python3 >/dev/null; then
    python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.argv[1])[1:-1])' "$1"
  else
    # Fallback: handle backslash, quote, tab, newline, CR.
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
                          -e ':a;N;$!ba;s/\n/\\n/g' -e 's/\r/\\r/g' -e 's/\t/\\t/g'
  fi
}

print_json() {
  printf '{\n'
  printf '  "host": "%s",\n' "$(hostname)"
  printf '  "date": "%s",\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  printf '  "summary": {"pass": %d, "warn": %d, "fail": %d, "info": %d},\n' \
    "$COUNT_PASS" "$COUNT_WARN" "$COUNT_FAIL" "$COUNT_INFO"
  if (( COUNT_FAIL > 0 )); then printf '  "verdict": "NOT_READY",\n'
  elif (( COUNT_WARN > 0 )); then printf '  "verdict": "READY_WITH_WARNINGS",\n'
  else printf '  "verdict": "READY",\n'; fi
  printf '  "checks": [\n'
  local n=${#RESULTS_NAME[@]}
  for ((i=0; i<n; i++)); do
    local sep=","
    (( i == n-1 )) && sep=""
    printf '    {"section": "%s", "name": "%s", "status": "%s", "message": "%s", "fix": "%s"}%s\n' \
      "$(json_escape "${RESULTS_SECTION[i]}")" \
      "$(json_escape "${RESULTS_NAME[i]}")" \
      "$(json_escape "${RESULTS_STATUS[i]}")" \
      "$(json_escape "${RESULTS_MSG[i]}")" \
      "$(json_escape "${RESULTS_FIX[i]}")" \
      "$sep"
  done
  printf '  ]\n'
  printf '}\n'
}

main
