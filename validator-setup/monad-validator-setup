#!/usr/bin/env bash
# monad-validator-setup — one-shot Monad validator host configuration
# Project: BeeHive monad-tools
# Repo: https://github.com/BeeHiveTeam/monad-tools
#
# What it does (idempotent, safe to re-run):
#   1. Run monad-doctor preflight (abort on FAIL unless --skip-preflight)
#   2. Tune kernel (sysctl): network buffers, swappiness, file-max
#   3. Tune ulimits: /etc/security/limits.conf
#   4. Set IO scheduler to mq-deadline on triedb device
#   5. Install chrony (replace systemd-timesyncd if active)
#   6. Add Monad apt repository and install `monad` package
#   7. Enable otelcol if shipped by monad pkg and has a config (skipped on contrib setups)
#   8. Configure UFW firewall (Monad ports + SSH)
#   9. Optionally install BeeHive monad-grafana monitoring stack
#  10. Optionally enable VDP OTel push to Monad Foundation (--with-vdp-otel)
#  11. Print post-install report and next steps for keys + start
#
# What it deliberately does NOT do:
#   - Generate or import validator keys (you must do this manually)
#   - Start monad-bft.service (you start it after placing keys)
#   - Touch existing files without backup (.bak.<timestamp>)
#
# Usage:
#   sudo ./monad-validator-setup                       # interactive (asks network)
#   sudo ./monad-validator-setup --network=testnet     # skip prompt
#   sudo ./monad-validator-setup --network=mainnet --non-interactive
#   sudo ./monad-validator-setup --full-node           # full-node template (default: validator)
#   sudo ./monad-validator-setup --dry-run             # show what would change
#   sudo ./monad-validator-setup --triedb-dev=nvme1n1
#   sudo ./monad-validator-setup --with-monitoring     # also install monad-grafana
#   sudo ./monad-validator-setup --with-vdp-otel       # run MF VDP OTel push setup (testnet first!)
#   sudo ./monad-validator-setup --skip-preflight      # skip monad-doctor
#   sudo ./monad-validator-setup --uninstall           # remove (best-effort)

set -u

# ===== Defaults =====
NON_INTERACTIVE=0
DRY_RUN=0
SKIP_PREFLIGHT=0
WITH_MONITORING=0
WITH_VDP_OTEL=0
TRIEDB_DEV=""
NETWORK=""                  # testnet | mainnet — asked interactively if empty
NODE_TYPE="validator"       # validator | full — affects which node.toml to fetch
ACTION="install"
LOG_FILE="/tmp/monad-validator-setup-$(date +%Y%m%d-%H%M%S).log"
TS=$(date -u +%Y%m%d-%H%M%S)
DOCTOR_PATH="$(dirname "$0")/../doctor/monad-doctor"
REPORT_FILE="/var/lib/monad-validator-setup/report-${TS}.json"

# Monad foundation config bucket per docs (full-node-installation page).
MF_BUCKET="${MF_BUCKET:-https://bucket.monadinfra.com}"

# Tuning values
SYSCTL_RMEM=16777216
SYSCTL_WMEM=16777216
SYSCTL_NETDEV_BACKLOG=5000
SYSCTL_FILE_MAX=2097152
SYSCTL_SWAPPINESS=1
ULIMIT_NOFILE=1048576

# Official Monad apt repo (Category Labs).
# Source: https://docs.monad.xyz/node-ops/full-node-installation
MONAD_APT_REPO="${MONAD_APT_REPO:-https://pkg.category.xyz/}"
MONAD_APT_SUITE="${MONAD_APT_SUITE:-noble}"
# Foundation moved the key 2026-05-14: was /category-labs.gpg (binary, now 403),
# now /keys/public-key.asc (ASCII-armored — requires `gpg --dearmor`).
MONAD_APT_KEY_URL="${MONAD_APT_KEY_URL:-https://pkg.category.xyz/keys/public-key.asc}"
MONAD_APT_KEYRING="${MONAD_APT_KEYRING:-/etc/apt/keyrings/category-labs.gpg}"
# Pin version per docs — testnet and mainnet currently ship different versions.
# Source: https://docs.monad.xyz/node-ops/full-node-installation
# Resolved after --network=/choose_network. Set MONAD_PKG_VERSION explicitly to override
# both defaults, or set it empty to install "latest" available in the apt repo.
MONAD_PKG_VERSION_TESTNET="${MONAD_PKG_VERSION_TESTNET:-0.14.3}"
MONAD_PKG_VERSION_MAINNET="${MONAD_PKG_VERSION_MAINNET:-0.14.2}"
MONAD_PKG_VERSION="${MONAD_PKG_VERSION-__auto__}"   # __auto__ = pick by NETWORK later

# UFW ports per docs:
#   - SSH (22/tcp)
#   - 8000 (TCP+UDP — consensus P2P)
#   - 8001/udp (Authenticated UDP)
UFW_SSH_PORT="22"
UFW_P2P_PORT="8000"        # both TCP and UDP
UFW_AUTHUDP_PORT="8001"    # UDP only

# ===== Colors =====
if [[ -t 1 ]]; then
  C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[0;33m'
  C_BLUE=$'\033[0;34m'; C_PURPLE=$'\033[0;35m'; C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_PURPLE=""; C_BOLD=""; C_DIM=""; C_RESET=""
fi

info()    { echo "${C_BLUE}[i]${C_RESET} $*"; }
ok()      { echo "${C_GREEN}[✓]${C_RESET} $*"; }
warn()    { echo "${C_YELLOW}[!]${C_RESET} $*" >&2; }
err()     { echo "${C_RED}[✗]${C_RESET} $*" >&2; }
fatal()   { err "$*"; exit 1; }
section() { echo; echo "${C_BOLD}${C_PURPLE}━━ $* ━━${C_RESET}"; }

# ===== Args =====
while [[ $# -gt 0 ]]; do
  case "$1" in
    --non-interactive) NON_INTERACTIVE=1 ;;
    --dry-run)         DRY_RUN=1 ;;
    --skip-preflight)  SKIP_PREFLIGHT=1 ;;
    --with-monitoring) WITH_MONITORING=1 ;;
    --with-vdp-otel)   WITH_VDP_OTEL=1 ;;
    --triedb-dev=*)    TRIEDB_DEV="${1#*=}" ;;
    --network=*)       NETWORK="${1#*=}" ;;
    --node-type=*)     NODE_TYPE="${1#*=}" ;;
    --full-node)       NODE_TYPE="full" ;;
    --uninstall)       ACTION="uninstall" ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) fatal "Unknown option: $1 (try --help)" ;;
  esac
  shift
done

# Validate flags
case "$NETWORK" in
  ""|testnet|mainnet) ;;
  *) fatal "Invalid --network='$NETWORK' (must be 'testnet' or 'mainnet')" ;;
esac
case "$NODE_TYPE" in
  validator|full) ;;
  *) fatal "Invalid --node-type='$NODE_TYPE' (must be 'validator' or 'full')" ;;
esac

# ===== Pre-checks =====
[[ $EUID -eq 0 ]] || fatal "Run as root: sudo $0 $*"

confirm() {
  [[ $NON_INTERACTIVE -eq 1 ]] && { info "(non-interactive: assuming Yes for: $1)"; return 0; }
  local ans
  read -rp "${C_YELLOW}?${C_RESET} $1 [Y/n] " ans
  [[ ! "$ans" =~ ^[Nn]$ ]]
}

# Ask the operator to choose network if not provided via --network=.
choose_network() {
  if [[ -n "$NETWORK" ]]; then
    info "Network: ${C_BOLD}${NETWORK}${C_RESET} (from --network=${NETWORK})"
    resolve_pkg_version
    return 0
  fi
  if [[ $NON_INTERACTIVE -eq 1 ]]; then
    fatal "--network=testnet or --network=mainnet required in --non-interactive mode"
  fi
  echo
  echo "${C_BOLD}Which Monad network are you setting up this node for?${C_RESET}"
  echo "  1) testnet  (recommended for first deployment; VDP requires testnet validator)"
  echo "  2) mainnet"
  local ans
  while true; do
    read -rp "${C_YELLOW}?${C_RESET} Choose [1/2]: " ans
    case "$ans" in
      1|testnet) NETWORK="testnet"; break ;;
      2|mainnet) NETWORK="mainnet"; break ;;
      *)         echo "  Please enter 1 or 2." ;;
    esac
  done
  info "Network: ${C_BOLD}${NETWORK}${C_RESET}"
  resolve_pkg_version
}

# Resolve MONAD_PKG_VERSION from per-network defaults if user did not set it
# explicitly. Empty value means "install latest available in apt repo".
resolve_pkg_version() {
  if [[ "$MONAD_PKG_VERSION" == "__auto__" ]]; then
    case "$NETWORK" in
      testnet) MONAD_PKG_VERSION="$MONAD_PKG_VERSION_TESTNET" ;;
      mainnet) MONAD_PKG_VERSION="$MONAD_PKG_VERSION_MAINNET" ;;
      *)       MONAD_PKG_VERSION="" ;;
    esac
    info "Pinned monad version for ${NETWORK}: ${C_BOLD}${MONAD_PKG_VERSION:-latest}${C_RESET} (default per docs)"
  else
    info "Pinned monad version: ${C_BOLD}${MONAD_PKG_VERSION:-latest}${C_RESET} (from MONAD_PKG_VERSION env)"
  fi
}

run() {
  # run <description> <cmd...>  — runs (or echoes if dry-run) and logs
  local desc="$1"; shift
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] $desc:${C_RESET} $*"
    return 0
  fi
  echo "  ${C_DIM}→ $desc${C_RESET}" >>"$LOG_FILE"
  if "$@" >>"$LOG_FILE" 2>&1; then
    return 0
  else
    local rc=$?
    err "Command failed (rc=$rc): $*"
    err "  See $LOG_FILE for details"
    return $rc
  fi
}

backup_file() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  local bak="${f}.bak.${TS}"
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] backup: $f → $bak${C_RESET}"
    return 0
  fi
  cp -p "$f" "$bak" && echo "  ${C_DIM}backup: $bak${C_RESET}"
}

ensure_line() {
  # ensure_line <file> <line>  — adds line if absent (idempotent)
  local file="$1" line="$2"
  if [[ -f "$file" ]] && grep -qxF "$line" "$file"; then
    return 0
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] add to $file:${C_RESET} $line"
    return 0
  fi
  backup_file "$file"
  echo "$line" >>"$file"
}

# ===== Step: preflight =====
step_preflight() {
  section "Pre-flight (monad-doctor)"

  if (( SKIP_PREFLIGHT )); then
    info "Skipping preflight (--skip-preflight)"
    return 0
  fi

  if [[ ! -x "$DOCTOR_PATH" ]]; then
    warn "monad-doctor not found at $DOCTOR_PATH — skipping preflight"
    warn "Get it: git clone https://github.com/BeeHiveTeam/monad-tools.git"
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] would run: $DOCTOR_PATH --quick${C_RESET}"
    return 0
  fi

  info "Running monad-doctor (this is read-only, no system changes)…"
  "$DOCTOR_PATH" --quick
  local rc=$?
  case $rc in
    0) ok "Preflight: all clean" ;;
    1) warn "Preflight: warnings (continuing)" ;;
    2)
      err "Preflight: FAIL — server not ready for validator"
      if confirm "Continue anyway? (NOT recommended)"; then
        warn "Continuing despite preflight failures"
      else
        fatal "Aborted by user"
      fi ;;
    *) warn "Preflight: unknown exit code $rc" ;;
  esac
}

# ===== Step: dependencies =====
# Per docs (full-node-installation): apt install -y curl nvme-cli aria2 jq
step_dependencies() {
  section "System dependencies (per docs)"
  # gnupg: needed to dearmor the ASCII-armored apt signing key (since 2026-05-14).
  local pkgs=(curl gnupg nvme-cli aria2 jq ethtool ufw iptables iptables-persistent)
  local missing=()
  for p in "${pkgs[@]}"; do
    dpkg -l "$p" 2>/dev/null | grep -qE '^.i  ' || missing+=("$p")
  done
  if (( ${#missing[@]} == 0 )); then
    ok "All dependencies installed: ${pkgs[*]}"
    return
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] apt install -y ${missing[*]}${C_RESET}"
    return
  fi
  # iptables-persistent prompts non-interactively — preseed answers.
  echo iptables-persistent iptables-persistent/autosave_v4 boolean true | debconf-set-selections
  echo iptables-persistent iptables-persistent/autosave_v6 boolean true | debconf-set-selections
  run "apt update" apt-get update -qq
  run "installing missing deps: ${missing[*]}" apt-get install -y "${missing[@]}"
  ok "Dependencies installed."
}

# ===== Step: monad user / directories =====
# Per docs: useradd -m -s /bin/bash monad
#          mkdir -p /home/monad/monad-bft/{config,ledger,config/forkpoint,config/validators}
step_monad_user() {
  section "Monad user / directories (per docs)"
  if id monad >/dev/null 2>&1; then
    ok "user 'monad' already exists ($(id -u monad):$(id -g monad))"
  else
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] useradd -m -s /bin/bash monad${C_RESET}"
    else
      run "creating user monad" useradd -m -s /bin/bash monad
    fi
  fi
  local dirs=(
    /home/monad/monad-bft/config
    /home/monad/monad-bft/ledger
    /home/monad/monad-bft/config/forkpoint
    /home/monad/monad-bft/config/validators
  )
  for d in "${dirs[@]}"; do
    if [[ -d "$d" ]]; then
      :
    elif (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] mkdir -p $d${C_RESET}"
    else
      mkdir -p "$d"
    fi
  done
  if (( DRY_RUN == 0 )) && id monad >/dev/null 2>&1; then
    chown -R monad:monad /home/monad/monad-bft 2>/dev/null || true
  fi
  ok "Directory tree under /home/monad/monad-bft/ ready"
}

# ===== Step: iptables UDP DDoS filter =====
# Per docs: sudo iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP
step_iptables_ddos() {
  section "iptables UDP length filter (per docs)"
  if ! command -v iptables >/dev/null; then
    warn "iptables not installed — skipping (install via step_dependencies)"
    return
  fi
  if iptables -C INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP 2>/dev/null; then
    ok "rule already present"
    return
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP${C_RESET}"
    echo "  ${C_DIM}[dry-run] netfilter-persistent save${C_RESET}"
    return
  fi
  # An iptables INSERT runs ahead of any existing rules on the INPUT chain and
  # can interact badly with custom netfilter setups (frr/bird/k8s/wireguard).
  # Operators with their own firewall stack should review before we touch it.
  info "Will add: iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP"
  info "(drops short UDP packets <1400B on :8000 — valid raptorcast traffic is larger)"
  if ! confirm "Add this iptables rule?"; then
    warn "Skipped — docs recommend this rule for UDP DDoS robustness"
    return 0
  fi
  run "adding UDP length 0:1400 DROP rule" \
    iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP
  if command -v netfilter-persistent >/dev/null; then
    run "persisting iptables rules" netfilter-persistent save
  else
    warn "netfilter-persistent not available — rule will be lost on reboot"
  fi
  ok "UDP length filter active and persisted"
}

# ===== Step: /dev/triedb SYMLINK udev rule =====
# Per docs:
#   PARTUUID=$(lsblk -o PARTUUID $TRIEDB_DRIVE | tail -n 1)
#   echo "ENV{ID_PART_ENTRY_UUID}==\"$PARTUUID\", MODE=\"0666\", SYMLINK+=\"triedb\"" \
#     | tee /etc/udev/rules.d/99-triedb.rules
step_triedb_symlink() {
  section "TriedB SYMLINK udev rule (per docs)"
  local rule=/etc/udev/rules.d/99-triedb.rules

  # Identify triedb partition: prefer existing /dev/triedb symlink; else
  # nothing to do (operator must partition first or specify --triedb-dev=).
  local triedb_part=""
  if [[ -L /dev/triedb ]]; then
    triedb_part=$(readlink -f /dev/triedb)
  fi
  if [[ -z "$triedb_part" || ! -b "$triedb_part" ]]; then
    info "No triedb partition detected (/dev/triedb missing) — operator must"
    info "partition the triedb device first, then re-run this step."
    return
  fi

  local partuuid
  partuuid=$(lsblk -no PARTUUID "$triedb_part" 2>/dev/null | tr -d ' ')
  if [[ -z "$partuuid" ]]; then
    warn "Could not read PARTUUID of $triedb_part — skipping symlink rule"
    return
  fi

  local content="# monad-validator-setup ${TS}
ENV{ID_PART_ENTRY_UUID}==\"${partuuid}\", MODE=\"0666\", SYMLINK+=\"triedb\"
"
  if [[ -f "$rule" ]] && [[ "$(cat "$rule" 2>/dev/null)" == "$content" ]]; then
    ok "udev rule for triedb SYMLINK already in place (PARTUUID=$partuuid)"
    return
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write $rule with PARTUUID=$partuuid${C_RESET}"
    return
  fi
  backup_file "$rule"
  echo "$content" >"$rule"
  ok "Wrote $rule (PARTUUID=$partuuid)"
  run "reloading udev" udevadm control --reload-rules
}

# ===== Step: download config files (.env + node.toml) =====
# Per docs (full-node-installation):
#   curl -o /home/monad/.env $MF_BUCKET/config/<network>/latest/.env.example
#   curl -o /home/monad/monad-bft/config/node.toml \
#        $MF_BUCKET/config/<network>/latest/<full-node-node.toml | node.toml>
# Validator template is `node.toml`; full-node template is `full-node-node.toml`.
step_config_files() {
  section "Bootstrap config files (.env + node.toml)"

  if [[ -z "$NETWORK" ]]; then
    warn "Network not chosen — skipping config download (run choose_network first)"
    return
  fi

  local env_file=/home/monad/.env
  local node_toml=/home/monad/monad-bft/config/node.toml
  local toml_name
  if [[ "$NODE_TYPE" == "validator" ]]; then
    toml_name="node.toml"
  else
    toml_name="full-node-node.toml"
  fi
  local env_url="${MF_BUCKET}/config/${NETWORK}/latest/.env.example"
  local toml_url="${MF_BUCKET}/config/${NETWORK}/latest/${toml_name}"

  # .env — preserve if already exists (operator may have customized)
  if [[ -f "$env_file" ]]; then
    info ".env already present — keeping (delete first to re-download)"
  elif (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -o $env_file $env_url${C_RESET}"
  else
    mkdir -p "$(dirname "$env_file")"
    if run "downloading .env (${NETWORK})" curl -fsSL --max-time 30 -o "$env_file" "$env_url"; then
      chown monad:monad "$env_file" 2>/dev/null || true
      chmod 0644 "$env_file"
      ok "Wrote $env_file (from $env_url)"
    else
      warn "Failed to download .env — operator must place manually"
      return 1
    fi
  fi

  # node.toml — preserve if already exists
  if [[ -f "$node_toml" ]]; then
    info "node.toml already present — keeping (delete first to re-download)"
  elif (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -o $node_toml $toml_url${C_RESET}"
  else
    mkdir -p "$(dirname "$node_toml")"
    if run "downloading node.toml (${NODE_TYPE} on ${NETWORK})" \
         curl -fsSL --max-time 30 -o "$node_toml" "$toml_url"; then
      chown monad:monad "$node_toml" 2>/dev/null || true
      chmod 0644 "$node_toml"
      ok "Wrote $node_toml (from $toml_url)"
    else
      warn "Failed to download node.toml — operator must place manually"
      return 1
    fi
  fi
}

# ===== Step: enable monad-cruft.timer =====
step_cruft_timer() {
  section "monad-cruft.timer (hourly cleanup)"
  if ! systemctl cat monad-cruft.timer >/dev/null 2>&1; then
    info "monad-cruft.timer not installed (will appear after monad package install)"
    return
  fi
  if systemctl is-active --quiet monad-cruft.timer; then
    ok "monad-cruft.timer already active"
    return
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] systemctl enable --now monad-cruft.timer${C_RESET}"
    return
  fi
  run "enabling monad-cruft.timer" systemctl enable --now monad-cruft.timer
  ok "monad-cruft.timer active"
}

# ===== Step: sysctl =====
step_sysctl() {
  section "Kernel tuning (sysctl)"

  local conf=/etc/sysctl.d/99-monad-validator.conf
  local content
  content="# monad-validator-setup ${TS}
# Network buffers — raptorcast UDP throughput
net.core.rmem_max = $SYSCTL_RMEM
net.core.wmem_max = $SYSCTL_WMEM
net.core.rmem_default = $SYSCTL_RMEM
net.core.wmem_default = $SYSCTL_WMEM
net.core.netdev_max_backlog = $SYSCTL_NETDEV_BACKLOG
# File descriptors
fs.file-max = $SYSCTL_FILE_MAX
# Swap behaviour — validators must not swap
vm.swappiness = $SYSCTL_SWAPPINESS
# Reasonable defaults for high-perf servers
net.ipv4.tcp_fastopen = 3
"

  if [[ -f "$conf" ]] && [[ "$(cat "$conf" 2>/dev/null)" == "$content" ]]; then
    ok "sysctl already configured ($conf)"
    return 0
  fi

  backup_file "$conf"
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write $conf with monad tuning${C_RESET}"
    return 0
  fi
  echo "$content" >"$conf"
  ok "Wrote $conf"
  run "applying sysctl" sysctl --system
}

# ===== Step: ulimits =====
step_ulimits() {
  section "ulimits"

  local conf=/etc/security/limits.d/99-monad-validator.conf
  local content
  content="# monad-validator-setup ${TS}
* soft nofile $ULIMIT_NOFILE
* hard nofile $ULIMIT_NOFILE
root soft nofile $ULIMIT_NOFILE
root hard nofile $ULIMIT_NOFILE
"

  if [[ -f "$conf" ]] && [[ "$(cat "$conf" 2>/dev/null)" == "$content" ]]; then
    ok "ulimits already configured ($conf)"
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write $conf with nofile=$ULIMIT_NOFILE${C_RESET}"
    return 0
  fi
  echo "$content" >"$conf"
  ok "Wrote $conf (effective on next login or service restart)"
}

# ===== Step: IO scheduler =====
step_io_scheduler() {
  section "IO scheduler (mq-deadline on triedb)"

  local target="$TRIEDB_DEV"

  # Priority 1: explicit --triedb-dev= flag (already set in $target)

  # Priority 2: /dev/triedb symlink — authoritative, set by monad-mpt config
  if [[ -z "$target" && -L /dev/triedb ]]; then
    local triedb_part triedb_disk
    triedb_part=$(readlink -f /dev/triedb 2>/dev/null)
    triedb_part="${triedb_part##*/}"
    triedb_disk=$(lsblk -no PKNAME "/dev/${triedb_part}" 2>/dev/null | head -1)
    if [[ -n "$triedb_disk" ]]; then
      target="$triedb_disk"
      info "Detected triedb device from /dev/triedb → /dev/${triedb_part} (disk: $target)"
    fi
  fi

  # Priority 3: find an UNUSED NVMe — not part of OS RAID, not mounted, no role.
  # Avoid the dangerous "largest NVMe" guess that may pick the OS disk on
  # asymmetric setups where multiple disks share the same size.
  if [[ -z "$target" ]]; then
    local root_src root_dev parts_under_root=()
    root_src=$(findmnt -no SOURCE / 2>/dev/null)
    root_dev="${root_src##*/}"
    if [[ -n "$root_dev" && -e "/sys/block/$root_dev/md" ]]; then
      while IFS= read -r m; do
        parts_under_root+=("$m")
      done < <(ls "/sys/block/$root_dev/md/" 2>/dev/null | sed -n 's/^dev-//p')
    fi

    local best=""
    while IFS= read -r disk; do
      [[ -z "$disk" ]] && continue
      # Reject if any partition is a member of the root md array
      local skip=0
      for m in "${parts_under_root[@]}"; do
        if lsblk -ln -o NAME "/dev/$disk" 2>/dev/null | grep -qx "$m"; then skip=1; break; fi
      done
      (( skip )) && continue
      # Reject if anything under this disk is mounted at /
      if lsblk -ln -o MOUNTPOINT "/dev/$disk" 2>/dev/null | grep -qx "/"; then continue; fi
      # Reject if disk has any non-swap mounts (already in use for something)
      if lsblk -ln -o MOUNTPOINT "/dev/$disk" 2>/dev/null \
         | grep -vE '^$|^\[SWAP\]$' | grep -q .; then continue; fi
      # Pick the largest among remaining (unused) candidates.
      local size_b
      size_b=$(lsblk -bdn -o SIZE "/dev/$disk" 2>/dev/null)
      if [[ -z "$best" ]] || (( size_b > $(lsblk -bdn -o SIZE "/dev/$best" 2>/dev/null || echo 0) )); then
        best="$disk"
      fi
    done < <(lsblk -dn -o NAME,TYPE 2>/dev/null | awk '$2=="disk" && $1 ~ /^nvme/ {print $1}')

    if [[ -n "$best" ]]; then
      target="$best"
      info "/dev/triedb not present — picked unused NVMe '$target' as triedb candidate"
      info "(safer than 'largest NVMe' — won't accidentally select the OS disk)"
    fi
  fi

  if [[ -z "$target" ]]; then
    warn "No NVMe found — cannot tune IO scheduler"
    return 0
  fi

  local sched_file="/sys/block/$target/queue/scheduler"
  if [[ ! -f "$sched_file" ]]; then
    warn "$sched_file does not exist — skipping"
    return 0
  fi

  local cur
  cur=$(awk '{for(i=1;i<=NF;i++) if($i ~ /^\[/) {gsub(/[][]/,"",$i); print $i; exit}}' "$sched_file")
  if [[ "$cur" == "mq-deadline" ]]; then
    ok "$target already on mq-deadline"
  else
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] echo mq-deadline > $sched_file${C_RESET}"
    else
      echo mq-deadline > "$sched_file" && ok "$target: scheduler $cur → mq-deadline"
    fi
  fi

  # Persist via udev rule.
  # NOTE: match by attribute (rotational=0 → SSD), not by exact device name.
  # Hardcoding KERNEL=="nvme1n1" silently breaks if the operator swaps the
  # disk (RMA, upgrade) — udev no longer applies the scheduler.
  local rule=/etc/udev/rules.d/60-monad-triedb-scheduler.rules
  local rule_content="# monad-validator-setup ${TS}
# Apply mq-deadline to all NVMe SSDs (matches by attribute, not name).
# Required for triedb performance per Monad operator feedback.
ACTION==\"add|change\", SUBSYSTEM==\"block\", KERNEL==\"nvme*\", \\
  ATTR{queue/rotational}==\"0\", ATTR{queue/scheduler}=\"mq-deadline\"
"
  if [[ -f "$rule" ]] && [[ "$(cat "$rule")" == "$rule_content" ]]; then
    ok "udev rule already in place"
    return 0
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write udev rule $rule${C_RESET}"
    return 0
  fi
  echo "$rule_content" >"$rule"
  ok "Wrote udev rule (persists across reboots)"
  run "reloading udev" udevadm control --reload-rules
}

# ===== Step: chrony =====
step_chrony() {
  section "NTP (chrony)"

  if command -v chronyc >/dev/null && systemctl is-active --quiet chrony; then
    ok "chrony already active"
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] disable systemd-timesyncd, install chrony${C_RESET}"
    return 0
  fi

  # If a non-default NTP setup is in place (ntpd, custom chrony build, OpenNTPD,
  # whatever), replacing it silently can break time sync the operator carefully
  # configured. We only get here if `chrony` isn't already the active service.
  if systemctl is-active --quiet systemd-timesyncd; then
    info "systemd-timesyncd is active. It drifts ~10–100ms which inflates vote_delay."
    if ! confirm "Replace systemd-timesyncd with chrony?"; then
      warn "Keeping systemd-timesyncd — vote_delay metrics may be skewed"
      return 0
    fi
    info "Disabling systemd-timesyncd"
    systemctl disable --now systemd-timesyncd >>"$LOG_FILE" 2>&1
  else
    if ! confirm "Install and enable chrony for NTP?"; then
      warn "Skipping chrony install — ensure another NTP daemon is running"
      return 0
    fi
  fi

  run "installing chrony" apt-get install -y chrony
  run "starting chrony" systemctl enable --now chrony
  sleep 2
  if systemctl is-active --quiet chrony; then
    ok "chrony installed and active"
  else
    err "chrony failed to start"
    return 1
  fi
}

# ===== Step: monad apt repo + package =====
step_monad_install() {
  section "Monad package"

  # Already installed?
  if dpkg -l monad 2>/dev/null | grep -qE '^.i  monad'; then
    local cur
    cur=$(dpkg-query -W -f='${Version}' monad)
    ok "monad already installed (version $cur)"
    info "To upgrade: apt update && apt install --only-upgrade monad"
    return 0
  fi

  # Install apt repo if missing — uses deb822 .sources format per official docs
  local sources_file=/etc/apt/sources.list.d/category-labs.sources
  if [[ ! -f "$sources_file" ]]; then
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] add Category Labs apt repo (${MONAD_APT_REPO})${C_RESET}"
    else
      info "Adding Monad apt repository: $MONAD_APT_REPO (suite=$MONAD_APT_SUITE)"
      mkdir -p "$(dirname "$MONAD_APT_KEYRING")"
      # ASCII-armored key (.asc) — dearmor to keyring binary format that apt expects.
      run "fetching + dearmoring signing key" bash -c \
        "curl -fsSL '${MONAD_APT_KEY_URL}' | gpg --dearmor --yes -o '$MONAD_APT_KEYRING'"
      cat > "$sources_file" <<EOF
Types: deb
URIs: ${MONAD_APT_REPO}
Suites: ${MONAD_APT_SUITE}
Components: main
Signed-By: ${MONAD_APT_KEYRING}
EOF
      ok "Wrote $sources_file"
      run "apt update" apt-get update
    fi
  fi

  if (( DRY_RUN )); then
    if [[ -n "$MONAD_PKG_VERSION" ]]; then
      echo "  ${C_DIM}[dry-run] apt install monad=${MONAD_PKG_VERSION}${C_RESET}"
    else
      echo "  ${C_DIM}[dry-run] apt install monad (latest)${C_RESET}"
    fi
    return 0
  fi
  if [[ -n "$MONAD_PKG_VERSION" ]]; then
    run "installing monad=${MONAD_PKG_VERSION}" apt-get install -y "monad=${MONAD_PKG_VERSION}"
  else
    run "installing monad (latest)" apt-get install -y monad
  fi
  if dpkg -l monad 2>/dev/null | grep -qE '^.i  monad'; then
    ok "monad package installed"
  else
    err "monad install failed — check $LOG_FILE"
    return 1
  fi
}

# ===== Step: otelcol enable =====
# The Monad apt package installs an otelcol systemd unit but does NOT enable it.
# Without an active collector, doctor's `vdp.otel-collector` check FAILs and the
# node cannot push metrics to MF — VDP rejects nodes that don't report.
# We enable+start the plain `otelcol` only if:
#   - the unit exists (i.e. monad package shipped it)
#   - it is not already active
#   - a custom otelcol-contrib is NOT active (operator may run their own stack)
#   - it has a config file (skips clean-slate boxes where MF setup hasn't run yet)
# --with-vdp-otel layers MF push config on top via step_vdp_otel_push.
step_otelcol_enable() {
  section "OTel collector (otelcol)"

  if ! systemctl cat otelcol >/dev/null 2>&1; then
    info "otelcol.service not installed (ships with monad package) — skipping"
    return 0
  fi

  if systemctl is-active --quiet otelcol-contrib 2>/dev/null; then
    info "otelcol-contrib.service active — leaving plain otelcol alone (operator runs custom collector)"
    return 0
  fi

  if systemctl is-active --quiet otelcol; then
    ok "otelcol already active"
    return 0
  fi

  if [[ ! -s /etc/otelcol/config.yaml ]]; then
    warn "otelcol unit exists but /etc/otelcol/config.yaml is empty/missing — not auto-starting"
    warn "Run with --with-vdp-otel to install the MF push config, or write your own first."
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] systemctl enable --now otelcol${C_RESET}"
    return 0
  fi

  run "enabling otelcol" systemctl enable --now otelcol
  sleep 2
  if systemctl is-active --quiet otelcol; then
    ok "otelcol active — local metrics collector running"
  else
    err "otelcol failed to start — check: journalctl -u otelcol -n 100"
    return 1
  fi
}

# ===== Step: firewall (UFW) =====
step_firewall() {
  section "Firewall (UFW)"

  if ! command -v ufw >/dev/null; then
    info "Installing ufw…"
    run "installing ufw" apt-get install -y ufw
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] configure UFW: allow ${UFW_SSH_PORT}/tcp, ${UFW_P2P_PORT} (tcp+udp), ${UFW_AUTHUDP_PORT}/udp${C_RESET}"
    return 0
  fi

  # SSH (avoid lockout!)
  ufw allow "${UFW_SSH_PORT}/tcp" comment 'ssh' >>"$LOG_FILE" 2>&1 || true
  # 8000: consensus P2P — both TCP and UDP per docs
  ufw allow "${UFW_P2P_PORT}/tcp" comment 'monad p2p (tcp)' >>"$LOG_FILE" 2>&1 || true
  ufw allow "${UFW_P2P_PORT}/udp" comment 'monad p2p (udp/raptorcast)' >>"$LOG_FILE" 2>&1 || true
  # 8001: Authenticated UDP only
  ufw allow "${UFW_AUTHUDP_PORT}/udp" comment 'monad authenticated udp' >>"$LOG_FILE" 2>&1 || true

  if ! ufw status | grep -q "Status: active"; then
    if confirm "Enable UFW now?"; then
      ufw --force enable >>"$LOG_FILE" 2>&1
      ok "UFW enabled"
    else
      warn "UFW configured but not enabled — run 'sudo ufw enable' when ready"
    fi
  else
    ok "UFW rules added"
  fi
}

# ===== Step: monitoring (optional) =====
step_monitoring() {
  if (( WITH_MONITORING == 0 )); then
    info "Skipping monitoring (use --with-monitoring to install monad-grafana)"
    return 0
  fi
  section "Monitoring (BeeHive monad-grafana)"

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -fsSL https://raw.githubusercontent.com/BeeHiveTeam/monad-grafana/main/install.sh | sudo bash${C_RESET}"
    return 0
  fi

  info "Launching monad-grafana installer…"
  curl -fsSL https://raw.githubusercontent.com/BeeHiveTeam/monad-grafana/main/install.sh \
    | bash -s -- --non-interactive
}

# Per MF email (May 2026): every validator must push OTel metrics to
# otel-external.monadinfra.com:443 for VDP compliance. MF distributes the setup
# script via bucket.monadinfra.com with a verified sha256.
#
# Pinned sha256 for /tmp/otel-validator-setup.sh that was current as of 2026-05-14.
# If MF rotates the script, this check will (intentionally) fail — re-fetch the
# new sha256 from the official email/Discord before relaxing.
VDP_OTEL_SETUP_URL="${VDP_OTEL_SETUP_URL:-https://bucket.monadinfra.com/tmp/otel-validator-setup.sh}"
VDP_OTEL_SETUP_SHA256="${VDP_OTEL_SETUP_SHA256:-92cca0add5456db13c792b6e1b484999724b348ebd41a40a73d7f42086f26a23}"

step_vdp_otel_push() {
  if (( WITH_VDP_OTEL == 0 )); then
    info "Skipping VDP OTel push setup (use --with-vdp-otel to enable; testnet first!)"
    return 0
  fi
  section "VDP OTel push (Monad Foundation metrics export)"

  # Critical pre-conditions: KEYSTORE_PASSWORD must be in /home/monad/.env
  # (set by the operator when generating SECP/BLS keys). Without it, monad-keystore
  # can't recover the SECP pubkey that the MF script needs for the resource label.
  if [[ ! -f /home/monad/.env ]] || ! grep -q "^KEYSTORE_PASSWORD=" /home/monad/.env 2>/dev/null; then
    err "/home/monad/.env missing or has no KEYSTORE_PASSWORD — set it after generating keys"
    err "Skipping VDP setup. Re-run with --with-vdp-otel once keys are placed."
    return 1
  fi

  # Bail out cleanly if the operator runs a custom otelcol-contrib (e.g. ours
  # extended with journald → Loki). The MF script targets plain otelcol and would
  # write to /etc/otelcol/config.yaml which a contrib service doesn't read,
  # producing no error but no compliance either.
  if systemctl is-active --quiet otelcol-contrib 2>/dev/null; then
    warn "otelcol-contrib.service is active — MF setup script targets plain 'otelcol' and may NOT work on contrib setups"
    warn "Refer to https://github.com/BeeHiveTeam/monad-tools/blob/main/docs/vdp-otel-push.md"
    warn "Skipping --with-vdp-otel auto-apply. Apply the equivalent manually (see wiki) and re-check with monad-doctor."
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -fsSL -o /tmp/otel-validator-setup.sh $VDP_OTEL_SETUP_URL${C_RESET}"
    echo "  ${C_DIM}[dry-run] sha256sum -c against $VDP_OTEL_SETUP_SHA256${C_RESET}"
    echo "  ${C_DIM}[dry-run] sudo bash /tmp/otel-validator-setup.sh${C_RESET}"
    return 0
  fi

  info "Downloading MF VDP setup script…"
  curl -fsSL -o /tmp/otel-validator-setup.sh "$VDP_OTEL_SETUP_URL" \
    || { err "Failed to download $VDP_OTEL_SETUP_URL"; return 1; }

  info "Verifying sha256…"
  if ! echo "$VDP_OTEL_SETUP_SHA256  /tmp/otel-validator-setup.sh" | sha256sum -c; then
    err "SHA-256 mismatch — MF may have rotated the script."
    err "Verify the new sha256 from MF email/Discord and update VDP_OTEL_SETUP_SHA256."
    return 1
  fi

  info "Running MF VDP setup (idempotent on re-runs)…"
  bash /tmp/otel-validator-setup.sh
}

# ===== Step: report =====
step_report() {
  section "Post-install report"

  mkdir -p "$(dirname "$REPORT_FILE")"
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write report to $REPORT_FILE${C_RESET}"
    return 0
  fi

  cat >"$REPORT_FILE" <<EOF
{
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "host": "$(hostname)",
  "kernel": "$(uname -r)",
  "os": "$(. /etc/os-release; echo "$PRETTY_NAME")",
  "monad_version": "$(dpkg-query -W -f='${Version}' monad 2>/dev/null || echo "not-installed")",
  "tuning": {
    "sysctl_conf": "/etc/sysctl.d/99-monad-validator.conf",
    "limits_conf": "/etc/security/limits.d/99-monad-validator.conf",
    "udev_scheduler": "/etc/udev/rules.d/60-monad-triedb-scheduler.rules"
  },
  "log_file": "$LOG_FILE"
}
EOF
  ok "Report: $REPORT_FILE"
}

