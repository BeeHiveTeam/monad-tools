# ===== Uninstall (best-effort) =====
do_uninstall() {
  warn "This will REMOVE configuration files written by this installer."
  warn "It will NOT remove the monad package, chrony, ufw, or your keys."
  warn ""
  warn "${C_BOLD}If you ALSO want to remove the monad package + monad user${C_RESET},"
  warn "use --uninstall-deep instead. The order matters there: the monad"
  warn "postrm script (as of pkg.category.xyz monad 0.14.x) runs"
  warn "  crontab -u monad -r"
  warn "which FAILS if the monad user was already deleted — do apt purge"
  warn "BEFORE userdel, never the other way around. --uninstall-deep handles"
  warn "that ordering for you."
  confirm "Continue with config-only removal?" || { info "Aborted."; exit 0; }

  # /etc/sysctl.d/99-monad-validator.conf is from older script versions —
  # we no longer create it, but remove if present so a re-install doesn't
  # inherit stale tuning.
  for f in /etc/sysctl.d/99-monad-validator.conf \
           /etc/security/limits.d/99-monad-validator.conf \
           /etc/udev/rules.d/60-monad-triedb-scheduler.rules; do
    if [[ -f "$f" ]]; then
      rm -f "$f" && ok "Removed $f"
    fi
  done
  sysctl --system >/dev/null 2>&1 || true
  udevadm control --reload-rules 2>/dev/null || true
  ok "Configuration removed. Reboot recommended to fully reset kernel parameters."
}

# Full uninstall — removes the monad package + system user + all our configs.
# Order is critical: monad's postrm calls `crontab -u monad -r`, which fails
# if the monad user is already gone. So we MUST apt purge BEFORE userdel.
# DO NOT change the order below without testing both paths.
do_uninstall_deep() {
  warn "${C_BOLD}DEEP UNINSTALL${C_RESET} — this removes:"
  warn "  - all config files this installer wrote"
  warn "  - the monad apt package (apt-mark unhold + apt purge)"
  warn "  - the monad system user + /home/monad"
  warn "  - validator keys + KEYSTORE_PASSWORD backups"
  warn ""
  warn "Does NOT touch: chrony, ufw, otelcol, kernel parameters from monad pkg's"
  warn "                90-monad-network-buffer.conf (it's removed by apt purge)."
  if ! confirm_destructive "Wipe the monad install?"; then
    info "Aborted."
    exit 0
  fi

  # Stop services first — if monad-bft is running, files are locked / busy
  for s in monad-rpc monad-bft monad-execution monad-cruft.timer monad-mpt otelcol; do
    if systemctl is-active --quiet "$s" 2>/dev/null; then
      run "stopping $s" systemctl stop "$s" || true
    fi
    if systemctl is-enabled --quiet "$s" 2>/dev/null; then
      run "disabling $s" systemctl disable "$s" || true
    fi
  done

  # Apt purge BEFORE userdel — see comment above the function.
  if dpkg -l monad 2>/dev/null | grep -qE '^.i  monad'; then
    run "apt-mark unhold monad" apt-mark unhold monad || true
    run "apt purge monad" apt-get purge -y monad || warn "apt purge monad failed; the monad user / cron entry may need cleanup"
  fi
  if dpkg -l otelcol 2>/dev/null | grep -qE '^.i  otelcol'; then
    run "apt-mark unhold otelcol" apt-mark unhold otelcol || true
    run "apt purge otelcol" apt-get purge -y otelcol || true
  fi

  # NOW it's safe to remove the user — postrm ran while user still existed.
  if id monad >/dev/null 2>&1; then
    run "removing monad user + home" userdel -r monad || warn "userdel -r monad failed; remove /home/monad manually if needed"
  fi

  # Our config drop-ins
  for f in /etc/sysctl.d/99-monad-validator.conf \
           /etc/security/limits.d/99-monad-validator.conf \
           /etc/udev/rules.d/60-monad-triedb-scheduler.rules \
           /etc/udev/rules.d/99-triedb.rules \
           /etc/apt/sources.list.d/category-labs.sources \
           /etc/apt/keyrings/category-labs.gpg; do
    [[ -e "$f" ]] && rm -f "$f" && ok "Removed $f"
  done

  # Backup directory (with keystore password!) — don't auto-delete; print path.
  if [[ -d /opt/monad/backup ]]; then
    warn "/opt/monad/backup/ contains your KEYSTORE_PASSWORD + key backups."
    warn "NOT removing automatically. Delete manually after off-host backup:"
    warn "  sudo rm -rf /opt/monad/backup/"
  fi

  sysctl --system >/dev/null 2>&1 || true
  udevadm control --reload-rules 2>/dev/null || true
  ok "Deep uninstall complete. Reboot recommended."
}

# ===== Main =====
do_install() {
  echo "${C_BOLD}${C_PURPLE}"
  cat <<'EOF'
  ╔══════════════════════════════════════════════╗
  ║   monad-validator-setup — host preparation   ║
  ║   BeeHive monad-tools                        ║
  ╚══════════════════════════════════════════════╝
EOF
  echo "${C_RESET}"

  cat <<EOF
${C_BOLD}This script will install a Monad node end-to-end (25 steps, ~5–10 min):${C_RESET}

  ${C_BLUE}①${C_RESET} Verify hardware/OS (monad-doctor preflight)
  ${C_BLUE}②${C_RESET} Install OS packages (curl, gnupg, ufw, parted, python3, …)
  ${C_BLUE}③${C_RESET} Create 'monad' user + /home/monad/monad-bft directory tree
  ${C_BLUE}④${C_RESET} Partition a free NVMe disk for /dev/triedb ${C_YELLOW}(destructive — asks first)${C_RESET}
  ${C_BLUE}⑤${C_RESET} Tune ulimits, IO scheduler (mq-deadline)
  ${C_BLUE}⑥${C_RESET} Foundation CVE mitigation (algif_aead blacklist) + chrony (NTP)
  ${C_BLUE}⑦${C_RESET} Add Monad apt repo + install + hold the 'monad' package
  ${C_BLUE}⑧${C_RESET} Run one-shot triedb format (systemctl start monad-mpt)
  ${C_BLUE}⑨${C_RESET} Download .env + node.toml from Monad Foundation bucket ${C_BOLD}(full-node template by default)${C_RESET}
  ${C_BLUE}⑩${C_RESET} ${C_BOLD}Ask you for: beneficiary address (0x…) + node name${C_RESET}
  ${C_BLUE}⑪${C_RESET} Generate validator keys (SECP + BLS) — ${C_BOLD}saves password to /opt/monad/backup${C_RESET}
  ${C_BLUE}⑫${C_RESET} Sign Auth UDP name-record + inject into node.toml
  ${C_BLUE}⑬${C_RESET} Install + enable otelcol (metrics collector)
  ${C_BLUE}⑭${C_RESET} Configure UFW firewall + iptables UDP-DDoS filter
  ${C_BLUE}⑮${C_RESET} ${C_BOLD}Snapshot restore (per docs hard-reset, default ON)${C_RESET} — testnet < 5 min, mainnet 1-5 min
  ${C_BLUE}⑯${C_RESET} ${C_BOLD}Ask you: start services now? (FINAL — goes live on the network)${C_RESET}

${C_BOLD}You'll be prompted ONLY at destructive / operator-specific steps.${C_RESET}
Other actions just happen with [✓] / [!] / [✗] markers.

EOF
  info "Log file: $LOG_FILE"
  info "Re-run with --help for all flags"
  (( DRY_RUN )) && warn "DRY-RUN MODE: no changes will be made"
  echo

  # Ask early so the rest of the run can show consistent banner.
  choose_network

  # One-shot legacy cleanup: prior versions of this script wrote
  # /etc/sysctl.d/99-monad-validator.conf with rmem_max=16MB, silently
  # downgrading what the monad apt pkg sets (62.5MB) and crashing
  # monad-bft at startup. We no longer manage sysctl drop-ins; remove
  # the legacy file if it survived from an older install.
  if [[ -f /etc/sysctl.d/99-monad-validator.conf ]] && (( DRY_RUN == 0 )); then
    info "Removing legacy /etc/sysctl.d/99-monad-validator.conf (script no longer manages sysctl)"
    rm -f /etc/sysctl.d/99-monad-validator.conf
    sysctl --system >/dev/null 2>&1 || true
  fi

  local failed=()
  step_preflight             || failed+=("preflight")
  step_dependencies          || failed+=("dependencies")
  step_monad_user            || failed+=("monad-user")
  step_triedb_partition      || failed+=("triedb-partition")
  step_ulimits               || failed+=("ulimits")
  step_io_scheduler          || failed+=("io-scheduler")
  step_triedb_symlink        || failed+=("triedb-symlink")
  step_cve_mitigation        || failed+=("cve-mitigation")
  step_chrony                || failed+=("chrony")
  step_monad_install         || failed+=("monad-install")
  step_triedb_format         || failed+=("triedb-format")
  step_config_files          || failed+=("config-files")
  step_node_toml_customize   || failed+=("node-toml-customize")
  step_generate_keys         || failed+=("generate-keys")
  step_sign_name_record      || failed+=("sign-name-record")
  step_cruft_timer           || failed+=("cruft-timer")
  step_otelcol_install       || failed+=("otelcol-install")
  step_otelcol_enable        || failed+=("otelcol-enable")
  step_firewall              || failed+=("firewall")
  step_iptables_ddos         || failed+=("iptables-ddos")
  step_monitoring            || failed+=("monitoring")
  step_snapshot_restore      || failed+=("snapshot-restore")
  step_start_services        || failed+=("start-services")
  # VDP OTel push MUST come AFTER services start — the MF setup script's
  # verify step (`secp_key not found in metrics`) reads localhost:8889/metrics,
  # which is empty until monad-bft is running AND has emitted at least one
  # metrics scrape to otelcol. Running this BEFORE start-services guaranteed
  # the verify to fail with no secp_key in the (empty) metrics stream.
  step_vdp_otel_push         || failed+=("vdp-otel-push")
  step_report

  if (( ${#failed[@]} > 0 )); then
    echo
    err "═══════════════════════════════════════════════════"
    err "  Setup INCOMPLETE — failed steps: ${failed[*]}"
    err "═══════════════════════════════════════════════════"
    err "  See log for details: $LOG_FILE"
    err "  Re-run after fixing, or open an issue:"
    err "    https://github.com/BeeHiveTeam/monad-tools/issues"
    exit 1
  fi

  print_next_steps
}

case "$ACTION" in
  install)        do_install ;;
  uninstall)      do_uninstall ;;
  uninstall-deep) do_uninstall_deep ;;
esac
