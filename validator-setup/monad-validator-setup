#!/usr/bin/env bash
# monad-validator-setup — one-shot Monad validator host configuration
# Project: BeeHive monad-tools
# Repo: https://github.com/BeeHiveTeam/monad-tools
#
# What it does (idempotent, safe to re-run; many steps optional with explicit
# opt-in via prompt or flag — defaults preserve manual-control workflow):
#   Mandatory: preflight, deps, monad user/dirs, sysctl/ulimits, IO scheduler,
#              triedb udev SYMLINK, chrony, monad apt+pkg, otelcol install+enable,
#              UFW, iptables UDP filter, post-install report.
#   Optional (prompts or --flags):
#              triedb partitioning (--triedb-partition=DEV)
#              triedb format (--triedb-format)
#              node.toml customize (--beneficiary=, --node-name=)
#              key generation (--generate-keys, --keys-password=auto|prompt)
#              name-record signing (--sign-name-record)
#              monad-grafana monitoring (--with-monitoring)
#              VDP OTel push (--with-vdp-otel)
#              start services (--start-services)
#
# What it deliberately does NOT do:
#   - Generate or import validator keys (you must do this manually)
#   - Start monad-bft.service (you start it after placing keys)
#   - Touch existing files without backup (.bak.<timestamp>)
#
# Usage:
#   sudo ./monad-validator-setup                       # interactive (asks network + prompts for optionals)
#   sudo ./monad-validator-setup --network=testnet     # skip network prompt
#   sudo ./monad-validator-setup --network=mainnet --non-interactive
#   sudo ./monad-validator-setup --full-node           # full-node template (default: validator)
#   sudo ./monad-validator-setup --dry-run             # show what would change
#   sudo ./monad-validator-setup --triedb-dev=nvme1n1  # pin IO-scheduler target
#   sudo ./monad-validator-setup --triedb-partition=nvme1n1   # DESTRUCTIVE: partition this disk for triedb
#   sudo ./monad-validator-setup --triedb-format       # systemctl start monad-mpt (first-time triedb format)
#   sudo ./monad-validator-setup --beneficiary=0x... --node-name=BeeHive-1   # write into node.toml
#   sudo ./monad-validator-setup --generate-keys --keys-password=auto        # auto-gen + show password
#   sudo ./monad-validator-setup --generate-keys --keys-password=prompt      # prompt for password
#   sudo ./monad-validator-setup --sign-name-record    # auto-sign + inject into node.toml
#   sudo ./monad-validator-setup --start-services      # systemctl enable+start monad-* (FINAL, opt-in)
#   sudo ./monad-validator-setup --with-monitoring     # also install monad-grafana
#   sudo ./monad-validator-setup --with-vdp-otel       # run MF VDP OTel push setup (testnet first!)
#   sudo ./monad-validator-setup --skip-preflight      # skip monad-doctor
#   sudo ./monad-validator-setup --uninstall           # remove (best-effort)
#
# Full end-to-end automated install (zero-prompt CI):
#   sudo MONAD_PKG_VERSION=0.14.3 ./monad-validator-setup --non-interactive \
#     --network=testnet --triedb-partition=nvme1n1 --triedb-format \
#     --beneficiary=0x... --node-name=BeeHive-1 \
#     --generate-keys --keys-password=auto \
#     --sign-name-record --start-services

set -u

# ===== Defaults =====
NON_INTERACTIVE=0
DRY_RUN=0
SKIP_PREFLIGHT=0
WITH_MONITORING=0
WITH_VDP_OTEL=0
TRIEDB_DEV=""
TRIEDB_PARTITION_DEV=""     # if set, step_triedb_partition uses this disk non-interactively
WITH_TRIEDB_FORMAT=0        # if 1, systemctl start monad-mpt (one-shot triedb format)
BENEFICIARY=""              # 0x... address — auto-injected into node.toml if set
NODE_NAME=""                # unique moniker — auto-injected into node.toml if set
WITH_KEYS=0                 # if 1, run monad-keystore create with KEYSTORE_PASSWORD source
KEYSTORE_PASSWORD_INPUT=""  # "auto" | "prompt" | "" (interactive picks)
WITH_SIGN_NAME_RECORD=0     # if 1, run monad-sign-name-record + inject into node.toml
WITH_START_SERVICES=0       # if 1, systemctl enable+start monad-* services (FINAL)
NETWORK=""                  # testnet | mainnet — asked interactively if empty
NODE_TYPE="validator"       # validator | full — affects which node.toml to fetch
ACTION="install"
LOG_FILE="/tmp/monad-validator-setup-$(date +%Y%m%d-%H%M%S).log"
TS=$(date -u +%Y%m%d-%H%M%S)
DOCTOR_PATH="$(dirname "$0")/../doctor/monad-doctor"
REPORT_FILE="/var/lib/monad-validator-setup/report-${TS}.json"

# Monad foundation config bucket per docs (full-node-installation page).
MF_BUCKET="${MF_BUCKET:-https://bucket.monadinfra.com}"

# Tuning values
SYSCTL_RMEM=16777216
SYSCTL_WMEM=16777216
SYSCTL_NETDEV_BACKLOG=5000
SYSCTL_FILE_MAX=2097152
SYSCTL_SWAPPINESS=1
ULIMIT_NOFILE=1048576

# OpenTelemetry collector .deb from upstream (per Monad docs — they pin
# this version + sha256 in full-node-installation page). The Monad apt
# package does NOT include otelcol; it must be installed separately.
# Verified 2026-05-15.
OTEL_VERSION="${OTEL_VERSION:-0.139.0}"
OTEL_CHECKSUM="${OTEL_CHECKSUM:-1a1576dde7d51fa7094f4963ceaff37c91ac7b9c9593ba735a3a328ec6f8acd9}"
OTEL_DEB_URL="${OTEL_DEB_URL:-https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v${OTEL_VERSION}/otelcol_${OTEL_VERSION}_linux_amd64.deb}"

# Official Monad apt repo (Category Labs).
# Source: https://docs.monad.xyz/node-ops/full-node-installation
MONAD_APT_REPO="${MONAD_APT_REPO:-https://pkg.category.xyz/}"
MONAD_APT_SUITE="${MONAD_APT_SUITE:-noble}"
# Foundation moved the key 2026-05-14: was /category-labs.gpg (binary, now 403),
# now /keys/public-key.asc (ASCII-armored — requires `gpg --dearmor`).
MONAD_APT_KEY_URL="${MONAD_APT_KEY_URL:-https://pkg.category.xyz/keys/public-key.asc}"
MONAD_APT_KEYRING="${MONAD_APT_KEYRING:-/etc/apt/keyrings/category-labs.gpg}"
# Monad package version policy.
# Default: track whatever Category Labs publishes as the "candidate" in their
# apt repo (https://pkg.category.xyz/). This is what `apt install monad`
# without a version pin gets, and it's the source-of-truth the docs page
# mirrors. By detecting the candidate at install time we never need to hand-
# edit a hardcoded pin when MF/CL bump a release.
#
# Override paths (in priority order):
#   MONAD_PKG_VERSION=0.14.3    → install exactly this version
#   MONAD_PKG_VERSION=""        → install latest candidate from apt repo (default)
#   MONAD_PKG_VERSION_TESTNET=  → per-network override (set both to keep them divergent)
#   MONAD_PKG_VERSION_MAINNET=
MONAD_PKG_VERSION_TESTNET="${MONAD_PKG_VERSION_TESTNET-}"
MONAD_PKG_VERSION_MAINNET="${MONAD_PKG_VERSION_MAINNET-}"
MONAD_PKG_VERSION="${MONAD_PKG_VERSION-__auto__}"   # __auto__ = decide after apt update

# UFW ports per docs:
#   - SSH (default 22/tcp, but auto-detected — operators commonly move SSH)
#   - 8000 (TCP+UDP — consensus P2P)
#   - 8001/udp (Authenticated UDP)
# UFW_SSH_PORT is a space-separated list, populated by detect_ssh_ports()
# at runtime if empty. Override via env (e.g. UFW_SSH_PORT="22 2222") to
# pin specific ports.
UFW_SSH_PORT="${UFW_SSH_PORT:-}"
UFW_P2P_PORT="8000"        # both TCP and UDP
UFW_AUTHUDP_PORT="8001"    # UDP only

# ===== Colors =====
if [[ -t 1 ]]; then
  C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[0;33m'
  C_BLUE=$'\033[0;34m'; C_PURPLE=$'\033[0;35m'; C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_PURPLE=""; C_BOLD=""; C_DIM=""; C_RESET=""
fi

info()    { echo "${C_BLUE}[i]${C_RESET} $*"; }
ok()      { echo "${C_GREEN}[✓]${C_RESET} $*"; }
warn()    { echo "${C_YELLOW}[!]${C_RESET} $*" >&2; }
err()     { echo "${C_RED}[✗]${C_RESET} $*" >&2; }
fatal()   { err "$*"; exit 1; }
section() { echo; echo "${C_BOLD}${C_PURPLE}━━ $* ━━${C_RESET}"; }

# ===== Args =====
while [[ $# -gt 0 ]]; do
  case "$1" in
    --non-interactive) NON_INTERACTIVE=1 ;;
    --dry-run)         DRY_RUN=1 ;;
    --skip-preflight)  SKIP_PREFLIGHT=1 ;;
    --with-monitoring) WITH_MONITORING=1 ;;
    --with-vdp-otel)   WITH_VDP_OTEL=1 ;;
    --triedb-dev=*)    TRIEDB_DEV="${1#*=}" ;;
    --triedb-partition=*) TRIEDB_PARTITION_DEV="${1#*=}" ;;
    --triedb-format)   WITH_TRIEDB_FORMAT=1 ;;
    --beneficiary=*)   BENEFICIARY="${1#*=}" ;;
    --node-name=*)     NODE_NAME="${1#*=}" ;;
    --generate-keys)   WITH_KEYS=1 ;;
    --keys-password=*) KEYSTORE_PASSWORD_INPUT="${1#*=}" ;;
    --sign-name-record) WITH_SIGN_NAME_RECORD=1 ;;
    --start-services)  WITH_START_SERVICES=1 ;;
    --network=*)       NETWORK="${1#*=}" ;;
    --node-type=*)     NODE_TYPE="${1#*=}" ;;
    --full-node)       NODE_TYPE="full" ;;
    --uninstall)       ACTION="uninstall" ;;
    -h|--help)
      sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) fatal "Unknown option: $1 (try --help)" ;;
  esac
  shift
done

# Validate flags
case "$NETWORK" in
  ""|testnet|mainnet) ;;
  *) fatal "Invalid --network='$NETWORK' (must be 'testnet' or 'mainnet')" ;;
esac
case "$NODE_TYPE" in
  validator|full) ;;
  *) fatal "Invalid --node-type='$NODE_TYPE' (must be 'validator' or 'full')" ;;
esac
if [[ -n "$BENEFICIARY" ]]; then
  [[ "$BENEFICIARY" =~ ^0x[0-9a-fA-F]{40}$ ]] \
    || fatal "Invalid --beneficiary='$BENEFICIARY' (must be 0x + 40 hex chars)"
fi
if [[ -n "$KEYSTORE_PASSWORD_INPUT" ]]; then
  case "$KEYSTORE_PASSWORD_INPUT" in
    auto|prompt) ;;
    *) fatal "Invalid --keys-password='$KEYSTORE_PASSWORD_INPUT' (must be 'auto' or 'prompt')" ;;
  esac
fi

# ===== Pre-checks =====
[[ $EUID -eq 0 ]] || fatal "Run as root: sudo $0 $*"

# Read interactively from the controlling terminal, not STDIN. This is what
# makes prompts work when the script is run as `curl ... | sudo bash` — in
# that case STDIN is the script body itself, so `read` would consume future
# script lines instead of waiting for the operator.
# Falls back to STDIN if /dev/tty isn't available (e.g. true headless CI).
prompt_read() {
  local var="$1" promptmsg="$2"
  if [[ -r /dev/tty ]]; then
    read -rp "$promptmsg" "$var" </dev/tty
  else
    read -rp "$promptmsg" "$var"
  fi
}

confirm() {
  [[ $NON_INTERACTIVE -eq 1 ]] && { info "(non-interactive: assuming Yes for: $1)"; return 0; }
  local ans=""
  prompt_read ans "${C_YELLOW}?${C_RESET} $1 [Y/n] "
  [[ ! "$ans" =~ ^[Nn]$ ]]
}

# Detect ports SSH actually listens on. We must NEVER hardcode 22/tcp into the
# UFW rules — operators very commonly move SSH (`Port 2222`) as a defense
# against bruteforce, and `ufw allow 22/tcp + ufw enable` would lock them out.
# Sources (merged + deduped):
#   1. $SSH_CONNECTION (when run inside an SSH session): the LAST field is the
#      server port we're connected on right now. Guaranteed-not-locked-out port.
#   2. sshd_config `Port` directive(s) via `sshd -T` (handles Include + multi-Port).
# NOTE: we deliberately do NOT inspect `ss -tlnp` for sshd-owned sockets.
# That source picks up X11 forwarding sockets (6010, 6011, ...) which are
# owned by per-session sshd processes but are NOT the master daemon port —
# whitelisting them in UFW would add useless rules that disappear with the session.
# Returns a space-separated list. Falls back to "22" only if all sources empty.
detect_ssh_ports() {
  local ports=""
  # Source 1: current SSH session
  if [[ -n "${SSH_CONNECTION:-}" ]]; then
    local cur_port
    cur_port=$(awk '{print $NF}' <<<"$SSH_CONNECTION")
    [[ "$cur_port" =~ ^[0-9]+$ ]] && ports+="$cur_port "
  fi
  # Source 2: sshd_config — `sshd -T` evaluates Include + Match defaults and is
  # the authoritative source for the daemon's listening port(s).
  if [[ -r /etc/ssh/sshd_config ]]; then
    local sshd_ports
    sshd_ports=$(sshd -T 2>/dev/null | awk '/^port / {print $2}')
    [[ -z "$sshd_ports" ]] && sshd_ports=$(grep -hE '^\s*Port\s+[0-9]+' \
      /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null \
      | awk '{print $2}')
    ports+="$sshd_ports "
  fi
  # Dedupe and validate
  local unique
  unique=$(tr ' ' '\n' <<<"$ports" | awk 'NF && /^[0-9]+$/' | sort -u | tr '\n' ' ')
  unique="${unique% }"
  [[ -z "$unique" ]] && unique="22"
  echo "$unique"
}

# Ask the operator to choose network if not provided via --network=.
choose_network() {
  if [[ -n "$NETWORK" ]]; then
    info "Network: ${C_BOLD}${NETWORK}${C_RESET} (from --network=${NETWORK})"
    resolve_pkg_version
    return 0
  fi
  if [[ $NON_INTERACTIVE -eq 1 ]]; then
    fatal "--network=testnet or --network=mainnet required in --non-interactive mode"
  fi
  echo
  echo "${C_BOLD}Which Monad network are you setting up this node for?${C_RESET}"
  echo "  1) testnet  (recommended for first deployment; VDP requires testnet validator)"
  echo "  2) mainnet"
  local ans
  while true; do
    prompt_read ans "${C_YELLOW}?${C_RESET} Choose [1/2]: "
    case "$ans" in
      1|testnet) NETWORK="testnet"; break ;;
      2|mainnet) NETWORK="mainnet"; break ;;
      *)         echo "  Please enter 1 or 2." ;;
    esac
  done
  info "Network: ${C_BOLD}${NETWORK}${C_RESET}"
  resolve_pkg_version
}

# Resolve MONAD_PKG_VERSION from per-network env overrides if the user set them.
# If neither this nor MONAD_PKG_VERSION is set, leave value empty — the real
# version will be auto-detected from `apt-cache policy monad` after the repo
# is added (see step_monad_install). This means the script tracks whatever
# Category Labs publishes without anyone hand-editing version pins.
resolve_pkg_version() {
  if [[ "$MONAD_PKG_VERSION" == "__auto__" ]]; then
    case "$NETWORK" in
      testnet) MONAD_PKG_VERSION="$MONAD_PKG_VERSION_TESTNET" ;;
      mainnet) MONAD_PKG_VERSION="$MONAD_PKG_VERSION_MAINNET" ;;
      *)       MONAD_PKG_VERSION="" ;;
    esac
  fi
  if [[ -n "$MONAD_PKG_VERSION" ]]; then
    info "Pinned monad version: ${C_BOLD}${MONAD_PKG_VERSION}${C_RESET} (env override)"
  else
    info "Monad version: ${C_BOLD}auto${C_RESET} — will use apt repo candidate at install time"
  fi
}

run() {
  # run <description> <cmd...>  — runs (or echoes if dry-run) and logs
  local desc="$1"; shift
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] $desc:${C_RESET} $*"
    return 0
  fi
  echo "  ${C_DIM}→ $desc${C_RESET}" >>"$LOG_FILE"
  if "$@" >>"$LOG_FILE" 2>&1; then
    return 0
  else
    local rc=$?
    err "Command failed (rc=$rc): $*"
    err "  See $LOG_FILE for details"
    return $rc
  fi
}

backup_file() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  local bak="${f}.bak.${TS}"
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] backup: $f → $bak${C_RESET}"
    return 0
  fi
  cp -p "$f" "$bak" && echo "  ${C_DIM}backup: $bak${C_RESET}"
}

ensure_line() {
  # ensure_line <file> <line>  — adds line if absent (idempotent)
  local file="$1" line="$2"
  if [[ -f "$file" ]] && grep -qxF "$line" "$file"; then
    return 0
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] add to $file:${C_RESET} $line"
    return 0
  fi
  backup_file "$file"
  echo "$line" >>"$file"
}

# ===== Step: preflight =====
step_preflight() {
  section "Pre-flight (monad-doctor)"

  if (( SKIP_PREFLIGHT )); then
    info "Skipping preflight (--skip-preflight)"
    return 0
  fi

  if [[ ! -x "$DOCTOR_PATH" ]]; then
    warn "monad-doctor not found at $DOCTOR_PATH — skipping preflight"
    warn "Get it: git clone https://github.com/BeeHiveTeam/monad-tools.git"
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] would run: $DOCTOR_PATH --quick${C_RESET}"
    return 0
  fi

  info "Running monad-doctor (this is read-only, no system changes)…"
  "$DOCTOR_PATH" --quick
  local rc=$?
  case $rc in
    0) ok "Preflight: all clean" ;;
    1) warn "Preflight: warnings (continuing)" ;;
    2)
      err "Preflight: FAIL — server not ready for validator"
      # Hard-abort in --non-interactive mode: CI/automation must not silently
      # auto-continue past a hardware/OS issue the operator hasn't seen.
      # Operators who *want* to bypass FAIL non-interactively can pass
      # --skip-preflight explicitly.
      if (( NON_INTERACTIVE )); then
        fatal "Preflight FAIL in --non-interactive mode — re-run without it OR pass --skip-preflight to override."
      fi
      if confirm "Continue anyway? (NOT recommended)"; then
        warn "Continuing despite preflight failures"
      else
        fatal "Aborted by user"
      fi ;;
    *) warn "Preflight: unknown exit code $rc" ;;
  esac
}

# ===== Step: dependencies =====
# Per docs (full-node-installation): apt install -y curl nvme-cli aria2 jq
step_dependencies() {
  section "System dependencies (per docs)"
  # gnupg: needed to dearmor the ASCII-armored apt signing key (since 2026-05-14).
  # On Ubuntu 24.04 `ufw` and `iptables-persistent` declare Conflicts at the
  # Debian metadata level — installing both in one apt call (or installing ufw
  # after iptables-persistent) silently removes iptables-persistent. We do NOT
  # bundle iptables-persistent here. The iptables UDP DROP rule is persisted
  # via UFW's /etc/ufw/before.rules instead (handled by step_iptables_ddos).
  local pkgs=(curl gnupg nvme-cli aria2 jq ethtool ufw iptables)
  local missing=()
  for p in "${pkgs[@]}"; do
    dpkg -l "$p" 2>/dev/null | grep -qE '^.i  ' || missing+=("$p")
  done
  if (( ${#missing[@]} == 0 )); then
    ok "All dependencies installed: ${pkgs[*]}"
    return
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] apt install -y ${missing[*]}${C_RESET}"
    return
  fi
  # apt update failure here is almost always a broken /etc/apt/sources.list.d
  # entry (e.g. a half-configured Category Labs source from a previous run).
  # Bail out — silent success masked the real problem before.
  if ! run "apt update" apt-get update -qq; then
    err "apt-get update failed — likely a broken entry in /etc/apt/sources.list.d/"
    err "Inspect: sudo apt-get update    (without -qq to see the offending source)"
    err "Common fix: sudo rm /etc/apt/sources.list.d/category-labs.sources \\"
    err "           /etc/apt/keyrings/category-labs.gpg   # then re-run this script"
    return 1
  fi
  if ! run "installing missing deps: ${missing[*]}" apt-get install -y "${missing[@]}"; then
    err "Dependency install failed — check $LOG_FILE"
    return 1
  fi
  ok "Dependencies installed."
}

# ===== Step: monad user / directories =====
# Per docs: useradd -m -s /bin/bash monad
#          mkdir -p /home/monad/monad-bft/{config,ledger,config/forkpoint,config/validators}
step_monad_user() {
  section "Monad user / directories (per docs)"
  if id monad >/dev/null 2>&1; then
    ok "user 'monad' already exists ($(id -u monad):$(id -g monad))"
  else
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] useradd -m -s /bin/bash monad${C_RESET}"
    else
      if ! run "creating user monad" useradd -m -s /bin/bash monad; then
        err "Could not create 'monad' user — aborting step."
        return 1
      fi
    fi
  fi
  local dirs=(
    /home/monad/monad-bft/config
    /home/monad/monad-bft/ledger
    /home/monad/monad-bft/config/forkpoint
    /home/monad/monad-bft/config/validators
  )
  for d in "${dirs[@]}"; do
    if [[ -d "$d" ]]; then
      :
    elif (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] mkdir -p $d${C_RESET}"
    else
      if ! mkdir -p "$d"; then
        err "Could not create directory $d"
        return 1
      fi
    fi
  done
  if (( DRY_RUN == 0 )) && id monad >/dev/null 2>&1; then
    # chown is intentionally tolerant: on a re-run after a partial failure,
    # some files may already be owned by monad; we don't want to fail the
    # whole step over that.
    chown -R monad:monad /home/monad/monad-bft 2>/dev/null || true
  fi
  ok "Directory tree under /home/monad/monad-bft/ ready"
}

# Enumerate NVMe disks that look genuinely free (not in OS RAID, no mounts,
# no swap, no partitions at all). Returns a newline-separated list of disk
# basenames (e.g. "nvme1n1").
list_free_nvme_disks() {
  local root_src root_dev
  root_src=$(findmnt -no SOURCE / 2>/dev/null)
  root_dev="${root_src##*/}"

  # Build set of partitions that belong to the root md array (if any).
  local parts_under_root=()
  if [[ -n "$root_dev" && -e "/sys/block/$root_dev/md" ]]; then
    while IFS= read -r m; do
      parts_under_root+=("$m")
    done < <(ls "/sys/block/$root_dev/md/" 2>/dev/null | sed -n 's/^dev-//p')
  fi

  while IFS= read -r disk; do
    [[ -z "$disk" ]] && continue
    # Skip if in OS root md array
    local skip=0
    for m in "${parts_under_root[@]}"; do
      if lsblk -ln -o NAME "/dev/$disk" 2>/dev/null | grep -qx "$m"; then skip=1; break; fi
    done
    (( skip )) && continue
    # Skip if anything under this disk is mounted at /
    if lsblk -ln -o MOUNTPOINT "/dev/$disk" 2>/dev/null | grep -qx "/"; then continue; fi
    # Skip if any non-swap mount on this disk (already in use)
    if lsblk -ln -o MOUNTPOINT "/dev/$disk" 2>/dev/null \
       | grep -vE '^$|^\[SWAP\]$' | grep -q .; then continue; fi
    echo "$disk"
  done < <(lsblk -dn -o NAME,TYPE 2>/dev/null | awk '$2=="disk" && $1 ~ /^nvme/ {print $1}')
}

# ===== Step: partition triedb disk (optional, destructive) =====
# Per docs:
#   parted $DRIVE mklabel gpt
#   parted $DRIVE mkpart triedb 0% 100%
#   PARTUUID=$(lsblk -o PARTUUID $DRIVE | tail -n 1)
#   echo "ENV{ID_PART_ENTRY_UUID}==..." > /etc/udev/rules.d/99-triedb.rules
#   udevadm trigger
# Also: nvme format --lbaf=0 if LBA != 512 (DESTROYS disk, before parted).
step_triedb_partition() {
  section "Triedb disk partitioning (optional, DESTRUCTIVE)"

  # Already done? Skip silently.
  if [[ -L /dev/triedb ]]; then
    ok "/dev/triedb already exists — skipping partition step"
    return 0
  fi

  # Find candidates
  local -a candidates=()
  while IFS= read -r d; do
    [[ -n "$d" ]] && candidates+=("$d")
  done < <(list_free_nvme_disks)

  if (( ${#candidates[@]} == 0 )); then
    info "No free NVMe disks found (all are in OS RAID / mounted / partitioned)"
    info "If you want to partition a specific disk, pass --triedb-partition=DEV"
    return 0
  fi

  # Decide target: --triedb-partition flag wins, else interactive prompt.
  local target=""
  if [[ -n "$TRIEDB_PARTITION_DEV" ]]; then
    target="${TRIEDB_PARTITION_DEV#/dev/}"
    info "Using --triedb-partition=$target (operator-specified)"
  elif (( NON_INTERACTIVE )); then
    info "No --triedb-partition= and --non-interactive — skipping"
    info "(operator will partition manually; re-run with --triedb-partition=DEV to automate)"
    return 0
  else
    echo
    echo "${C_BOLD}Free NVMe disks detected (safe to partition for triedb):${C_RESET}"
    local i=1
    for d in "${candidates[@]}"; do
      local size_h model
      size_h=$(lsblk -dn -o SIZE "/dev/$d" 2>/dev/null | xargs)
      model=$(lsblk -dn -o MODEL "/dev/$d" 2>/dev/null | xargs)
      printf "  %d) /dev/%s  %-8s  %s\n" "$i" "$d" "$size_h" "$model"
      ((i++))
    done
    echo "  0) Skip — partition manually later"
    echo
    local ans=""
    prompt_read ans "${C_YELLOW}?${C_RESET} Choose disk for triedb [0-${#candidates[@]}]: "
    if [[ -z "$ans" || "$ans" == "0" ]]; then
      info "Skipped — operator will partition manually"
      return 0
    fi
    if [[ ! "$ans" =~ ^[0-9]+$ ]] || (( ans < 1 || ans > ${#candidates[@]} )); then
      warn "Invalid choice '$ans' — skipping"
      return 0
    fi
    target="${candidates[$((ans-1))]}"
  fi

  local dev="/dev/$target"
  if [[ ! -b "$dev" ]]; then
    err "$dev is not a block device — aborting"
    return 1
  fi

  echo
  warn "${C_BOLD}DESTRUCTIVE${C_RESET}: this will WIPE $dev. Any data on it is lost."
  if ! confirm "Partition $dev as 'triedb' (single full-disk partition)?"; then
    info "Skipped by operator"
    return 0
  fi

  # LBA check (per docs: must be 512-byte).
  if command -v nvme >/dev/null 2>&1; then
    local lba
    lba=$(lsblk -dn -o LOG-SEC "$dev" 2>/dev/null | tr -d ' ')
    if [[ -n "$lba" && "$lba" != "512" ]]; then
      warn "$dev currently has ${lba}-byte LBA — docs require 512 for triedb."
      warn "Reformatting at the NVMe level (lbaf=0) destroys the disk entirely."
      if confirm "Run 'nvme format $dev --lbaf=0 --force' now?"; then
        if (( DRY_RUN )); then
          echo "  ${C_DIM}[dry-run] nvme format $dev --lbaf=0 --force${C_RESET}"
        else
          run "nvme format $dev --lbaf=0" nvme format "$dev" --lbaf=0 --force || {
            err "nvme format failed — see $LOG_FILE"
            return 1
          }
        fi
      else
        warn "Continuing with ${lba}-byte LBA — triedb performance will suffer (per docs)"
      fi
    fi
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] parted -s $dev mklabel gpt${C_RESET}"
    echo "  ${C_DIM}[dry-run] parted -s $dev mkpart triedb 0% 100%${C_RESET}"
    echo "  ${C_DIM}[dry-run] write /etc/udev/rules.d/99-triedb.rules${C_RESET}"
    return 0
  fi

  if ! command -v parted >/dev/null 2>&1; then
    run "installing parted" apt-get install -y parted || {
      err "Could not install parted"
      return 1
    }
  fi

  run "parted: mklabel gpt on $dev" parted -s "$dev" mklabel gpt || return 1
  run "parted: mkpart triedb on $dev" parted -s "$dev" mkpart triedb 0% 100% || return 1
  sleep 2  # udev settle
  partprobe "$dev" 2>/dev/null || true
  sleep 1

  # Detect new partition name (nvme0n1 → nvme0n1p1, sda → sda1)
  local part_name
  part_name=$(lsblk -ln -o NAME "$dev" 2>/dev/null | awk -v d="$target" '$0 != d {print; exit}')
  if [[ -z "$part_name" ]]; then
    err "Could not detect new partition on $dev"
    return 1
  fi
  local part_dev="/dev/$part_name"

  local partuuid
  partuuid=$(lsblk -no PARTUUID "$part_dev" 2>/dev/null | tr -d ' ')
  if [[ -z "$partuuid" ]]; then
    err "Could not read PARTUUID of $part_dev"
    return 1
  fi
  ok "Created $part_dev (PARTUUID=$partuuid)"

  # Write udev rule per docs (step_triedb_symlink would also do this, but we do
  # it here so /dev/triedb appears before later steps run).
  local rule=/etc/udev/rules.d/99-triedb.rules
  backup_file "$rule"
  cat >"$rule" <<EOF
# monad-validator-setup ${TS}
ENV{ID_PART_ENTRY_UUID}=="${partuuid}", MODE="0666", SYMLINK+="triedb"
EOF
  ok "Wrote $rule"
  run "reloading udev" udevadm control --reload-rules || true
  run "triggering udev" udevadm trigger || true
  udevadm settle || true
  if [[ -L /dev/triedb ]]; then
    ok "/dev/triedb → $(readlink -f /dev/triedb)"
  else
    warn "/dev/triedb symlink did not appear after udev trigger — may need reboot"
  fi
}

# ===== Step: format triedb partition (optional, runs once per docs) =====
# Per docs: systemctl start monad-mpt; journalctl -u monad-mpt -n 14
# Only run when explicitly requested (--triedb-format) OR interactive yes.
# Skipped if monad-mpt unit not installed, /dev/triedb missing, or partition
# is already formatted (monad-mpt is a one-shot — second run is a no-op but
# we don't want to look like we're "re-formatting" needlessly).
step_triedb_format() {
  section "Triedb partition format (one-shot, optional)"

  if ! systemctl cat monad-mpt >/dev/null 2>&1; then
    info "monad-mpt service not installed (ships with monad package) — skipping"
    return 0
  fi
  if [[ ! -L /dev/triedb ]]; then
    info "/dev/triedb not present — partition first or skip"
    return 0
  fi
  # If monad-mpt has already completed successfully, ActiveState is "inactive"
  # (one-shot) and ExecMainStatus is 0. Skip in that case to avoid log noise.
  local main_status
  main_status=$(systemctl show monad-mpt -p ExecMainStatus --value 2>/dev/null)
  if [[ "$main_status" == "0" ]]; then
    ok "monad-mpt already ran successfully — triedb formatted"
    return 0
  fi

  local proceed=0
  if (( WITH_TRIEDB_FORMAT )); then
    proceed=1
  elif (( NON_INTERACTIVE == 0 )); then
    if confirm "Run one-shot triedb format (systemctl start monad-mpt)?"; then
      proceed=1
    fi
  fi
  if (( proceed == 0 )); then
    info "Skipped — run manually later: sudo systemctl start monad-mpt"
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] systemctl start monad-mpt${C_RESET}"
    return 0
  fi

  run "starting monad-mpt (one-shot)" systemctl start monad-mpt || {
    err "monad-mpt failed — last 14 lines:"
    journalctl -u monad-mpt -n 14 --no-pager >&2 || true
    return 1
  }
  ok "monad-mpt completed — triedb partition ready"
}

# ===== Step: customize node.toml (optional) =====
# Operator must set beneficiary (rewards address) and node_name (unique moniker)
# before going live. Auto-fills if --beneficiary / --node-name flags given; else
# prompts interactively. Skips silently if both already set in node.toml.
step_node_toml_customize() {
  section "node.toml customization (beneficiary + node_name)"

  local node_toml=/home/monad/monad-bft/config/node.toml
  if [[ ! -f "$node_toml" ]]; then
    info "node.toml not present yet — run step_config_files first"
    return 0
  fi

  # Read current values
  local cur_ben cur_name
  cur_ben=$(awk -F\" '/^[[:space:]]*beneficiary[[:space:]]*=/ {print $2; exit}' "$node_toml")
  cur_name=$(awk -F\" '/^[[:space:]]*node_name[[:space:]]*=/ {print $2; exit}' "$node_toml")

  # --- Beneficiary ---
  local ben_target="$BENEFICIARY"
  local ben_placeholder='0x[0-9a-fA-F]*BENEFICIARY[0-9a-fA-F]*'
  if [[ -z "$ben_target" ]]; then
    # Only prompt if current is empty or looks like a placeholder
    if [[ -z "$cur_ben" || "$cur_ben" == "0x0000000000000000000000000000000000000000" \
          || "$cur_ben" =~ $ben_placeholder ]]; then
      if (( NON_INTERACTIVE )); then
        warn "Beneficiary placeholder in node.toml and no --beneficiary= provided"
        warn "Edit $node_toml manually before starting services."
      else
        echo
        info "Current beneficiary: ${cur_ben:-(empty)}"
        info "This is the address where staking rewards are sent. Must be 0x + 40 hex."
        local input=""
        prompt_read input "${C_YELLOW}?${C_RESET} Beneficiary address (Enter to skip): "
        if [[ -n "$input" ]]; then
          if [[ ! "$input" =~ ^0x[0-9a-fA-F]{40}$ ]]; then
            err "Invalid address format — skipping beneficiary"
          else
            ben_target="$input"
          fi
        fi
      fi
    else
      ok "beneficiary already set: $cur_ben"
    fi
  fi
  if [[ -n "$ben_target" ]]; then
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] set beneficiary = \"$ben_target\" in $node_toml${C_RESET}"
    else
      backup_file "$node_toml"
      sed -i "s|^[[:space:]]*beneficiary[[:space:]]*=.*|beneficiary = \"$ben_target\"|" "$node_toml"
      ok "Set beneficiary = $ben_target"
    fi
  fi

  # --- node_name ---
  local name_target="$NODE_NAME"
  if [[ -z "$name_target" ]]; then
    if [[ -z "$cur_name" || "$cur_name" == "PLACEHOLDER" || "$cur_name" == "REPLACE_ME" ]]; then
      local default_name="BeeHive-$(hostname -s)"
      if (( NON_INTERACTIVE )); then
        name_target="$default_name"
        info "Auto node_name: $name_target (override with --node-name=)"
      else
        local input=""
        prompt_read input "${C_YELLOW}?${C_RESET} node_name (Enter for '$default_name'): "
        name_target="${input:-$default_name}"
      fi
    else
      ok "node_name already set: $cur_name"
    fi
  fi
  if [[ -n "$name_target" ]]; then
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] set node_name = \"$name_target\" in $node_toml${C_RESET}"
    else
      backup_file "$node_toml"
      sed -i "s|^[[:space:]]*node_name[[:space:]]*=.*|node_name = \"$name_target\"|" "$node_toml"
      ok "Set node_name = $name_target"
    fi
  fi
}

# ===== Step: generate validator keys (optional) =====
# Per docs: openssl rand → KEYSTORE_PASSWORD in /home/monad/.env, then
# monad-keystore create for SECP + BLS keys. Operator picks password mode:
#   1) auto-generate (display once — must back up immediately)
#   2) enter manually (twice for confirmation)
# Skipped silently if keys already exist.
step_generate_keys() {
  section "Validator key generation (optional)"

  if ! command -v monad-keystore >/dev/null 2>&1; then
    info "monad-keystore not installed (ships with monad package) — skipping"
    return 0
  fi
  if [[ -f /home/monad/monad-bft/config/id-secp || -f /home/monad/monad-bft/config/id-bls ]]; then
    ok "Keys already exist in /home/monad/monad-bft/config/ — skipping"
    return 0
  fi

  local proceed=0
  if (( WITH_KEYS )); then
    proceed=1
  elif (( NON_INTERACTIVE == 0 )); then
    if confirm "Generate validator keys (SECP + BLS) now?"; then
      proceed=1
    fi
  fi
  if (( proceed == 0 )); then
    info "Skipped — generate manually later per docs/node-ops/validator-installation"
    return 0
  fi

  # Pick password mode
  local mode="${KEYSTORE_PASSWORD_INPUT:-}"
  if [[ -z "$mode" ]]; then
    if (( NON_INTERACTIVE )); then
      mode="auto"
      info "Non-interactive: auto-generating password"
    else
      echo
      echo "${C_BOLD}Password mode:${C_RESET}"
      echo "  1) auto-generate strong random password (32 bytes base64, shown ONCE)"
      echo "  2) enter your own password (typed twice, masked)"
      local c=""
      prompt_read c "${C_YELLOW}?${C_RESET} Choose [1/2]: "
      case "$c" in
        1) mode="auto" ;;
        2) mode="prompt" ;;
        *) warn "Invalid choice — skipping key gen"; return 0 ;;
      esac
    fi
  fi

  local password=""
  case "$mode" in
    auto)
      if ! command -v openssl >/dev/null 2>&1; then
        run "installing openssl" apt-get install -y openssl || return 1
      fi
      password=$(openssl rand -base64 32)
      echo
      echo "${C_BOLD}${C_YELLOW}═══════════════════════════════════════════════════════════"
      echo "  GENERATED KEYSTORE PASSWORD — BACK UP NOW, SHOWN ONCE:"
      echo "  ${password}"
      echo "═══════════════════════════════════════════════════════════${C_RESET}"
      echo
      ;;
    prompt)
      local pw1 pw2
      while true; do
        if [[ -r /dev/tty ]]; then
          read -srp "Enter keystore password: " pw1 </dev/tty; echo
          read -srp "Confirm password:         " pw2 </dev/tty; echo
        else
          read -srp "Enter keystore password: " pw1; echo
          read -srp "Confirm password:         " pw2; echo
        fi
        if [[ "$pw1" == "$pw2" && -n "$pw1" ]]; then
          password="$pw1"
          break
        fi
        warn "Passwords don't match (or empty). Try again."
      done
      ;;
  esac

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write KEYSTORE_PASSWORD to /home/monad/.env${C_RESET}"
    echo "  ${C_DIM}[dry-run] monad-keystore create --key-type secp${C_RESET}"
    echo "  ${C_DIM}[dry-run] monad-keystore create --key-type bls${C_RESET}"
    return 0
  fi

  # Write to /home/monad/.env (replace existing line or append).
  local envfile=/home/monad/.env
  if [[ -f "$envfile" ]] && grep -q '^KEYSTORE_PASSWORD=' "$envfile"; then
    backup_file "$envfile"
    # Use awk + temp file for safety (escapes don't need to be perfect because
    # password is base64 or operator-typed; we always single-quote it).
    awk -v pw="$password" '
      /^KEYSTORE_PASSWORD=/ { print "KEYSTORE_PASSWORD='\''" pw "'\''"; next }
      { print }
    ' "$envfile" >"${envfile}.tmp" && mv "${envfile}.tmp" "$envfile"
  else
    echo "KEYSTORE_PASSWORD='${password}'" >>"$envfile"
  fi
  chown monad:monad "$envfile"
  chmod 0600 "$envfile"

  # Backup directory per docs
  mkdir -p /opt/monad/backup
  echo "Keystore password: $password" >/opt/monad/backup/keystore-password-backup
  chmod 0600 /opt/monad/backup/keystore-password-backup
  ok "Wrote KEYSTORE_PASSWORD to $envfile (mode 0600) + backup in /opt/monad/backup/"

  # Generate keys as 'monad' user
  if ! sudo -u monad bash -c "
    set -e
    source /home/monad/.env
    monad-keystore create --key-type secp \
      --keystore-path /home/monad/monad-bft/config/id-secp \
      --password \"\$KEYSTORE_PASSWORD\" > /opt/monad/backup/secp-backup
    monad-keystore create --key-type bls \
      --keystore-path /home/monad/monad-bft/config/id-bls \
      --password \"\$KEYSTORE_PASSWORD\" > /opt/monad/backup/bls-backup
    grep 'public key' /opt/monad/backup/secp-backup /opt/monad/backup/bls-backup \
      > /home/monad/pubkey-secp-bls
  " 2>>"$LOG_FILE"; then
    err "monad-keystore create failed — see $LOG_FILE"
    return 1
  fi
  chmod 0600 /opt/monad/backup/*-backup 2>/dev/null || true
  ok "Generated SECP + BLS keys in /home/monad/monad-bft/config/"
  ok "Public keys recorded in /home/monad/pubkey-secp-bls"
  warn "${C_BOLD}BACK UP THE PASSWORD NOW. Without it the keys are unrecoverable.${C_RESET}"
}

# ===== Step: sign node-name record (optional) =====
# Per docs: monad-sign-name-record outputs a signature for Auth UDP.
# Inject into node.toml's [peer_discovery] section. Skip if signature already
# present or keys missing.
step_sign_name_record() {
  section "Auth UDP name-record signature (optional)"

  if ! command -v monad-sign-name-record >/dev/null 2>&1; then
    info "monad-sign-name-record not installed (ships with monad package) — skipping"
    return 0
  fi
  if [[ ! -f /home/monad/monad-bft/config/id-secp ]]; then
    info "SECP key missing — run --generate-keys first"
    return 0
  fi
  local node_toml=/home/monad/monad-bft/config/node.toml
  if [[ ! -f "$node_toml" ]]; then
    info "node.toml not present — run step_config_files first"
    return 0
  fi
  # Skip if signature already in node.toml (avoid bumping self_record_seq_num)
  if awk '/^\[peer_discovery\]/ {in_pd=1} /^\[/ && !/^\[peer_discovery\]/ {in_pd=0}
          in_pd && /^[[:space:]]*self_name_record_sig[[:space:]]*=/ && !/= *""/ {found=1; exit}
          END {exit !found}' "$node_toml" 2>/dev/null; then
    ok "self_name_record_sig already in node.toml — skipping (avoids seq_num bump)"
    return 0
  fi

  local proceed=0
  if (( WITH_SIGN_NAME_RECORD )); then
    proceed=1
  elif (( NON_INTERACTIVE == 0 )); then
    if confirm "Run monad-sign-name-record now (auto-pick public IP)?"; then
      proceed=1
    fi
  fi
  if (( proceed == 0 )); then
    info "Skipped — generate manually per docs"
    return 0
  fi

  # Need public IP
  local pubip=""
  if command -v curl >/dev/null 2>&1; then
    pubip=$(curl -fsS -m 5 -4 https://ifconfig.me 2>/dev/null \
            || curl -fsS -m 5 https://api.ipify.org 2>/dev/null \
            || true)
  fi
  if [[ -z "$pubip" ]]; then
    err "Could not auto-detect public IP — skipping. Run manually:"
    err "  monad-sign-name-record --address <YOUR_IP>:8000 --authenticated-udp-port 8001 \\"
    err "    --keystore-path /home/monad/monad-bft/config/id-secp \\"
    err "    --password \"\$KEYSTORE_PASSWORD\" --self-record-seq-num 1"
    return 1
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] monad-sign-name-record --address ${pubip}:8000 ...${C_RESET}"
    return 0
  fi

  info "Public IP: $pubip"
  local sig_output
  if ! sig_output=$(sudo -u monad bash -c "
    source /home/monad/.env
    monad-sign-name-record \
      --address ${pubip}:8000 \
      --authenticated-udp-port 8001 \
      --keystore-path /home/monad/monad-bft/config/id-secp \
      --password \"\$KEYSTORE_PASSWORD\" \
      --self-record-seq-num 1
  " 2>>"$LOG_FILE"); then
    err "monad-sign-name-record failed — see $LOG_FILE"
    return 1
  fi
  # Output is a signature string (likely hex). Capture last non-empty line.
  local sig
  sig=$(printf '%s\n' "$sig_output" | awk 'NF {last=$0} END {print last}')
  if [[ -z "$sig" ]]; then
    err "monad-sign-name-record produced no signature output"
    return 1
  fi

  # Inject into [peer_discovery] — replace self_name_record_sig + self_record_seq_num.
  # Also set self_address if currently empty.
  backup_file "$node_toml"
  python3 - "$node_toml" "$pubip" "$sig" <<'PYEOF'
import sys, re
path, pubip, sig = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    text = f.read()

def set_in_section(text, section, key, value):
    # Find [section] ... up to next [section] or EOF
    pattern = re.compile(
        r'(\[' + re.escape(section) + r'\][^\[]*?)'
        r'(^\s*' + re.escape(key) + r'\s*=.*$)',
        flags=re.MULTILINE | re.DOTALL
    )
    repl = r'\1' + key + ' = "' + value + '"'
    new, n = pattern.subn(repl, text, count=1)
    if n == 0:
        # Key not present — insert at end of section
        sect_re = re.compile(r'(\[' + re.escape(section) + r'\][^\[]*)', re.DOTALL)
        m = sect_re.search(text)
        if m:
            insertion = f'\n{key} = "{value}"\n'
            new = text[:m.end()] + insertion + text[m.end():]
        else:
            new = text + f'\n[{section}]\n{key} = "{value}"\n'
    return new

text = set_in_section(text, 'peer_discovery', 'self_address', f'{pubip}:8000')
text = set_in_section(text, 'peer_discovery', 'self_auth_port', '8001')
text = set_in_section(text, 'peer_discovery', 'self_record_seq_num', '1')
text = set_in_section(text, 'peer_discovery', 'self_name_record_sig', sig)

with open(path, 'w') as f:
    f.write(text)
print("Injected name-record signature into node.toml")
PYEOF
  ok "self_name_record_sig injected into node.toml [peer_discovery]"
}

# ===== Step: start services (final, opt-in) =====
# Enable + start the three core services in the order docs prescribe.
# Default: skip — operator should review node.toml + keys before going live.
step_start_services() {
  section "Start monad services (FINAL — opt-in)"

  local services=(monad-execution monad-bft monad-rpc)
  local missing=()
  for s in "${services[@]}"; do
    systemctl cat "$s" >/dev/null 2>&1 || missing+=("$s")
  done
  if (( ${#missing[@]} > 0 )); then
    info "Skipped — services not installed yet: ${missing[*]}"
    info "(Install monad package first via step_monad_install)"
    return 0
  fi

  # Skip if all already active
  local active_all=1
  for s in "${services[@]}"; do
    systemctl is-active --quiet "$s" || { active_all=0; break; }
  done
  if (( active_all )); then
    ok "All services already active: ${services[*]}"
    return 0
  fi

  local proceed=0
  if (( WITH_START_SERVICES )); then
    proceed=1
  elif (( NON_INTERACTIVE == 0 )); then
    echo
    warn "Starting services boots the validator into the network."
    warn "Before saying yes, confirm:"
    warn "  - node.toml has correct beneficiary, node_name, self_name_record_sig"
    warn "  - keys in /home/monad/monad-bft/config/ are correct (id-secp, id-bls)"
    warn "  - /dev/triedb partition is formatted (systemctl status monad-mpt)"
    if confirm "Start ${services[*]} now?"; then
      proceed=1
    fi
  fi
  if (( proceed == 0 )); then
    info "Skipped — start manually when ready:"
    for s in "${services[@]}"; do info "  sudo systemctl enable --now $s"; done
    return 0
  fi

  if (( DRY_RUN )); then
    for s in "${services[@]}"; do
      echo "  ${C_DIM}[dry-run] systemctl enable --now $s${C_RESET}"
    done
    return 0
  fi

  for s in "${services[@]}"; do
    if ! run "enabling+starting $s" systemctl enable --now "$s"; then
      err "$s failed to start — check: journalctl -u $s -n 50"
      return 1
    fi
  done
  sleep 3
  for s in "${services[@]}"; do
    if systemctl is-active --quiet "$s"; then
      ok "$s active"
    else
      err "$s not active after start — check journal"
      return 1
    fi
  done
  ok "All services started. Validator is now online."
}

# ===== Step: iptables UDP DDoS filter =====
# Per docs: sudo iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP
step_iptables_ddos() {
  section "iptables UDP length filter (per docs)"
  if ! command -v iptables >/dev/null; then
    warn "iptables not installed — skipping (install via step_dependencies)"
    return
  fi

  local rule_marker="# monad-bft UDP raptorcast: drop short packets (per docs)"
  local ufw_before=/etc/ufw/before.rules
  local rule_args=(-p udp --dport 8000 -m length --length 0:1400 -j DROP)

  # Already in the live ruleset? (matches either via INPUT or ufw-before-input)
  if iptables -C INPUT "${rule_args[@]}" 2>/dev/null \
     || iptables -C ufw-before-input "${rule_args[@]}" 2>/dev/null; then
    # Verify it will also survive reboot — if UFW is active but the rule is
    # not in before.rules, it'll vanish on next `ufw reload` / reboot.
    if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active" \
       && [[ -f "$ufw_before" ]] && ! grep -qF "$rule_marker" "$ufw_before"; then
      info "rule is live but not in $ufw_before — will be lost on reboot. Adding…"
    else
      ok "rule already present (and persistent)"
      return
    fi
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] iptables -I INPUT ${rule_args[*]}${C_RESET}"
    echo "  ${C_DIM}[dry-run] persist rule (via netfilter-persistent or UFW before.rules)${C_RESET}"
    return
  fi

  # An iptables INSERT runs ahead of any existing rules on the INPUT chain and
  # can interact badly with custom netfilter setups (frr/bird/k8s/wireguard).
  # Operators with their own firewall stack should review before we touch it.
  info "Will add: iptables -I INPUT ${rule_args[*]}"
  info "(drops short UDP packets <1400B on :8000 — valid raptorcast traffic is larger)"
  if ! confirm "Add this iptables rule?"; then
    warn "Skipped — docs recommend this rule for UDP DDoS robustness"
    return 0
  fi

  # Apply the rule live (idempotent thanks to the -C check above).
  if ! iptables -C INPUT "${rule_args[@]}" 2>/dev/null; then
    run "adding UDP length 0:1400 DROP rule" iptables -I INPUT "${rule_args[@]}"
  fi

  # Persistence: choose one of two paths.
  #   1. netfilter-persistent (saves to /etc/iptables/rules.v4 on shutdown)
  #   2. UFW before.rules     (loaded by ufw.service on boot)
  # On Ubuntu 24.04 these packages Conflict — only one will be installed.
  # We prefer netfilter-persistent when present (classic path); fall back to
  # UFW's before.rules, which is the canonical way to add custom iptables
  # rules when UFW is the firewall.
  if command -v netfilter-persistent >/dev/null; then
    run "persisting iptables rules" netfilter-persistent save
    ok "UDP length filter active and persisted via netfilter-persistent"
  elif [[ -f "$ufw_before" ]]; then
    if grep -qF "$rule_marker" "$ufw_before"; then
      ok "rule already in $ufw_before"
    else
      cp "$ufw_before" "${ufw_before}.bak.${TS}"
      info "backup: ${ufw_before}.bak.${TS}"
      # Insert in the *filter table, before the COMMIT line, as a
      # ufw-before-input rule (runs alongside UFW's own pre-input rules).
      # We use awk so we hit the COMMIT inside the *filter section specifically.
      awk -v marker="$rule_marker" '
        /^\*filter/ { in_filter = 1 }
        in_filter && /^COMMIT/ {
          print ""
          print marker
          print "-A ufw-before-input -p udp --dport 8000 -m length --length 0:1400 -j DROP"
          in_filter = 0
        }
        { print }
      ' "$ufw_before" >"${ufw_before}.tmp" && mv "${ufw_before}.tmp" "$ufw_before"

      # Verify the insertion actually landed. If before.rules has an unusual
      # structure (no *filter, no COMMIT in *filter section), awk silently
      # leaves the file unchanged — and the rule would not persist.
      if ! grep -qF "$rule_marker" "$ufw_before"; then
        err "Failed to insert rule into $ufw_before — unusual file structure?"
        err "Restore from backup: sudo cp ${ufw_before}.bak.${TS} ${ufw_before}"
        return 1
      fi
      if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
        run "reloading ufw to load before.rules" ufw reload
      fi
      ok "UDP length filter persisted via $ufw_before"
    fi
  else
    warn "no persistence mechanism (no netfilter-persistent, no $ufw_before) — rule will be lost on reboot"
    warn "Install one: apt install -y netfilter-persistent  OR  enable UFW first."
  fi
}

# ===== Step: /dev/triedb SYMLINK udev rule =====
# Per docs:
#   PARTUUID=$(lsblk -o PARTUUID $TRIEDB_DRIVE | tail -n 1)
#   echo "ENV{ID_PART_ENTRY_UUID}==\"$PARTUUID\", MODE=\"0666\", SYMLINK+=\"triedb\"" \
#     | tee /etc/udev/rules.d/99-triedb.rules
step_triedb_symlink() {
  section "TriedB SYMLINK udev rule (per docs)"
  local rule=/etc/udev/rules.d/99-triedb.rules

  # Identify triedb partition: prefer existing /dev/triedb symlink; else
  # nothing to do (operator must partition first or specify --triedb-dev=).
  local triedb_part=""
  if [[ -L /dev/triedb ]]; then
    triedb_part=$(readlink -f /dev/triedb)
  fi
  if [[ -z "$triedb_part" || ! -b "$triedb_part" ]]; then
    info "No triedb partition detected (/dev/triedb missing) — operator must"
    info "partition the triedb device first, then re-run this step."
    return
  fi

  local partuuid
  partuuid=$(lsblk -no PARTUUID "$triedb_part" 2>/dev/null | tr -d ' ')
  if [[ -z "$partuuid" ]]; then
    warn "Could not read PARTUUID of $triedb_part — skipping symlink rule"
    return
  fi

  local content="# monad-validator-setup ${TS}
ENV{ID_PART_ENTRY_UUID}==\"${partuuid}\", MODE=\"0666\", SYMLINK+=\"triedb\"
"
  if [[ -f "$rule" ]] && [[ "$(cat "$rule" 2>/dev/null)" == "$content" ]]; then
    ok "udev rule for triedb SYMLINK already in place (PARTUUID=$partuuid)"
    return
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write $rule with PARTUUID=$partuuid${C_RESET}"
    return
  fi
  backup_file "$rule"
  echo "$content" >"$rule"
  ok "Wrote $rule (PARTUUID=$partuuid)"
  run "reloading udev" udevadm control --reload-rules
}

# ===== Step: download config files (.env + node.toml) =====
# Per docs (full-node-installation):
#   curl -o /home/monad/.env $MF_BUCKET/config/<network>/latest/.env.example
#   curl -o /home/monad/monad-bft/config/node.toml \
#        $MF_BUCKET/config/<network>/latest/<full-node-node.toml | node.toml>
# Validator template is `node.toml`; full-node template is `full-node-node.toml`.
step_config_files() {
  section "Bootstrap config files (.env + node.toml)"

  if [[ -z "$NETWORK" ]]; then
    warn "Network not chosen — skipping config download (run choose_network first)"
    return
  fi

  local env_file=/home/monad/.env
  local node_toml=/home/monad/monad-bft/config/node.toml
  local toml_name
  if [[ "$NODE_TYPE" == "validator" ]]; then
    toml_name="node.toml"
  else
    toml_name="full-node-node.toml"
  fi
  local env_url="${MF_BUCKET}/config/${NETWORK}/latest/.env.example"
  local toml_url="${MF_BUCKET}/config/${NETWORK}/latest/${toml_name}"

  # .env — preserve if already exists (operator may have customized)
  if [[ -f "$env_file" ]]; then
    info ".env already present — keeping (delete first to re-download)"
  elif (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -o $env_file $env_url${C_RESET}"
  else
    mkdir -p "$(dirname "$env_file")"
    if run "downloading .env (${NETWORK})" curl -fsSL --max-time 30 -o "$env_file" "$env_url"; then
      chown monad:monad "$env_file" 2>/dev/null || true
      chmod 0644 "$env_file"
      ok "Wrote $env_file (from $env_url)"
    else
      warn "Failed to download .env — operator must place manually"
      return 1
    fi
  fi

  # node.toml — preserve if already exists
  if [[ -f "$node_toml" ]]; then
    info "node.toml already present — keeping (delete first to re-download)"
  elif (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -o $node_toml $toml_url${C_RESET}"
  else
    mkdir -p "$(dirname "$node_toml")"
    if run "downloading node.toml (${NODE_TYPE} on ${NETWORK})" \
         curl -fsSL --max-time 30 -o "$node_toml" "$toml_url"; then
      chown monad:monad "$node_toml" 2>/dev/null || true
      chmod 0644 "$node_toml"
      ok "Wrote $node_toml (from $toml_url)"
    else
      warn "Failed to download node.toml — operator must place manually"
      return 1
    fi
  fi
}

