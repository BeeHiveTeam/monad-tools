# ===== Pre-checks =====
[[ $EUID -eq 0 ]] || fatal "Run as root: sudo $0 $*"

# Read interactively from the controlling terminal, not STDIN. This is what
# makes prompts work when the script is run as `curl ... | sudo bash` — in
# that case STDIN is the script body itself, so `read` would consume future
# script lines instead of waiting for the operator.
# Falls back to STDIN if /dev/tty isn't available (e.g. true headless CI).
prompt_read() {
  local var="$1" promptmsg="$2"
  if [[ -r /dev/tty ]]; then
    read -rp "$promptmsg" "$var" </dev/tty
  else
    read -rp "$promptmsg" "$var"
  fi
}

confirm() {
  [[ $NON_INTERACTIVE -eq 1 ]] && { info "(non-interactive: assuming Yes for: $1)"; return 0; }
  local ans=""
  prompt_read ans "${C_YELLOW}?${C_RESET} $1 [Y/n] "
  [[ ! "$ans" =~ ^[Nn]$ ]]
}

# Like confirm() but for DESTRUCTIVE actions (data loss possible): requires
# the operator to type 'y' or 'yes' explicitly — Enter / empty input is
# treated as 'no'. Prevents accidentally wiping a disk by hitting Enter.
confirm_destructive() {
  if (( NON_INTERACTIVE == 1 )); then
    # Non-interactive auto-Yes only when the operator explicitly enables it
    # via the optional second arg (e.g. ALLOW_NVME_REFORMAT for nvme format).
    if [[ "${2:-0}" == "1" ]]; then
      info "(non-interactive + opt-in: assuming Yes for: $1)"
      return 0
    fi
    err "DESTRUCTIVE action skipped in --non-interactive: $1"
    return 1
  fi
  local ans=""
  prompt_read ans "${C_RED}${C_BOLD}!${C_RESET} $1 (type 'yes' to proceed) "
  [[ "$ans" == "yes" || "$ans" == "y" ]]
}

# Detect ports SSH actually listens on. We must NEVER hardcode 22/tcp into the
# UFW rules — operators very commonly move SSH (`Port 2222`) as a defense
# against bruteforce, and `ufw allow 22/tcp + ufw enable` would lock them out.
# Sources (merged + deduped):
#   1. $SSH_CONNECTION (when run inside an SSH session): the LAST field is the
#      server port we're connected on right now. Guaranteed-not-locked-out port.
#   2. sshd_config `Port` directive(s) via `sshd -T` (handles Include + multi-Port).
# NOTE: we deliberately do NOT inspect `ss -tlnp` for sshd-owned sockets.
# That source picks up X11 forwarding sockets (6010, 6011, ...) which are
# owned by per-session sshd processes but are NOT the master daemon port —
# whitelisting them in UFW would add useless rules that disappear with the session.
# Returns a space-separated list. Falls back to "22" only if all sources empty.
detect_ssh_ports() {
  local ports=""
  # Source 1: current SSH session
  if [[ -n "${SSH_CONNECTION:-}" ]]; then
    local cur_port
    cur_port=$(awk '{print $NF}' <<<"$SSH_CONNECTION")
    [[ "$cur_port" =~ ^[0-9]+$ ]] && ports+="$cur_port "
  fi
  # Source 2: sshd_config — `sshd -T` evaluates Include + Match defaults and is
  # the authoritative source for the daemon's listening port(s).
  if [[ -r /etc/ssh/sshd_config ]]; then
    local sshd_ports
    sshd_ports=$(sshd -T 2>/dev/null | awk '/^port / {print $2}')
    [[ -z "$sshd_ports" ]] && sshd_ports=$(grep -hE '^\s*Port\s+[0-9]+' \
      /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null \
      | awk '{print $2}')
    ports+="$sshd_ports "
  fi
  # Dedupe and validate
  local unique
  unique=$(tr ' ' '\n' <<<"$ports" | awk 'NF && /^[0-9]+$/' | sort -u | tr '\n' ' ')
  unique="${unique% }"
  [[ -z "$unique" ]] && unique="22"
  echo "$unique"
}

# Ask the operator to choose network if not provided via --network=.
choose_network() {
  if [[ -n "$NETWORK" ]]; then
    info "Network: ${C_BOLD}${NETWORK}${C_RESET} (from --network=${NETWORK})"
    resolve_pkg_version
    return 0
  fi
  if [[ $NON_INTERACTIVE -eq 1 ]]; then
    fatal "--network=testnet or --network=mainnet required in --non-interactive mode"
  fi
  echo
  echo "${C_BOLD}Which Monad network are you setting up this node for?${C_RESET}"
  echo "  1) testnet  (recommended for first deployment; VDP requires testnet validator)"
  echo "  2) mainnet"
  local ans
  while true; do
    prompt_read ans "${C_YELLOW}?${C_RESET} Choose [1/2]: "
    case "$ans" in
      1|testnet) NETWORK="testnet"; break ;;
      2|mainnet) NETWORK="mainnet"; break ;;
      *)         echo "  Please enter 1 or 2." ;;
    esac
  done
  info "Network: ${C_BOLD}${NETWORK}${C_RESET}"
  resolve_pkg_version
}

# Resolve MONAD_PKG_VERSION from per-network env overrides if the user set them.
# If neither this nor MONAD_PKG_VERSION is set, leave value empty — the real
# version will be auto-detected from `apt-cache policy monad` after the repo
# is added (see step_monad_install). This means the script tracks whatever
# Category Labs publishes without anyone hand-editing version pins.
resolve_pkg_version() {
  if [[ "$MONAD_PKG_VERSION" == "__auto__" ]]; then
    case "$NETWORK" in
      testnet) MONAD_PKG_VERSION="$MONAD_PKG_VERSION_TESTNET" ;;
      mainnet) MONAD_PKG_VERSION="$MONAD_PKG_VERSION_MAINNET" ;;
      *)       MONAD_PKG_VERSION="" ;;
    esac
  fi
  if [[ -n "$MONAD_PKG_VERSION" ]]; then
    info "Pinned monad version: ${C_BOLD}${MONAD_PKG_VERSION}${C_RESET} (env override)"
  else
    info "Monad version: ${C_BOLD}auto${C_RESET} — will use apt repo candidate at install time"
  fi

  # Auto-enable VDP OTel push for testnet — VDP eligibility requires 4-week
  # uptime + metrics flow to MF. Testnet is where that history accumulates,
  # so every testnet validator should be pushing from day one. Mainnet stays
  # opt-in (operator may have a custom collector or no VDP plans).
  # --no-vdp-otel lets the operator opt out explicitly.
  if (( WITH_VDP_OTEL_EXPLICIT == 0 )) && [[ "$NETWORK" == "testnet" ]]; then
    WITH_VDP_OTEL=1
    info "Testnet default: ${C_BOLD}--with-vdp-otel${C_RESET} enabled (VDP delegation track)"
    info "  Opt out with: --no-vdp-otel"
  fi

  # Mainnet operators who want VDP must opt in explicitly. If they didn't,
  # warn loudly — VDP enrollment requires MF metrics access, and discovering
  # this post-install means re-running setup later. Not a hard fail because
  # some mainnet validators legitimately don't participate in VDP.
  if (( WITH_VDP_OTEL_EXPLICIT == 0 )) && [[ "$NETWORK" == "mainnet" ]]; then
    warn "Mainnet install without --with-vdp-otel."
    warn "  If you intend to participate in VDP, MF requires metrics push to"
    warn "  otel-external.monadinfra.com:443 with your secp_key label. Re-run"
    warn "  this script with --with-vdp-otel after the node syncs to enable it."
    warn "  Pass --no-vdp-otel to silence this warning if you don't want VDP."
  fi
}

run() {
  # run <description> <cmd...>  — runs (or echoes if dry-run) and logs
  local desc="$1"; shift
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] $desc:${C_RESET} $*"
    return 0
  fi
  echo "  ${C_DIM}→ $desc${C_RESET}" >>"$LOG_FILE"
  if "$@" >>"$LOG_FILE" 2>&1; then
    return 0
  else
    local rc=$?
    err "Command failed (rc=$rc): $*"
    err "  See $LOG_FILE for details"
    return $rc
  fi
}

backup_file() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  # Find an unused backup name. ${f}.bak.${TS} would collide when multiple
  # steps in the same run back up the same file (witnessed: step_node_toml_
  # customize and step_sign_name_record both write node.toml → second
  # backup_file overwrites the first, losing the original-state copy).
  local bak="${f}.bak.${TS}"
  if [[ -e "$bak" ]]; then
    local n=1
    while [[ -e "${f}.bak.${TS}.${n}" ]]; do ((n++)); done
    bak="${f}.bak.${TS}.${n}"
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] backup: $f → $bak${C_RESET}"
    return 0
  fi
  cp -p "$f" "$bak" && echo "  ${C_DIM}backup: $bak${C_RESET}"
}

ensure_line() {
  # ensure_line <file> <line>  — adds line if absent (idempotent)
  local file="$1" line="$2"
  if [[ -f "$file" ]] && grep -qxF "$line" "$file"; then
    return 0
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] add to $file:${C_RESET} $line"
    return 0
  fi
  backup_file "$file"
  echo "$line" >>"$file"
}

# ===== Step: preflight =====
step_preflight() {
  section "Pre-flight (monad-doctor)"

  if (( SKIP_PREFLIGHT )); then
    info "Skipping preflight (--skip-preflight)"
    return 0
  fi

  if [[ ! -x "$DOCTOR_PATH" ]]; then
    warn "monad-doctor not found at $DOCTOR_PATH — skipping preflight"
    warn "Get it: git clone https://github.com/BeeHiveTeam/monad-tools.git"
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] would run: $DOCTOR_PATH --quick${C_RESET}"
    return 0
  fi

  info "Running monad-doctor (this is read-only, no system changes)…"
  "$DOCTOR_PATH" --quick
  local rc=$?
  case $rc in
    0) ok "Preflight: all clean" ;;
    1) warn "Preflight: warnings (continuing)" ;;
    2)
      err "Preflight: FAIL — server not ready for validator"
      # Hard-abort in --non-interactive mode: CI/automation must not silently
      # auto-continue past a hardware/OS issue the operator hasn't seen.
      # Operators who *want* to bypass FAIL non-interactively can pass
      # --skip-preflight explicitly.
      if (( NON_INTERACTIVE )); then
        fatal "Preflight FAIL in --non-interactive mode — re-run without it OR pass --skip-preflight to override."
      fi
      if confirm "Continue anyway? (NOT recommended)"; then
        warn "Continuing despite preflight failures"
      else
        fatal "Aborted by user"
      fi ;;
    *) warn "Preflight: unknown exit code $rc" ;;
  esac
}

# ===== Step: dependencies =====
# Per docs (full-node-installation): apt install -y curl nvme-cli aria2 jq
step_dependencies() {
  section "System dependencies (per docs)"
  # gnupg: needed to dearmor the ASCII-armored apt signing key (since 2026-05-14).
  # parted: needed by step_triedb_partition for mklabel/mkpart.
  # python3: needed by step_sign_name_record for TOML injection (usually
  #          pre-installed via python3-minimal essential, but minimal images
  #          sometimes lack it).
  # On Ubuntu 24.04 `ufw` and `iptables-persistent` declare Conflicts at the
  # Debian metadata level — installing both in one apt call (or installing ufw
  # after iptables-persistent) silently removes iptables-persistent. We do NOT
  # bundle iptables-persistent here. The iptables UDP DROP rule is persisted
  # via UFW's /etc/ufw/before.rules instead (handled by step_iptables_ddos).
  local pkgs=(curl gnupg nvme-cli aria2 jq ethtool ufw iptables parted python3)
  local missing=()
  for p in "${pkgs[@]}"; do
    dpkg -l "$p" 2>/dev/null | grep -qE '^.i  ' || missing+=("$p")
  done
  if (( ${#missing[@]} == 0 )); then
    ok "All dependencies installed: ${pkgs[*]}"
    return
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] apt install -y ${missing[*]}${C_RESET}"
    return
  fi
  # apt update failure here is almost always a broken /etc/apt/sources.list.d
  # entry (e.g. a half-configured Category Labs source from a previous run).
  # Bail out — silent success masked the real problem before.
  if ! run "apt update" apt-get update -qq; then
    err "apt-get update failed — likely a broken entry in /etc/apt/sources.list.d/"
    err "Inspect: sudo apt-get update    (without -qq to see the offending source)"
    err "Common fix: sudo rm /etc/apt/sources.list.d/category-labs.sources \\"
    err "           /etc/apt/keyrings/category-labs.gpg   # then re-run this script"
    return 1
  fi
  if ! run "installing missing deps: ${missing[*]}" apt-get install -y "${missing[@]}"; then
    err "Dependency install failed — check $LOG_FILE"
    return 1
  fi
  ok "Dependencies installed."
}

# ===== Step: monad user / directories =====
# Per docs: useradd -m -s /bin/bash monad
#          mkdir -p /home/monad/monad-bft/{config,ledger,config/forkpoint,config/validators}
step_monad_user() {
  section "Monad user / directories (per docs)"
  if id monad >/dev/null 2>&1; then
    ok "user 'monad' already exists ($(id -u monad):$(id -g monad))"
  else
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] useradd -m -s /bin/bash monad${C_RESET}"
    else
      if ! run "creating user monad" useradd -m -s /bin/bash monad; then
        err "Could not create 'monad' user — aborting step."
        return 1
      fi
      ok "Created user 'monad' ($(id -u monad):$(id -g monad), home: /home/monad)"
    fi
  fi
  local dirs=(
    /home/monad/monad-bft/config
    /home/monad/monad-bft/ledger
    /home/monad/monad-bft/config/forkpoint
    /home/monad/monad-bft/config/validators
  )
  for d in "${dirs[@]}"; do
    if [[ -d "$d" ]]; then
      :
    elif (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] mkdir -p $d${C_RESET}"
    else
      if ! mkdir -p "$d"; then
        err "Could not create directory $d"
        return 1
      fi
    fi
  done
  if (( DRY_RUN == 0 )) && id monad >/dev/null 2>&1; then
    # chown is intentionally tolerant: on a re-run after a partial failure,
    # some files may already be owned by monad; we don't want to fail the
    # whole step over that.
    chown -R monad:monad /home/monad/monad-bft 2>/dev/null || true
  fi
  ok "Directory tree under /home/monad/monad-bft/ ready"
}

# Enumerate NVMe disks that look genuinely free (not in OS RAID, no mounts,
# no swap, no partitions at all). Returns a newline-separated list of disk
# basenames (e.g. "nvme1n1").
list_free_nvme_disks() {
  local root_src root_dev
  root_src=$(findmnt -no SOURCE / 2>/dev/null)
  root_dev="${root_src##*/}"

  # Build set of partitions that belong to the root md array (if any).
  local parts_under_root=()
  if [[ -n "$root_dev" && -e "/sys/block/$root_dev/md" ]]; then
    while IFS= read -r m; do
      parts_under_root+=("$m")
    done < <(ls "/sys/block/$root_dev/md/" 2>/dev/null | sed -n 's/^dev-//p')
  fi

  while IFS= read -r disk; do
    [[ -z "$disk" ]] && continue
    # Skip if in OS root md array
    local skip=0
    for m in "${parts_under_root[@]}"; do
      if lsblk -ln -o NAME "/dev/$disk" 2>/dev/null | grep -qx "$m"; then skip=1; break; fi
    done
    (( skip )) && continue
    # Skip if anything under this disk is mounted at /
    if lsblk -ln -o MOUNTPOINT "/dev/$disk" 2>/dev/null | grep -qx "/"; then continue; fi
    # Skip if any non-swap mount on this disk (already in use)
    if lsblk -ln -o MOUNTPOINT "/dev/$disk" 2>/dev/null \
       | grep -vE '^$|^\[SWAP\]$' | grep -q .; then continue; fi
    echo "$disk"
  done < <(lsblk -dn -o NAME,TYPE 2>/dev/null | awk '$2=="disk" && $1 ~ /^nvme/ {print $1}')
}

# ===== Step: partition triedb disk (optional, destructive) =====
# Per docs:
#   parted $DRIVE mklabel gpt
#   parted $DRIVE mkpart triedb 0% 100%
#   PARTUUID=$(lsblk -o PARTUUID $DRIVE | tail -n 1)
#   echo "ENV{ID_PART_ENTRY_UUID}==..." > /etc/udev/rules.d/99-triedb.rules
#   udevadm trigger
# Also: nvme format --lbaf=0 if LBA != 512 (DESTROYS disk, before parted).
step_triedb_partition() {
  section "Triedb disk partitioning (optional, DESTRUCTIVE)"

  # Already done? Skip silently.
  if [[ -L /dev/triedb ]]; then
    ok "/dev/triedb already exists — skipping partition step"
    return 0
  fi

  # Detect "half state": a previous run created a GPT partition with label
  # "triedb" but udev didn't get the rule / symlink. Re-running would
  # uselessly destroy the partition and start over; better to just re-emit
  # the udev rule with the existing partition's PARTUUID and trigger udev.
  local existing_triedb_part=""
  while IFS= read -r blk; do
    local lbl
    lbl=$(lsblk -no PARTLABEL "/dev/$blk" 2>/dev/null | head -1 | tr -d ' ')
    if [[ "$lbl" == "triedb" ]]; then
      existing_triedb_part="$blk"
      break
    fi
  done < <(lsblk -ln -o NAME,TYPE 2>/dev/null | awk '$2=="part" {print $1}')
  if [[ -n "$existing_triedb_part" ]]; then
    local partuuid
    partuuid=$(lsblk -no PARTUUID "/dev/$existing_triedb_part" 2>/dev/null | tr -d ' ')
    if [[ -n "$partuuid" ]]; then
      info "Found existing 'triedb' partition /dev/$existing_triedb_part (PARTUUID=$partuuid) — recovering udev rule"
      local rule=/etc/udev/rules.d/99-triedb.rules
      backup_file "$rule"
      cat >"$rule" <<EOF
# monad-validator-setup ${TS} (recovered from existing partition)
ENV{ID_PART_ENTRY_UUID}=="${partuuid}", MODE="0666", SYMLINK+="triedb"
EOF
      udevadm control --reload-rules 2>/dev/null || true
      udevadm trigger 2>/dev/null || true
      udevadm settle --timeout=10 2>/dev/null || sleep 2
      if [[ -L /dev/triedb ]]; then
        ok "/dev/triedb → $(readlink -f /dev/triedb) (recovered)"
        return 0
      else
        warn "udev rule rewritten but /dev/triedb still not appearing — may need reboot"
        return 0
      fi
    fi
  fi

  # Find candidates
  local -a candidates=()
  while IFS= read -r d; do
    [[ -n "$d" ]] && candidates+=("$d")
  done < <(list_free_nvme_disks)

  if (( ${#candidates[@]} == 0 )); then
    info "No free NVMe disks found (all are in OS RAID / mounted / partitioned)"
    info "If you want to partition a specific disk, pass --triedb-partition=DEV"
    return 0
  fi

  # Decide target: --triedb-partition flag wins, else interactive prompt.
  local target=""
  if [[ -n "$TRIEDB_PARTITION_DEV" ]]; then
    target="${TRIEDB_PARTITION_DEV#/dev/}"
    info "Using --triedb-partition=$target (operator-specified)"
  elif (( NON_INTERACTIVE )); then
    info "No --triedb-partition= and --non-interactive — skipping"
    info "(operator will partition manually; re-run with --triedb-partition=DEV to automate)"
    return 0
  else
    echo
    echo "${C_BOLD}Free NVMe disks detected (safe to partition for triedb):${C_RESET}"
    local i=1
    for d in "${candidates[@]}"; do
      local size_h model
      size_h=$(lsblk -dn -o SIZE "/dev/$d" 2>/dev/null | xargs)
      model=$(lsblk -dn -o MODEL "/dev/$d" 2>/dev/null | xargs)
      printf "  %d) /dev/%s  %-8s  %s\n" "$i" "$d" "$size_h" "$model"
      ((i++))
    done
    echo "  0) Skip — partition manually later"
    echo
    local ans=""
    prompt_read ans "${C_YELLOW}?${C_RESET} Choose disk for triedb [0-${#candidates[@]}]: "
    if [[ -z "$ans" || "$ans" == "0" ]]; then
      info "Skipped — operator will partition manually"
      return 0
    fi
    if [[ ! "$ans" =~ ^[0-9]+$ ]] || (( ans < 1 || ans > ${#candidates[@]} )); then
      warn "Invalid choice '$ans' — skipping"
      return 0
    fi
    target="${candidates[$((ans-1))]}"
  fi

  local dev="/dev/$target"
  if [[ ! -b "$dev" ]]; then
    err "$dev is not a block device — aborting"
    return 1
  fi

  echo
  warn "${C_BOLD}DESTRUCTIVE${C_RESET}: this will WIPE $dev. Any data on it is lost."
  if ! confirm_destructive "Partition $dev as 'triedb' (single full-disk partition)?"; then
    info "Skipped by operator"
    return 0
  fi

  # LBA check (per docs: must be 512-byte).
  if command -v nvme >/dev/null 2>&1; then
    local lba
    lba=$(lsblk -dn -o LOG-SEC "$dev" 2>/dev/null | tr -d ' ')
    if [[ -n "$lba" && "$lba" != "512" ]]; then
      warn "$dev currently has ${lba}-byte LBA — docs require 512 for triedb."
      warn "Reformatting at the NVMe level (lbaf=0) destroys the disk entirely."
      # In --non-interactive mode, confirm() returns Yes by default. For
      # nvme format that's too dangerous — require an explicit opt-in flag.
      if (( NON_INTERACTIVE )) && (( ALLOW_NVME_REFORMAT == 0 )); then
        warn "Skipping nvme format in --non-interactive (use --allow-nvme-reformat to opt in)"
        warn "Continuing with ${lba}-byte LBA — triedb performance will suffer (per docs)"
      elif confirm_destructive "Run 'nvme format $dev --lbaf=0 --force' now?" "$ALLOW_NVME_REFORMAT"; then
        if (( DRY_RUN )); then
          echo "  ${C_DIM}[dry-run] nvme format $dev --lbaf=0 --force${C_RESET}"
        else
          run "nvme format $dev --lbaf=0" nvme format "$dev" --lbaf=0 --force || {
            err "nvme format failed — see $LOG_FILE"
            return 1
          }
        fi
      else
        warn "Continuing with ${lba}-byte LBA — triedb performance will suffer (per docs)"
      fi
    fi
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] parted -s $dev mklabel gpt${C_RESET}"
    echo "  ${C_DIM}[dry-run] parted -s $dev mkpart triedb 0% 100%${C_RESET}"
    echo "  ${C_DIM}[dry-run] write /etc/udev/rules.d/99-triedb.rules${C_RESET}"
    return 0
  fi

  if ! command -v parted >/dev/null 2>&1; then
    run "installing parted" apt-get install -y parted || {
      err "Could not install parted"
      return 1
    }
  fi

  run "parted: mklabel gpt on $dev" parted -s "$dev" mklabel gpt || return 1
  run "parted: mkpart triedb on $dev" parted -s "$dev" mkpart triedb 0% 100% || return 1
  # Wait for kernel to re-read the partition table and for udev to create
  # device nodes. Without an explicit settle, slow boxes race: lsblk returns
  # only the parent disk, no partition, and step bails with "could not detect
  # new partition." partprobe nudges the kernel; udevadm settle waits for
  # all queued events to drain.
  partprobe "$dev" 2>/dev/null || true
  udevadm settle --timeout=10 2>/dev/null || sleep 2

  # Detect new partition name (nvme0n1 → nvme0n1p1, sda → sda1)
  local part_name
  part_name=$(lsblk -ln -o NAME "$dev" 2>/dev/null | awk -v d="$target" '$0 != d {print; exit}')
  if [[ -z "$part_name" ]]; then
    err "Could not detect new partition on $dev"
    return 1
  fi
  local part_dev="/dev/$part_name"

  local partuuid
  partuuid=$(lsblk -no PARTUUID "$part_dev" 2>/dev/null | tr -d ' ')
  if [[ -z "$partuuid" ]]; then
    err "Could not read PARTUUID of $part_dev"
    return 1
  fi
  ok "Created $part_dev (PARTUUID=$partuuid)"

  # Write udev rule per docs (step_triedb_symlink would also do this, but we do
  # it here so /dev/triedb appears before later steps run).
  local rule=/etc/udev/rules.d/99-triedb.rules
  backup_file "$rule"
  cat >"$rule" <<EOF
# monad-validator-setup ${TS}
ENV{ID_PART_ENTRY_UUID}=="${partuuid}", MODE="0666", SYMLINK+="triedb"
EOF
  ok "Wrote $rule"
  run "reloading udev" udevadm control --reload-rules || true
  run "triggering udev" udevadm trigger || true
  udevadm settle || true
  if [[ -L /dev/triedb ]]; then
    ok "/dev/triedb → $(readlink -f /dev/triedb)"
  else
    warn "/dev/triedb symlink did not appear after udev trigger — may need reboot"
  fi
}

# ===== Step: format triedb partition (optional, runs once per docs) =====
# Per docs: systemctl start monad-mpt; journalctl -u monad-mpt -n 14
# Only run when explicitly requested (--triedb-format) OR interactive yes.
# Skipped if monad-mpt unit not installed, /dev/triedb missing, or partition
# is already formatted (monad-mpt is a one-shot — second run is a no-op but
# we don't want to look like we're "re-formatting" needlessly).
step_triedb_format() {
  section "Triedb partition format (one-shot, auto)"

  if ! systemctl cat monad-mpt >/dev/null 2>&1; then
    info "monad-mpt service not installed (ships with monad package) — skipping"
    return 0
  fi
  if [[ ! -L /dev/triedb ]]; then
    info "/dev/triedb not present — partition first or skip"
    return 0
  fi
  # Idempotency: skip only when monad-mpt has ACTUALLY been started and
  # exited cleanly. ExecMainStatus=0 alone matches a never-started unit too
  # (default value before first run), which made us skip on a fresh install
  # and leave triedb unformatted. Cross-check with ExecMainStartTimestamp:
  # empty timestamp = never started.
  local last_run main_status
  last_run=$(systemctl show monad-mpt -p ExecMainStartTimestamp --value 2>/dev/null)
  main_status=$(systemctl show monad-mpt -p ExecMainStatus --value 2>/dev/null)
  if [[ -n "$last_run" && "$main_status" == "0" ]]; then
    ok "monad-mpt already ran successfully ($last_run) — triedb formatted"
    return 0
  fi

  # Auto-run: monad-mpt is a one-shot systemd service. If /dev/triedb exists
  # and monad-mpt hasn't run successfully yet, we want it to run — there's no
  # reason to make the operator wait for a prompt here. Idempotent on re-run
  # (we already skipped above if ExecMainStatus=0).
  info "Running triedb format (auto — /dev/triedb present, monad-mpt not yet completed)"

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] systemctl start monad-mpt${C_RESET}"
    return 0
  fi

  run "starting monad-mpt (one-shot)" systemctl start monad-mpt || {
    err "monad-mpt failed — last 14 lines:"
    journalctl -u monad-mpt -n 14 --no-pager >&2 || true
    return 1
  }
  ok "monad-mpt completed — triedb partition ready"
}

# ===== Step: customize node.toml (optional) =====
# Operator must set beneficiary (rewards address) and node_name (unique moniker)
# before going live. Auto-fills if --beneficiary / --node-name flags given; else
# prompts interactively. Skips silently if both already set in node.toml.
step_node_toml_customize() {
  section "node.toml customization (beneficiary + node_name)"

  local node_toml=/home/monad/monad-bft/config/node.toml
  if [[ ! -f "$node_toml" ]]; then
    info "node.toml not present yet — run step_config_files first"
    return 0
  fi

  # Read current values
  local cur_ben cur_name
  cur_ben=$(awk -F\" '/^[[:space:]]*beneficiary[[:space:]]*=/ {print $2; exit}' "$node_toml")
  cur_name=$(awk -F\" '/^[[:space:]]*node_name[[:space:]]*=/ {print $2; exit}' "$node_toml")

  # Track whether we've already backed up (we may edit twice — beneficiary
  # then node_name — but want a single backup of the pre-edit state).
  local backed_up=0
  _backup_once() {
    (( backed_up )) && return
    backup_file "$node_toml"
    backed_up=1
  }

  # --- Beneficiary ---
  # A valid beneficiary is ^0x[0-9a-fA-F]{40}$ (Ethereum address). Anything
  # else — empty, `<INSERT_ADDRESS>` placeholder, partial hex, stray angle
  # brackets — must be treated as "not set", otherwise monad-bft panics at
  # startup with `InvalidDigit('<')`.
  # EXCEPTION for full-node: docs explicitly tell full-node operators to use
  # the zero address (0x0000…0000) as beneficiary. For validators that's
  # still rejected (operator must set a real reward address).
  local ben_target="$BENEFICIARY"
  local ben_is_valid=0
  if [[ "$cur_ben" =~ ^0x[0-9a-fA-F]{40}$ ]]; then
    if [[ "$cur_ben" == "0x0000000000000000000000000000000000000000" \
          && "$NODE_TYPE" != "full" ]]; then
      :  # zero address rejected for validator role
    else
      ben_is_valid=1
    fi
  fi
  if [[ -z "$ben_target" ]]; then
    if (( ben_is_valid == 0 )); then
      if (( NON_INTERACTIVE )); then
        warn "Beneficiary in node.toml is invalid/placeholder: '${cur_ben:-(empty)}'"
        warn "Pass --beneficiary=0x... or edit $node_toml manually before starting services."
      else
        echo
        info "Current beneficiary: ${cur_ben:-(empty)}  ← NOT a valid Ethereum address"
        info "This is the address where staking rewards are sent. Must be 0x + 40 hex."
        local input=""
        prompt_read input "${C_YELLOW}?${C_RESET} Beneficiary address (Enter to skip): "
        if [[ -n "$input" ]]; then
          if [[ ! "$input" =~ ^0x[0-9a-fA-F]{40}$ ]]; then
            err "Invalid address format — skipping beneficiary"
          else
            ben_target="$input"
          fi
        fi
      fi
    else
      ok "beneficiary already set: $cur_ben"
    fi
  fi
  if [[ -n "$ben_target" ]]; then
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] set beneficiary = \"$ben_target\" in $node_toml${C_RESET}"
    else
      _backup_once
      sed -i "s|^[[:space:]]*beneficiary[[:space:]]*=.*|beneficiary = \"$ben_target\"|" "$node_toml"
      ok "Set beneficiary = $ben_target"
      NODE_RECONFIGURED=1
      # Detect full→validator transition: previous beneficiary was zero address
      # (full-node default) and new one is a real Ethereum address.
      if [[ "$cur_ben" == "0x0000000000000000000000000000000000000000" \
            && "$ben_target" != "0x0000000000000000000000000000000000000000" ]]; then
        ROLE_TRANSITION="full→validator"
        info "${C_BOLD}Detected role transition: full-node → validator-ready${C_RESET}"
        info "  (beneficiary moved from 0x000…000 to your reward address)"
      fi
    fi
  elif (( ben_is_valid == 0 )); then
    # Operator declined to provide a beneficiary AND current value is a
    # placeholder. Fail the step loudly — silent continuation would lead to
    # monad-bft panic on startup with InvalidDigit('<') (real bug witnessed).
    err "node.toml beneficiary is invalid/placeholder and no value provided."
    err "Re-run with --beneficiary=0x... or fix $node_toml manually."
    return 1
  fi

  # --- node_name ---
  # A valid node_name is anything that doesn't look like a placeholder.
  # The default node.toml from MF ships with `node_name = "<NODE_NAME>"` —
  # the angle brackets are the tell. Treat any value containing `<` or `>`
  # as a placeholder; also catch common manual placeholders.
  local name_target="$NODE_NAME"
  local name_is_valid=1
  if [[ -z "$cur_name" \
        || "$cur_name" =~ [\<\>] \
        || "$cur_name" == "PLACEHOLDER" \
        || "$cur_name" == "REPLACE_ME" ]]; then
    name_is_valid=0
  fi
  if [[ -z "$name_target" ]]; then
    if (( name_is_valid == 0 )); then
      local default_name="BeeHive-$(hostname -s)"
      if (( NON_INTERACTIVE )); then
        name_target="$default_name"
        info "Auto node_name: $name_target (override with --node-name=)"
      else
        local input=""
        prompt_read input "${C_YELLOW}?${C_RESET} node_name (Enter for '$default_name'): "
        name_target="${input:-$default_name}"
      fi
    else
      ok "node_name already set: $cur_name"
    fi
  fi
  if [[ -n "$name_target" ]]; then
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] set node_name = \"$name_target\" in $node_toml${C_RESET}"
    else
      _backup_once
      # Use # as sed delimiter — node_name may contain | or / chars
      sed -i "s#^[[:space:]]*node_name[[:space:]]*=.*#node_name = \"${name_target//\#/\\#}\"#" "$node_toml"
      ok "Set node_name = $name_target"
      NODE_RECONFIGURED=1
    fi
  fi

  # --- Full-node-specific fields (per docs/full-node-installation) ---
  # The full-node template should already have these set, but we ensure them
  # idempotently in case the template drifted or the operator started with a
  # validator template and switched to --full-node.
  if [[ "$NODE_TYPE" == "full" ]] && (( DRY_RUN == 0 )); then
    # enable_client = true under [fullnode_raptorcast]
    if ! awk '/^\[fullnode_raptorcast\]/{f=1} /^\[/&&!/fullnode_raptorcast/{f=0}
              f && /^[[:space:]]*enable_client[[:space:]]*=[[:space:]]*true/{found=1; exit}
              END{exit !found}' "$node_toml"; then
      _backup_once
      python3 - "$node_toml" <<'PYEOF'
import sys, re
path = sys.argv[1]
with open(path) as f:
    text = f.read()
pattern = re.compile(
    r'(\[fullnode_raptorcast\][^\[]*?)(^\s*enable_client\s*=.*$)',
    flags=re.MULTILINE
)
new, n = pattern.subn(lambda m: m.group(1) + 'enable_client = true', text, count=1)
if n == 0:
    sect = re.compile(r'(\[fullnode_raptorcast\][^\[]*)')
    m = sect.search(text)
    new = text[:m.end()] + '\nenable_client = true\n' + text[m.end():] if m else text + '\n[fullnode_raptorcast]\nenable_client = true\n'
open(path, 'w').write(new)
PYEOF
      ok "Set enable_client = true (full-node)"
    fi
    # expand_to_group = true under [statesync]
    if ! awk '/^\[statesync\]/{f=1} /^\[/&&!/statesync/{f=0}
              f && /^[[:space:]]*expand_to_group[[:space:]]*=[[:space:]]*true/{found=1; exit}
              END{exit !found}' "$node_toml"; then
      _backup_once
      python3 - "$node_toml" <<'PYEOF'
import sys, re
path = sys.argv[1]
with open(path) as f:
    text = f.read()
pattern = re.compile(
    r'(\[statesync\][^\[]*?)(^\s*expand_to_group\s*=.*$)',
    flags=re.MULTILINE
)
new, n = pattern.subn(lambda m: m.group(1) + 'expand_to_group = true', text, count=1)
if n == 0:
    sect = re.compile(r'(\[statesync\][^\[]*)')
    m = sect.search(text)
    new = text[:m.end()] + '\nexpand_to_group = true\n' + text[m.end():] if m else text + '\n[statesync]\nexpand_to_group = true\n'
open(path, 'w').write(new)
PYEOF
      ok "Set expand_to_group = true (full-node)"
    fi
  fi
}

# ===== Step: generate validator keys (optional) =====
# Per docs: openssl rand → KEYSTORE_PASSWORD in /home/monad/.env, then
# monad-keystore create for SECP + BLS keys. Operator picks password mode:
#   1) auto-generate (display once — must back up immediately)
#   2) enter manually (twice for confirmation)
# Skipped silently if keys already exist.
step_generate_keys() {
  section "Validator key generation (optional)"

  if ! command -v monad-keystore >/dev/null 2>&1; then
    info "monad-keystore not installed (ships with monad package) — skipping"
    return 0
  fi
  # Require BOTH keys to exist AND be non-empty. The old OR-check skipped
  # the step when only one key existed (e.g. SECP succeeded, BLS failed) —
  # leaving the operator with a broken half-install that nothing detected.
  if [[ -s /home/monad/monad-bft/config/id-secp \
        && -s /home/monad/monad-bft/config/id-bls ]]; then
    ok "Keys already exist in /home/monad/monad-bft/config/ — skipping"
    return 0
  fi
  # If only one of them is present (partial state from a previous run),
  # bail with a clear message — re-creating would overwrite the surviving
  # one and the operator would lose half the keypair if they didn't notice.
  if [[ -e /home/monad/monad-bft/config/id-secp \
        || -e /home/monad/monad-bft/config/id-bls ]]; then
    err "Partial keystore state — only one of id-secp/id-bls is present."
    err "  id-secp: $([[ -s /home/monad/monad-bft/config/id-secp ]] && echo OK || echo missing/empty)"
    err "  id-bls:  $([[ -s /home/monad/monad-bft/config/id-bls  ]] && echo OK || echo missing/empty)"
    err "Refusing to silently regenerate — either restore from backup OR"
    err "remove both files first: sudo rm -f /home/monad/monad-bft/config/id-{secp,bls}"
    return 1
  fi

  local proceed=0
  if (( WITH_KEYS )); then
    proceed=1
  elif (( NON_INTERACTIVE == 0 )); then
    if confirm "Generate validator keys (SECP + BLS) now?"; then
      proceed=1
    fi
  fi
  if (( proceed == 0 )); then
    info "Skipped — generate manually later per docs/node-ops/validator-installation"
    return 0
  fi

  # Pick password mode
  local mode="${KEYSTORE_PASSWORD_INPUT:-}"
  if [[ -z "$mode" ]]; then
    if (( NON_INTERACTIVE )); then
      mode="auto"
      info "Non-interactive: auto-generating password"
    else
      echo
      echo "${C_BOLD}Password mode:${C_RESET}"
      echo "  1) auto-generate strong random password (32 bytes base64, shown ONCE)"
      echo "  2) enter your own password (typed twice, masked)"
      local c=""
      prompt_read c "${C_YELLOW}?${C_RESET} Choose [1/2]: "
      case "$c" in
        1) mode="auto" ;;
        2) mode="prompt" ;;
        *) warn "Invalid choice — skipping key gen"; return 0 ;;
      esac
    fi
  fi

  local password=""
  case "$mode" in
    auto)
      if ! command -v openssl >/dev/null 2>&1; then
        run "installing openssl" apt-get install -y openssl || return 1
      fi
      password=$(openssl rand -base64 32)
      echo
      echo "${C_BOLD}${C_YELLOW}═══════════════════════════════════════════════════════════"
      echo "  GENERATED KEYSTORE PASSWORD — BACK UP NOW, SHOWN ONCE:"
      echo "  ${password}"
      echo "═══════════════════════════════════════════════════════════${C_RESET}"
      echo
      ;;
    prompt)
      local pw1 pw2
      while true; do
        if [[ -r /dev/tty ]]; then
          read -srp "Enter keystore password: " pw1 </dev/tty; echo
          read -srp "Confirm password:         " pw2 </dev/tty; echo
        else
          read -srp "Enter keystore password: " pw1; echo
          read -srp "Confirm password:         " pw2; echo
        fi
        if [[ "$pw1" == "$pw2" && -n "$pw1" ]]; then
          password="$pw1"
          break
        fi
        warn "Passwords don't match (or empty). Try again."
      done
      ;;
  esac

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write KEYSTORE_PASSWORD to /home/monad/.env${C_RESET}"
    echo "  ${C_DIM}[dry-run] monad-keystore create --key-type secp${C_RESET}"
    echo "  ${C_DIM}[dry-run] monad-keystore create --key-type bls${C_RESET}"
    return 0
  fi

  # Escape single quotes for bash single-quoted-string syntax: ' → '\''
  # Auto-generated base64 passwords don't contain ', but operator-typed
  # ones might — without this escape, a password like  abc'def  would
  # produce  KEYSTORE_PASSWORD='abc'def'  which is a parse error in `source`.
  local password_esc="${password//\'/\'\\\'\'}"

  # Write to /home/monad/.env (replace existing line or append).
  local envfile=/home/monad/.env
  if [[ -f "$envfile" ]] && grep -q '^KEYSTORE_PASSWORD=' "$envfile"; then
    backup_file "$envfile"
    # Use awk + temp file for safety. password_esc is pre-escaped so the
    # resulting `KEYSTORE_PASSWORD='...'` is parseable by `source`.
    awk -v pw="$password_esc" '
      /^KEYSTORE_PASSWORD=/ { print "KEYSTORE_PASSWORD='\''" pw "'\''"; next }
      { print }
    ' "$envfile" >"${envfile}.tmp" && mv "${envfile}.tmp" "$envfile"
  else
    echo "KEYSTORE_PASSWORD='${password_esc}'" >>"$envfile"
  fi
  chown monad:monad "$envfile"
  chmod 0600 "$envfile"

  # Sanity-check the resulting .env actually sources cleanly. If we
  # corrupted it (escape bug), monad-keystore below will fail in a
  # confusing way — better catch it here.
  if ! ( set +u; source "$envfile" >/dev/null 2>&1; [[ -n "${KEYSTORE_PASSWORD:-}" ]] ); then
    err "$envfile became un-sourceable after writing KEYSTORE_PASSWORD."
    err "Likely a quoting/escape bug in the password — review and restore from:"
    err "  ${envfile}.bak.${TS}"
    return 1
  fi

  # Backup directory per docs (root-owned, operator-readable only).
  # mkdir -p alone leaves the dir world-listable (0755) — the password file
  # inside is 0600 but the directory itself shouldn't even be enumerable
  # by non-root. Set 0700 explicitly.
  mkdir -p /opt/monad/backup
  chmod 0700 /opt/monad/backup
  echo "Keystore password: $password" >/opt/monad/backup/keystore-password-backup
  chmod 0600 /opt/monad/backup/keystore-password-backup
  ok "Wrote KEYSTORE_PASSWORD to $envfile (mode 0600) + backup in /opt/monad/backup/"

  # Generate keys. Docs run this as root (not as monad user) — keystore files
  # land in /home/monad/monad-bft/config/ owned by root, then a chown to
  # monad:monad at the end. /opt/monad/backup is also a root-owned dir per
  # docs. Running as 'monad' fails because /opt/monad/backup is 0755 root —
  # the user can't write there.
  if ! bash -c "
    set -e
    source /home/monad/.env
    monad-keystore create --key-type secp \
      --keystore-path /home/monad/monad-bft/config/id-secp \
      --password \"\$KEYSTORE_PASSWORD\" > /opt/monad/backup/secp-backup
    monad-keystore create --key-type bls \
      --keystore-path /home/monad/monad-bft/config/id-bls \
      --password \"\$KEYSTORE_PASSWORD\" > /opt/monad/backup/bls-backup
    grep 'public key' /opt/monad/backup/secp-backup /opt/monad/backup/bls-backup \
      > /home/monad/pubkey-secp-bls
  " 2>>"$LOG_FILE"; then
    err "monad-keystore create failed — see $LOG_FILE"
    err "Common causes:"
    err "  - monad-keystore binary not found (monad pkg not installed?)"
    err "  - KEYSTORE_PASSWORD contains chars that broke shell escaping"
    err "  - /opt/monad/backup not writable"
    err "Last 20 lines of log:"
    tail -20 "$LOG_FILE" | sed 's/^/  /' >&2
    return 1
  fi
  # chown the new files to monad (per docs at end of install).
  chown monad:monad /home/monad/monad-bft/config/id-secp /home/monad/monad-bft/config/id-bls 2>/dev/null || true
  chmod 0600 /home/monad/monad-bft/config/id-secp /home/monad/monad-bft/config/id-bls 2>/dev/null || true
  chown monad:monad /home/monad/pubkey-secp-bls 2>/dev/null || true
  chmod 0600 /opt/monad/backup/*-backup 2>/dev/null || true
  ok "Generated SECP + BLS keys in /home/monad/monad-bft/config/"
  ok "Public keys recorded in /home/monad/pubkey-secp-bls"
  warn "${C_BOLD}BACK UP THE PASSWORD NOW. Without it the keys are unrecoverable.${C_RESET}"
  NODE_RECONFIGURED=1
}

# ===== Step: sign node-name record (optional) =====
# Per docs: monad-sign-name-record outputs a signature for Auth UDP.
# Inject into node.toml's [peer_discovery] section. Skip if signature already
# present or keys missing.
step_sign_name_record() {
  section "Auth UDP name-record signature (auto)"

  if ! command -v monad-sign-name-record >/dev/null 2>&1; then
    info "monad-sign-name-record not installed (ships with monad package) — skipping"
    return 0
  fi
  if [[ ! -f /home/monad/monad-bft/config/id-secp ]]; then
    info "SECP key missing — run --generate-keys first"
    return 0
  fi
  local node_toml=/home/monad/monad-bft/config/node.toml
  if [[ ! -f "$node_toml" ]]; then
    info "node.toml not present — run step_config_files first"
    return 0
  fi
  # Skip ONLY if signature is already set to a REAL value (avoid bumping
  # self_record_seq_num for a re-sign that would break Auth UDP with cached
  # peers). The default MF template ships `self_name_record_sig = "<NAME_RECORD_SIG>"`
  # — that's NOT a valid signature, treat as missing.
  local existing_sig
  existing_sig=$(awk -F\" '/^\[peer_discovery\]/ {in_pd=1; next}
                           /^\[/ && !/^\[peer_discovery\]/ {in_pd=0}
                           in_pd && /^[[:space:]]*self_name_record_sig[[:space:]]*=/ {print $2; exit}' \
                 "$node_toml" 2>/dev/null)
  if [[ -n "$existing_sig" && ! "$existing_sig" =~ [\<\>] ]]; then
    ok "self_name_record_sig already in node.toml — skipping (avoids seq_num bump)"
    return 0
  fi

  # Auto-run when prereqs are met. Signing is not destructive (it just
  # generates a signature for self_name_record_sig). The only risk is
  # bumping self_record_seq_num — but our skip-if-already-set check
  # above prevents that on re-run.
  info "Generating name-record signature (auto — prerequisites are met)"

  # Need public IP. Force IPv4 on BOTH probes — monad-bft binds IPv4 by
  # default for raptorcast/consensus, and a v6 self_address would break peer
  # discovery silently.
  local pubip=""
  if command -v curl >/dev/null 2>&1; then
    pubip=$(curl -fsS -m 5 -4 https://ifconfig.me 2>/dev/null \
            || curl -fsS -m 5 -4 https://api.ipify.org 2>/dev/null \
            || curl -fsS -m 5 -4 https://icanhazip.com 2>/dev/null \
            || true)
  fi
  # Validate looks like IPv4 (defence against ifconfig.me returning HTML/error page)
  if [[ -n "$pubip" && ! "$pubip" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    warn "Detected '$pubip' doesn't look like an IPv4 address — discarding"
    pubip=""
  fi
  if [[ -z "$pubip" ]]; then
    err "Could not auto-detect public IP — skipping. Run manually:"
    err "  monad-sign-name-record --address <YOUR_IP>:8000 --authenticated-udp-port 8001 \\"
    err "    --keystore-path /home/monad/monad-bft/config/id-secp \\"
    err "    --password \"\$KEYSTORE_PASSWORD\" --self-record-seq-num 1"
    return 1
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] monad-sign-name-record --address ${pubip}:8000 ...${C_RESET}"
    return 0
  fi

  info "Public IP: $pubip"
  local sig_output
  # Run as root (not monad) — monad-sign-name-record reads the keystore which
  # is now monad-owned 0600, but root can read it anyway. Avoids the
  # /opt/monad/backup permission pitfall that hit step_generate_keys.
  if ! sig_output=$(bash -c "
    source /home/monad/.env
    monad-sign-name-record \
      --address ${pubip}:8000 \
      --authenticated-udp-port 8001 \
      --keystore-path /home/monad/monad-bft/config/id-secp \
      --password \"\$KEYSTORE_PASSWORD\" \
      --self-record-seq-num 1
  " 2>>"$LOG_FILE"); then
    err "monad-sign-name-record failed — see $LOG_FILE"
    return 1
  fi

  # monad-sign-name-record outputs TOML-style lines, e.g.:
  #   self_name_record_sig = "e8187992a11dd4..."
  # The naive "last non-empty line" approach captured the WHOLE line
  # including the `key = "` prefix, then python's set_in_section quoted
  # it again, producing  self_name_record_sig = "self_name_record_sig = "...""
  # — which is a TOML parse error (witnessed in production today).
  # Extract ONLY the value between the outer double quotes.
  local sig
  sig=$(printf '%s\n' "$sig_output" | awk -F\" '
    /^[[:space:]]*self_name_record_sig[[:space:]]*=/ {print $2; exit}')
  if [[ -z "$sig" ]]; then
    # Fallback: any long hex string in the output (>=60 chars, 0-9a-f)
    sig=$(printf '%s\n' "$sig_output" | grep -oE '[0-9a-f]{60,}' | head -1)
  fi
  if [[ -z "$sig" ]]; then
    err "Could not parse signature from monad-sign-name-record output."
    err "Tool stdout was:"
    printf '%s\n' "$sig_output" | sed 's/^/  /' >&2
    err "Tool stderr in: $LOG_FILE"
    return 1
  fi
  # Sanity-check: hex only, reasonable length (sig is ~130 hex chars for SECP)
  if [[ ! "$sig" =~ ^[0-9a-fA-F]{60,}$ ]]; then
    err "Parsed signature doesn't look hex: '$sig'"
    return 1
  fi

  # Inject into [peer_discovery]. Three fields are integers in TOML
  # (self_auth_port, self_record_seq_num) so the python helper takes a
  # mode flag — quoting integers as strings is also a parse error per docs
  # (witnessed: monad-bft TOML parser rejected `self_auth_port = "8001"`).
  backup_file "$node_toml"
  python3 - "$node_toml" "$pubip" "$sig" <<'PYEOF'
import sys, re
path, pubip, sig = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    text = f.read()

def set_in_section(text, section, key, value, as_int=False):
    """Set/insert key=value inside [section]. as_int=True writes  key = N
    (no quotes); as_int=False writes  key = "value" (TOML string).

    NOTE: deliberately NOT using re.DOTALL. With DOTALL, the `.*$` in the
    second capture group becomes greedy across newlines and eats the rest
    of the file (a real bug: node.toml shrank from 3300 → 900 bytes,
    dropping refresh_period and everything after the matched key).
    Without DOTALL: `.*$` is bounded to one line; the `[^\[]*?` char-class
    in group 1 still matches newlines fine because char classes ignore
    DOTALL — they're explicit about what they include/exclude.
    """
    rhs = value if as_int else f'"{value}"'
    pattern = re.compile(
        r'(\[' + re.escape(section) + r'\][^\[]*?)'
        r'(^\s*' + re.escape(key) + r'\s*=.*$)',
        flags=re.MULTILINE
    )
    # NOTE: \1 in replacement gets the captured section prefix back.
    # Use a lambda to avoid re module interpreting backslashes in `rhs`
    # (signatures are hex so they're safe, but lambda is cleaner).
    new, n = pattern.subn(lambda m: m.group(1) + f'{key} = {rhs}', text, count=1)
    if n == 0:
        # Key not present — insert at end of section
        sect_re = re.compile(r'(\[' + re.escape(section) + r'\][^\[]*)', re.DOTALL)
        m = sect_re.search(text)
        if m:
            insertion = f'\n{key} = {rhs}\n'
            new = text[:m.end()] + insertion + text[m.end():]
        else:
            new = text + f'\n[{section}]\n{key} = {rhs}\n'
    return new

# Strings → quoted; ports/seq → bare integers per docs
text = set_in_section(text, 'peer_discovery', 'self_address',         f'{pubip}:8000')
text = set_in_section(text, 'peer_discovery', 'self_auth_port',       '8001', as_int=True)
text = set_in_section(text, 'peer_discovery', 'self_record_seq_num',  '1',    as_int=True)
text = set_in_section(text, 'peer_discovery', 'self_name_record_sig', sig)

with open(path, 'w') as f:
    f.write(text)
print("Injected name-record signature into node.toml")
PYEOF
  ok "self_name_record_sig injected into node.toml [peer_discovery]"
  NODE_RECONFIGURED=1
}

# ===== Step: snapshot restore (per docs hard-reset, default ON) =====
# Per docs.monad.xyz/node-ops/node-recovery/hard-reset:
#   curl -sSL $MF_BUCKET/scripts/<network>/restore-from-snapshot.sh | bash
# Docs full-node-installation step 15 explicitly tells operators to run
# hard-reset to seed the triedb so monad-bft doesn't sync from genesis
# (testnet: hours; mainnet: weeks). Default ON for fresh installs; auto-
# skip when the ledger already has data unless LEDGER_SUSPECT (a node.toml
# template swap that may invalidate chain state). A beneficiary-only
# full→validator promotion keeps its synced triedb — never re-snapshots.
step_snapshot_restore() {
  if (( WITH_SNAPSHOT_RESTORE == 0 )); then
    info "Skipping snapshot restore (--no-snapshot-restore was passed)"
    info "Without it, monad-bft syncs from genesis — days on mainnet, hours on testnet"
    return 0
  fi
  section "Snapshot restore (per docs hard-reset)"

  if [[ -z "$NETWORK" ]]; then
    err "Network not chosen — cannot pick snapshot URL"
    return 1
  fi

  if [[ ! -L /dev/triedb ]]; then
    err "/dev/triedb not present — partition + format the triedb device first"
    return 1
  fi

  # If services are running, stop them — restoring under a live node would
  # corrupt state. Remember we did this so step_start_services later starts
  # them back up.
  local services_were_active=0
  if systemctl is-active --quiet monad-bft 2>/dev/null; then
    services_were_active=1
    warn "monad-bft is active — stopping services for snapshot restore"
    run "stopping services" systemctl stop monad-bft monad-execution monad-rpc || true
  fi

  # Skip if ledger already has data AND no role transition. Tens of GB
  # download is wasteful when triedb is already populated and the node
  # only needs to catch up from current snapshot via normal sync.
  local ledger_dir=/home/monad/monad-bft/ledger
  local ledger_bytes=0
  if [[ -d "$ledger_dir" ]]; then
    ledger_bytes=$(du -sb "$ledger_dir" 2>/dev/null | awk '{print $1+0}')
  fi
  # 100 MB threshold — empty fresh install is < 1 MB; even short genesis
  # sync produces tens of MB; "real" data starts in the hundreds.
  if (( ledger_bytes > 104857600 )) && (( LEDGER_SUSPECT == 0 )); then
    info "Ledger already populated ($(( ledger_bytes / 1048576 )) MB) and chain state intact — skipping snapshot."
    info "To force re-import: rm -rf $ledger_dir/* && re-run with --snapshot-restore"
    # If we stopped services for this check, restart them.
    if (( services_were_active )); then
      info "Restarting services that were stopped pre-check…"
      run "starting services" systemctl start monad-bft monad-execution monad-rpc || true
    fi
    return 0
  fi
  if (( LEDGER_SUSPECT == 1 )); then
    warn "Ledger suspect (template swap: $ROLE_TRANSITION) — proceeding with snapshot restore regardless of existing ledger."
  fi

  local snap_url="${MF_BUCKET}/scripts/${NETWORK}/restore-from-snapshot.sh"

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -sSL $snap_url | bash${C_RESET}"
    return 0
  fi

  warn "About to download + apply a DB snapshot for ${NETWORK}."
  warn "This OVERWRITES /dev/triedb contents (testnet < 5 min, mainnet 1-5 min)."

  # Two cases:
  #   * Fresh install (ledger empty): nothing to lose — a normal confirm is
  #     fine, and --non-interactive auto-proceeds (seeding triedb is the
  #     expected fresh-install behavior, avoids days of genesis sync).
  #   * Existing populated ledger being overwritten (LEDGER_SUSPECT after a
  #     template swap): this DESTROYS synced state — gate behind
  #     confirm_destructive so an automated re-run can't silently wipe it.
  #     Opt in via ALLOW_SNAPSHOT_OVERWRITE=1 for non-interactive.
  local proceed=0
  if (( ledger_bytes > 104857600 )); then
    if confirm_destructive "Run snapshot restore now? This OVERWRITES an existing $(( ledger_bytes / 1048576 )) MB ledger." "${ALLOW_SNAPSHOT_OVERWRITE:-0}"; then
      proceed=1
    fi
  else
    if confirm "Run snapshot restore now? (fresh install — seeds triedb)"; then
      proceed=1
    fi
  fi
  if (( proceed == 0 )); then
    info "Skipped — re-run with --snapshot-restore (or stop services + curl manually)"
    if (( services_were_active )); then
      run "restarting services" systemctl start monad-bft monad-execution monad-rpc || true
    fi
    return 0
  fi

  info "Fetching + running $snap_url …"
  if ! curl -sSL --max-time 30 "$snap_url" | bash; then
    err "Snapshot restore script failed — check log on its own (it writes to /var/log/monad-snapshot* or similar)"
    if (( services_were_active )); then
      run "restarting services" systemctl start monad-bft monad-execution monad-rpc || true
    fi
    return 1
  fi
  ok "Snapshot restore completed"
}

# ===== Step: start services (final, opt-in) =====
# Enable + start the three core services in the order docs prescribe.
# Default: skip — operator should review node.toml + keys before going live.
step_start_services() {
  section "Start monad services (FINAL — opt-in)"

  # Docs canonical order: monad-bft monad-execution monad-rpc.
  # systemd dependencies usually sort this regardless, but match docs to
  # avoid surprises when monad team changes their unit's After= clauses.
  local services=(monad-bft monad-execution monad-rpc)
  local missing=()
  for s in "${services[@]}"; do
    systemctl cat "$s" >/dev/null 2>&1 || missing+=("$s")
  done
  if (( ${#missing[@]} > 0 )); then
    info "Skipped — services not installed yet: ${missing[*]}"
    info "(Install monad package first via step_monad_install)"
    return 0
  fi

  # Hard prerequisite checks — refuse to start if obvious dealbreakers are
  # missing. monad-bft will crash-loop on missing keys / unformatted triedb /
  # placeholder node.toml, leaving systemd in "failed" state and the operator
  # debugging from scratch. Better to bail loudly here.
  local blockers=()
  [[ -f /home/monad/monad-bft/config/id-secp ]] || blockers+=("missing /home/monad/monad-bft/config/id-secp (run --generate-keys)")
  [[ -f /home/monad/monad-bft/config/id-bls ]]  || blockers+=("missing /home/monad/monad-bft/config/id-bls (run --generate-keys)")
  [[ -L /dev/triedb ]] || blockers+=("/dev/triedb symlink missing (run --triedb-partition= or partition manually)")
  # monad-bft will panic at startup if rmem_max is below 62500000 — see
  # monad-dataplane/src/udp.rs panic "unable to set udp receive buffer size".
  local rmem_max_now
  rmem_max_now=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
  if (( rmem_max_now < 62500000 )); then
    blockers+=("net.core.rmem_max = $rmem_max_now (need ≥62500000 — monad-bft will panic). Fix: sudo sysctl --system; if still low, check /etc/sysctl.d/ for an override")
  fi
  if [[ -f /home/monad/monad-bft/config/node.toml ]]; then
    local ben name self_addr self_sig
    ben=$(awk -F\" '/^[[:space:]]*beneficiary[[:space:]]*=/ {print $2; exit}' /home/monad/monad-bft/config/node.toml)
    name=$(awk -F\" '/^[[:space:]]*node_name[[:space:]]*=/ {print $2; exit}' /home/monad/monad-bft/config/node.toml)
    self_addr=$(awk -F\" '/^[[:space:]]*self_address[[:space:]]*=/ {print $2; exit}' /home/monad/monad-bft/config/node.toml)
    self_sig=$(awk -F\" '/^[[:space:]]*self_name_record_sig[[:space:]]*=/ {print $2; exit}' /home/monad/monad-bft/config/node.toml)

    # Beneficiary must be a real Ethereum address. ANYTHING with < or > or
    # non-hex chars makes monad-bft panic with InvalidDigit('<') at startup.
    # For full-node mode, docs explicitly say to use the zero address — allow.
    if [[ ! "$ben" =~ ^0x[0-9a-fA-F]{40}$ ]]; then
      blockers+=("node.toml beneficiary invalid/placeholder: '$ben' (run --beneficiary=0x... or edit node.toml)")
    elif [[ "$ben" == "0x0000000000000000000000000000000000000000" \
            && "$NODE_TYPE" != "full" ]]; then
      blockers+=("node.toml beneficiary is the zero address — only valid for --full-node mode (use a real reward address for a validator)")
    fi
    # node_name placeholder check (angle brackets are the tell)
    if [[ -z "$name" || "$name" =~ [\<\>] || "$name" == "PLACEHOLDER" ]]; then
      blockers+=("node.toml node_name is placeholder: '$name' (run --node-name=... or edit node.toml)")
    fi
    # Auth UDP: self_address + self_name_record_sig must be set (not placeholder)
    if [[ -z "$self_addr" || "$self_addr" =~ [\<\>] ]]; then
      blockers+=("node.toml self_address placeholder: '$self_addr' (run --sign-name-record or edit node.toml)")
    fi
    if [[ -z "$self_sig" || "$self_sig" =~ [\<\>] ]]; then
      blockers+=("node.toml self_name_record_sig placeholder: '$self_sig' (run --sign-name-record or edit node.toml)")
    fi
    # Catch the specific double-quote injection bug we hit: when
    # monad-sign-name-record output gets misparsed, the sig ends up as
    # the literal TOML LINE ('self_name_record_sig = "hex..."') wrapped in
    # additional quotes — anything containing '=' or quotes is corrupt.
    if [[ "$self_sig" == *'='* || "$self_sig" == *'"'* ]]; then
      blockers+=("node.toml self_name_record_sig is malformed (contains = or quotes): '$self_sig' — re-run after restoring node.toml from backup")
    fi
    # TOML int fields must NOT be strings — monad-bft parser rejects
    # self_auth_port = "8001" (quoted). Detect by checking the line content.
    local node_toml_path=/home/monad/monad-bft/config/node.toml
    if grep -qE '^[[:space:]]*self_auth_port[[:space:]]*=[[:space:]]*"' "$node_toml_path" 2>/dev/null; then
      blockers+=("node.toml self_auth_port is quoted (must be integer): edit to 'self_auth_port = 8001' (no quotes)")
    fi
    if grep -qE '^[[:space:]]*self_record_seq_num[[:space:]]*=[[:space:]]*"' "$node_toml_path" 2>/dev/null; then
      blockers+=("node.toml self_record_seq_num is quoted (must be integer): edit to 'self_record_seq_num = 1' (no quotes)")
    fi
  else
    blockers+=("node.toml missing (run step_config_files)")
  fi
  if (( ${#blockers[@]} > 0 )); then
    err "Refusing to start services — preconditions not met:"
    for b in "${blockers[@]}"; do err "  - $b"; done
    err "Fix the above and re-run with --start-services (or systemctl start manually)."
    return 1
  fi

  # Skip if all already active — BUT if we just modified node.toml or keys
  # this run (e.g. full→validator promotion), the running services don't
  # know about the change. Try monad-debug-node reload-config first (hot
  # reload, no service downtime); fall back to `systemctl restart monad-bft`.
  local active_all=1
  for s in "${services[@]}"; do
    systemctl is-active --quiet "$s" || { active_all=0; break; }
  done
  if (( active_all )); then
    if (( NODE_RECONFIGURED == 0 )); then
      ok "All services already active: ${services[*]}"
      return 0
    fi
    # Reconfigured in this run — propagate changes.
    if [[ -n "$ROLE_TRANSITION" ]]; then
      info "Applying role transition ($ROLE_TRANSITION) to running monad-bft…"
    else
      info "node.toml / keys changed this run — reloading monad-bft config…"
    fi
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] monad-debug-node reload-config OR systemctl restart monad-bft${C_RESET}"
      return 0
    fi
    local sock=/home/monad/monad-bft/controlpanel.sock
    if command -v monad-debug-node >/dev/null 2>&1 && [[ -e "$sock" ]]; then
      if sudo -u monad monad-debug-node --control-panel-ipc-path "$sock" reload-config 2>>"$LOG_FILE"; then
        ok "monad-bft reloaded config without restart (no downtime)"
        return 0
      fi
      warn "reload-config failed — falling back to systemctl restart monad-bft"
    fi
    if ! run "restarting monad-bft to pick up new config" systemctl restart monad-bft; then
      err "monad-bft restart failed — check journal"
      return 1
    fi
    sleep 3
    if systemctl is-active --quiet monad-bft; then
      ok "monad-bft restarted with new config"
    else
      err "monad-bft not active after restart — check: journalctl -u monad-bft -n 50"
      return 1
    fi
    return 0
  fi

  local proceed=0
  if (( WITH_START_SERVICES )); then
    proceed=1
  elif (( NON_INTERACTIVE == 0 )); then
    echo
    warn "Starting services boots the validator into the network."
    warn "Before saying yes, confirm:"
    warn "  - node.toml has correct beneficiary, node_name, self_name_record_sig"
    warn "  - keys in /home/monad/monad-bft/config/ are correct (id-secp, id-bls)"
    warn "  - /dev/triedb partition is formatted (systemctl status monad-mpt)"
    if confirm "Start ${services[*]} now?"; then
      proceed=1
    fi
  fi
  if (( proceed == 0 )); then
    info "Skipped — start manually when ready:"
    for s in "${services[@]}"; do info "  sudo systemctl enable --now $s"; done
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] chown -R monad:monad /home/monad/${C_RESET}"
    echo "  ${C_DIM}[dry-run] systemctl enable ${services[*]}${C_RESET}"
    echo "  ${C_DIM}[dry-run] systemctl start  ${services[*]}${C_RESET}"
    return 0
  fi

  # Per docs (step 49 of full-node-installation): chown entire /home/monad
  # before service start. We've been chown'ing piecemeal (config files, keys)
  # in their respective steps, but a final blanket chown catches anything
  # we missed and matches the docs flow exactly.
  chown -R monad:monad /home/monad 2>>"$LOG_FILE" || \
    warn "chown -R monad:monad /home/monad/ returned non-zero (some files may stay root-owned)"

  # Per docs (steps 50 + 51): enable then start, all three services in
  # one command each. Docs do this for a reason — systemd starts the
  # full target in one batch with proper After= ordering applied.
  if ! run "enabling ${services[*]}" systemctl enable "${services[@]}"; then
    err "systemctl enable failed — see $LOG_FILE"
    return 1
  fi
  if ! run "starting ${services[*]}" systemctl start "${services[@]}"; then
    err "systemctl start failed — check: journalctl -u monad-bft -n 50"
    return 1
  fi

  sleep 3
  local any_failed=0
  for s in "${services[@]}"; do
    if systemctl is-active --quiet "$s"; then
      ok "$s active"
    else
      err "$s not active after start — check: journalctl -u $s -n 50"
      any_failed=1
    fi
  done
  (( any_failed )) && return 1
  ok "All services started. Validator is now online."
}

# ===== Step: iptables UDP DDoS filter =====
# Per docs: sudo iptables -I INPUT -p udp --dport 8000 -m length --length 0:1400 -j DROP
step_iptables_ddos() {
  section "iptables UDP length filter (per docs)"
  if ! command -v iptables >/dev/null; then
    warn "iptables not installed — skipping (install via step_dependencies)"
    return
  fi

  local rule_marker="# monad-bft UDP raptorcast: drop short packets (per docs)"
  local ufw_before=/etc/ufw/before.rules
  local rule_args=(-p udp --dport 8000 -m length --length 0:1400 -j DROP)
  local needs_persistence_only=0

  # Already in the live ruleset? (matches either via INPUT or ufw-before-input)
  if iptables -C INPUT "${rule_args[@]}" 2>/dev/null \
     || iptables -C ufw-before-input "${rule_args[@]}" 2>/dev/null; then
    # Verify it will also survive reboot — if UFW is active but the rule is
    # not in before.rules, it'll vanish on next `ufw reload` / reboot.
    if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active" \
       && [[ -f "$ufw_before" ]] && ! grep -qF "$rule_marker" "$ufw_before"; then
      info "Rule is live but not in $ufw_before — needs persistence only."
      needs_persistence_only=1
    else
      ok "rule already present (and persistent)"
      return
    fi
  fi

  if (( DRY_RUN )); then
    if (( needs_persistence_only )); then
      echo "  ${C_DIM}[dry-run] persist rule via UFW before.rules${C_RESET}"
    else
      echo "  ${C_DIM}[dry-run] iptables -I INPUT ${rule_args[*]}${C_RESET}"
      echo "  ${C_DIM}[dry-run] persist rule (via netfilter-persistent or UFW before.rules)${C_RESET}"
    fi
    return
  fi

  # Decide the prompt based on what we're actually about to do.
  if (( needs_persistence_only )); then
    info "iptables UDP-length filter is already in the live ruleset but not in"
    info "$ufw_before — without persisting, it vanishes on the next ufw reload/reboot."
    if ! confirm "Persist the existing rule via $ufw_before?"; then
      warn "Skipped — rule will be lost on next reboot"
      return 0
    fi
  else
    # An iptables INSERT runs ahead of any existing rules on the INPUT chain and
    # can interact badly with custom netfilter setups (frr/bird/k8s/wireguard).
    info "Will add: iptables -I INPUT ${rule_args[*]}"
    info "(drops short UDP packets <1400B on :8000 — valid raptorcast traffic is larger)"
    if ! confirm "Add this iptables rule?"; then
      warn "Skipped — docs recommend this rule for UDP DDoS robustness"
      return 0
    fi
  fi

  # Apply the rule live (idempotent thanks to the -C check above).
  if ! iptables -C INPUT "${rule_args[@]}" 2>/dev/null; then
    run "adding UDP length 0:1400 DROP rule" iptables -I INPUT "${rule_args[@]}"
  fi

  # Persistence: choose one of two paths.
  #   1. netfilter-persistent (saves to /etc/iptables/rules.v4 on shutdown)
  #   2. UFW before.rules     (loaded by ufw.service on boot)
  # On Ubuntu 24.04 these packages Conflict — only one will be installed.
  # We prefer netfilter-persistent when present (classic path); fall back to
  # UFW's before.rules, which is the canonical way to add custom iptables
  # rules when UFW is the firewall.
  if command -v netfilter-persistent >/dev/null; then
    run "persisting iptables rules" netfilter-persistent save
    ok "UDP length filter active and persisted via netfilter-persistent"
  elif [[ -f "$ufw_before" ]]; then
    if grep -qF "$rule_marker" "$ufw_before"; then
      ok "rule already in $ufw_before"
    else
      cp "$ufw_before" "${ufw_before}.bak.${TS}"
      info "backup: ${ufw_before}.bak.${TS}"
      # Insert in the *filter table, before the COMMIT line, as a
      # ufw-before-input rule (runs alongside UFW's own pre-input rules).
      # We use awk so we hit the COMMIT inside the *filter section specifically.
      awk -v marker="$rule_marker" '
        /^\*filter/ { in_filter = 1 }
        in_filter && /^COMMIT/ {
          print ""
          print marker
          print "-A ufw-before-input -p udp --dport 8000 -m length --length 0:1400 -j DROP"
          in_filter = 0
        }
        { print }
      ' "$ufw_before" >"${ufw_before}.tmp" && mv "${ufw_before}.tmp" "$ufw_before"

      # Verify the insertion actually landed. If before.rules has an unusual
      # structure (no *filter, no COMMIT in *filter section), awk silently
      # leaves the file unchanged — and the rule would not persist.
      if ! grep -qF "$rule_marker" "$ufw_before"; then
        err "Failed to insert rule into $ufw_before — unusual file structure?"
        err "Restore from backup: sudo cp ${ufw_before}.bak.${TS} ${ufw_before}"
        return 1
      fi
      if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
        run "reloading ufw to load before.rules" ufw reload
      fi
      ok "UDP length filter persisted via $ufw_before"
    fi
  else
    warn "no persistence mechanism (no netfilter-persistent, no $ufw_before) — rule will be lost on reboot"
    warn "Install one: apt install -y netfilter-persistent  OR  enable UFW first."
  fi
}

# ===== Step: /dev/triedb SYMLINK udev rule =====
# Per docs:
#   PARTUUID=$(lsblk -o PARTUUID $TRIEDB_DRIVE | tail -n 1)
#   echo "ENV{ID_PART_ENTRY_UUID}==\"$PARTUUID\", MODE=\"0666\", SYMLINK+=\"triedb\"" \
#     | tee /etc/udev/rules.d/99-triedb.rules
step_triedb_symlink() {
  section "TriedB SYMLINK udev rule (per docs)"
  local rule=/etc/udev/rules.d/99-triedb.rules

  # Identify triedb partition: prefer existing /dev/triedb symlink; else
  # nothing to do (operator must partition first or specify --triedb-dev=).
  local triedb_part=""
  if [[ -L /dev/triedb ]]; then
    triedb_part=$(readlink -f /dev/triedb)
  fi
  if [[ -z "$triedb_part" || ! -b "$triedb_part" ]]; then
    info "No triedb partition detected (/dev/triedb missing) — operator must"
    info "partition the triedb device first, then re-run this step."
    return
  fi

  local partuuid
  partuuid=$(lsblk -no PARTUUID "$triedb_part" 2>/dev/null | tr -d ' ')
  if [[ -z "$partuuid" ]]; then
    warn "Could not read PARTUUID of $triedb_part — skipping symlink rule"
    return
  fi

  local content="# monad-validator-setup ${TS}
ENV{ID_PART_ENTRY_UUID}==\"${partuuid}\", MODE=\"0666\", SYMLINK+=\"triedb\"
"
  if [[ -f "$rule" ]] && [[ "$(cat "$rule" 2>/dev/null)" == "$content" ]]; then
    ok "udev rule for triedb SYMLINK already in place (PARTUUID=$partuuid)"
    return
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write $rule with PARTUUID=$partuuid${C_RESET}"
    return
  fi
  backup_file "$rule"
  echo "$content" >"$rule"
  ok "Wrote $rule (PARTUUID=$partuuid)"
  run "reloading udev" udevadm control --reload-rules
}

# ===== Step: download config files (.env + node.toml) =====
# Per docs (full-node-installation):
#   curl -o /home/monad/.env $MF_BUCKET/config/<network>/latest/.env.example
#   curl -o /home/monad/monad-bft/config/node.toml \
#        $MF_BUCKET/config/<network>/latest/<full-node-node.toml | node.toml>
# Validator template is `node.toml`; full-node template is `full-node-node.toml`.
step_config_files() {
  section "Bootstrap config files (.env + node.toml)"

  if [[ -z "$NETWORK" ]]; then
    warn "Network not chosen — skipping config download (run choose_network first)"
    return
  fi

  local env_file=/home/monad/.env
  local node_toml=/home/monad/monad-bft/config/node.toml
  local toml_name
  if [[ "$NODE_TYPE" == "validator" ]]; then
    toml_name="node.toml"
  else
    toml_name="full-node-node.toml"
  fi
  local env_url="${MF_BUCKET}/config/${NETWORK}/latest/.env.example"
  local toml_url="${MF_BUCKET}/config/${NETWORK}/latest/${toml_name}"

  # .env — preserve if already exists (operator may have customized)
  if [[ -f "$env_file" ]]; then
    info ".env already present — keeping (delete first to re-download)"
  elif (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -o $env_file $env_url${C_RESET}"
  else
    mkdir -p "$(dirname "$env_file")"
    if run "downloading .env (${NETWORK})" curl -fsSL --max-time 30 -o "$env_file" "$env_url"; then
      chown monad:monad "$env_file" 2>/dev/null || true
      chmod 0644 "$env_file"
      ok "Wrote $env_file (from $env_url)"
    else
      warn "Failed to download .env — operator must place manually"
      return 1
    fi
  fi

  # node.toml — detect mismatched template (validator vs full) before
  # preserving. If the existing file is a validator template but operator
  # asked for full-node (or vice versa), backup + replace. This catches
  # the common "I installed as validator before stake, now want to be a
  # full node so peers will talk to me" recovery flow.
  local existing_type=""
  if [[ -f "$node_toml" ]]; then
    # Heuristic: validator template has enable_publisher=true and a real
    # beneficiary; full-node template has enable_publisher=false and
    # beneficiary = 0x0000…0000.
    if grep -qE '^enable_publisher[[:space:]]*=[[:space:]]*true' "$node_toml" 2>/dev/null; then
      existing_type="validator"
    elif grep -qE '^enable_publisher[[:space:]]*=[[:space:]]*false' "$node_toml" 2>/dev/null; then
      existing_type="full"
    fi
  fi

  if [[ -f "$node_toml" && -n "$existing_type" && "$existing_type" != "$NODE_TYPE" ]]; then
    warn "Existing node.toml is a ${existing_type}-template, requested ${NODE_TYPE}."
    if [[ "$existing_type" == "validator" && "$NODE_TYPE" == "full" ]]; then
      warn "A validator node without on-chain registration won't receive peer-list from bootstraps."
      warn "Switching to full-node template fixes peer discovery."
    fi
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] backup + replace $node_toml with ${toml_name}${C_RESET}"
    elif confirm "Replace node.toml with the ${NODE_TYPE} template (backup created)?"; then
      # Stop services if running — replacing node.toml under a live node
      # would cause an immediate config-reload mid-flight.
      local services_were_active=0
      if systemctl is-active --quiet monad-bft 2>/dev/null; then
        services_were_active=1
        warn "Stopping monad-bft/execution/rpc before replacing node.toml…"
        run "stopping services" systemctl stop monad-bft monad-execution monad-rpc || true
      fi
      cp -a "$node_toml" "${node_toml}.${existing_type}-backup.${TS}"
      ok "Backed up: ${node_toml}.${existing_type}-backup.${TS}"
      if run "downloading node.toml (${NODE_TYPE} on ${NETWORK})" \
           curl -fsSL --max-time 30 -o "$node_toml" "$toml_url"; then
        chown monad:monad "$node_toml" 2>/dev/null || true
        chmod 0644 "$node_toml"
        ok "Replaced $node_toml with ${NODE_TYPE} template"
        NODE_RECONFIGURED=1
        ROLE_TRANSITION="${existing_type}→${NODE_TYPE}"
        # A full template swap can invalidate the on-disk chain state, so the
        # ledger is suspect and a snapshot re-import is justified here.
        LEDGER_SUSPECT=1
      else
        warn "Download failed — restoring backup"
        cp -a "${node_toml}.${existing_type}-backup.${TS}" "$node_toml"
        return 1
      fi
      # If we stopped services, mark for snapshot restore + restart in
      # later steps. The role transition means stale ledger is suspect.
      (( services_were_active )) && info "Services will restart after remaining steps."
    else
      info "Keeping existing ${existing_type}-template node.toml"
    fi
  elif [[ -f "$node_toml" ]]; then
    info "node.toml already present (${existing_type:-unknown} template) — keeping"
  elif (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -o $node_toml $toml_url${C_RESET}"
  else
    mkdir -p "$(dirname "$node_toml")"
    if run "downloading node.toml (${NODE_TYPE} on ${NETWORK})" \
         curl -fsSL --max-time 30 -o "$node_toml" "$toml_url"; then
      chown monad:monad "$node_toml" 2>/dev/null || true
      chmod 0644 "$node_toml"
      ok "Wrote $node_toml (from $toml_url)"
    else
      warn "Failed to download node.toml — operator must place manually"
      return 1
    fi
  fi

  # Ensure REMOTE_VALIDATORS_URL / REMOTE_FORKPOINT_URL are set in .env.
  # The MF .env.example template currently includes them, but defensive
  # coding: docs explicitly say "Add these to /home/monad/.env", so if a
  # future template drops them or the operator pre-placed a stripped .env,
  # we add them ourselves. monad-bft uses them to fetch validators.toml
  # and forkpoint.toml at startup.
  if (( DRY_RUN == 0 )) && [[ -f "$env_file" ]]; then
    local v_url="${MF_BUCKET}/validators/${NETWORK}/validators.toml"
    local f_url="${MF_BUCKET}/forkpoint/${NETWORK}/forkpoint.toml"
    if ! grep -qE '^[[:space:]]*REMOTE_VALIDATORS_URL[[:space:]]*=' "$env_file"; then
      echo "REMOTE_VALIDATORS_URL='$v_url'" >>"$env_file"
      ok "Added REMOTE_VALIDATORS_URL to $env_file"
    fi
    if ! grep -qE '^[[:space:]]*REMOTE_FORKPOINT_URL[[:space:]]*=' "$env_file"; then
      echo "REMOTE_FORKPOINT_URL='$f_url'" >>"$env_file"
      ok "Added REMOTE_FORKPOINT_URL to $env_file"
    fi
  fi
}

