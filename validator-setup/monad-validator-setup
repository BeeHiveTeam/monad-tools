# ===== Step: IO scheduler =====
step_io_scheduler() {
  section "IO scheduler (mq-deadline on triedb)"

  local target="$TRIEDB_DEV"

  # Priority 1: explicit --triedb-dev= flag (already set in $target)

  # Priority 2: /dev/triedb symlink — authoritative, set by monad-mpt config
  if [[ -z "$target" && -L /dev/triedb ]]; then
    local triedb_part triedb_disk
    triedb_part=$(readlink -f /dev/triedb 2>/dev/null)
    triedb_part="${triedb_part##*/}"
    triedb_disk=$(lsblk -no PKNAME "/dev/${triedb_part}" 2>/dev/null | head -1)
    if [[ -n "$triedb_disk" ]]; then
      target="$triedb_disk"
      info "Detected triedb device from /dev/triedb → /dev/${triedb_part} (disk: $target)"
    fi
  fi

  # Priority 3: find an UNUSED NVMe — not part of OS RAID, not mounted, no role.
  # Avoid the dangerous "largest NVMe" guess that may pick the OS disk on
  # asymmetric setups where multiple disks share the same size.
  if [[ -z "$target" ]]; then
    local root_src root_dev parts_under_root=()
    root_src=$(findmnt -no SOURCE / 2>/dev/null)
    root_dev="${root_src##*/}"
    if [[ -n "$root_dev" && -e "/sys/block/$root_dev/md" ]]; then
      while IFS= read -r m; do
        parts_under_root+=("$m")
      done < <(ls "/sys/block/$root_dev/md/" 2>/dev/null | sed -n 's/^dev-//p')
    fi

    local best=""
    while IFS= read -r disk; do
      [[ -z "$disk" ]] && continue
      # Reject if any partition is a member of the root md array
      local skip=0
      for m in "${parts_under_root[@]}"; do
        if lsblk -ln -o NAME "/dev/$disk" 2>/dev/null | grep -qx "$m"; then skip=1; break; fi
      done
      (( skip )) && continue
      # Reject if anything under this disk is mounted at /
      if lsblk -ln -o MOUNTPOINT "/dev/$disk" 2>/dev/null | grep -qx "/"; then continue; fi
      # Reject if disk has any non-swap mounts (already in use for something)
      if lsblk -ln -o MOUNTPOINT "/dev/$disk" 2>/dev/null \
         | grep -vE '^$|^\[SWAP\]$' | grep -q .; then continue; fi
      # Pick the largest among remaining (unused) candidates.
      local size_b
      size_b=$(lsblk -bdn -o SIZE "/dev/$disk" 2>/dev/null)
      if [[ -z "$best" ]] || (( size_b > $(lsblk -bdn -o SIZE "/dev/$best" 2>/dev/null || echo 0) )); then
        best="$disk"
      fi
    done < <(lsblk -dn -o NAME,TYPE 2>/dev/null | awk '$2=="disk" && $1 ~ /^nvme/ {print $1}')

    if [[ -n "$best" ]]; then
      target="$best"
      info "/dev/triedb not present — picked unused NVMe '$target' as triedb candidate"
      info "(safer than 'largest NVMe' — won't accidentally select the OS disk)"
    fi
  fi

  if [[ -z "$target" ]]; then
    warn "No NVMe found — cannot tune IO scheduler"
    return 0
  fi

  local sched_file="/sys/block/$target/queue/scheduler"
  if [[ ! -f "$sched_file" ]]; then
    warn "$sched_file does not exist — skipping"
    return 0
  fi

  local cur
  cur=$(awk '{for(i=1;i<=NF;i++) if($i ~ /^\[/) {gsub(/[][]/,"",$i); print $i; exit}}' "$sched_file")
  if [[ "$cur" == "mq-deadline" ]]; then
    ok "$target already on mq-deadline"
  else
    if (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] echo mq-deadline > $sched_file${C_RESET}"
    else
      echo mq-deadline > "$sched_file" && ok "$target: scheduler $cur → mq-deadline"
    fi
  fi

  # Persist via udev rule.
  # NOTE: match by attribute (rotational=0 → SSD), not by exact device name.
  # Hardcoding KERNEL=="nvme1n1" silently breaks if the operator swaps the
  # disk (RMA, upgrade) — udev no longer applies the scheduler.
  local rule=/etc/udev/rules.d/60-monad-triedb-scheduler.rules
  local rule_content="# monad-validator-setup ${TS}
# Apply mq-deadline to all NVMe SSDs (matches by attribute, not name).
# Required for triedb performance per Monad operator feedback.
ACTION==\"add|change\", SUBSYSTEM==\"block\", KERNEL==\"nvme*\", \\
  ATTR{queue/rotational}==\"0\", ATTR{queue/scheduler}=\"mq-deadline\"
"
  if [[ -f "$rule" ]] && [[ "$(cat "$rule")" == "$rule_content" ]]; then
    ok "udev rule already in place"
    return 0
  fi
  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] write udev rule $rule${C_RESET}"
    return 0
  fi
  echo "$rule_content" >"$rule"
  ok "Wrote udev rule (persists across reboots)"
  run "reloading udev" udevadm control --reload-rules || \
    warn "udev rule written but reload failed — will apply on next boot"
}

# ===== Step: CVE mitigations =====
# Per Monad Foundation Discord advisory 2026-04-30 (CVE-2026-31431):
#   the algif_aead kernel module is exploitable on validator workloads.
#   Foundation recommends blacklisting it. monad-bft does not use it.
# Also: docs.monad.xyz/node-ops/full-node-installation guidance to keep
# the node from auto-rebooting under unattended-upgrades (an unscheduled
# reboot mid-block-proposal misses votes).
step_cve_mitigation() {
  section "Security mitigations (Foundation advisory)"

  # algif_aead blacklist — idempotent, harmless if already present.
  local conf=/etc/modprobe.d/blacklist-algif_aead.conf
  if [[ -f "$conf" ]] && grep -q '^blacklist algif_aead' "$conf"; then
    ok "algif_aead already blacklisted (per Foundation 2026-04-30 advisory)"
  elif (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] echo 'blacklist algif_aead' > $conf${C_RESET}"
  else
    if confirm "Blacklist algif_aead kernel module (Foundation advisory, CVE-2026-31431)?"; then
      echo 'blacklist algif_aead' > "$conf"
      chmod 0644 "$conf"
      # Unload now if currently loaded
      if lsmod | grep -q '^algif_aead'; then
        modprobe -r algif_aead 2>/dev/null || \
          warn "algif_aead is loaded but couldn't be unloaded — reboot to clear"
      fi
      ok "Wrote $conf (algif_aead blacklisted)"
    else
      info "Skipped — re-run any time to apply"
    fi
  fi

  # Unattended-upgrades automatic-reboot — set Automatic-Reboot "false"
  # so apt security updates don't reboot mid-block-proposal.
  local au_conf=/etc/apt/apt.conf.d/50unattended-upgrades
  if [[ -f "$au_conf" ]]; then
    if grep -qE '^[[:space:]]*Unattended-Upgrade::Automatic-Reboot[[:space:]]+"false"' "$au_conf"; then
      ok "unattended-upgrades auto-reboot already disabled"
    elif (( DRY_RUN )); then
      echo "  ${C_DIM}[dry-run] disable Unattended-Upgrade::Automatic-Reboot in $au_conf${C_RESET}"
    else
      # Replace any existing Automatic-Reboot setting, or append.
      if grep -qE 'Unattended-Upgrade::Automatic-Reboot' "$au_conf"; then
        sed -i -E 's|^[[:space:]]*//?[[:space:]]*Unattended-Upgrade::Automatic-Reboot[[:space:]]+"[^"]*"[[:space:]]*;|Unattended-Upgrade::Automatic-Reboot "false";|' "$au_conf"
      else
        printf '\nUnattended-Upgrade::Automatic-Reboot "false";\n' >> "$au_conf"
      fi
      ok "Disabled unattended-upgrades automatic reboot"
    fi
  else
    info "unattended-upgrades not configured — skipping reboot-disable"
  fi
}

# ===== Step: chrony =====
step_chrony() {
  section "NTP (chrony)"

  if command -v chronyc >/dev/null && systemctl is-active --quiet chrony; then
    ok "chrony already active"
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] disable systemd-timesyncd, install chrony${C_RESET}"
    return 0
  fi

  # If a non-default NTP setup is in place (ntpd, custom chrony build, OpenNTPD,
  # whatever), replacing it silently can break time sync the operator carefully
  # configured. We only get here if `chrony` isn't already the active service.
  if systemctl is-active --quiet systemd-timesyncd; then
    info "systemd-timesyncd is active. It drifts ~10–100ms which inflates vote_delay."
    if ! confirm "Replace systemd-timesyncd with chrony?"; then
      warn "Keeping systemd-timesyncd — vote_delay metrics may be skewed"
      return 0
    fi
    info "Disabling systemd-timesyncd"
    systemctl disable --now systemd-timesyncd >>"$LOG_FILE" 2>&1
  else
    if ! confirm "Install and enable chrony for NTP?"; then
      warn "Skipping chrony install — ensure another NTP daemon is running"
      return 0
    fi
  fi

  if ! run "installing chrony" apt-get install -y chrony; then
    err "chrony install failed — see $LOG_FILE"
    return 1
  fi
  if ! run "starting chrony" systemctl enable --now chrony; then
    err "chrony failed to enable/start — see $LOG_FILE"
    return 1
  fi
  sleep 2
  if systemctl is-active --quiet chrony; then
    ok "chrony installed and active"
  else
    err "chrony unit not active after start — check: systemctl status chrony"
    return 1
  fi
}

# ===== Step: monad apt repo + package =====
step_monad_install() {
  section "Monad package"

  # Already installed?
  if dpkg -l monad 2>/dev/null | grep -qE '^.i  monad'; then
    local cur
    cur=$(dpkg-query -W -f='${Version}' monad)
    ok "monad already installed (version $cur)"
    # Surface available upgrade so operator sees the gap on re-run.
    local candidate=""
    candidate=$(apt-cache policy monad 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
    if [[ -n "$candidate" && "$candidate" != "(none)" && "$candidate" != "$cur" ]]; then
      info "Apt repo offers a newer version: $candidate"
      info "To upgrade: apt-mark unhold monad && apt install --only-upgrade monad && apt-mark hold monad"
    fi
    return 0
  fi

  # Install apt repo + key. Use a strict order: key first, sources file ONLY
  # after the key is on disk, apt-get update last. If any step fails, do not
  # leave a half-configured state (broken sources file pointing at a repo with
  # no valid key) for the next run to trip on.
  local sources_file=/etc/apt/sources.list.d/category-labs.sources
  # Re-fetch key whenever the keyring is missing OR empty, even if sources_file
  # exists — this recovers from a previous run where the curl failed but the
  # sources file got written anyway (happened with the old GPG URL going 403).
  local need_key=0 need_sources=0
  if [[ ! -s "$MONAD_APT_KEYRING" ]]; then need_key=1; fi
  if [[ ! -f "$sources_file" ]]; then need_sources=1; fi

  if (( DRY_RUN )); then
    if (( need_key + need_sources > 0 )); then
      echo "  ${C_DIM}[dry-run] add Category Labs apt repo (${MONAD_APT_REPO})${C_RESET}"
    fi
  else
    if (( need_key )); then
      info "Adding Monad apt signing key: $MONAD_APT_KEY_URL"
      mkdir -p "$(dirname "$MONAD_APT_KEYRING")"
      # ASCII-armored key (.asc) — dearmor to keyring binary format apt expects.
      # If this fails, clean up so the next run retries from scratch.
      if ! run "fetching + dearmoring signing key" bash -c \
          "curl -fsSL '${MONAD_APT_KEY_URL}' | gpg --dearmor --yes -o '$MONAD_APT_KEYRING'"; then
        rm -f "$MONAD_APT_KEYRING"   # don't leave an empty/partial keyring
        err "Could not fetch the apt signing key — aborting monad install."
        err "Check network, then verify the URL: ${MONAD_APT_KEY_URL}"
        return 1
      fi
      ok "Signing key installed at $MONAD_APT_KEYRING"
    fi
    if (( need_sources )); then
      info "Adding Monad apt repository: $MONAD_APT_REPO (suite=$MONAD_APT_SUITE)"
      cat > "$sources_file" <<EOF
Types: deb
URIs: ${MONAD_APT_REPO}
Suites: ${MONAD_APT_SUITE}
Components: main
Signed-By: ${MONAD_APT_KEYRING}
EOF
      ok "Wrote $sources_file"
    fi
    if (( need_key + need_sources > 0 )); then
      # Refresh package lists. If this fails, the repo is misconfigured — bail
      # out rather than letting the next `apt-get install` produce confusing
      # "Unable to locate package monad" output.
      if ! run "apt update" apt-get update; then
        err "apt-get update failed against Monad repo. Common causes:"
        err "  - signing key URL changed (check ${MONAD_APT_KEY_URL})"
        err "  - network filtered (CloudFront block, captive portal)"
        err "  - GPG keyring corrupt — rm $MONAD_APT_KEYRING and re-run"
        return 1
      fi
    fi
  fi

  # Resolve final install target. Sources of truth, in priority order:
  #   1. MONAD_PKG_VERSION env (operator pinned explicitly)
  #   2. GitHub releases/latest (Category Labs publishes stable tags there;
  #      /releases/latest endpoint excludes pre-releases by design)
  #   3. apt-cache candidate (fallback when GitHub unreachable) — BUT only
  #      if it's not a pre-release suffix (~rc, ~beta, ~alpha, ~dev).
  #      apt's "Candidate" greedily picks the highest version including RCs;
  #      auto-installing an RC silently is a footgun.
  local target_version=""
  if [[ -n "$MONAD_PKG_VERSION" ]]; then
    target_version="$MONAD_PKG_VERSION"
    info "Installing pinned version: monad=${target_version}"
  else
    local gh_latest=""
    if command -v curl >/dev/null 2>&1; then
      # GitHub API rejects unauthenticated requests without User-Agent with
      # 403 Forbidden — set a recognisable UA so they don't 403 us.
      gh_latest=$(curl -fsS -m 5 \
        -H 'Accept: application/vnd.github+json' \
        -H 'User-Agent: BeeHive/monad-tools' \
        https://api.github.com/repos/category-labs/monad-bft/releases/latest 2>/dev/null \
        | grep -oE '"tag_name":[^,]+' | head -1 \
        | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+([-~][a-z0-9.]+)?' | sed 's/^v//')
    fi
    if [[ -n "$gh_latest" ]]; then
      target_version="$gh_latest"
      info "Latest stable from GitHub: monad=${C_BOLD}${target_version}${C_RESET}"
    else
      info "GitHub API unreachable — falling back to apt-cache candidate"
      local candidate=""
      candidate=$(apt-cache policy monad 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
      if [[ -z "$candidate" || "$candidate" == "(none)" ]]; then
        err "Could not determine a monad version to install."
        err "Neither GitHub releases/latest nor apt-cache returned a usable version."
        err "Pin manually: MONAD_PKG_VERSION=X.Y.Z ./monad-validator-setup ..."
        return 1
      fi
      if [[ "$candidate" =~ ~(rc|alpha|beta|dev|pre) ]]; then
        err "Apt repo candidate is a PRE-RELEASE: $candidate"
        err "Refusing to auto-install pre-release. Either:"
        err "  - Pin a stable version: MONAD_PKG_VERSION=$(echo "$candidate" | sed 's/~.*//') ./monad-validator-setup ..."
        err "  - Explicitly opt in to the RC: MONAD_PKG_VERSION=$candidate ./monad-validator-setup ..."
        return 1
      fi
      target_version="$candidate"
      info "Apt repo candidate: monad=${C_BOLD}${target_version}${C_RESET}"
    fi

    # Mainnet guard: the auto-detected version (GitHub releases/latest or apt
    # candidate) is network-agnostic, but mainnet routinely runs a version
    # BEHIND testnet — docs.monad.xyz pins different versions per network.
    # Installing the global latest on mainnet can put the node ahead of the
    # network. Only fires on the auto path (operator didn't pin a version).
    if [[ "$NETWORK" == "mainnet" ]]; then
      warn "Auto-detected monad=${target_version} for MAINNET."
      warn "Mainnet often lags testnet — verify ${target_version} matches the mainnet"
      warn "version at docs.monad.xyz/node-ops/full-node-installation."
      warn "To pin explicitly: MONAD_PKG_VERSION_MAINNET=X.Y.Z ./monad-validator-setup ..."
      if ! confirm "Proceed installing monad=${target_version} on mainnet?"; then
        err "Aborted. Re-run with MONAD_PKG_VERSION_MAINNET=<correct mainnet version>."
        return 1
      fi
    fi
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] apt install monad=${target_version}${C_RESET}"
    return 0
  fi

  if ! run "installing monad=${target_version}" apt-get install -y "monad=${target_version}"; then
    err "apt-get install monad=${target_version} failed — check $LOG_FILE"
    return 1
  fi
  if ! dpkg -l monad 2>/dev/null | grep -qE '^.i  monad'; then
    err "monad install failed (package not in installed state) — check $LOG_FILE"
    return 1
  fi
  ok "monad ${target_version} installed"

  # Hold the package so unattended-upgrades / accidental `apt upgrade` don't
  # bump the version mid-epoch. Operators can `apt-mark unhold monad` to
  # upgrade deliberately during a planned maintenance window.
  if ! dpkg -l monad 2>/dev/null | grep -qE '^hi  monad'; then
    run "holding monad package version" apt-mark hold monad || true
    ok "monad pinned at $(dpkg-query -W -f='${Version}' monad) (apt-mark hold)"
  else
    ok "monad already on hold"
  fi

  # The monad package drops /etc/sysctl.d/90-monad-network-buffer.conf with
  # rmem_max=62500000 (and the other UDP buffer settings monad-bft needs).
  # Postinst may or may not invoke `sysctl --system` — we run it explicitly
  # so the values are guaranteed live before any later step that depends on
  # them (notably step_start_services / monad-bft).
  if [[ -f /etc/sysctl.d/90-monad-network-buffer.conf ]]; then
    run "applying monad pkg sysctl drop-in" sysctl --system >/dev/null \
      || warn "sysctl --system returned non-zero (values may still be in effect)"
    local rmem_now
    rmem_now=$(sysctl -n net.core.rmem_max 2>/dev/null || echo 0)
    if (( rmem_now < 62500000 )); then
      warn "rmem_max is $rmem_now after sysctl --system — monad-bft needs ≥62500000"
      warn "Reboot the host or investigate /etc/sysctl.d/ priority before --start-services"
    else
      ok "net.core.rmem_max = $rmem_now (≥62500000 — monad-bft will be happy)"
    fi
  fi
}

# ===== Step: otelcol install (per docs) =====
# Docs explicitly install otelcol from the OpenTelemetry GitHub release with a
# pinned sha256, then copy the bundled config from /opt/monad/scripts/.
# We do the same — skipping cleanly when:
#   - otelcol-contrib is the active collector (operator has custom setup)
#   - otelcol is already installed at the pinned (or newer) version
step_otelcol_install() {
  section "OTel collector install (per docs, v${OTEL_VERSION})"

  if systemctl is-active --quiet otelcol-contrib 2>/dev/null; then
    info "otelcol-contrib.service is active — leaving plain otelcol untouched"
    info "(operator runs a custom collector; see docs/vdp-otel-push.md for VDP setup)"
    return 0
  fi

  if command -v otelcol >/dev/null 2>&1; then
    local cur
    cur=$(otelcol --version 2>/dev/null | awk '{print $NF; exit}' | tr -d 'v')
    if [[ -n "$cur" ]] && dpkg --compare-versions "$cur" ge "$OTEL_VERSION" 2>/dev/null; then
      ok "otelcol $cur already installed (≥ $OTEL_VERSION required)"
      return 0
    fi
    info "otelcol $cur present but < $OTEL_VERSION — will upgrade"
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] download $OTEL_DEB_URL${C_RESET}"
    echo "  ${C_DIM}[dry-run] sha256 verify against $OTEL_CHECKSUM${C_RESET}"
    echo "  ${C_DIM}[dry-run] dpkg -i otelcol .deb${C_RESET}"
    echo "  ${C_DIM}[dry-run] cp /opt/monad/scripts/otel-config.yaml /etc/otelcol/config.yaml${C_RESET}"
    return 0
  fi

  local deb=/tmp/otelcol_linux_amd64.deb
  if ! run "downloading otelcol .deb" curl -fsSL --max-time 120 -o "$deb" "$OTEL_DEB_URL"; then
    err "Could not download otelcol from $OTEL_DEB_URL"
    err "Check network reachability to github.com."
    return 1
  fi

  if ! echo "${OTEL_CHECKSUM}  ${deb}" | sha256sum --check --quiet; then
    err "OTel collector .deb sha256 mismatch — refusing to install"
    err "Expected: ${OTEL_CHECKSUM}"
    err "Actual:   $(sha256sum "$deb" | awk '{print $1}')"
    err "Either GitHub serves a tampered file (very unlikely) or upstream rotated"
    err "the release. Verify against docs.monad.xyz and update OTEL_CHECKSUM."
    rm -f "$deb"
    return 1
  fi

  if ! run "installing otelcol via dpkg" dpkg -i "$deb"; then
    err "dpkg -i failed — see $LOG_FILE"
    return 1
  fi
  rm -f "$deb"

  # Pin otelcol so `apt upgrade` doesn't silently bump it past the
  # sha256-pinned version we just installed (any future upgrade should be
  # deliberate + manually-verified).
  if ! dpkg -l otelcol 2>/dev/null | grep -qE '^hi  otelcol'; then
    run "holding otelcol version" apt-mark hold otelcol || true
    ok "otelcol pinned at $OTEL_VERSION (apt-mark hold)"
  fi

  # Docs: cp /opt/monad/scripts/otel-config.yaml /etc/otelcol/config.yaml
  # The bundled config comes from the monad apt package. If monad isn't
  # installed yet (operator hasn't reached step_monad_install), or used a
  # split setup, skip the copy and let step_otelcol_enable warn about
  # the missing config.
  if [[ -f /opt/monad/scripts/otel-config.yaml ]]; then
    mkdir -p /etc/otelcol
    cp /opt/monad/scripts/otel-config.yaml /etc/otelcol/config.yaml
    ok "Wrote /etc/otelcol/config.yaml (from monad-bundled template)"
  else
    warn "/opt/monad/scripts/otel-config.yaml not found — config not seeded"
    warn "(monad package may not be installed yet; step_otelcol_enable will warn)"
  fi

  ok "otelcol $OTEL_VERSION installed"
}

# ===== Step: otelcol enable =====
# The OTel collector binary is installed by step_otelcol_install above (or by
# an operator's custom flow). This step enables + starts the systemd unit if
# everything is in place. We enable+start plain `otelcol` only if:
#   - the unit exists
#   - it is not already active
#   - a custom otelcol-contrib is NOT active (operator may run their own stack)
#   - it has a config file (skips clean-slate boxes where MF setup hasn't run yet)
# --with-vdp-otel layers MF push config on top via step_vdp_otel_push.
step_otelcol_enable() {
  section "OTel collector (otelcol)"

  if ! systemctl cat otelcol >/dev/null 2>&1; then
    info "otelcol.service not installed (ships with monad package) — skipping"
    return 0
  fi

  if systemctl is-active --quiet otelcol-contrib 2>/dev/null; then
    info "otelcol-contrib.service active — leaving plain otelcol alone (operator runs custom collector)"
    return 0
  fi

  if systemctl is-active --quiet otelcol; then
    ok "otelcol already active"
    return 0
  fi

  if [[ ! -s /etc/otelcol/config.yaml ]]; then
    warn "otelcol unit exists but /etc/otelcol/config.yaml is empty/missing — not auto-starting"
    warn "Run with --with-vdp-otel to install the MF push config, or write your own first."
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] systemctl enable --now otelcol${C_RESET}"
    return 0
  fi

  if ! run "enabling otelcol" systemctl enable --now otelcol; then
    err "systemctl enable --now otelcol failed — check $LOG_FILE"
    return 1
  fi
  sleep 2
  if systemctl is-active --quiet otelcol; then
    ok "otelcol active — local metrics collector running"
  else
    err "otelcol failed to start — check: journalctl -u otelcol -n 100"
    return 1
  fi
}

# ===== Step: firewall (UFW) =====
step_firewall() {
  section "Firewall (UFW)"

  if ! command -v ufw >/dev/null; then
    info "Installing ufw…"
    run "installing ufw" apt-get install -y ufw
  fi

  # Detect SSH port(s) at runtime if not pinned via env. Operators very commonly
  # move SSH off :22; allowing only 22/tcp + ufw enable would lock them out.
  if [[ -z "$UFW_SSH_PORT" ]]; then
    UFW_SSH_PORT=$(detect_ssh_ports)
    info "Detected SSH port(s): ${C_BOLD}${UFW_SSH_PORT}${C_RESET}"
    if [[ "$UFW_SSH_PORT" == "22" ]]; then
      info "(default — override with UFW_SSH_PORT=\"22 2222 ...\" if your config differs)"
    fi
  else
    info "SSH port(s) from env: ${C_BOLD}${UFW_SSH_PORT}${C_RESET}"
  fi

  if (( DRY_RUN )); then
    local p_dry
    for p_dry in $UFW_SSH_PORT; do
      echo "  ${C_DIM}[dry-run] ufw allow ${p_dry}/tcp${C_RESET}"
    done
    echo "  ${C_DIM}[dry-run] ufw allow ${UFW_P2P_PORT} (tcp+udp), ${UFW_AUTHUDP_PORT}/udp${C_RESET}"
    return 0
  fi

  # SSH (avoid lockout!) — allow EVERY detected port, not just the default 22.
  local p
  for p in $UFW_SSH_PORT; do
    ufw allow "${p}/tcp" comment "ssh (port ${p})" >>"$LOG_FILE" 2>&1 || true
  done
  # 8000: consensus P2P — both TCP and UDP per docs
  ufw allow "${UFW_P2P_PORT}/tcp" comment 'monad p2p (tcp)' >>"$LOG_FILE" 2>&1 || true
  ufw allow "${UFW_P2P_PORT}/udp" comment 'monad p2p (udp/raptorcast)' >>"$LOG_FILE" 2>&1 || true
  # 8001: Authenticated UDP only
  ufw allow "${UFW_AUTHUDP_PORT}/udp" comment 'monad authenticated udp' >>"$LOG_FILE" 2>&1 || true

  if ! ufw status | grep -q "Status: active"; then
    if confirm "Enable UFW now? (SSH allowed on: ${UFW_SSH_PORT})"; then
      # Explicit default policies. ufw's first-install defaults are normally
      # deny-incoming / allow-outgoing, but a previous operator may have
      # flipped them with `ufw default allow incoming` — we don't want to
      # `ufw enable` on top of an allow-incoming default.
      ufw default deny incoming  >>"$LOG_FILE" 2>&1 || true
      ufw default allow outgoing >>"$LOG_FILE" 2>&1 || true
      ufw --force enable >>"$LOG_FILE" 2>&1
      ok "UFW enabled (default deny incoming, SSH allowed on ${UFW_SSH_PORT})"
    else
      warn "UFW configured but not enabled — run 'sudo ufw enable' when ready"
    fi
  else
    ok "UFW rules added (SSH allowed on ${UFW_SSH_PORT})"
  fi
}

