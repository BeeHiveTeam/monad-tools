# Per MF email (May 2026): every validator must push OTel metrics to
# otel-external.monadinfra.com:443 for VDP compliance. MF distributes the setup
# script via bucket.monadinfra.com with a verified sha256.
#
# Pinned sha256 for /tmp/otel-validator-setup.sh that was current as of 2026-05-14.
# If MF rotates the script, this check will (intentionally) fail — re-fetch the
# new sha256 from the official email/Discord before relaxing.
VDP_OTEL_SETUP_URL="${VDP_OTEL_SETUP_URL:-https://bucket.monadinfra.com/tmp/otel-validator-setup.sh}"
VDP_OTEL_SETUP_SHA256="${VDP_OTEL_SETUP_SHA256:-92cca0add5456db13c792b6e1b484999724b348ebd41a40a73d7f42086f26a23}"

step_vdp_otel_push() {
  if (( WITH_VDP_OTEL == 0 )); then
    info "Skipping VDP OTel push setup (use --with-vdp-otel to enable; testnet first!)"
    return 0
  fi
  section "VDP OTel push (Monad Foundation metrics export)"

  # Critical pre-conditions: KEYSTORE_PASSWORD must be in /home/monad/.env
  # (set by the operator when generating SECP/BLS keys). Without it,
  # monad-keystore can't recover the SECP pubkey that the MF script needs.
  if [[ ! -f /home/monad/.env ]] || ! grep -q "^KEYSTORE_PASSWORD=" /home/monad/.env 2>/dev/null; then
    # If VDP was auto-enabled (testnet default), soft-skip — don't fail the
    # whole install when keys just aren't placed yet. Operator can re-run
    # --with-vdp-otel later. If VDP was EXPLICITLY requested, hard-fail
    # because the operator asked for it.
    if (( WITH_VDP_OTEL_EXPLICIT == 0 )); then
      warn "VDP push skipped — no KEYSTORE_PASSWORD in /home/monad/.env (keys not generated yet)"
      warn "Auto-enabled because --network=testnet. Re-run with --with-vdp-otel after --generate-keys"
      return 0
    fi
    err "/home/monad/.env missing or has no KEYSTORE_PASSWORD — set it after generating keys"
    err "Re-run with --with-vdp-otel once keys are placed."
    return 1
  fi

  # Bail out cleanly if the operator runs a custom otelcol-contrib (e.g. ours
  # extended with journald → Loki). The MF script targets plain otelcol and would
  # write to /etc/otelcol/config.yaml which a contrib service doesn't read,
  # producing no error but no compliance either.
  if systemctl is-active --quiet otelcol-contrib 2>/dev/null; then
    warn "otelcol-contrib.service is active — MF setup script targets plain 'otelcol' and may NOT work on contrib setups"
    warn "Refer to https://github.com/BeeHiveTeam/monad-tools/blob/main/docs/vdp-otel-push.md"
    warn "Skipping --with-vdp-otel auto-apply. Apply the equivalent manually (see wiki) and re-check with monad-doctor."
    return 0
  fi

  if (( DRY_RUN )); then
    echo "  ${C_DIM}[dry-run] curl -fsSL -o /tmp/otel-validator-setup.sh $VDP_OTEL_SETUP_URL${C_RESET}"
    echo "  ${C_DIM}[dry-run] sha256sum -c against $VDP_OTEL_SETUP_SHA256${C_RESET}"
    echo "  ${C_DIM}[dry-run] sudo bash /tmp/otel-validator-setup.sh${C_RESET}"
    return 0
  fi

  info "Downloading MF VDP setup script…"
  curl -fsSL -o /tmp/otel-validator-setup.sh "$VDP_OTEL_SETUP_URL" \
    || { err "Failed to download $VDP_OTEL_SETUP_URL"; return 1; }

  info "Verifying sha256…"
  if ! echo "$VDP_OTEL_SETUP_SHA256  /tmp/otel-validator-setup.sh" | sha256sum -c; then
    err "SHA-256 mismatch — MF may have rotated the script."
    err "Verify the new sha256 from MF email/Discord and update VDP_OTEL_SETUP_SHA256."
    return 1
  fi

  # MF script's final step verifies that 'secp_key' label appears in
  # localhost:8889/metrics. That requires monad-bft to be running AND to
  # have completed at least one Prometheus scrape into otelcol. If we
  # arrive here right after step_start_services, monad-bft is up but
  # may not have produced metrics yet. Wait up to 30s for monad_* metrics
  # to appear; only then invoke the MF script.
  if systemctl is-active --quiet monad-bft 2>/dev/null; then
    info "Waiting for monad-bft to emit Prometheus metrics on :8889…"
    local waited=0
    while (( waited < 30 )); do
      if curl -sf --max-time 2 http://localhost:8889/metrics 2>/dev/null \
           | grep -q '^monad_'; then
        info "monad_* metrics flowing (after ${waited}s wait)"
        break
      fi
      sleep 2; waited=$((waited+2))
    done
    if (( waited >= 30 )); then
      warn "No monad_* metrics on :8889 after 30s — MF script verify will likely fail."
      warn "MF setup itself (config + restart) will still apply; re-run --with-vdp-otel after node syncs."
    fi
  else
    warn "monad-bft is NOT active — MF script verify will fail."
    warn "Start services first: sudo systemctl start monad-bft monad-execution monad-rpc"
    warn "Then re-run with --with-vdp-otel."
  fi

  info "Running MF VDP setup (idempotent on re-runs)…"
  if ! bash /tmp/otel-validator-setup.sh; then
    # MF script may exit non-zero on its own verify step even when the
    # config write + restart succeeded. Treat as soft-fail: config IS in
    # place, operator can re-run --with-vdp-otel once monad-bft is syncing
    # and emitting metrics, and the script's verify will pass then.
    warn "MF script returned non-zero (likely the secp_key verify step)."
    warn "The config + otelcol restart still applied — re-check after node sync:"
    warn "  curl -s http://localhost:8889/metrics | grep secp_key"
    warn "  ss -tnp | grep \":443\"   # → connections to otel-external.monadinfra.com"
    warn "Or re-run: sudo ./monad-validator-setup --network=testnet --skip-preflight --with-vdp-otel"
    return 0   # don't fail the install — config likely OK, only verify failed
  fi
  ok "MF VDP setup completed — metrics push to MF is active"
}

