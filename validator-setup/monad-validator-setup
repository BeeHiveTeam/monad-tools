#!/usr/bin/env bash
# monad-validator-setup — one-shot Monad validator host configuration
# Project: BeeHive monad-tools
# Repo: https://github.com/BeeHiveTeam/monad-tools
#
# What it does (idempotent, safe to re-run; many steps optional with explicit
# opt-in via prompt or flag — defaults preserve manual-control workflow):
#   Mandatory: preflight, deps, monad user/dirs, ulimits, IO scheduler,
#              triedb udev SYMLINK, chrony, monad apt+pkg (which drops its
#              own /etc/sysctl.d/90-monad-network-buffer.conf for rmem_max
#              etc), otelcol install+enable, UFW, iptables UDP filter,
#              post-install report.
#   Note: we no longer write a /etc/sysctl.d/99-monad-validator.conf —
#         the monad pkg owns network-buffer tuning. Legacy file from
#         older installs is cleaned up at start.
#   Optional (prompts or --flags):
#              triedb partitioning (--triedb-partition=DEV; prompts otherwise — DESTRUCTIVE)
#              triedb format (AUTO when /dev/triedb exists & monad-mpt unrun)
#              node.toml customize (--beneficiary=, --node-name=; prompts for beneficiary)
#              key generation (--generate-keys, --keys-password=auto|prompt; prompts otherwise)
#              name-record signing (AUTO when keys exist & sig is placeholder)
#              monad-grafana monitoring (--with-monitoring)
#              VDP OTel push (--with-vdp-otel)
#              start services (--start-services; prompts otherwise — FINAL go-live)
#
# Safety properties:
#   - Touches no existing file without first saving .bak.<timestamp>
#   - Destructive operations (disk partition, nvme reformat, key gen, service
#     start) are gated behind --flags or confirm() prompts — never silent
#   - --non-interactive auto-Yes confirms only; preflight FAIL still aborts
#
# Usage:
#   sudo ./monad-validator-setup                       # interactive (asks network + prompts for optionals)
#   sudo ./monad-validator-setup --network=testnet     # skip network prompt
#   sudo ./monad-validator-setup --network=mainnet --non-interactive
#   sudo ./monad-validator-setup --full-node           # full-node template (default: validator)
#   sudo ./monad-validator-setup --dry-run             # show what would change
#   sudo ./monad-validator-setup --triedb-dev=nvme1n1  # pin IO-scheduler target
#   sudo ./monad-validator-setup --triedb-partition=nvme1n1   # DESTRUCTIVE: partition this disk for triedb
#   sudo ./monad-validator-setup --triedb-format       # (kept for back-compat — triedb format now AUTO-runs)
#   sudo ./monad-validator-setup --beneficiary=0x... --node-name=BeeHive-1   # write into node.toml
#   sudo ./monad-validator-setup --generate-keys --keys-password=auto        # auto-gen + show password
#   sudo ./monad-validator-setup --generate-keys --keys-password=prompt      # prompt for password
#   sudo ./monad-validator-setup --sign-name-record    # (kept for back-compat — name-record sign now AUTO-runs)
#   sudo ./monad-validator-setup --start-services      # systemctl enable+start monad-* (FINAL, opt-in)
#   sudo ./monad-validator-setup --with-monitoring     # also install monad-grafana
#   sudo ./monad-validator-setup --with-vdp-otel       # run MF VDP OTel push setup (testnet first!)
#   sudo ./monad-validator-setup --skip-preflight      # skip monad-doctor
#   sudo ./monad-validator-setup --uninstall           # remove (best-effort)
#
# Full end-to-end automated install (zero-prompt CI):
#   sudo MONAD_PKG_VERSION=0.14.3 ./monad-validator-setup --non-interactive \
#     --network=testnet --triedb-partition=nvme1n1 --triedb-format \
#     --beneficiary=0x... --node-name=BeeHive-1 \
#     --generate-keys --keys-password=auto \
#     --sign-name-record --start-services

set -u

# ===== Defaults =====
NON_INTERACTIVE=0
DRY_RUN=0
SKIP_PREFLIGHT=0
WITH_MONITORING=0
WITH_VDP_OTEL=0
WITH_VDP_OTEL_EXPLICIT=0     # 1 if operator passed --with-vdp-otel OR --no-vdp-otel explicitly
TRIEDB_DEV=""
TRIEDB_PARTITION_DEV=""     # if set, step_triedb_partition uses this disk non-interactively
WITH_TRIEDB_FORMAT=0        # if 1, systemctl start monad-mpt (one-shot triedb format)
WITH_SNAPSHOT_RESTORE=1     # default ON per docs full-node-installation step 15; use --no-snapshot-restore to skip
WITH_SNAPSHOT_RESTORE_EXPLICIT=0   # set if --snapshot-restore or --no-snapshot-restore was passed
ALLOW_NVME_REFORMAT=0       # if 1, --non-interactive may invoke nvme format --lbaf=0
ALLOW_SNAPSHOT_OVERWRITE=0  # if 1, --non-interactive may overwrite an EXISTING populated triedb
BENEFICIARY=""              # 0x... address — auto-injected into node.toml if set
NODE_NAME=""                # unique moniker — auto-injected into node.toml if set
WITH_KEYS=0                 # if 1, run monad-keystore create with KEYSTORE_PASSWORD source
KEYSTORE_PASSWORD_INPUT=""  # "auto" | "prompt" | "" (interactive picks)
WITH_SIGN_NAME_RECORD=0     # if 1, run monad-sign-name-record + inject into node.toml
WITH_START_SERVICES=0       # if 1, systemctl enable+start monad-* services (FINAL)
NODE_RECONFIGURED=0         # set to 1 when a step modifies node.toml or keys
ROLE_TRANSITION=""          # "full→validator" / "validator→full" / "" when changed
LEDGER_SUSPECT=0            # 1 only when the chain state may be invalid (node.toml
                            # template swap). A beneficiary-only promotion does NOT
                            # set this — triedb state is identical, no re-snapshot.
NETWORK=""                  # testnet | mainnet — asked interactively if empty
NODE_TYPE="full"            # full | validator — default per docs validator-installation:
                            # "Start by configuring a node according to the full node installation
                            # instructions." Validators are promoted from a full node AFTER on-chain
                            # registration. Use --validator to override (only if you already have
                            # an on-chain stake / Auth Address grant).
NODE_TYPE_EXPLICIT=0        # set if --full-node, --validator, or --node-type= was passed
ACTION="install"
LOG_FILE="/tmp/monad-validator-setup-$(date +%Y%m%d-%H%M%S).log"
TS=$(date -u +%Y%m%d-%H%M%S)
DOCTOR_PATH="$(dirname "$0")/../doctor/monad-doctor"
REPORT_FILE="/var/lib/monad-validator-setup/report-${TS}.json"

# Monad foundation config bucket per docs (full-node-installation page).
MF_BUCKET="${MF_BUCKET:-https://bucket.monadinfra.com}"

# Tuning values
#
# We deliberately DO NOT write /etc/sysctl.d/99-monad-validator.conf anymore.
# The monad apt package drops /etc/sysctl.d/90-monad-network-buffer.conf with
# the network-buffer tuning its dataplane needs; everything else (swappiness,
# netdev_max_backlog, fs.file-max, tcp_fastopen) uses Linux defaults.
# Operators who want stricter limits write their own drop-in.
#
# monad-doctor will WARN (not FAIL) on the defaults — that's informational,
# the operator decides. See history (commits before bf6730d) for the old
# behavior that wrote rmem_max=16MB and silently downgraded the monad pkg.
ULIMIT_NOFILE=1048576

# OpenTelemetry collector .deb from upstream (per Monad docs — they pin
# this version + sha256 in full-node-installation page). The Monad apt
# package does NOT include otelcol; it must be installed separately.
# Verified 2026-05-15.
OTEL_VERSION="${OTEL_VERSION:-0.139.0}"
OTEL_CHECKSUM="${OTEL_CHECKSUM:-1a1576dde7d51fa7094f4963ceaff37c91ac7b9c9593ba735a3a328ec6f8acd9}"
OTEL_DEB_URL="${OTEL_DEB_URL:-https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v${OTEL_VERSION}/otelcol_${OTEL_VERSION}_linux_amd64.deb}"

# Official Monad apt repo (Category Labs).
# Source: https://docs.monad.xyz/node-ops/full-node-installation
MONAD_APT_REPO="${MONAD_APT_REPO:-https://pkg.category.xyz/}"
MONAD_APT_SUITE="${MONAD_APT_SUITE:-noble}"
# Foundation moved the key 2026-05-14: was /category-labs.gpg (binary, now 403),
# now /keys/public-key.asc (ASCII-armored — requires `gpg --dearmor`).
MONAD_APT_KEY_URL="${MONAD_APT_KEY_URL:-https://pkg.category.xyz/keys/public-key.asc}"
MONAD_APT_KEYRING="${MONAD_APT_KEYRING:-/etc/apt/keyrings/category-labs.gpg}"
# Monad package version policy.
# Default: track whatever Category Labs publishes as the "candidate" in their
# apt repo (https://pkg.category.xyz/). This is what `apt install monad`
# without a version pin gets, and it's the source-of-truth the docs page
# mirrors. By detecting the candidate at install time we never need to hand-
# edit a hardcoded pin when MF/CL bump a release.
#
# Override paths (in priority order):
#   MONAD_PKG_VERSION=0.14.3    → install exactly this version
#   MONAD_PKG_VERSION=""        → install latest candidate from apt repo (default)
#   MONAD_PKG_VERSION_TESTNET=  → per-network override (set both to keep them divergent)
#   MONAD_PKG_VERSION_MAINNET=
MONAD_PKG_VERSION_TESTNET="${MONAD_PKG_VERSION_TESTNET-}"
MONAD_PKG_VERSION_MAINNET="${MONAD_PKG_VERSION_MAINNET-}"
MONAD_PKG_VERSION="${MONAD_PKG_VERSION-__auto__}"   # __auto__ = decide after apt update

# UFW ports per docs:
#   - SSH (default 22/tcp, but auto-detected — operators commonly move SSH)
#   - 8000 (TCP+UDP — consensus P2P)
#   - 8001/udp (Authenticated UDP)
# UFW_SSH_PORT is a space-separated list, populated by detect_ssh_ports()
# at runtime if empty. Override via env (e.g. UFW_SSH_PORT="22 2222") to
# pin specific ports.
UFW_SSH_PORT="${UFW_SSH_PORT:-}"
UFW_P2P_PORT="8000"        # both TCP and UDP
UFW_AUTHUDP_PORT="8001"    # UDP only

# ===== Colors =====
if [[ -t 1 ]]; then
  C_RED=$'\033[0;31m'; C_GREEN=$'\033[0;32m'; C_YELLOW=$'\033[0;33m'
  C_BLUE=$'\033[0;34m'; C_PURPLE=$'\033[0;35m'; C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'; C_RESET=$'\033[0m'
else
  C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_PURPLE=""; C_BOLD=""; C_DIM=""; C_RESET=""
fi

info()    { echo "${C_BLUE}[i]${C_RESET} $*"; }
ok()      { echo "${C_GREEN}[✓]${C_RESET} $*"; }
warn()    { echo "${C_YELLOW}[!]${C_RESET} $*" >&2; }
err()     { echo "${C_RED}[✗]${C_RESET} $*" >&2; }
fatal()   { err "$*"; exit 1; }
section() { echo; echo "${C_BOLD}${C_PURPLE}━━ $* ━━${C_RESET}"; }

# ===== Args =====
while [[ $# -gt 0 ]]; do
  case "$1" in
    --non-interactive) NON_INTERACTIVE=1 ;;
    --dry-run)         DRY_RUN=1 ;;
    --skip-preflight)  SKIP_PREFLIGHT=1 ;;
    --with-monitoring) WITH_MONITORING=1 ;;
    --with-vdp-otel)   WITH_VDP_OTEL=1; WITH_VDP_OTEL_EXPLICIT=1 ;;
    --no-vdp-otel)     WITH_VDP_OTEL=0; WITH_VDP_OTEL_EXPLICIT=1 ;;
    --triedb-dev=*)    TRIEDB_DEV="${1#*=}" ;;
    --triedb-partition=*) TRIEDB_PARTITION_DEV="${1#*=}" ;;
    --triedb-format)   WITH_TRIEDB_FORMAT=1 ;;
    --beneficiary=*)   BENEFICIARY="${1#*=}" ;;
    --node-name=*)     NODE_NAME="${1#*=}" ;;
    --generate-keys)   WITH_KEYS=1 ;;
    --keys-password=*) KEYSTORE_PASSWORD_INPUT="${1#*=}" ;;
    --sign-name-record) WITH_SIGN_NAME_RECORD=1 ;;
    --snapshot-restore) WITH_SNAPSHOT_RESTORE=1; WITH_SNAPSHOT_RESTORE_EXPLICIT=1 ;;
    --no-snapshot-restore) WITH_SNAPSHOT_RESTORE=0; WITH_SNAPSHOT_RESTORE_EXPLICIT=1 ;;
    --allow-nvme-reformat) ALLOW_NVME_REFORMAT=1 ;;
    --allow-snapshot-overwrite) ALLOW_SNAPSHOT_OVERWRITE=1 ;;
    --start-services)  WITH_START_SERVICES=1 ;;
    --network=*)       NETWORK="${1#*=}" ;;
    --node-type=*)     NODE_TYPE="${1#*=}"; NODE_TYPE_EXPLICIT=1 ;;
    --full-node)       NODE_TYPE="full"; NODE_TYPE_EXPLICIT=1 ;;
    --validator)       NODE_TYPE="validator"; NODE_TYPE_EXPLICIT=1 ;;
    --uninstall)       ACTION="uninstall" ;;
    --uninstall-deep)  ACTION="uninstall-deep" ;;
    -h|--help)
      cat <<'HELP'
monad-validator-setup — one-shot Monad validator host configuration.

USAGE
  sudo ./monad-validator-setup                        # interactive walkthrough
  sudo ./monad-validator-setup --network=testnet      # skip network prompt
  sudo ./monad-validator-setup --non-interactive ...  # CI mode (see below)

QUICK START (interactive, recommended for first install)
